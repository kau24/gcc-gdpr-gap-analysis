r processing; does not address providing information or communications to data subjects."}], "confidence": 0.64, "holistic_label": "partial", "id": "2b2e10fd99f2c63a1b33", "condition": "negative_control", "required": "C5", "ru_id": "RU-047", "jurisdiction": "BHR", "n_candidates": 3}
