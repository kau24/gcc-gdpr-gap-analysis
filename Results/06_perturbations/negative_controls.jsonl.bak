{"label": "C5", "slot_verdicts": [{"gdpr": "controller", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "addressee"}, {"gdpr": "obligation", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "modality"}, {"gdpr": "include the name and contact details of the controller in the record", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr": "the record of processing activities maintained under Article 30(1)", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "exception"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "consequence"}], "candidates_selected": [], "candidates_excluded": [{"id": "b59c6e3df96d0cdf91f8", "reason": "Concerns appointment of an external auditor upon Ministry request and submitting the audit report; does not address records of processing or including the controller’s name/contact details."}, {"id": "498c9cb637b86367567b", "reason": "Establishes Ministry functions, including maintaining a register of controllers/processors; does not impose on controllers a record of processing or specify inclusion of controller name/contact details."}], "confidence": 0.86, "holistic_label": "uncovered", "id": "2d83c9b1ad974f1c238f", "condition": "negative_control", "required": "C5", "ru_id": "RU-255", "jurisdiction": "OMN", "n_candidates": 2}
{"label": "C5", "slot_verdicts": [{"gdpr": "controller", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "addressee"}, {"gdpr": "obligation", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "modality"}, {"gdpr": "provide the data subject with the identity of the controller", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr": "information duties when personal data were not obtained from the data subject", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr": "where personal data have not been obtained from the data subject", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr": "Paragraphs 1 to 4 do not apply where and insofar as: (a) the data subject already has the information; (b) providing the information proves impossible or would involve a disproportionate effort, in particular for processing for archiving in the public interest, scientific or historical research, or statistical purposes, subject to Article 89(1), or insofar as the obligation in paragraph 1 would render impossible or seriously impair the achievement of the objectives of that processing; (c) obtaining or disclosure is expressly laid down by Union or Member State law to which the controller is subject and which provides appropriate measures to protect the data subject's legitimate interests; or (d) the personal data must remain confidential subject to an obligation of professional secrecy under Union or Member State law, including a statutory obligation of secrecy.", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "exception"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "consequence"}], "candidates_selected": [], "candidates_excluded": [{"id": "9b42add02f4d45cf8a57", "reason": "General administrative provisions (compliance timeframe, authority guidance, sanctions) with no data-subject information duties and no requirement to provide the controller’s identity when data were not obtained from the data subject."}], "confidence": 0.86, "holistic_label": "uncovered", "id": "b383c51d4021bbbbb035", "condition": "negative_control", "required": "C5", "ru_id": "RU-086", "jurisdiction": "KWT", "n_candidates": 1}
