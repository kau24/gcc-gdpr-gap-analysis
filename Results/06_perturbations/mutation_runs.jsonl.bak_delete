ndition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "data protection officer", "target": "مسؤول حماية البيانات الشخصية ... لدى المتحكم أو المعالج", "basis": "direct_textual", "verdict": "covered", "citation": "Article 35 (chapeau)"}, {"slot": "modality", "gdpr": "obligation", "target": "يتولى ... المهام الآتية:", "basis": "direct_textual", "verdict": "covered", "citation": "Article 35"}, {"slot": "action", "gdpr": "inform the controller or the processor and the employees who carry out processing of their data protection obligations", "target": "تقديم المقترحات والاستشارات للمتحكم أو المعالج فيما يتعلق بالتزاماتهما", "basis": "direct_textual", "verdict": "partial", "citation": "Article 35(1)"}, {"slot": "scope", "gdpr": "obligations under the GDPR and other Union or Member State data protection provisions", "target": "التزاماتهما الواردة في القانون وهذه اللائحة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 35(1)"}, {"slot": "condition", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "exception", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.67, "reasoning_note": "Article 35(1) obliges the DPO to advise the controller or processor regarding their obligations under the law and regulation, which functionally covers informing those entities. However, no provision explicitly requires the DPO to inform employees who carry out processing of their obligations, leaving that element uncovered.", "label": "C2", "ru_id": "RU-474", "gdpr_article": 39, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 5, "total": 17}, {"round": 3, "n_queries": 4, "new": 1, "total": 18}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict is not supported by the citation, and the provision does not explicitly cover the obligation to inform employees.", "counter_evidence": [{"id": "db1b46495b01511abeef", "span": "1- تقديم المقترحات والاستشارات للمتحكم أو المعالج فيما يتعلق بالتزاماتهما الواردة في القانون وهذه اللائحة.", "why": "The provision does not explicitly state that the data protection officer is obliged to inform employees."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The target jurisdiction's provisions do not explicitly cover informing employees who carry out processing of their obligations under the GDPR and other Union or Member State data protection provisions.", "counter_evidence": [{"id": "db1b46495b01511abeef", "span": "1- تقديم المقترحات والاستشارات للمتحكم أو المعالج فيما يتعلق بالتزاماتهما الواردة في القانون وهذه اللائحة.", "why": "This provision supports the obligation to inform the controller or processor but does not explicitly mention employees who carry out processing."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["487015f110e7b88b5c03", "6e6fc1f4d7421fb141d6", "3a6219e8839cbad1f76e", "865fbf2c2a6ca6fcb814", "a0a0194dd91481c29c6e", "9afcca9ce75d4e0c23f1", "db1b46495b01511abeef", "a4136d70ee84d058ef85", "bb26cffae1f1c0beb85d", "05b7537a91d92a0529ad", "40626451a5025d77cff5", "a0040ee4dad7d4440e19"], "n_llm_calls": 7, "latency_s": 325.32, "temperature": 0.0, "seed": 20260801, "id": "0867716febd8b2ec0b13", "mutation_id": "c5e25e860eae79709078", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["593beb6b1fe15a8fda31"], "candidates_excluded": [{"id": "f8c6dae3f69fbe207307", "reason": "Regulates disclosure exceptions; does not govern controller selection or use of processors."}, {"id": "62cc177254bb6a5bed90", "reason": "Imposes security measures on controllers generally; does not address selecting/engaging processors."}, {"id": "557230873031d6e5cb2c", "reason": "Marketing processing conditions; unrelated to processor selection."}, {"id": "4919410df7147924356b", "reason": "Data subject access; not about processors."}, {"id": "3a56eed81feb3655d1d1", "reason": "Public-interest processing by public bodies; not about processor selection."}, {"id": "08b4c74d887bbe3b2039", "reason": "Credit data-specific rules; not about controller–processor arrangements."}, {"id": "7ddbf4e54143664b8b8b", "reason": "Disclosure handling; not about choosing processors."}, {"id": "8394f801a0a97e521f68", "reason": "DPO appointment; not about processor engagement."}, {"id": "ea8306cd18f9261f6413", "reason": "Information at collection; not about processors."}, {"id": "c511c9bf7779067e64f4", "reason": "Lawful bases/exceptions for collection/other processing; not about processors."}, {"id": "9cfd6fbae8182dbc0028", "reason": "Right to be informed; not about processor selection."}], "target_frame": {"addressee": {"span": "على جهة التحكم", "article": "Article 17(1)"}, "modality": {"span": "على جهة التحكم ... الالتزام", "article": "Article 17(1)"}, "action": {"span": "الالتزام باختيار جهة معالجة تقدم ضمانات كافية لحماية البيانات الشخصية", "article": "Article 17(1)"}, "scope": {"span": "وأن يتضمن الاتفاق مع جهة المعالجة ما يلي:", "article": "Article 17(1)"}, "condition": {"span": "عند اختيار جهة المعالجة", "article": "Article 17(1)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": "عند مخالفة جهة المعالجة للتعليمات الصادرة من جهة التحكم أو الاتفاق المبرم معها بشأن معالجة البيانات الشخصية، فتعد جهة المعالجة في حكم جهة التحكم وتكون مسؤولة عن مخالفة أحكام النظام.", "article": "Article 17(4)"}}, "slot_verdicts": [{"gdpr": "controller", "target": "جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(1)", "slot": "addressee"}, {"gdpr": "obligation", "target": "على جهة التحكم ... الالتزام", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(1)", "slot": "modality"}, {"gdpr": "use only processors that provide sufficient guarantees to implement appropriate technical and organisational measures so that processing meets this Regulation and protects data subjects' rights", "target": "choose a processor that provides sufficient guarantees to protect personal data", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 17(1)", "slot": "action"}, {"gdpr": "selection and engagement of processors", "target": "selection and agreement terms with the processor", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(1)", "slot": "scope"}, {"gdpr": "where processing is to be carried out on behalf of a controller", "target": "when selecting a processor", "basis": "conceptual", "verdict": "covered", "citation": "Article 17(1)", "slot": "condition"}, {"gdpr": "None", "target": "no exception stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr": "None", "target": "no temporal qualifier stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": "if the processor violates instructions or the agreement, it is deemed a controller and is liable", "basis": "direct_textual", "verdict": "broader", "citation": "Article 17(4)", "slot": "consequence"}], "holistic_label": "mostly_covered_with_narrower_action", "confidence": 0.78, "reasoning_note": "For the action slot, Article 17(1) obliges the controller to select a processor offering sufficient guarantees to protect personal data, but it does not require guarantees to implement appropriate technical and organisational measures or to ensure compliance with the law/rights; hence the ‘narrower’ verdict. Article 17(3) concerns periodic verification/monitoring and does not convert the selection guarantee into one about technical/organizational measures. The remaining slots are directly or conceptually aligned.", "label": "C1", "ru_id": "RU-224", "gdpr_article": 28, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 14, "total": 26}, {"round": 3, "n_queries": 4, "new": 0, "total": 26}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The KSA jurisdiction does not have a full counterpart to the GDPR requirement unit [RU-224], and the analyst's claim of a partial match is not fully justified.", "counter_evidence": [{"id": "593beb6b1fe15a8fda31", "span": "Article 17", "why": "Article 17 does not explicitly require the processor to implement appropriate technical and organizational measures to meet the Regulation and protect data subjects' rights."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's citation of Article 17(1) and Article 17(3) does not fully support the verdict on the 'action' slot", "counter_evidence": [{"id": "593beb6b1fe15a8fda31", "span": "Article 17(1) and Article 17(3)", "why": "The provisions do not explicitly state that the controller is obliged to use only processors that provide sufficient guarantees to implement appropriate technical and organizational measures"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["f8c6dae3f69fbe207307", "62cc177254bb6a5bed90", "593beb6b1fe15a8fda31", "557230873031d6e5cb2c", "4919410df7147924356b", "3a56eed81feb3655d1d1", "08b4c74d887bbe3b2039", "7ddbf4e54143664b8b8b", "8394f801a0a97e521f68", "ea8306cd18f9261f6413", "c511c9bf7779067e64f4", "9cfd6fbae8182dbc0028"], "n_llm_calls": 7, "latency_s": 395.34, "temperature": 0.0, "seed": 20260801, "id": "6fa01ee958926f0f5b48", "mutation_id": "b99e2da22993939c2a76", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["85e94dba24cbfb8955cd"], "candidates_excluded": [{"id": "89d1bb9a58e65b732117", "reason": "Pre-processing notice duty imposed on the controller; does not itself grant a right to obtain purposes information."}, {"id": "6c76988b817262e3e312", "reason": "Procedural/facilitative obligations (systems to handle requests); does not specify a right to obtain purposes information."}, {"id": "f5c366135483fe580381", "reason": "Breach notification; not about data subject's right to information on processing purposes."}, {"id": "75db9db720e9e34a1148", "reason": "Conditions for disclosure/transfer to processor; not about data subject information rights."}, {"id": "85d05fccf5b4f57eceaf", "reason": "General controller obligations (fairness, security, policies); no data subject right to purposes information."}, {"id": "fcbd13532c69b340214e", "reason": "Security safeguards and processor-to-controller breach notice; not about data subject information rights."}, {"id": "dce663972f2d5e58176e", "reason": "Scope of the law; not about data subject information rights."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "National security and other exemptions from specified articles; does not address Art. 6 rights."}, {"id": "f169b712b14aea8718ee", "reason": "Legal bases for processing; not about data subject information rights."}, {"id": "455aae046cacf7979576", "reason": "Data minimization/accuracy/retention; not about data subject information rights."}, {"id": "2bcce9feda2fcb9d35fe", "reason": "General right to privacy; does not specify a right to obtain purposes information."}], "target_frame": {"addressee": {"span": "للفرد", "article": "Article 6"}, "modality": {"span": "وله بوجه خاص الحق", "article": "Article 6"}, "action": {"span": "إخطاره بمعالجة بياناته الشخصية ... وبالأغراض التي تجري من أجلها تلك المعالجة", "article": "Article 6"}, "scope": {"span": "بالأغراض التي تجري من أجلها تلك المعالجة", "article": "Article 6"}, "condition": {"span": "معالجة بياناته الشخصية", "article": "Article 6"}, "exception": {"span": null, "article": null}, "temporal": {"span": "في أي وقت", "article": "Article 6"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "data subject", "target": "الفرد (data subject)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 6", "slot": "addressee"}, {"gdpr": "right", "target": "له/وله بوجه خاص الحق", "basis": "direct_textual", "verdict": "covered", "citation": "Article 6", "slot": "modality"}, {"gdpr": "obtain from the controller information on the purposes of the processing", "target": "إخطاره بمعالجة بياناته الشخصية وبالأغراض التي تجري من أجلها تلك المعالجة (حق يمارس في مواجهة أي مراقب)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 6", "slot": "action"}, {"gdpr": "purposes of the processing", "target": "الأغراض التي تجري من أجلها تلك المعالجة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 6", "slot": "scope"}, {"gdpr": "where the personal data concerning the data subject are being processed", "target": "عند معالجة بياناته الشخصية (يتناول الحق إخطار الفرد بمعالجة بياناته الشخصية)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 6", "slot": "condition"}, {"gdpr": "None", "target": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr": "None", "target": "في أي وقت", "basis": "direct_textual", "verdict": "broader", "citation": "Article 6", "slot": "temporal"}, {"gdpr": "None", "target": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "covered", "confidence": 0.79, "reasoning_note": "Article 6 explicitly grants the individual a right, exercisable vis-à-vis any controller, to be notified of the processing of their personal data and the purposes of that processing—functionally equivalent to the GDPR right to obtain such information from the controller. Article 9 was excluded because it imposes a controller duty to inform before processing, not a data subject right to obtain information.", "label": "C1", "ru_id": "RU-124", "gdpr_article": 15, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 8, "total": 8}, {"round": 2, "n_queries": 4, "new": 4, "total": 12}, {"round": 3, "n_queries": 4, "new": 0, "total": 12}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The target jurisdiction's provisions do not explicitly grant the data subject the right to obtain information on the purposes of the processing where their personal data are being processed.", "counter_evidence": [{"id": "85e94dba24cbfb8955cd", "span": "للفرد، في أي وقت، الوصول إلى بياناته الشخصية أو أي بيانات أخرى تتعلق به وطلب مراجعتها", "why": "This article grants the individual the right to access and review their personal data, but does not explicitly mention the right to obtain information on the purposes of the processing."}, {"id": "89d1bb9a58e65b732117", "span": "على المراقب، قبل البدء في معالجة أية بيانات شخصية، أن يُعلم الفرد بما يلي: 1- بيانات المراقب، أو أي طرف آخر يتولى معالجة البيانات لصالح المراقب أو لاستغلالها من قبله. 2- الأغراض المشروعة التي يرغب المراقب أو أي طرف آخر في معالجة البيانات الشخصية من أجلها.", "why": "This article requires the controller to inform the individual of the purposes of the processing before starting to process their personal data, but does not grant the data subject the right to obtain this information at any time."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict is not entirely supported by the provisions. Article 6 does not explicitly state that the data subject has the right to obtain information on the purposes of the processing, and while Article 9 implies that the controller must inform the data subject of the purposes of the processing, it does not explicitly state that the data subject has the right to obtain this information.", "counter_evidence": [{"id": "85e94dba24cbfb8955cd", "span": "للفرد، في أي وقت، الوصول إلى بياناته الشخصية أو أي بيانات أخرى تتعلق به وطلب مراجعتها، في مواجهة أي مراقب، وله بوجه خاص الحق فيما يلي: 1- إخطاره بمعالجة بياناته الشخصية أو أي بيانات أخرى تتعلق به وبالأغراض التي تجري من أجلها تلك المعالجة", "why": "Article 6 does not explicitly state that the data subject has the right to obtain information on the purposes of the processing"}, {"id": "89d1bb9a58e65b732117", "span": "على المراقب، قبل البدء في معالجة أية بيانات شخصية، أن يُعلم الفرد بما يلي: 1- بيانات المراقب، أو أي طرف آخر يتولى معالجة البيانات لصالح المراقب أو لاستغلالها من قبله. 2- الأغراض المشروعة التي يرغب المراقب أو أي طرف آخر في معالجة البيانات الشخصية من أجلها", "why": "Article 9 implies that the controller must inform the data subject of the purposes of the processing, but does not explicitly state that the data subject has the right to obtain this information"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["f5c366135483fe580381", "75db9db720e9e34a1148", "85e94dba24cbfb8955cd", "85d05fccf5b4f57eceaf", "6c76988b817262e3e312", "89d1bb9a58e65b732117", "fcbd13532c69b340214e", "dce663972f2d5e58176e", "3f5cc5a2c4af5fb90388", "f169b712b14aea8718ee", "455aae046cacf7979576", "2bcce9feda2fcb9d35fe"], "n_llm_calls": 7, "latency_s": 452.29, "temperature": 0.0, "seed": 20260801, "id": "47af4e48a8c0d9832e89", "mutation_id": "4a7ef6ae94a1819c7a71", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["2c020ba48e817e4f4c7a", "9f3112d28a1b850ba61f"], "candidates_excluded": [{"id": "e8fe267db21063b1b45f", "reason": "Scope clause; sets applicability of the regulation but does not impose or describe data-protection policy implementation."}, {"id": "b983a5ed0e1c7a2b779a", "reason": "Legal bases for processing; does not address development or implementation of internal data-protection policies."}, {"id": "a418980931b429c7909a", "reason": "Breach-notification duties; not about establishing or implementing internal data-protection policies."}], "target_frame": {"addressee": {"span": "على مقدم الخدمة وأي جهة تجمع أو تعالج أو تخزن أو تنقل البيانات الشخصية", "article": "Article 5 (chapeau)"}, "modality": {"span": "على ... اتخاذ الآتي:", "article": "Article 5 (chapeau)"}, "action": {"span": "تطوير والالتزام بسياسات داخلية للحماية وخصوصية البيانات.", "article": "Article 5(7)"}, "scope": {"span": "اتخاذ الآتي:", "article": "Article 5 (chapeau)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "controller", "target": "مقدم الخدمة وأي جهة تجمع أو تعالج أو تخزن أو تنقل البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 5 (chapeau)", "slot": "addressee"}, {"gdpr": "obligation", "target": "على ... اتخاذ الآتي:", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 5 (chapeau)", "slot": "modality"}, {"gdpr": "implement appropriate data protection policies as part of the measures referred to in Article 24(1)", "target": "تطوير والالتزام بسياسات داخلية للحماية وخصوصية البيانات.", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 5(7)", "slot": "action"}, {"gdpr": "measures established under Article 24(1)", "target": "السياسات جزء من تدابير مفروضة ضمن قائمة \"اتخاذ الآتي\" في مادة أمن وحماية البيانات الشخصية", "basis": "distributed", "verdict": "covered", "citation": "Art. 5 (title and chapeau) + Art. 5(7)", "slot": "scope"}, {"gdpr": "where proportionate in relation to processing activities", "target": "No proportionality qualifier stated for the policy requirement", "basis": "absent", "verdict": "broader", "citation": "Art. 5(7)", "slot": "condition"}, {"gdpr": "None", "target": "None stated", "basis": "absent", "verdict": "covered", "citation": "Art. 5(7)", "slot": "exception"}, {"gdpr": "None", "target": "None stated", "basis": "absent", "verdict": "covered", "citation": "Art. 5(7)", "slot": "temporal"}, {"gdpr": "None", "target": "None stated specific to this duty", "basis": "absent", "verdict": "covered", "citation": "Art. 5(7)", "slot": "consequence"}], "holistic_label": "covered", "confidence": 0.79, "reasoning_note": "Article 5(7) imposes a clear duty to develop and adhere to internal data protection and privacy policies; this squarely matches the GDPR policy-implementation requirement. The policy duty is positioned as part of a broader set of organizational measures under Article 5. The GDPR proportionality qualifier is not present for policies, making the Kuwaiti text broader on that point.", "label": "C1", "ru_id": "RU-207", "gdpr_article": 24, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 2, "total": 2}, {"round": 2, "n_queries": 4, "new": 3, "total": 5}, {"round": 3, "n_queries": 4, "new": 0, "total": 5}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 5, "candidate_ids": ["9f3112d28a1b850ba61f", "2c020ba48e817e4f4c7a", "e8fe267db21063b1b45f", "b983a5ed0e1c7a2b779a", "a418980931b429c7909a"], "n_llm_calls": 4, "latency_s": 188.16, "temperature": 0.0, "seed": 20260801, "id": "cb15759776ba1a2cec5d", "mutation_id": "d7cfed5a97b7f035177d", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["063ab5d9ef023666aed7"], "candidates_excluded": [{"id": "10e6e0e9f2f36b4c7b42", "reason": "Concerns publicly accessible records; does not regulate arrangements between joint controllers."}, {"id": "4f0c7ea198f3c5b3627c", "reason": "Governs cross-border transfer contracts; not about joint-controller arrangements."}, {"id": "7e2914aa34ab2739dafd", "reason": "Security of processing and controller–processor contracting; not about joint controllers’ internal arrangement."}, {"id": "cf27d7263418b5d502ef", "reason": "Definitions; no operative rule on joint-controller arrangements."}, {"id": "762372b7329c44286e43", "reason": "Lawful bases for processing; not about joint-controller arrangements."}, {"id": "a55a0ab8369bad4528f9", "reason": "Refers to processor/third-party contracting and cross-border transfer requirements; not joint-controller arrangements."}, {"id": "8cd7b777aa3cd8ca5f1f", "reason": "Supervisory authority powers; not about joint-controller arrangements."}, {"id": "1d8fd3d4070b1ff36d68", "reason": "Prior notification regime; not about joint-controller arrangements."}, {"id": "51a58b98a34fba9eb037", "reason": "Training obligations; not about joint-controller arrangements."}, {"id": "5a79146e04b73c99685c", "reason": "Data subject access to information about processing; not about the controllers’ internal arrangement."}, {"id": "c9145cc9a91d8ff7530c", "reason": "DPO liability; not about joint-controller arrangements."}], "target_frame": {"addressee": {"span": "في حال تمت مُعالجة أي بيانات، شخصية كانت أو غير شخصية، من قبل أكثر من مدير بيانات بصورة مشتركة، يجب على مديري البيانات التقيد بما يأتي:", "article": "Article 7"}, "modality": {"span": "يجب على مديري البيانات التقيد بما يأتي:", "article": "Article 7"}, "action": {"span": "1 - الاتفاق الكتابي فيما بينهم على دور ومسؤوليات كل منهم، لضمان الامتثال للقانون والقرارات الصادرة تنفيذاً له.", "article": "Article 7"}, "scope": {"span": "في حال تمت مُعالجة أي بيانات، شخصية كانت أو غير شخصية، من قبل أكثر من مدير بيانات بصورة مشتركة", "article": "Article 7"}, "condition": {"span": "بمراعاة الحصول على التصريح المسبق طبقاً للمادة (15) من القانون", "article": "Article 7"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "joint controllers", "target": "more than one data controller processing jointly", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 7", "slot": "addressee"}, {"gdpr": "obligation", "target": "يجب على مديري البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 7", "slot": "modality"}, {"gdpr": "ensure the arrangement duly reflects the respective roles and relationships of the joint controllers vis-à-vis the data subjects", "target": "Written agreement specifying each controller’s roles and responsibilities; designation of a single controller as the point of contact with data subjects", "basis": "distributed", "verdict": "covered", "citation": "Art. 7(1) and 7(3)", "slot": "action"}, {"gdpr": "the arrangement referred to in Article 26(1)", "target": "arrangement between controllers when processing jointly (agreement among them)", "basis": "conceptual", "verdict": "covered", "citation": "Art. 7(1)", "slot": "scope"}, {"gdpr": "None", "target": "subject to prior authorization requirement and the occurrence of joint processing", "basis": "direct_textual", "verdict": "narrower", "citation": "Art. 7 (chapeau)", "slot": "condition"}, {"gdpr": "None", "target": "No exception stated", "basis": "absent", "verdict": "covered", "citation": "—", "slot": "exception"}, {"gdpr": "None", "target": "No temporal element stated", "basis": "absent", "verdict": "covered", "citation": "—", "slot": "temporal"}, {"gdpr": "None", "target": "No consequence specified", "basis": "absent", "verdict": "covered", "citation": "—", "slot": "consequence"}], "holistic_label": "covered", "confidence": 0.7, "reasoning_note": "Article 7 requires joint controllers to conclude a written agreement specifying each controller’s roles and responsibilities and to designate a single point of contact for data subjects, which functionally reflects both roles and their relationship vis-à-vis data subjects. The reviewer’s point about protecting data subjects’ rights pertains to other parts of GDPR Art. 26; RU-217 is limited to the ‘duly reflect roles and relationships’ element. Thus, for RU-217 specifically, the Bahraini text provides equivalent coverage.", "label": "C1", "ru_id": "RU-217", "gdpr_article": 26, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 9, "total": 21}, {"round": 3, "n_queries": 4, "new": 1, "total": 22}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The BHR law does not explicitly require the arrangement to reflect the respective roles and relationships of the joint controllers vis-à-vis data subjects.", "counter_evidence": [{"id": "063ab5d9ef023666aed7", "span": "الاتفاق الكتابي فيما بينهم على دور ومسؤوليات كل منهم", "why": "This provision only requires the data controllers to agree on their roles and responsibilities, but it does not explicitly state that the arrangement must reflect their respective roles and relationships vis-à-vis data subjects."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The target jurisdiction's law does not explicitly ensure that the arrangement between joint controllers reflects their respective roles and relationships in a manner that protects data subjects' rights as required by the GDPR.", "counter_evidence": [{"id": "063ab5d9ef023666aed7", "span": "الاتفاق الكتابي فيما بينهم على دور ومسؤوليات كل منهم", "why": "This provision indicates a requirement for a written agreement among joint controllers but does not explicitly address the protection of data subjects' rights in the context of their roles and relationships."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["063ab5d9ef023666aed7", "10e6e0e9f2f36b4c7b42", "4f0c7ea198f3c5b3627c", "7e2914aa34ab2739dafd", "cf27d7263418b5d502ef", "762372b7329c44286e43", "a55a0ab8369bad4528f9", "8cd7b777aa3cd8ca5f1f", "1d8fd3d4070b1ff36d68", "51a58b98a34fba9eb037", "5a79146e04b73c99685c", "c9145cc9a91d8ff7530c"], "n_llm_calls": 7, "latency_s": 371.78, "temperature": 0.0, "seed": 20260801, "id": "8c0753b7de0951748608", "mutation_id": "d7cd8203adc03addc74a", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["a079a5ac446830a74bfc", "6201d16404c0d4b9f63d", "0cc06e3d3b107448da5a", "743bfdd72ed773ff5ba9"], "candidates_excluded": [{"id": "674524dee00496cb5de7", "reason": "Obligations of the controller, not the processor; does not set cross-border transfer prohibitions."}, {"id": "717a67a0d311f88c5fd9", "reason": "Data subject information rights; references cross-border safeguards but does not impose processor transfer prohibitions."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment; unrelated to cross-border transfer prohibitions."}, {"id": "ebfe638a86be87347658", "reason": "Data portability right; not about international transfers by processors."}, {"id": "c34922f387019af45e42", "reason": "Automated processing decisions; not about cross-border transfers."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restriction; not governing cross-border transfers."}, {"id": "4a1a7742c2a181be0640", "reason": "Right to object; not governing cross-border transfers."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "General processing principles; does not create the specific cross-border prohibition/conditions."}], "target_frame": {"addressee": {"span": "يجب على المعالج الالتزام بما يأتي:", "article": "Article 8"}, "modality": {"span": "يجوز نقل البيانات الشخصية ... إلى خارج الدولة في الأحوال الآتية المعتمدة من المكتب", "article": "Article 22"}, "action": {"span": "نقل ومشاركة البيانات الشخصية ... عبر الحدود إلى خارج الدولة", "article": "Article 22"}, "scope": {"span": "عبر الحدود لأغراض المعالجة", "article": "Article 22"}, "condition": {"span": "إجراء المعالجة وتنفيذها طبقاً للقواعد والاشتراطات والضوابط المحددة بهذا المرسوم بقانون ولائحته التنفيذية", "article": "Article 8(9)"}, "exception": {"span": "استثناءً مما ورد في المادة (22) من هذا المرسوم بقانون، يجوز نقل البيانات الشخصية إلى خارج الدولة في الحالات التالية:", "article": "Article 23"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "processor", "target_value": "يجب على المعالج الالتزام بما يأتي:", "basis": "direct_textual", "verdict": "covered", "citation": "Article 8 [0cc06e3d3b107448da5a]"}, {"slot": "modality", "gdpr_value": "prohibition", "target_value": "يجوز نقل البيانات الشخصية ... إلى خارج الدولة في الأحوال/الحالات المحددة", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Articles 22, 23 [a079a5ac446830a74bfc; 6201d16404c0d4b9f63d]"}, {"slot": "action", "gdpr_value": "transfer personal data to a third country or to an international organisation, including onward transfers", "target_value": "نقل ومشاركة البيانات الشخصية عبر الحدود إلى خارج الدولة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 22 [a079a5ac446830a74bfc]"}, {"slot": "scope", "gdpr_value": "personal data that are undergoing processing or intended for processing after transfer; includes onward transfers from the third country or international organisation to another third country or international organisation", "target_value": "عبر الحدود لأغراض المعالجة", "basis": "absent", "verdict": "narrower", "citation": "Articles 22, 23 (titles) [a079a5ac446830a74bfc; 6201d16404c0d4b9f63d]"}, {"slot": "condition", "gdpr_value": "subject to the other provisions of the GDPR", "target_value": "إجراء المعالجة وتنفيذها طبقاً للقواعد والاشتراطات والضوابط المحددة بهذا المرسوم بقانون ولائحته التنفيذية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 8(9) [0cc06e3d3b107448da5a]"}, {"slot": "exception", "gdpr_value": "when the conditions laid down in Chapter V are complied with", "target_value": "يجوز النقل عبر الحدود فقط في الأحوال/الحالات المحددة (مادتان 22 و23)", "basis": "distributed", "verdict": "covered", "citation": "Articles 22, 23 [a079a5ac446830a74bfc; 6201d16404c0d4b9f63d]"}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.63, "reasoning_note": "The UAE text regulates international transfers by allowing them only in specified cases (Arts. 22–23) and imposes a general duty on processors to comply with the Decree-Law (Art. 8), which functions as a default prohibition outside those cases, though it is not phrased as an explicit prohibition. However, the UAE provisions do not expressly address onward transfers or transfers to international organisations. This yields a weaker modality and a narrower scope than GDPR Art. 44.", "label": "C3", "ru_id": "RU-546", "gdpr_article": 44, "jurisdiction": "UAE", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 6, "total": 18}, {"round": 3, "n_queries": 4, "new": 2, "total": 20}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The UAE provisions may not fully align with GDPR's Chapter V requirements for transferring personal data, potentially leaving gaps in protection.", "counter_evidence": [{"id": "Article 22", "span": "يجوز نقل البيانات الشخصية إلى خارج الدولة في الأحوال الآتية المعتمدة من المكتب:", "why": "This provision allows for data transfer under certain conditions but may not fully capture the nuances of GDPR's Chapter V requirements."}, {"id": "Article 23", "span": "نقل ومشاركة البيانات الشخصية عبر الحدود لأغراض المعالجة في حال عدم وجود مستوى حماية ملائم", "why": "This article discusses data transfer in the absence of adequate protection but does not explicitly mirror the GDPR's conditions for such transfers."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The UAE law does not explicitly prohibit the transfer of personal data to third countries or international organizations, including onward transfers.", "counter_evidence": [{"id": "a079a5ac446830a74bfc", "span": "المادة (22) نقل ومشاركة البيانات الشخصية أو المتعلقة بالأشخاص الطبيعيين بأي صورة كانت عبر الحدود لأغراض المعالجة في حال وجود مستوى حماية ملائم", "why": "Article 22 only mentions the transfer of personal data to countries with an adequate level of protection, but does not explicitly prohibit the transfer of personal data to third countries or international organizations."}, {"id": "6201d16404c0d4b9f63d", "span": "المادة (23) نقل ومشاركة البيانات الشخصية عبر الحدود لأغراض المعالجة في حال عدم وجود مستوى حماية ملائم", "why": "Article 23 mentions exceptions to the general rule, but does not explicitly prohibit the transfer of personal data to third countries or international organizations."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["6201d16404c0d4b9f63d", "0cc06e3d3b107448da5a", "a079a5ac446830a74bfc", "674524dee00496cb5de7", "ebfe638a86be87347658", "c34922f387019af45e42", "5bedab371a9fc40ba93a", "743bfdd72ed773ff5ba9", "3cc10eb2dd7e95bdd0c2", "717a67a0d311f88c5fd9", "9630e6d967b64e07d339", "4a1a7742c2a181be0640"], "n_llm_calls": 7, "latency_s": 430.46, "temperature": 0.0, "seed": 20260801, "id": "bc7edda20a49be252459", "mutation_id": "acd47133497f90446af0", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["5a79146e04b73c99685c", "93fde8c87940ae524c86"], "candidates_excluded": [{"id": "3bf5db493f62912c0a15", "reason": "Concerns disclosures by external data protection officers; does not address a data subject’s right to obtain information on processing purposes."}, {"id": "c9145cc9a91d8ff7530c", "reason": "Addresses liability of external DPOs (legal persons); unrelated to data subject access or purposes of processing."}, {"id": "f8e27ed18c61ec00ea9c", "reason": "Procedures for registering an internal DPO; no rule on informing data subjects about processing purposes."}, {"id": "6a403e591ecc2a5638fc", "reason": "Investigation of DPO breaches; not about data subject rights to information on purposes."}, {"id": "b6efa51e73b9b96a9b0f", "reason": "DPO appointment requirement; no relationship to data subject access to purposes."}, {"id": "762372b7329c44286e43", "reason": "Lawful basis for processing; does not grant a right to obtain information on purposes upon request."}, {"id": "7e2914aa34ab2739dafd", "reason": "Security of processing; no provision on informing data subjects about processing purposes."}, {"id": "4f0c7ea198f3c5b3627c", "reason": "Cross-border transfer contracts must inform data subjects of purpose, but this is a context-specific contractual requirement, not a general right of the data subject to obtain purposes information from the controller."}, {"id": "c9f5b5ef9189452960fe", "reason": "Registration of DPOs; irrelevant to data subject access rights."}, {"id": "98fa9fe9b0650c71a971", "reason": "Direct marketing objection notice; does not concern the right to obtain purposes information."}], "target_frame": {"addressee": {"span": "صاحب البيانات", "article": "Article 18 (5a79146e04b73c99685c)"}, "modality": {"span": "على مدير البيانات، بناءً على طلب من صاحب البيانات ... إخطار مقدِّم الطلب", "article": "Article 18(1) (5a79146e04b73c99685c)"}, "action": {"span": "يَلتزم مدير البيانات بإخطار صاحب البيانات ... بما يأتي: ... ج - الغرض من معالجة البيانات.", "article": "Article 18(1)(ج) (5a79146e04b73c99685c)"}, "scope": {"span": "الغرض من معالجة البيانات", "article": "Article 18(1)(ج) (5a79146e04b73c99685c); Article 17(1)(ب) (93fde8c87940ae524c86)"}, "condition": {"span": "عما إذا كان مدير البيانات يعالِج أيّ بيانات تتعلق بصاحب الطلب، شخصية كانت أو غير شخصية، وفي حالة وجود معالَجة من أيّ نوع لهذه البيانات", "article": "Article 18(1) (5a79146e04b73c99685c)"}, "exception": {"span": "لمدير البيانات عدم قبول الطلب ... إذا لم يكن مستوفياً... وله رفْضُه إذا تضمَّن تعسُّفاً لاستعمال صاحب البيانات لحقه في المعرفة.", "article": "Article 18(3) (5a79146e04b73c99685c)"}, "temporal": {"span": "خلال ميعاد أقصاه خمسة عشر يوم عمل من تاريخ الطلب", "article": "Article 18(1) (5a79146e04b73c99685c)"}, "consequence": {"span": "يكون لصاحب البيانات تقديم شكوى إلى الهيئة ضد مدير البيانات.", "article": "Article 18(4) (5a79146e04b73c99685c)"}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data subject", "target_value": "صاحب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 18 (title) (5a79146e04b73c99685c)"}, {"slot": "modality", "gdpr_value": "right", "target_value": "على مدير البيانات ... إخطار مقدِّم الطلب (بناءً على طلب من صاحب البيانات)", "basis": "conceptual", "verdict": "covered", "citation": "Article 18(1) (5a79146e04b73c99685c)"}, {"slot": "action", "gdpr_value": "obtain from the controller information on the purposes of the processing", "target_value": "إخطار صاحب البيانات ... بالغرض من معالجة البيانات", "basis": "distributed", "verdict": "covered", "citation": "Article 18(1)(ج) (5a79146e04b73c99685c); Article 17(1)(ب) (93fde8c87940ae524c86)"}, {"slot": "scope", "gdpr_value": "purposes of the processing", "target_value": "الغرض/الأغراض من معالجة البيانات", "basis": "distributed", "verdict": "covered", "citation": "Article 18(1)(ج) (5a79146e04b73c99685c); Article 17(1)(ب) (93fde8c87940ae524c86)"}, {"slot": "condition", "gdpr_value": "where the personal data concerning the data subject are being processed", "target_value": "إذا كان مدير البيانات يعالِج أيّ بيانات تتعلق بصاحب الطلب... وفي حالة وجود معالجة", "basis": "direct_textual", "verdict": "broader", "citation": "Article 18(1) (5a79146e04b73c99685c)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "يجوز عدم قبول الطلب إذا لم يكن مستوفياً أو رفضه إذا انطوى على تعسف", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 18(3) (5a79146e04b73c99685c)"}, {"slot": "temporal", "gdpr_value": "None", "target_value": "خلال ميعاد أقصاه خمسة عشر يوم عمل من تاريخ الطلب", "basis": "direct_textual", "verdict": "broader", "citation": "Article 18(1) (5a79146e04b73c99685c)"}, {"slot": "consequence", "gdpr_value": "None", "target_value": "لصاحب البيانات تقديم شكوى إلى الهيئة عند الرفض أو عدم الرد في المدة المحددة", "basis": "direct_textual", "verdict": "broader", "citation": "Article 18(4) (5a79146e04b73c99685c)"}], "holistic_label": "covered", "confidence": 0.79, "reasoning_note": "Article 18 directly grants the data subject, upon request, the ability to obtain from the controller information including the purpose of processing, satisfying the GDPR Art. 15 element. Article 17(1)(ب) additionally requires proactive notice of purposes at or shortly after collection, which reinforces (but is not necessary to trigger) the on-request access right. The target text thus covers the requirement, with added procedural limits and timelines.", "label": "C1", "ru_id": "RU-124", "gdpr_article": 15, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 9, "total": 21}, {"round": 3, "n_queries": 4, "new": 6, "total": 27}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The BHR law may not fully align with the GDPR requirement, particularly with regards to the condition under which the data subject can exercise their right to obtain information on the purposes of the processing.", "counter_evidence": [{"id": "Article 18(1)", "span": "بناءً على طلب من صاحب البيانات", "why": "The provision does not explicitly state that the data subject has the right to obtain information on the purposes of the processing."}, {"id": "Article 18(3)", "span": "تضمَّن تعسُّفاً لاستعمال صاحب البيانات لحقه في المعرفة", "why": "The provision allows the data controller to refuse the request if it contains an abuse of the data subject's right to knowledge, which could be seen as a deviation from the GDPR requirement."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict may be incomplete or inaccurate due to the lack of consideration of Article 17, which provides additional information about the obligations of the data controller to inform the data subject about the processing of their personal data.", "counter_evidence": [{"id": "93fde8c87940ae524c86", "span": "Article 17(1)(ب)", "why": "This provision requires the data controller to inform the data subject about the purposes of the processing, which aligns with the GDPR requirement."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["3bf5db493f62912c0a15", "c9145cc9a91d8ff7530c", "f8e27ed18c61ec00ea9c", "6a403e591ecc2a5638fc", "b6efa51e73b9b96a9b0f", "762372b7329c44286e43", "5a79146e04b73c99685c", "7e2914aa34ab2739dafd", "4f0c7ea198f3c5b3627c", "c9f5b5ef9189452960fe", "93fde8c87940ae524c86", "98fa9fe9b0650c71a971"], "n_llm_calls": 7, "latency_s": 373.58, "temperature": 0.0, "seed": 20260801, "id": "54f89e04e3e9a289434b", "mutation_id": "e4be112e8977d89f0e4f", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["6b500d26673394f3d7e6", "1fdf77ac047fc519d30b", "93fde8c87940ae524c86"], "candidates_excluded": [{"id": "98fa9fe9b0650c71a971", "reason": "Direct-marketing objection right; does not regulate rectification."}, {"id": "5a79146e04b73c99685c", "reason": "Access/notice right; not a rectification right."}, {"id": "5bd7541a2690632a7c77", "reason": "Consent rules; unrelated to rectification."}, {"id": "4f0c7ea198f3c5b3627c", "reason": "Cross-border transfer contractual clauses; context-specific and not a general rectification right."}, {"id": "14fe9b230c7ba11703d5", "reason": "Penalties; not the substantive right to rectification."}, {"id": "74358e437cd9e85fdabb", "reason": "DPO duties; not rectification."}, {"id": "762372b7329c44286e43", "reason": "Lawful bases for processing; not rectification."}, {"id": "5e5fa8a4888b88a04311", "reason": "Compensation; not the rectification right."}, {"id": "7448a27e7806f2c0c143", "reason": "Data quality principle; does not itself confer a rectification right or procedure."}], "target_frame": {"addressee": {"span": "يجوز لكل صاحب بيانات أو من ينوب عنه قانوناً", "article": "Article 23(1)"}, "modality": {"span": "الحق في المطالبة بالتصحيح والحَجْب والمسح", "article": "Article 23 (title)"}, "action": {"span": "أن يتقدم إلى مدير البيانات بطلب ... لتصحيح ... البيانات الشخصية الخاصة بصاحب البيانات ... وعلى مدير البيانات، ما لم يكن لديه مسوِّغ مقبول قانوناً، الاستجابة للطلب", "article": "Article 23(1)"}, "scope": {"span": "البيانات الشخصية الخاصة بصاحب البيانات ... إذا كانت البيانات غير صحيحة أو ناقصة أو غير محدَّثة", "article": "Article 23(1)"}, "condition": {"span": "إذا كانت معالجتها تتم بالمخالفة لأحكام القانون", "article": "Article 23(1)"}, "exception": {"span": "ما لم يكن لديه مسوِّغ مقبول قانوناً؛ لا يسري حكم البند (1) من هذه المادة على أيّ سجل متاح للجمهور الاطلاع عليه، إذا تطلَّب القانون المنشئ للسجل إجراءات معينة للتصحيح أو الحَجْب أو المسح", "article": "Article 23(1)-(2)"}, "temporal": {"span": "خلال عشرة أيام عمل من تاريخ تسلُّم الطلب", "article": "Article 23(1)"}, "consequence": {"span": "وفي حالة عدم قبول صاحب البيانات بما أخطره به مدير البيانات بخصوص ما تم بشأن الطلب، أو انقضاء المدة المشار إليها دون أن يصل إلى صاحب البيانات أيّ إخطار بما تم بشأن طلبه، يكون لصاحب البيانات تقديم شكوى إلى الهيئة ضد مدير البيانات", "article": "Article 20(2), as applied by Article 23(4)"}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data subject", "target_value": "كل صاحب بيانات (the data subject)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(1) [6b500d26673394f3d7e6]"}, {"slot": "modality", "gdpr_value": "right", "target_value": "Explicit right to demand rectification; plus controller’s duty to comply unless a lawful justification exists", "basis": "distributed", "verdict": "covered", "citation": "Article 23 (title) and 23(1) [6b500d26673394f3d7e6]"}, {"slot": "action", "gdpr_value": "obtain from the controller the rectification of inaccurate personal data concerning him or her", "target_value": "Submit a request to the controller to correct personal data, and the controller must accede to the request unless a legally acceptable justification exists", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(1) [6b500d26673394f3d7e6]"}, {"slot": "scope", "gdpr_value": "inaccurate personal data concerning the data subject", "target_value": "Personal data of the data subject that are incorrect, incomplete, or not updated", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(1) [6b500d26673394f3d7e6]"}, {"slot": "condition", "gdpr_value": "None", "target_value": "Processing must be contrary to the law (including where data are incorrect, incomplete, or not updated)", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 23(1) [6b500d26673394f3d7e6]"}, {"slot": "exception", "gdpr_value": "None", "target_value": "Controller may refuse if it has a legally acceptable justification; requests concerning public registers follow the register’s statutory procedure", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 23(1)-(2) [6b500d26673394f3d7e6]"}, {"slot": "temporal", "gdpr_value": "without undue delay", "target_value": "within 10 working days of receiving the request", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(1) [6b500d26673394f3d7e6]"}, {"slot": "consequence", "gdpr_value": "None", "target_value": "If the response is unsatisfactory or late, the data subject may complain to the Authority", "basis": "distributed", "verdict": "broader", "citation": "Article 20(2) as applied by Article 23(4) [1fdf77ac047fc519d30b; 6b500d26673394f3d7e6]"}], "holistic_label": "narrower", "confidence": 0.78, "reasoning_note": "Article 23(1) goes beyond a mere right to request by obliging the controller to accede to the rectification request (“الاستجابة للطلب”) unless it has a legally acceptable justification, and it sets a 10‑working‑day deadline. However, the right is conditioned and contains exceptions (e.g., public registers and lawful justification) not present in GDPR Art. 16, so overall it is narrower. The timeline requirement is specific and satisfies the ‘without undue delay’ element.", "label": "C1", "ru_id": "RU-140", "gdpr_article": 16, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 10, "total": 22}, {"round": 3, "n_queries": 4, "new": 2, "total": 24}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The BHR jurisdiction's Article 23(1) includes a condition that the request must be accompanied by proof of identity, and the response time is limited to 10 days, which may not be considered 'without undue delay' as required by the GDPR.", "counter_evidence": [{"id": "6b500d26673394f3d7e6", "span": "مُشفوع بما يثبت هوية صاحب البيانات", "why": "The condition of proof of identity is not present in the GDPR requirement."}, {"id": "6b500d26673394f3d7e6", "span": "خلال عشرة أيام عمل من تاريخ تسلُّم الطلب", "why": "The response time is limited to 10 days, which may not be considered 'without undue delay' as required by the GDPR."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The provision does not guarantee the right to obtain rectification, but rather the right to request it.", "counter_evidence": [{"id": "6b500d26673394f3d7e6", "span": "يجوز لكل صاحب بيانات أو من ينوب عنه قانوناً أن يتقدم إلى مدير البيانات بطلب، مشفوع بما يثبت هويته، لتصحيح أو حَجْب أو مسح البيانات الشخصية الخاصة بصاحب البيانات", "why": "The provision grants the right to request rectification, but does not guarantee that the request will be granted."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["6b500d26673394f3d7e6", "98fa9fe9b0650c71a971", "5a79146e04b73c99685c", "93fde8c87940ae524c86", "5bd7541a2690632a7c77", "4f0c7ea198f3c5b3627c", "14fe9b230c7ba11703d5", "74358e437cd9e85fdabb", "1fdf77ac047fc519d30b", "762372b7329c44286e43", "5e5fa8a4888b88a04311", "7448a27e7806f2c0c143"], "n_llm_calls": 7, "latency_s": 403.81, "temperature": 0.0, "seed": 20260801, "id": "453d496d66af1a512b70", "mutation_id": "402f41c3879b8cd4f51d", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["743bfdd72ed773ff5ba9"], "candidates_excluded": [{"id": "e05de90f481c9410c6e0", "reason": "Breach-notification duties; not about territorial/extraterritorial scope."}, {"id": "877fafe0080725188d05", "reason": "Data subject rectification/erasure rights; not about territorial/extraterritorial scope."}, {"id": "c34922f387019af45e42", "reason": "Automated processing/profiling rights; not about territorial/extraterritorial scope."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment triggers; not about territorial/extraterritorial scope."}, {"id": "0cc06e3d3b107448da5a", "reason": "Processor obligations; not about territorial/extraterritorial scope."}, {"id": "9c38ab11b550755816f5", "reason": "DPO support duties; not about territorial/extraterritorial scope."}, {"id": "6201d16404c0d4b9f63d", "reason": "Cross-border transfer mechanisms (no adequate level); not about who must comply with the law."}, {"id": "a079a5ac446830a74bfc", "reason": "Cross-border transfer mechanisms (adequate level); not about who must comply with the law."}, {"id": "ebfe638a86be87347658", "reason": "Data portability right; not about territorial/extraterritorial scope."}, {"id": "5d949837d7aab073cd67", "reason": "Complaint mechanism; not about territorial/extraterritorial scope."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restriction; not about territorial/extraterritorial scope."}], "target_frame": {"addressee": {"span": "كل متحكم أو معالج متواجد خارج الدولة", "article": "Article 2(1)(ج)"}, "modality": {"span": "تسري أحكام هذا المرسوم بقانون", "article": "Article 2(1)"}, "action": {"span": "تسري أحكام هذا المرسوم بقانون على معالجة البيانات الشخصية", "article": "Article 2(1)"}, "scope": {"span": "كل متحكم أو معالج متواجد خارج الدولة يقوم بمزاولة أنشطة معالجة البيانات الشخصية لأصحاب البيانات في الدولة", "article": "Article 2(1)(ج)"}, "condition": {"span": "يقوم بمزاولة أنشطة معالجة البيانات الشخصية لأصحاب البيانات في الدولة", "article": "Article 2(1)(ج)"}, "exception": {"span": "لا تسري أحكام هذا المرسوم بقانون على ما يأتي: أ. البيانات الحكومية. ب. الجهات الحكومية المتحكمة بالبيانات الشخصية أو تلك التي تقوم بمعالجتها. ج. البيانات الشخصية لدى الجهات الأمنية والقضائية. د. صاحب البيانات الذي يقوم بمعالجة بياناته لأغراض شخصية بحتة وغير تجارية وفي نطاق أسري خاص. هـ. البيانات الشخصية الصحية التي لديها تشريع ينظم حماية ومعالجة تلك البيانات. و. البيانات والمعلومات الشخصية المصرفية والائتمانية التي لديها تشريع ينظم حماية ومعالجة تلك البيانات. ز. الشركات والمؤسسات الواقعة في المناطق الحرة في الدولة ولديها تشريعات خاصة بحماية البيانات الشخصية.", "article": "Article 2(2)"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "controller or processor not established in the Union", "target": "كل متحكم أو معالج متواجد خارج الدولة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 2(1)(ج)", "slot": "addressee"}, {"gdpr": "obligation", "target": "تسري أحكام هذا المرسوم بقانون", "basis": "direct_textual", "verdict": "covered", "citation": "Article 2(1)", "slot": "modality"}, {"gdpr": "comply with this Regulation for the processing of personal data", "target": "تسري أحكام هذا المرسوم بقانون على معالجة البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 2(1)", "slot": "action"}, {"gdpr": "processing of personal data of data subjects who are in the Union", "target": "… معالجة البيانات الشخصية … لأصحاب البيانات في الدولة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 2(1)(ج)", "slot": "scope"}, {"gdpr": "processing relates to offering goods or services to such data subjects in the Union, whether or not payment is required", "target": "يقوم بمزاولة أنشطة معالجة البيانات الشخصية لأصحاب البيانات في الدولة (دون قيد خاص بعرض السلع أو الخدمات)", "basis": "direct_textual", "verdict": "broader", "citation": "Article 2(1)(ج)", "slot": "condition"}, {"gdpr": "None", "target": "استثناءات شاملة: البيانات/الجهات الحكومية، الجهات الأمنية والقضائية، المعالجة الشخصية البحتة، والبيانات الصحية/المصرفية/الائتمانية ذات تشريع خاص، والمنشآت في المناطق الحرة ذات تشريعات خاصة", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 2(2)", "slot": "exception"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.77, "reasoning_note": "Article 2(1)(ج) triggers applicability for any processing of UAE data subjects by controllers/processors outside the UAE; this is broader than the GDPR’s condition limited to offering goods or services, so it is not narrower as suggested. However, Article 2(2) introduces exceptions absent from RU-009, yielding only partial overall equivalence. This directly addresses the objection: the missing ‘goods/services’ language expands, rather than narrows, the trigger.", "label": "C1", "ru_id": "RU-009", "gdpr_article": 3, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 6, "total": 18}, {"round": 3, "n_queries": 4, "new": 2, "total": 20}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The UAE law does not explicitly mention the condition of 'offering goods or services' as a requirement for the controller or processor to comply with the law.", "counter_evidence": [{"id": "743bfdd72ed773ff5ba9", "span": "ج. كل متحكم أو معالج متواجد خارج الدولة يقوم بمزاولة أنشطة معالجة البيانات الشخصية لأصحاب البيانات في الدولة.", "why": "This provision does not explicitly mention the condition of 'offering goods or services' as a requirement for the controller or processor to comply with the law."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The target jurisdiction's provision in Article 2(1)(ج) does not explicitly mention the condition of offering goods or services, which could indicate that the target jurisdiction's provision is actually narrower than the GDPR requirement.", "counter_evidence": [{"id": "743bfdd72ed773ff5ba9", "span": "ج. كل متحكم أو معالج متواجد خارج الدولة يقوم بمزاولة أنشطة معالجة البيانات الشخصية لأصحاب البيانات في الدولة", "why": "The provision does not explicitly mention the condition of offering goods or services."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["743bfdd72ed773ff5ba9", "e05de90f481c9410c6e0", "877fafe0080725188d05", "c34922f387019af45e42", "9630e6d967b64e07d339", "0cc06e3d3b107448da5a", "9c38ab11b550755816f5", "6201d16404c0d4b9f63d", "a079a5ac446830a74bfc", "ebfe638a86be87347658", "5d949837d7aab073cd67", "5bedab371a9fc40ba93a"], "n_llm_calls": 7, "latency_s": 329.3, "temperature": 0.0, "seed": 20260801, "id": "699a65d16928d5d274b6", "mutation_id": "64acbe1fee2b4c85b4ce", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["9cfd6fbae8182dbc0028", "8394f801a0a97e521f68"], "candidates_excluded": [{"id": "c95a0b593cc554df0eae", "reason": "Record-keeping obligations; does not address providing DPO contact details to data subjects."}, {"id": "f8c6dae3f69fbe207307", "reason": "Conditions for disclosure; unrelated to notice of DPO contact details."}, {"id": "a79606d0fb564d3b2b5d", "reason": "Breach notification; not about informing data subjects of DPO contact details at collection."}, {"id": "ea8306cd18f9261f6413", "reason": "General information items at collection but does not mention DPO contact details."}, {"id": "0922609ffbfd96a70f90", "reason": "Erasure rights; no relevance to providing DPO contact information."}, {"id": "c511c9bf7779067e64f4", "reason": "Collection and processing conditions; no notice duty regarding DPO contact."}, {"id": "14105f25ea49e7794aaa", "reason": "Data protection impact assessment content; not about notice of DPO contact."}, {"id": "593beb6b1fe15a8fda31", "reason": "Processor selection and obligations; not about informing data subjects."}, {"id": "08b4c74d887bbe3b2039", "reason": "Credit data specific rules; not the general duty to provide DPO contact details at collection."}, {"id": "557230873031d6e5cb2c", "reason": "Marketing processing basis; no duty to provide DPO contact details."}], "target_frame": {"addressee": {"span": "يجب على جهة التحكم أو المعالج", "article": "Article 4(1)"}, "modality": {"span": "يجب على", "article": "Article 4(1)"}, "action": {"span": "اتخاذ التدابير اللازمة لإبلاغ صاحب البيانات الشخصية ... ب- بيانات الاتصال بمسؤول حماية البيانات الشخصية -إن وجد- المعين من قبل جهة التحكم أو المعالج.", "article": "Article 4(1)(ب)"}, "scope": {"span": null, "article": null}, "condition": {"span": "في حال تم جمع البيانات الشخصية من صاحبها مباشرة", "article": "Article 4(1)"}, "exception": {"span": "لا يطبق ما ورد في الفقرة (1) من هذه المادة في حال كانت المعلومات الموضحة في الفقرات الفرعية (أ) إلى (ز) متوفرة مسبقاً لصاحب البيانات الشخصية، أو إذا كان تقديم تلك المعلومات يتعارض مع أي من الأنظمة السارية في المملكة.", "article": "Article 4(2)"}, "temporal": {"span": "قبل أو عند جمع البيانات", "article": "Article 4(1)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "جهة التحكم أو المعالج", "basis": "direct_textual", "verdict": "broader", "citation": "Article 4(1)", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "يجب على", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1)", "slot": "modality"}, {"gdpr_value": "provide the data subject with the contact details of the data protection officer", "target_value": "إبلاغ صاحب البيانات الشخصية ببيانات الاتصال بمسؤول حماية البيانات الشخصية -إن وجد-", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1)(ب)", "slot": "action"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "scope"}, {"gdpr_value": "where personal data are collected from the data subject and provision is applicable (i.e., a DPO exists)", "target_value": "في حال تم جمع البيانات الشخصية من صاحبها مباشرة؛ وتقديم بيانات الاتصال بمسؤول حماية البيانات الشخصية -إن وجد-", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1)", "slot": "condition"}, {"gdpr_value": "unless and insofar as the data subject already has the information", "target_value": "لا يطبق إذا كانت المعلومات متوفرة مسبقاً لصاحب البيانات الشخصية، أو إذا كان تقديم تلك المعلومات يتعارض مع أي من الأنظمة السارية في المملكة", "basis": "direct_textual", "verdict": "broader", "citation": "Article 4(2)", "slot": "exception"}, {"gdpr_value": "at the time when personal data are obtained", "target_value": "قبل أو عند جمع البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1)", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.83, "reasoning_note": "Article 4(1) expressly requires informing the data subject of DPO contact details, if any, before or at the time of collection from the data subject, which covers the GDPR timing. Article 4(2) creates a broader exception than GDPR by adding a conflict-with-laws carve-out in addition to the ‘already has the information’ exception. The inclusion of processors as addressees is broader, but does not reduce coverage of the GDPR obligation on controllers.", "label": "C4", "ru_id": "RU-058", "gdpr_article": 13, "jurisdiction": "KSA", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 9, "total": 21}, {"round": 3, "n_queries": 4, "new": 2, "total": 23}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The KSA jurisdiction has a similar provision, but with some differences in the conditions and exceptions.", "counter_evidence": [{"id": "9cfd6fbae8182dbc0028", "span": "Article 4(1)(b)", "why": "The provision requires the controller to inform the data subject of the DPO's contact details, if any."}, {"id": "8394f801a0a97e521f68", "span": "Article 32(1)", "why": "The provision implies that the controller may not always have a DPO."}, {"id": "9cfd6fbae8182dbc0028", "span": "Article 4(2)", "why": "The provision states that the information provided to the data subject may not be required if it is already available to the data subject or if providing it conflicts with applicable laws."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The KSA provisions do not fully align with the GDPR requirement, and the exception in Article 4(2) is broader than the GDPR exception.", "counter_evidence": [{"id": "9cfd6fbae8182dbc0028", "span": "Article 4(2)", "why": "The exception in Article 4(2) is broader than the GDPR exception."}, {"id": "9cfd6fbae8182dbc0028", "span": "Article 4(1)", "why": "The provision does not explicitly state that the information must be provided at the time of data collection."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["c95a0b593cc554df0eae", "8394f801a0a97e521f68", "9cfd6fbae8182dbc0028", "f8c6dae3f69fbe207307", "a79606d0fb564d3b2b5d", "ea8306cd18f9261f6413", "0922609ffbfd96a70f90", "c511c9bf7779067e64f4", "14105f25ea49e7794aaa", "593beb6b1fe15a8fda31", "08b4c74d887bbe3b2039", "557230873031d6e5cb2c"], "n_llm_calls": 7, "latency_s": 362.67, "temperature": 0.0, "seed": 20260801, "id": "81a1e1e48d43f97ad8f8", "mutation_id": "2ac514f22abddcb911d9", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["c34922f387019af45e42", "80f95c322bb3204c7f65", "ebfe638a86be87347658"], "candidates_excluded": [{"id": "4a1a7742c2a181be0640", "reason": "Addresses objection/stop to processing for direct marketing and surveys; not about automated decision-making with legal/similar effects."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restriction of processing; does not regulate automated decision-making or set exceptions thereto."}, {"id": "717a67a0d311f88c5fd9", "reason": "Right to information (including about automated decisions) but does not create a right not to be subject or specify exceptions."}, {"id": "877fafe0080725188d05", "reason": "Rectification/erasure rights; not about automated decision-making exceptions."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Scope of the law; no operative content on automated decision-making rights or exceptions."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "General processing principles (lawfulness, fairness, transparency) that do not articulate exceptions to an automated-decision right."}, {"id": "9c38ab11b550755816f5", "reason": "DPO-related duties; no substantive rule on automated decision-making rights or exceptions."}, {"id": "6201d16404c0d4b9f63d", "reason": "Cross-border transfer grounds; unrelated to automated decision-making exceptions."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment triggers reference profiling/automated processing but provides no right or exceptions regarding automated decisions."}], "target_frame": {"addressee": {"span": "يحق لصاحب البيانات", "article": "Article 18(1)"}, "modality": {"span": "يحق", "article": "Article 18(1)"}, "action": {"span": "الاعتراض على القرارات التي تصدر عن المعالجة المؤتمتة وتكون لها تبعات قانونية أو تؤثر بشكل جسيم على صاحب البيانات، بما فيها التنميط.", "article": "Article 18(1)"}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": "يجب على المتحكم تطبيق إجراءات وتدابير مناسبة لحماية خصوصية وسرية البيانات الشخصية لصاحب البيانات في الحالات المشار إليها في البند (2) من هذه المادة، وعدم الإضرار والمساس بحقوقه.", "article": "Article 18(3)"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "صاحب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 18(1)", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "يحق (right) to object", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 18(1)", "slot": "modality"}, {"gdpr_value": "not be subject to a decision based solely on automated processing (including profiling) with legal or similarly significant effects", "target_value": "right to object to decisions issued by automated processing that have legal or serious effects (including profiling); human review on request", "basis": "distributed", "verdict": "weaker_modality", "citation": "Art. 18(1), 18(4)", "slot": "action"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "scope"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "condition"}, {"gdpr_value": "Except if necessary for a contract; authorised by law with suitable safeguards; or based on explicit consent", "target_value": "Implied ‘cases’ allowing automated decisions subject to safeguards; general consent regime; recognition of contract necessity as a basis in the law", "basis": "distributed", "verdict": "partial", "citation": "Art. 18(3); Art. 6(1); Art. 14(1)", "slot": "exception"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.64, "reasoning_note": "Article 18 grants a right to object to automated decisions with legal/serious effects and to obtain human review on request, which is weaker than GDPR’s default prohibition. Exceptions are only partially traceable: Art. 18(3) references cases with safeguards, and the law elsewhere recognizes consent and contract necessity, but the text provided does not explicitly tie those grounds to exceptions from an ADM prohibition nor require ‘explicit’ consent for ADM.", "label": "C2", "ru_id": "RU-187", "gdpr_article": 22, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 10, "total": 22}, {"round": 3, "n_queries": 4, "new": 2, "total": 24}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The exceptions might be covered under the broader legal framework of the UAE law, even if not explicitly stated in the context of automated decision-making.", "counter_evidence": [{"id": "c34922f387019af45e42", "span": "Article 18(1)", "why": "Provides a right to object to automated decisions with legal consequences, aligning with GDPR principles."}, {"id": "5bedab371a9fc40ba93a", "span": "Article 5", "why": "Outlines principles for personal data processing, including fairness, lawfulness, and transparency, which could encompass exceptions similar to those in the GDPR."}, {"id": "80f95c322bb3204c7f65", "span": "Article 6", "why": "Discusses conditions for consent, which could be related to exceptions for automated decision-making."}, {"id": "6201d16404c0d4b9f63d", "span": "Article 23", "why": "Addresses data transfer across borders, including for contractual obligations or with explicit consent, similar to GDPR exceptions."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict of 'uncovered' for the slot 'exception' is not entirely accurate, as the provisions do provide some basis for exceptions.", "counter_evidence": [{"id": "c34922f387019af45e42", "span": "المادة (18) حق المعالجة والمعالجة المؤتمتة", "why": "Article 18(1) provides a right to object to decisions based on automated processing, and implies that the processing should be based on law."}, {"id": "5bedab371a9fc40ba93a", "span": "المادة (5) ضوابط معالجة البيانات الشخصية", "why": "Article 5 implies that the processing should be based on law, which could include contracts or Union/Member State law."}, {"id": "80f95c322bb3204c7f65", "span": "المادة (6) شروط الموافقة على معالجة البيانات", "why": "Article 6 implies that explicit consent is a valid basis for processing."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["c34922f387019af45e42", "4a1a7742c2a181be0640", "5bedab371a9fc40ba93a", "717a67a0d311f88c5fd9", "877fafe0080725188d05", "ebfe638a86be87347658", "743bfdd72ed773ff5ba9", "80f95c322bb3204c7f65", "3cc10eb2dd7e95bdd0c2", "9c38ab11b550755816f5", "6201d16404c0d4b9f63d", "9630e6d967b64e07d339"], "n_llm_calls": 7, "latency_s": 390.23, "temperature": 0.0, "seed": 20260801, "id": "72f0327fc0742e96ec62", "mutation_id": "fab37a3775ec8210a44e", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["b157dcadab6a3e8daf5f", "93f989531fe30cac1ed5", "823830174d241884bd73", "3f916831456908af27d8", "db6e2be94f2388e169a8", "bb26cffae1f1c0beb85d"], "candidates_excluded": [{"id": "2712fe4ebdba355a134b", "reason": "Consent prerequisites and proof; does not establish a right to restriction or blocking."}, {"id": "a2a61b7c9316716b7e74", "reason": "Limits on disclosure/publication; not about restriction of processing at the request of the data subject."}, {"id": "40626451a5025d77cff5", "reason": "Pre-processing information duties; does not create a right to restriction."}, {"id": "d0bb19cb0c67952144b4", "reason": "Data portability; unrelated to restriction of processing."}, {"id": "a0040ee4dad7d4440e19", "reason": "Controller permit/registration details; not a data-subject right to restrict processing."}, {"id": "3a6219e8839cbad1f76e", "reason": "Breach notification; not a right to restriction."}], "target_frame": {"addressee": {"span": "يكون لصاحب البيانات الشخصية الحق في الآتي", "article": "Article 11"}, "modality": {"span": "الحق في", "article": "Article 11"}, "action": {"span": "ب- طلب تعديل بياناته الشخصية أو تحديثها أو حجبها.", "article": "Article 11"}, "scope": {"span": "بياناته الشخصية", "article": "Article 11"}, "condition": {"span": "3- إذا كانت معالجة البيانات لا تتوافق مع أحكام القانون أو هذه اللائحة.", "article": "Article 18"}, "exception": {"span": "يجوز للمتحكم رفض طلب صاحب البيانات الشخصية جزئياً أو كلياً إذا كان الطلب متكرراً بشكل غير مبرر، أو أن تنفيذه يتطلب جهداً غير عادي.", "article": "Article 17"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data subject", "target_value": "صاحب البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 11"}, {"slot": "modality", "gdpr_value": "right", "target_value": "الحق في", "basis": "direct_textual", "verdict": "covered", "citation": "Article 11"}, {"slot": "action", "gdpr_value": "obtain from the controller the restriction of processing", "target_value": "طلب ... حجبها؛ كما يتيح الإطار العملي تقديم شكوى لتفعيل وقف المعالجة (وقف معالجة البيانات الشخصية بشكل مؤقت، أو دائم).", "basis": "distributed", "verdict": "weaker_modality", "citation": "Article 11; Article 21; Article 12; Article 8"}, {"slot": "scope", "gdpr_value": "processing of the data subject's personal data", "target_value": "بياناته الشخصية / وقف معالجة البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 11; Article 8"}, {"slot": "condition", "gdpr_value": "the processing is unlawful and the data subject opposes erasure of the personal data and requests restriction of their use instead", "target_value": "لا يُشترط للحق في الحجب سبب مخصوص؛ ويوجد حق مستقل في محو البيانات عند عدم مشروعية المعالجة: \"إذا كانت معالجة البيانات لا تتوافق مع أحكام القانون أو هذه اللائحة.\"", "basis": "distributed", "verdict": "broader", "citation": "Article 11; Article 18"}, {"slot": "exception", "gdpr_value": "None", "target_value": "يجوز للمتحكم رفض طلب صاحب البيانات الشخصية إذا كان متكرراً دون مبرر أو يتطلب جهداً غير عادي.", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 17"}, {"slot": "temporal", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.64, "reasoning_note": "A counterpart exists in distributed form: a right to request blocking (Article 11), a right to erasure when processing is unlawful (Article 18), the ability to complain (Article 12), and the authority to order suspension of processing (Article 8). However, the text grants only a right to request (not to obtain) restriction, does not articulate the specific GDPR condition (unlawful + oppose erasure), and allows refusals in some cases (Article 17), so coverage is partial with weaker modality.", "label": "C1", "ru_id": "RU-167", "gdpr_article": 18, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 11, "total": 23}, {"round": 3, "n_queries": 4, "new": 5, "total": 28}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict of C2 may be incorrect, as there are provisions in the OMN jurisdiction that could be interpreted as counterparts to the GDPR requirement.", "counter_evidence": [{"id": "8", "span": "ج- وقف معالجة البيانات الشخصية بشكل مؤقت، أو دائم.", "why": "This provision could be interpreted as a counterpart to the GDPR requirement, as it provides a mechanism for restricting the processing of personal data in certain circumstances."}, {"id": "18", "span": "لصاحب البيانات الشخصية الحق في طلب محو بياناته الشخصية لدى المتحكم في أي من الحالات الآتية: 1- إذا انتهى الغرض من المعالجة. 2- إذا ألغى موافقته على معالجة بياناته، وذلك دون الإخلال بحكم المادة (17) من هذه اللائحة. 3- إذا كانت معالجة البيانات لا تتوافق مع أحكام القانون أو هذه اللائحة.", "why": "This provision mentions the right of the data subject to request the restriction of processing of their personal data, but it does not explicitly state the condition that the processing must be unlawful and the data subject must oppose erasure."}], "confidence": 0.8}, {"verdict": "revise", "objection": "Counterpart exists under different terminology and distributed across several provisions", "counter_evidence": [{"id": "93f989531fe30cac1ed5", "span": "لصاحب البيانات الشخصية الحق في طلب محو بياناته الشخصية لدى المتحكم في أي من الحالات الآتية: 1- إذا انتهى الغرض من المعالجة. 2- إذا ألغى موافقته على معالجة بياناته، وذلك دون الإخلال بحكم المادة (17) من هذه اللائحة. 3- إذا كانت معالجة البيانات لا تتوافق مع أحكام القانون أو هذه اللائحة.", "why": "Provides a right to request erasure of personal data if processing is unlawful"}, {"id": "b157dcadab6a3e8daf5f", "span": "يكون لصاحب البيانات الشخصية الحق في الآتي: أ- إلغاء موافقته على معالجة بياناته الشخصية. ب- طلب تعديل بياناته الشخصية أو تحديثها أو حجبها.", "why": "Provides a right to request blocking of personal data"}, {"id": "3f916831456908af27d8", "span": "تتخذ الوزارة في سبيل حماية حقوق أصحاب البيانات الشخصية أياً من الإجراءات الآتية: أ- إنذار المتحكم أو المعالج، بالمخالفة التي تقع منه لأحكام هذا القانون. ب- الأمر بتصحيح ومحو البيانات الشخصية التي تمت معالجتها بالمخالفة لأحكام هذا القانون. ج- وقف معالجة البيانات الشخصية بشكل مؤقت، أو دائم.", "why": "Gives the Ministry the power to order suspension of processing if it is found to be in violation of the law"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["93f989531fe30cac1ed5", "b157dcadab6a3e8daf5f", "2712fe4ebdba355a134b", "bb26cffae1f1c0beb85d", "3f916831456908af27d8", "a2a61b7c9316716b7e74", "db6e2be94f2388e169a8", "40626451a5025d77cff5", "823830174d241884bd73", "d0bb19cb0c67952144b4", "a0040ee4dad7d4440e19", "3a6219e8839cbad1f76e"], "n_llm_calls": 7, "latency_s": 388.51, "temperature": 0.0, "seed": 20260801, "id": "5cce3f5971670d0f6440", "mutation_id": "9b2c4c0c2bd154a1c308", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["717a67a0d311f88c5fd9"], "candidates_excluded": [{"id": "ebfe638a86be87347658", "reason": "Data portability right; not about obtaining information on purposes of processing."}, {"id": "9d65c2815c41a25064db", "reason": "Security of processing obligations; not about a data subject right to information."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Scope of the law; does not create a right to obtain information on purposes."}, {"id": "c34922f387019af45e42", "reason": "Automated decision-making and profiling rights; not about obtaining information on purposes."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment; not a data subject right to obtain information."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "Principles of processing (including purpose limitation) but not a right to obtain information on purposes."}, {"id": "dec351a1e477287e3b22", "reason": "Controller contact mechanisms; ancillary and not the substantive right to obtain information on purposes."}, {"id": "877fafe0080725188d05", "reason": "Rectification/erasure rights; not about obtaining information on purposes."}, {"id": "0cc06e3d3b107448da5a", "reason": "Processor obligations; not about a data subject right to information."}, {"id": "5bedab371a9fc40ba93a", "reason": "Restriction of processing right; not about obtaining information on purposes."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification; not about a data subject right to obtain information on purposes."}], "target_frame": {"addressee": {"span": "صاحب البيانات أو ممثله القانوني المفوض أصولاً", "article": "Article 13(1)"}, "modality": {"span": "يحق لصاحب البيانات ... الحصول على المعلومات", "article": "Article 13(1)"}, "action": {"span": "بناءً على طلب يقدمه إلى المتحكم ... الحصول على المعلومات الآتية", "article": "Article 13(1)"}, "scope": {"span": "أغراض المعالجة.", "article": "Article 13(1)(ب)"}, "condition": {"span": "بناءً على طلب يقدمه إلى المتحكم", "article": "Article 13(1)"}, "exception": {"span": "يجوز للمتحكم رفض طلب صاحب البيانات ... في حال تبين له ما يأتي:", "article": "Article 13(3)"}, "temporal": {"span": "وقبل البدء بالمعالجة، تزويد صاحب البيانات ... بالمعلومات المنصوص عليها في الفقرات (ب) و(د) و(ز)", "article": "Article 13(2)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data subject", "target_value": "صاحب البيانات (data subject) أو ممثله القانوني", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13(1)"}, {"slot": "modality", "gdpr_value": "right", "target_value": "يحق (a right) to obtain information", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13(1)"}, {"slot": "action", "gdpr_value": "obtain from the controller information on the purposes of the processing", "target_value": "الحصول على المعلومات من المتحكم، ومنها أغراض المعالجة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13(1) chapeau and (b)"}, {"slot": "scope", "gdpr_value": "purposes of the processing", "target_value": "أغراض المعالجة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13(1)(b)"}, {"slot": "condition", "gdpr_value": "where the personal data concerning the data subject are being processed", "target_value": "right exercisable بناءً على طلب إلى المتحكم; certain information (including purposes) also provided قبل البدء بالمعالجة", "basis": "distributed", "verdict": "partial", "citation": "Article 13(1) and 13(2)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "يجوز للمتحكم رفض الطلب إذا كان غير ذي صلة أو متكرر بصورة مبالغ بها، أو يتعارض مع الإجراءات القضائية أو التحقيقات، أو يؤثر سلباً على أمن المعلومات، أو يمس خصوصية الغير", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 13(3)"}, {"slot": "temporal", "gdpr_value": "None", "target_value": "إلزام بتزويد بعض المعلومات (بما فيها أغراض المعالجة) قبل البدء بالمعالجة", "basis": "direct_textual", "verdict": "broader", "citation": "Article 13(2)"}, {"slot": "consequence", "gdpr_value": "None", "target_value": "No specific consequence stated in the cited provision", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.83, "reasoning_note": "Article 13(1)(b) directly grants a right to obtain information on purposes from the controller, satisfying the core of RU-124. However, Article 13(3) introduces refusal grounds that can limit this right, and the triggering conditions differ (request-based and also pre-processing disclosure). The assessment avoids claiming broader overall scope and explicitly treats the Article 13(3) exceptions as narrowing the right.", "label": "C2", "ru_id": "RU-124", "gdpr_article": 15, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 10, "total": 10}, {"round": 2, "n_queries": 4, "new": 7, "total": 17}, {"round": 3, "n_queries": 4, "new": 1, "total": 18}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The UAE jurisdiction requires that the processing be planned or imminent for the data subject to exercise the right to obtain information on the purposes of the processing.", "counter_evidence": [{"id": "Article 13(2)", "span": "في جميع الأحوال، يجب على المتحكم، وقبل البدء بالمعالجة، تزويد صاحب البيانات أو ممثله القانوني المفوض أصولاً بالمعلومات المنصوص عليها في الفقرات (ب) و(د) و(ز) من البند (1) من هذه المادة.", "why": "This provision suggests that the controller must provide the data subject with certain information, including the purposes of the processing, before starting the processing."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's claim about the broader scope of the target jurisdiction is unsupported, and the exceptions in Article 13(3) could limit the data subject's right to obtain information.", "counter_evidence": [{"id": "Article 13(1)", "span": "يحق لصاحب البيانات أو ممثله القانوني المفوض أصولاً وبناءً على طلب يقدمه إلى المتحكم ومن دون أي مقابل الحصول على المعلومات الآتية:", "why": "This provision only grants the data subject the right to obtain information about the purposes of processing, and not necessarily about other aspects."}, {"id": "Article 13(3)", "span": "يجوز للمتحكم رفض طلب صاحب البيانات أو ممثله القانوني المفوض أصولاً في الحصول على المعلومات الواردة في البند (1) من هذه المادة، في حال تبين له ما يأتي:", "why": "This provision provides exceptions that allow the controller to refuse the request, which could limit the data subject's right to obtain information."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["ebfe638a86be87347658", "717a67a0d311f88c5fd9", "9d65c2815c41a25064db", "743bfdd72ed773ff5ba9", "c34922f387019af45e42", "9630e6d967b64e07d339", "3cc10eb2dd7e95bdd0c2", "dec351a1e477287e3b22", "877fafe0080725188d05", "0cc06e3d3b107448da5a", "5bedab371a9fc40ba93a", "e05de90f481c9410c6e0"], "n_llm_calls": 7, "latency_s": 360.85, "temperature": 0.0, "seed": 20260801, "id": "f36783738370036d432b", "mutation_id": "cfd45f5e4a3f70cdec95", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["877fafe0080725188d05"], "candidates_excluded": [{"id": "c34922f387019af45e42", "reason": "Addresses automated decision-making objection/review, not rectification or completion of incomplete data."}, {"id": "717a67a0d311f88c5fd9", "reason": "Provides an access-to-information right about procedures for correction/erasure, but does not itself grant the right to complete incomplete data."}, {"id": "5bedab371a9fc40ba93a", "reason": "Covers restriction of processing, not the right to complete incomplete data."}, {"id": "ebfe638a86be87347658", "reason": "Covers data portability, unrelated to completion of incomplete data."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "Sets general processing principles (accuracy, purpose limitation) but does not establish a data subject right to completion or the specific condition tied to that right."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification, unrelated to completion of incomplete data."}, {"id": "80f95c322bb3204c7f65", "reason": "Consent conditions, unrelated to rectification/completion rights."}, {"id": "4a1a7742c2a181be0640", "reason": "Right to stop processing, not rectification/completion."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Scope of the law; does not address the right to complete incomplete data."}, {"id": "674524dee00496cb5de7", "reason": "Controller obligations (privacy by design/default); does not grant the specific right to complete incomplete data."}], "target_frame": {"addressee": {"span": "صاحب البيانات", "article": "Article 15(1)"}, "modality": {"span": "يحق", "article": "Article 15(1)"}, "action": {"span": "يحق لصاحب البيانات طلب تصحيح بياناته الشخصية غير الدقيقة، أو استكمالها لدى المتحكم", "article": "Article 15(1)"}, "scope": {"span": "بياناته الشخصية", "article": "Article 15(1)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "صاحب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 15(1)", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "يحق", "basis": "direct_textual", "verdict": "covered", "citation": "Article 15(1)", "slot": "modality"}, {"gdpr_value": "have incomplete personal data completed, including by providing a supplementary statement", "target_value": "طلب ... استكمالها لدى المتحكم", "basis": "direct_textual", "verdict": "partial", "citation": "Article 15(1)", "slot": "action"}, {"gdpr_value": "incomplete personal data concerning the data subject", "target_value": "بياناته الشخصية (مع تضمين الاستكمال لما هو غير مكتمل)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 15(1)", "slot": "scope"}, {"gdpr_value": "taking into account the purposes of the processing", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "direct_textual", "verdict": "covered", "citation": "Article 15(1)", "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.73, "reasoning_note": "Article 15(1) UAE grants a data subject right to complete their personal data, but it does not tie this to the purposes of processing, addressing the reviewer’s objection. The method of completion via a supplementary statement is not specified. General principles (Article 5) do not convert into an explicit condition on exercising this right.", "label": "C2", "ru_id": "RU-141", "gdpr_article": 16, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 10, "total": 10}, {"round": 2, "n_queries": 4, "new": 1, "total": 11}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict of 'partial' match is incorrect, as the UAE provisions do provide a counterpart to the GDPR requirement unit [RU-141].", "counter_evidence": [{"id": "877fafe0080725188d05", "span": "يحق لصاحب البيانات طلب تصحيح بياناته الشخصية غير الدقيقة، أو استكمالها لدى المتحكم", "why": "This provision matches the GDPR requirement unit [RU-141] closely, as it mentions the right to complete incomplete personal data."}, {"id": "5bedab371a9fc40ba93a", "span": "أن تكون البيانات الشخصية دقيقة وصحيحة، وأن تخضع للتحديث متى اقتضى الأمر ذلك", "why": "This provision implies that the controller has an obligation to ensure the accuracy and completeness of personal data."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The condition for completing incomplete personal data in the UAE provision does not explicitly match the GDPR requirement of taking into account the purposes of the processing.", "counter_evidence": [{"id": "877fafe0080725188d05", "span": "يحق لصاحب البيانات طلب تصحيح بياناته الشخصية غير الدقيقة، أو استكمالها لدى المتحكم", "why": "This provision does not explicitly mention considering the purposes of the processing for completing incomplete personal data."}], "confidence": 0.8}], "n_candidates": 11, "candidate_ids": ["c34922f387019af45e42", "717a67a0d311f88c5fd9", "5bedab371a9fc40ba93a", "877fafe0080725188d05", "ebfe638a86be87347658", "3cc10eb2dd7e95bdd0c2", "e05de90f481c9410c6e0", "80f95c322bb3204c7f65", "4a1a7742c2a181be0640", "743bfdd72ed773ff5ba9", "674524dee00496cb5de7"], "n_llm_calls": 6, "latency_s": 261.27, "temperature": 0.0, "seed": 20260801, "id": "9af246e5e96051db5235", "mutation_id": "335d52d341cb6bc9e02f", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["c95a0b593cc554df0eae", "f8f94d8d9d379713d656", "8394f801a0a97e521f68"], "candidates_excluded": [{"id": "c44e3478969c6bbb366c", "reason": "Ancillary reference to including purposes in records when processing for a new purpose; does not establish the baseline duty to maintain records."}, {"id": "0922609ffbfd96a70f90", "reason": "Right to erasure; unrelated to maintaining records of processing activities."}, {"id": "1fc3063dbbcf8d500da0", "reason": "Security measures obligation; not about records of processing activities."}, {"id": "0ec82f88effbafd6a911", "reason": "Health data processing controls; not about controllers’ records of processing."}, {"id": "cf114b62f7d3612bb117", "reason": "Complaints handling; not about records of processing activities."}, {"id": "d31b8876d3426a7c919a", "reason": "Data protection impact assessment; not the duty to keep records of processing."}, {"id": "4de7a5d9d6e42dc170c3", "reason": "National register of controllers by the authority; distinct from a controller’s internal records of processing."}, {"id": "d9a05a425b46428120ee", "reason": "Supervisory powers and cooperation; not the substantive duty to maintain records."}, {"id": "e33bde5f24e463a1e604", "reason": "Accreditation bodies; unrelated to records of processing activities."}], "target_frame": {"addressee": {"span": "جهة التحكم", "article": "Article 33"}, "modality": {"span": "على جهة التحكم", "article": "Article 33"}, "action": {"span": "الاحتفاظ بسجل أنشطة معالجة البيانات الشخصية", "article": "Article 33"}, "scope": {"span": "سجلات أنشطة معالجة البيانات الشخصية لدى جهة التحكم", "article": "Article 32"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": "أثناء فترة استمرار عمليات معالجة البيانات الشخصية، إضافة إلى خمس سنوات تبدأ من تاريخ انتهاء نشاط معالجة البيانات الشخصية.", "article": "Article 33"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller", "target_value": "جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 33"}, {"slot": "modality", "gdpr_value": "obligation (shall)", "target_value": "على جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 33"}, {"slot": "action", "gdpr_value": "maintain a record of processing activities", "target_value": "الاحتفاظ بسجل أنشطة معالجة البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 33"}, {"slot": "scope", "gdpr_value": "processing activities under the controller's responsibility", "target_value": "سجلات أنشطة معالجة البيانات الشخصية لدى جهة التحكم", "basis": "conceptual", "verdict": "covered", "citation": "Article 32"}, {"slot": "condition", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "exception", "gdpr_value": "Exemption for organisations with fewer than 250 employees, unless risk, non-occasional, or special categories involved", "target_value": null, "basis": "absent", "verdict": "broader", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "أثناء فترة استمرار عمليات المعالجة + خمس سنوات بعد انتهائها", "basis": "direct_textual", "verdict": "broader", "citation": "Article 33"}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "broader", "confidence": 0.86, "reasoning_note": "KSA PDPL expressly obliges controllers to keep a written, accurate, up-to-date record of processing activities and to retain it during processing and for five years thereafter. No size-based exemption exists, making the duty at least as strict as GDPR Art. 30(1) and broader in coverage. Ancillary provisions reinforce record content and oversight but do not narrow the obligation.", "label": "C1", "ru_id": "RU-253", "gdpr_article": 30, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 9, "total": 21}, {"round": 3, "n_queries": 4, "new": 4, "total": 25}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["c95a0b593cc554df0eae", "c44e3478969c6bbb366c", "0922609ffbfd96a70f90", "1fc3063dbbcf8d500da0", "0ec82f88effbafd6a911", "cf114b62f7d3612bb117", "8394f801a0a97e521f68", "d31b8876d3426a7c919a", "4de7a5d9d6e42dc170c3", "d9a05a425b46428120ee", "f8f94d8d9d379713d656", "e33bde5f24e463a1e604"], "n_llm_calls": 4, "latency_s": 186.33, "temperature": 0.0, "seed": 20260801, "id": "c64e3bae1daed0a70839", "mutation_id": "cf6bb0d48e844d44eff4", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["3cc10eb2dd7e95bdd0c2", "674524dee00496cb5de7", "9d65c2815c41a25064db"], "candidates_excluded": [{"id": "5bedab371a9fc40ba93a", "reason": "Right to restriction; not an obligation to apply safeguards nor tied to research/archiving/statistics."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment trigger; governance measure not the safeguards obligation at issue."}, {"id": "717a67a0d311f88c5fd9", "reason": "Access to information right; not a safeguards obligation for the processing."}, {"id": "c34922f387019af45e42", "reason": "Automated-decision-making safeguards in a specific context; not about research/archiving/statistics."}, {"id": "0cc06e3d3b107448da5a", "reason": "Processor obligations; RU addressee is controllers."}, {"id": "9c38ab11b550755816f5", "reason": "Duties toward DPO; not a safeguards obligation."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Scope of application; no operative safeguards obligation."}, {"id": "34f7595acb9df257ef5e", "reason": "DPO roles; not the safeguards obligation."}, {"id": "877fafe0080725188d05", "reason": "Rectification/erasure rights; not a safeguards obligation nor tied to research/archiving/statistics."}], "target_frame": {"addressee": {"span": "يجب على المتحكم الالتزام بما يأتي:", "article": "Article 7"}, "modality": {"span": "يجب", "article": "Article 7"}, "action": {"span": "اتخاذ الإجراءات والتدابير التقنية والتنظيمية الملائمة لتطبيق المعايير القياسية اللازمة لحماية وتأمين البيانات الشخصية حفاظاً على سريتها وخصوصيتها، وضمان عدم اختراقها أو إتلافها أو تغييرها أو العبث بها", "article": "Article 7(1)"}, "scope": {"span": "بهدف الامتثال لأحكام هذا المرسوم بقانون بما فيها الضوابط المنصوص عليها في المادة (5) منه، وتشمل هذه التدابير آلية إخفاء البيانات.", "article": "Article 7(2)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controllers", "target_value": "المتحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7: \"يجب على المتحكم الالتزام بما يأتي:\""}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "صيغة الإلزام \"يجب\"", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7 (chapeau)"}, {"slot": "action", "gdpr_value": "subject processing to appropriate safeguards for the rights and freedoms of the data subject", "target_value": "اتخاذ/وضع تدابير تقنية وتنظيمية ملائمة لحماية وتأمين البيانات الشخصية وضمان أمن المعالجة", "basis": "distributed", "verdict": "covered", "citation": "Article 7(1); Article 20(1)"}, {"slot": "scope", "gdpr_value": "appropriate safeguards in accordance with the GDPR", "target_value": "تدابير ملائمة بهدف الامتثال لأحكام المرسوم بقانون، بما فيها الضوابط بالمادة (5)، وتشمل آلية إخفاء البيانات", "basis": "conceptual", "verdict": "covered", "citation": "Article 7(2)"}, {"slot": "condition", "gdpr_value": "when processing personal data for archiving in the public interest, scientific or historical research, or statistical purposes", "target_value": "لا تُذكر أغراض محددة؛ الالتزام عام ويشمل جميع المعالجات", "basis": "distributed", "verdict": "broader", "citation": "Article 7(1); Article 20(1)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "لا استثناءات منصوصاً عليها لهذه الالتزامات", "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "temporal", "gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "consequence", "gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": ""}], "holistic_label": "covered", "confidence": 0.72, "reasoning_note": "Article 5(2) does not mention archiving in the public interest, scientific/historical research, or statistical purposes; it states a general purpose-limitation rule. UAE Articles 7 and 20 impose appropriate safeguards for all processing, which functionally includes those purposes, making the condition broader rather than partially matching specific listed purposes.", "label": "C1", "ru_id": "RU-964", "gdpr_article": 89, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 7, "total": 19}, {"round": 3, "n_queries": 4, "new": 1, "total": 20}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The UAE law provides some counterpart provisions for the GDPR requirement, but the analyst's slot verdict for the 'condition' slot is correct.", "counter_evidence": [{"id": "Article 7", "span": "اتخاذ الإجراءات والتدابير التقنية والتنظيمية الملائمة لتطبيق المعايير القياسية اللازمة لحماية وتأمين البيانات الشخصية", "why": "This provision requires the controller to take appropriate technical and organizational measures to protect personal data, which is similar to the GDPR requirement."}, {"id": "Article 20", "span": "تشفير البيانات الشخصية وتطبيق آلية إخفاء البيانات", "why": "This provision requires the controller and processor to implement appropriate technical and organizational measures to ensure the security of personal data, which includes encryption and pseudonymization."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The condition slot is partially covered by Article 5, which mentions the specific purposes of archiving in the public interest, scientific or historical research, or statistical purposes.", "counter_evidence": [{"id": "3cc10eb2dd7e95bdd0c2", "span": "2. أن تكون البيانات قد جمعت لغرض محدد وواضح، وألا يتم معالجتها في أي وقت لاحق على نحو يتنافى مع ذلك الغرض، ومع ذلك يجوز معالجتها في حال كان الغرض منها مشابه أو متقارب من الغرض الذي جمعت هذه البيانات من أجله.", "why": "This provision addresses the condition slot by mentioning the specific purposes of data processing."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["3cc10eb2dd7e95bdd0c2", "674524dee00496cb5de7", "5bedab371a9fc40ba93a", "9630e6d967b64e07d339", "717a67a0d311f88c5fd9", "c34922f387019af45e42", "0cc06e3d3b107448da5a", "9c38ab11b550755816f5", "743bfdd72ed773ff5ba9", "9d65c2815c41a25064db", "34f7595acb9df257ef5e", "877fafe0080725188d05"], "n_llm_calls": 7, "latency_s": 326.6, "temperature": 0.0, "seed": 20260801, "id": "1baa0d8cb269faa61d2e", "mutation_id": "658f2b00c79181b33a62", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["8cd7b777aa3cd8ca5f1f", "8e585010f3f5f3f24dbb", "9bcb8d6e5e38974e2a1b"], "candidates_excluded": [{"id": "7e54d45e18f8371cc670", "reason": "Registration procedures for external DPOs; does not address supervisory authority investigative/audit powers."}, {"id": "6a403e591ecc2a5638fc", "reason": "Referring a DPO to disciplinary investigation; not a general audit/investigative power over controllers/processing."}, {"id": "3d71a23a91370cadf799", "reason": "Substantive rules on processing criminal data; unrelated to authority’s audit powers."}, {"id": "601ddc5fd8dcb81306cb", "reason": "Board governance and internal administration; not investigative/audit powers."}, {"id": "b6efa51e73b9b96a9b0f", "reason": "DPO appointment; not supervisory authority investigative powers."}, {"id": "cbcb4f73e9dfbf01c9bf", "reason": "Internal investigations by data controllers; not powers of the authority."}, {"id": "34ea02d93464e8e2fa05", "reason": "Definitions; no operative grant of audit powers."}, {"id": "0dfa8d201a449ae5a66e", "reason": "Security measures for controllers; not authority’s investigative powers."}, {"id": "1d8fd3d4070b1ff36d68", "reason": "Notification to the authority; not a grant of audit or investigative powers."}], "target_frame": {"addressee": {"span": "الهيئة", "article": "Article 30"}, "modality": {"span": "ولها في سبيل ذلك القيام بوجه خاص بما يلي:", "article": "Article 30"}, "action": {"span": "الرقابة والتفتيش على أعمال مدراء البيانات المتعلقة بمعالجة البيانات الشخصية للتحقُّق من التزامهم بأحكام هذا القانون", "article": "Article 30(3)"}, "scope": {"span": "التحقيق في البلاغات والشكاوى الجدية المتعلقة بمخالفة أحكام هذا القانون، وفي المخالفات التي تكتشفها بنفسها أو تحال إليها من الوزير، والتصرف في التحقيق", "article": "Article 30(9)"}, "condition": {"span": "وذلك كله وِفقاً لأحكام الفصل الأول من الباب الثالث من هذا القانون.", "article": "Article 30(9)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "supervisory authority", "target_value": "الهيئة", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 30 (مهام الهيئة وصلاحياتها)"}, {"slot": "modality", "gdpr_value": "power", "target_value": "ولها في سبيل ذلك القيام بوجه خاص بما يلي:", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 30 chapeau"}, {"slot": "action", "gdpr_value": "carry out investigations in the form of data protection audits", "target_value": "الرقابة والتفتيش على أعمال مدراء البيانات ... + إجراء التحقيقات اللازمة", "basis": "distributed", "verdict": "covered", "citation": "Art. 30(3); Art. 17"}, {"slot": "scope", "gdpr_value": "investigative powers", "target_value": "التحقيق في البلاغات والشكاوى الجدية ... والتصرف في التحقيق", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 30(9)"}, {"slot": "condition", "gdpr_value": "None", "target_value": "وذلك كله وِفقاً لأحكام الفصل الأول من الباب الثالث من هذا القانون.", "basis": "direct_textual", "verdict": "narrower", "citation": "Art. 30(9)"}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "covered", "confidence": 0.68, "reasoning_note": "Bahrain’s law grants the authority the power to conduct ‘الرقابة والتفتيش’ (supervision/inspection) of controllers and DPOs and to conduct investigations; in administrative Arabic usage, ‘التفتيش’ serves the functional role of a data protection audit. Article 30(3) supplies the audit-like inspection function, and Articles 30(9)/17 supply investigative powers; together these satisfy the GDPR unit despite not using the word ‘audit’. The only textual narrowing is a generic requirement to follow the investigation chapter’s procedures.", "label": "C1", "ru_id": "RU-681", "gdpr_article": 58, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 8, "total": 20}, {"round": 3, "n_queries": 4, "new": 4, "total": 24}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The BHR provisions do not explicitly provide for the power to carry out investigations in the form of data protection audits.", "counter_evidence": [{"id": "8cd7b777aa3cd8ca5f1f", "span": "الرقابة والتفتيش على أعمال مدراء البيانات", "why": "This provision mentions supervision and inspection, but not explicitly data protection audits."}, {"id": "8e585010f3f5f3f24dbb", "span": "التحقيق في البلاغات والشكاوى الجدية", "why": "This provision mentions investigating serious complaints, but it is not clear if this includes data protection audits."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The provisions do not clearly support the claim that the authority has the power to carry out investigations in the form of data protection audits.", "counter_evidence": [{"id": "8e585010f3f5f3f24dbb", "span": "الرقابة والتفتيش تقوم الهيئة بالرقابة والتفتيش على أعمال مراقب حماية البيانات الخارجي والداخلي", "why": "This provision grants the authority some investigative powers, but it is not entirely clear that these powers extend to 'data protection audits'."}, {"id": "8cd7b777aa3cd8ca5f1f", "span": "الرقابة والتفتيش على أعمال مدراء البيانات", "why": "This provision grants the authority the power to supervise and inspect the activities of data controllers, but it does not explicitly mention 'data protection audits'."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["8e585010f3f5f3f24dbb", "7e54d45e18f8371cc670", "8cd7b777aa3cd8ca5f1f", "6a403e591ecc2a5638fc", "3d71a23a91370cadf799", "601ddc5fd8dcb81306cb", "9bcb8d6e5e38974e2a1b", "b6efa51e73b9b96a9b0f", "cbcb4f73e9dfbf01c9bf", "34ea02d93464e8e2fa05", "0dfa8d201a449ae5a66e", "1d8fd3d4070b1ff36d68"], "n_llm_calls": 7, "latency_s": 341.4, "temperature": 0.0, "seed": 20260801, "id": "593a41e46bfd7cd3ecad", "mutation_id": "06c61037bdc4e672da91", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["5bedab371a9fc40ba93a"], "candidates_excluded": [{"id": "c34922f387019af45e42", "reason": "Concerns objections to automated decision-making, not restriction of processing when accuracy is contested."}, {"id": "877fafe0080725188d05", "reason": "Provides rights to rectification and erasure, not the right to restrict processing pending accuracy verification."}, {"id": "717a67a0d311f88c5fd9", "reason": "Information right referencing procedures for restriction; does not confer the restriction right itself."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment; unrelated to restriction right."}, {"id": "ebfe638a86be87347658", "reason": "Data portability; unrelated to restriction right."}, {"id": "674524dee00496cb5de7", "reason": "General controller obligations; does not establish a data subject right to restriction when accuracy is contested."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "Processing principles (including accuracy) but no data subject right to restriction tied to contesting accuracy."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Scope of law; not a rights provision."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification; unrelated to restriction right."}, {"id": "9c38ab11b550755816f5", "reason": "DPO duties and contact; not the restriction right."}, {"id": "4a1a7742c2a181be0640", "reason": "Right to stop processing in other circumstances (e.g., direct marketing), not specifically when accuracy is contested."}], "target_frame": {"addressee": {"span": "صاحب البيانات", "article": "Article 16(1)"}, "modality": {"span": "يحق لصاحب البيانات", "article": "Article 16(1)"}, "action": {"span": "إلزام المتحكم بتقييد وإيقاف المعالجة", "article": "Article 16(1)"}, "scope": {"span": "بياناته، بما في ذلك بياناته الشخصية", "article": "Article 16(1)(أ)"}, "condition": {"span": "اعتراض صاحب البيانات على دقة بياناته، بما في ذلك بياناته الشخصية", "article": "Article 16(1)(أ)"}, "exception": {"span": "للمتحكم المضي في معالجة بيانات صاحب البيانات، بما في ذلك البيانات الشخصية، دون موافقته في أي من الحالات الآتية: أ. إذا كانت المعالجة مقتصرة على تخزين البيانات، بما في ذلك البيانات الشخصية. ب. إذا كانت المعالجة ضرورية لإقامة أي من إجراءات المطالبة بالحقوق والدعاوى القانونية أو الدفاع عنها أو تتعلق بالإجراءات القضائية. ج. إذا كانت المعالجة ضرورية لحماية حقوق الغير وفقاً للتشريعات السارية. د. إذا كانت المعالجة ضرورية لحماية المصلحة العامة.", "article": "Article 16(3)"}, "temporal": {"span": "لفترة محددة تسمح للمتحكم التحقق من دقتها", "article": "Article 16(1)(أ)"}, "consequence": {"span": "وفي جميع الأحوال، يجب على المتحكم في حال قام برفع التقييد المنصوص عليه في هذه المادة، أن يخطر صاحب البيانات بذلك.", "article": "Article 16(4)"}}, "slot_verdicts": [{"gdpr": "data subject", "target": "صاحب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 16(1)", "slot": "addressee"}, {"gdpr": "right", "target": "يحق", "basis": "direct_textual", "verdict": "covered", "citation": "Article 16(1)", "slot": "modality"}, {"gdpr": "obtain from the controller the restriction of processing", "target": "إلزام المتحكم بتقييد وإيقاف المعالجة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 16(1)", "slot": "action"}, {"gdpr": "processing of the data subject's personal data", "target": "بياناته، بما في ذلك بياناته الشخصية (في سياق تقييد المعالجة)", "basis": "distributed", "verdict": "covered", "citation": "Article 16(1), Article 16(1)(أ)", "slot": "scope"}, {"gdpr": "the accuracy of the personal data is contested by the data subject", "target": "اعتراض صاحب البيانات على دقة بياناته، بما في ذلك بياناته الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 16(1)(أ)", "slot": "condition"}, {"gdpr": "None", "target": "استثناءات تمكّن المتحكم من الاستمرار بالمعالجة (تخزين فقط، الدعاوى القانونية، حماية حقوق الغير، حماية المصلحة العامة)", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 16(3)", "slot": "exception"}, {"gdpr": "for a period enabling the controller to verify the accuracy", "target": "لفترة محددة تسمح للمتحكم التحقق من دقتها", "basis": "direct_textual", "verdict": "covered", "citation": "Article 16(1)(أ)", "slot": "temporal"}, {"gdpr": "None", "target": "إخطار صاحب البيانات عند رفع التقييد", "basis": "direct_textual", "verdict": "broader", "citation": "Article 16(4)", "slot": "consequence"}], "holistic_label": "covered", "confidence": 0.93, "reasoning_note": "Article 16(1)(a) of the UAE PDPL directly grants a right to restrict processing when accuracy is contested, for a period enabling verification. The law also sets exceptions allowing limited processing despite restriction (Art. 16(3)); while GDPR Art. 18 similarly allows limited processing, RU-166 does not specify exceptions, hence the narrower rating on that slot. All core elements of the GDPR unit are otherwise textually matched.", "label": "C1", "ru_id": "RU-166", "gdpr_article": 18, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 6, "total": 18}, {"round": 3, "n_queries": 4, "new": 0, "total": 18}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["5bedab371a9fc40ba93a", "c34922f387019af45e42", "877fafe0080725188d05", "717a67a0d311f88c5fd9", "9630e6d967b64e07d339", "ebfe638a86be87347658", "674524dee00496cb5de7", "3cc10eb2dd7e95bdd0c2", "743bfdd72ed773ff5ba9", "e05de90f481c9410c6e0", "9c38ab11b550755816f5", "4a1a7742c2a181be0640"], "n_llm_calls": 4, "latency_s": 181.7, "temperature": 0.0, "seed": 20260801, "id": "5770a243945c419af939", "mutation_id": "b70d680a8ce79c05c7d8", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["717a67a0d311f88c5fd9"], "candidates_excluded": [{"id": "ebfe638a86be87347658", "reason": "Data portability right; not about obtaining information on processing purposes."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Scope of the law; does not grant a right to obtain information on purposes."}, {"id": "c34922f387019af45e42", "reason": "Addresses automated decision-making objections; not the right to know purposes."}, {"id": "9c38ab11b550755816f5", "reason": "DPO-related duties; not a data subject information right."}, {"id": "5d949837d7aab073cd67", "reason": "Complaints mechanism; not the substantive right to obtain purposes information."}, {"id": "4a1a7742c2a181be0640", "reason": "Right to object/stop processing; not about informing on purposes."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment; not relevant to informing on purposes."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "Processing principles (including purpose limitation) but no data subject right to obtain purposes info."}, {"id": "34f7595acb9df257ef5e", "reason": "DPO roles; not an access-to-information right."}, {"id": "dec351a1e477287e3b22", "reason": "Requires controllers to provide contact methods; does not specify the content right to know purposes."}, {"id": "877fafe0080725188d05", "reason": "Rectification/erasure rights; not about purposes information."}], "target_frame": {"addressee": {"span": "يحق لصاحب البيانات", "article": "Article 13(1)"}, "modality": {"span": "يحق", "article": "Article 13(1)"}, "action": {"span": "وبناءً على طلب يقدمه إلى المتحكم ومن دون أي مقابل الحصول على المعلومات الآتية", "article": "Article 13(1)"}, "scope": {"span": "ب. أغراض المعالجة.", "article": "Article 13(1)(b)"}, "condition": {"span": "وبناءً على طلب يقدمه إلى المتحكم ومن دون أي مقابل", "article": "Article 13(1)"}, "exception": {"span": "في جميع الأحوال، يجب على المتحكم تزويد صاحب البيانات بالمعلومات المنصوص عليها في الفقرات (ب) و(د) و(ز) من البند (1) من هذه المادة.", "article": "Article 13(2)"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "صاحب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13(1)", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "يحق", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13(1)", "slot": "modality"}, {"gdpr_value": "obtain from the controller information on the purposes of the processing", "target_value": "الحصول على المعلومات الآتية ... ب. أغراض المعالجة.", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13(1)(b); 13(2)", "slot": "action"}, {"gdpr_value": "purposes of the processing", "target_value": "أغراض المعالجة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13(1)(b)", "slot": "scope"}, {"gdpr_value": "where the personal data concerning the data subject are being processed", "target_value": "لا يوجد ربط صريح بهذا الشرط؛ النص يقرر الحق \"وبناءً على طلب\" بل ويُلزم المتحكم \"في جميع الأحوال\" بتزويد المعلومات المذكورة في (ب).", "basis": "absent", "verdict": "uncovered", "citation": "Article 13(1)-(2)", "slot": "condition"}, {"gdpr_value": "None", "target_value": "في جميع الأحوال، يجب على المتحكم تزويد ... المعلومات المنصوص عليها في (ب).", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13(2)", "slot": "exception"}, {"gdpr_value": "None", "target_value": "غير منصوص عليه", "basis": "absent", "verdict": "covered", "citation": "", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "غير منصوص عليه", "basis": "absent", "verdict": "covered", "citation": "", "slot": "consequence"}], "holistic_label": "covered", "confidence": 0.79, "reasoning_note": "Article 13(1)(b) expressly grants the data subject the right to obtain information on the purposes of processing from the controller, and Article 13(2) mandates provision of that item in all cases. While there is no explicit condition tying the right to ongoing processing (as in GDPR Art. 15), the UAE text functionally covers the GDPR requirement whenever processing occurs and is, if anything, broader by not conditioning the right on that fact. This addresses the objection by noting the missing explicit linkage while confirming functional coverage.", "label": "C2", "ru_id": "RU-124", "gdpr_article": 15, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 10, "total": 10}, {"round": 2, "n_queries": 4, "new": 6, "total": 16}, {"round": 3, "n_queries": 4, "new": 0, "total": 16}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The UAE law does not explicitly state that the right to obtain information applies only where the personal data are being processed.", "counter_evidence": [{"id": "717a67a0d311f88c5fd9", "span": "Article 13(1) and Article 13(2)", "why": "The UAE law does not explicitly state that the right to obtain information applies only where the personal data are being processed."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The UAE jurisdiction does not explicitly link the right to obtain information on the purposes of the processing to the ongoing processing of personal data.", "counter_evidence": [{"id": "Article 13(1)", "span": "يحق لصاحب البيانات وبناءً على طلب يقدمه إلى المتحكم ومن دون أي مقابل الحصول على المعلومات الآتية: أ. أنواع البيانات الشخصية التابعة له التي يتم معالجتها. ب. أغراض المعالجة.", "why": "The article grants the right to obtain information on the purposes of the processing, but does not explicitly link it to ongoing processing."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["ebfe638a86be87347658", "717a67a0d311f88c5fd9", "743bfdd72ed773ff5ba9", "c34922f387019af45e42", "9c38ab11b550755816f5", "5d949837d7aab073cd67", "4a1a7742c2a181be0640", "9630e6d967b64e07d339", "3cc10eb2dd7e95bdd0c2", "34f7595acb9df257ef5e", "dec351a1e477287e3b22", "877fafe0080725188d05"], "n_llm_calls": 7, "latency_s": 350.11, "temperature": 0.0, "seed": 20260801, "id": "17b4d78053f35842542b", "mutation_id": "83341be17b2087117948", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["c95a0b593cc554df0eae", "8394f801a0a97e521f68", "3a56eed81feb3655d1d1", "c44e3478969c6bbb366c"], "candidates_excluded": [{"id": "14105f25ea49e7794aaa", "reason": "DPIA requirements; not about maintaining records of processing activities."}, {"id": "a7597ada8323b333cc94", "reason": "Collection purpose/minimisation duties; not about records of processing."}, {"id": "1fc3063dbbcf8d500da0", "reason": "Security safeguards; not about records of processing."}, {"id": "0ec82f88effbafd6a911", "reason": "Health-data specific processing restrictions; not about records."}, {"id": "d31b8876d3426a7c919a", "reason": "High-level DPIA obligation; not about maintaining records of processing."}, {"id": "3074a33b0107bc8c40a0", "reason": "Definitions; no operative duty to maintain records."}, {"id": "4de7a5d9d6e42dc170c3", "reason": "National register of controllers; not an internal record-of-processing obligation."}, {"id": "d9a05a425b46428120ee", "reason": "Supervisory powers to request documents; ancillary to, but does not itself impose, a record-keeping duty."}], "target_frame": {"addressee": {"span": "جهة التحكم وأي جهة أخرى تعالج البيانات الشخصية", "article": "Article 31"}, "modality": {"span": "تحتفظ جهة التحكم وأي جهة أخرى تعالج البيانات الشخصية بسجلات", "article": "Article 31"}, "action": {"span": "تحتفظ جهة التحكم وأي جهة أخرى تعالج البيانات الشخصية بسجلات", "article": "Article 31"}, "scope": {"span": "لأنشطة معالجة البيانات الشخصية بحسب طبيعة النشاط الذي تمارسه جهة التحكم", "article": "Article 31"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": "لمدة تحددها اللوائح", "article": "Article 31"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "جهة التحكم وأي جهة أخرى تعالج البيانات الشخصية", "basis": "direct_textual", "verdict": "broader", "citation": "Article 31", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "تحتفظ ... بسجلات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 31", "slot": "modality"}, {"gdpr_value": "maintain a record of processing activities under its responsibility", "target_value": "تحتفظ ... بسجلات لأنشطة معالجة البيانات الشخصية (مع حد أدنى من البيانات المدرجة في السجلات)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 31; see also Article 32(3)(و)", "slot": "action"}, {"gdpr_value": "processing activities under the controller's responsibility", "target_value": "لأنشطة معالجة البيانات الشخصية بحسب طبيعة النشاط الذي تمارسه جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 31", "slot": "scope"}, {"gdpr_value": null, "target_value": null, "basis": "absent", "verdict": "covered", "citation": "", "slot": "condition"}, {"gdpr_value": "shall not apply to organisations with fewer than 250 employees unless risk, not occasional, or includes special categories", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": "", "slot": "exception"}, {"gdpr_value": null, "target_value": "لمدة تحددها اللوائح", "basis": "direct_textual", "verdict": "broader", "citation": "Article 31", "slot": "temporal"}, {"gdpr_value": null, "target_value": null, "basis": "absent", "verdict": "covered", "citation": "", "slot": "consequence"}], "holistic_label": "covered", "confidence": 0.84, "reasoning_note": "Article 31 PDPL directly requires controllers to keep records of personal data processing activities and even specifies minimum content, addressing the reviewer’s concern. The main divergence from GDPR is the absence of the small-organisation exception, making the KSA duty broader, not weaker.", "label": "C4", "ru_id": "RU-253", "gdpr_article": 30, "jurisdiction": "KSA", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 6, "total": 18}, {"round": 3, "n_queries": 4, "new": 3, "total": 21}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The exception for organizations with fewer than 250 employees is not explicitly mentioned in Article 31.", "counter_evidence": [{"id": "c95a0b593cc554df0eae", "span": "المادة الحادية والثلاثون: دون إخلال بما ورد في المادة (الثامنة عشرة) من النظام، تحتفظ جهة التحكم وأي جهة أخرى تعالج البيانات الشخصية بسجلات لمدة تحددها اللوائح لأنشطة معالجة البيانات الشخصية بحسب طبيعة النشاط الذي تمارسه جهة التحكم؛", "why": "Article 31 requires the controller to maintain records of processing activities, but does not provide an exemption for organizations based on their size."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The KSA jurisdiction's provision may not be entirely equivalent to the GDPR's requirement", "counter_evidence": [{"id": "c95a0b593cc554df0eae", "span": "المادة الحادية والثلاثون: دون إخلال بما ورد في المادة (الثامنة عشرة) من النظام، تحتفظ جهة التحكم وأي جهة أخرى تعالج البيانات الشخصية بسجلات لمدة تحددها اللوائح لأنشطة معالجة البيانات الشخصية بحسب طبيعة النشاط الذي تمارسه جهة التحكم؛ لتكون متاحة عندما تطلبها الجهة المختصة.", "why": "The provision requires the controller to maintain records of processing activities, but the details of these records are not explicitly stated."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["c95a0b593cc554df0eae", "14105f25ea49e7794aaa", "3a56eed81feb3655d1d1", "a7597ada8323b333cc94", "1fc3063dbbcf8d500da0", "0ec82f88effbafd6a911", "8394f801a0a97e521f68", "d31b8876d3426a7c919a", "3074a33b0107bc8c40a0", "c44e3478969c6bbb366c", "4de7a5d9d6e42dc170c3", "d9a05a425b46428120ee"], "n_llm_calls": 7, "latency_s": 372.43, "temperature": 0.0, "seed": 20260801, "id": "8808997d3d46e62220f3", "mutation_id": "4854c56377f480068707", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["674524dee00496cb5de7"], "candidates_excluded": [{"id": "5d949837d7aab073cd67", "reason": "Complaints procedure; does not establish or limit a controller’s duty to maintain processing records."}, {"id": "c34922f387019af45e42", "reason": "Automated decision-making rights; unrelated to controller record-keeping."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification duties; not a general record of processing activities."}, {"id": "9d65c2815c41a25064db", "reason": "Security measures; no requirement to maintain a processing record."}, {"id": "fdfffc71ce002ff82134", "reason": "Data protection impact assessment; distinct from maintaining a processing record."}, {"id": "717a67a0d311f88c5fd9", "reason": "Data subject’s right to information; not the controller’s internal record-keeping duty."}, {"id": "34f7595acb9df257ef5e", "reason": "DPO roles; does not impose controller record-keeping."}, {"id": "0cc06e3d3b107448da5a", "reason": "Processor obligations (including a processor record); RU-253 addresses controllers, not processors."}, {"id": "9c38ab11b550755816f5", "reason": "Controller/processor duties toward DPO; not record-keeping."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment; not record-keeping."}, {"id": "57844ac856d11c289650", "reason": "Lawful bases/consent exceptions; does not create or limit a controller’s duty to keep processing records."}], "target_frame": {"addressee": {"span": "يجب على المتحكم", "article": "Article 7 (chapeau)"}, "modality": {"span": "يجب", "article": "Article 7 (chapeau)"}, "action": {"span": "مسك سجل خاص للبيانات، بما في ذلك البيانات الشخصية", "article": "Article 7(4)"}, "scope": {"span": "المدد الزمنية للمعالجة وقيودها ونطاقها ... والغرض من المعالجة", "article": "Article 7(4)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller", "target_value": "المتحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7 (chapeau)"}, {"slot": "modality", "gdpr_value": "obligation (shall)", "target_value": "يجب", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7 (chapeau)"}, {"slot": "action", "gdpr_value": "maintain a record of processing activities under its responsibility", "target_value": "مسك سجل خاص للبيانات، بما في ذلك البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7(4)"}, {"slot": "scope", "gdpr_value": "processing activities under the controller's responsibility", "target_value": "يشمل السجل تفاصيل عن \"المدد الزمنية للمعالجة وقيودها ونطاقها ... والغرض من المعالجة\"", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7(4)"}, {"slot": "condition", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "exception", "gdpr_value": "Exemption for enterprises with fewer than 250 employees unless certain conditions apply", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "covered", "confidence": 0.86, "reasoning_note": "Article 7(4) directly obliges controllers to keep a record with processing details, satisfying Art. 30’s core duty. The cited Article 4 concerns lawful bases/consent exceptions and does not operate as an exception to the record-keeping duty in Article 7(4). The UAE text contains no express small-entity or similar exemption to controller record-keeping, unlike GDPR’s sub-250 employee carve-out.", "label": "C2", "ru_id": "RU-253", "gdpr_article": 30, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 7, "total": 7}, {"round": 2, "n_queries": 4, "new": 9, "total": 16}, {"round": 3, "n_queries": 4, "new": 1, "total": 17}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The UAE jurisdiction may not have a direct counterpart to the GDPR requirement of maintaining a record of processing activities under the controller's responsibility.", "counter_evidence": [{"id": "674524dee00496cb5de7", "span": "Article 7(4)", "why": "The article requires the controller to maintain a record of processing activities, but it does not explicitly state that the record must be kept under the controller's responsibility."}, {"id": "0cc06e3d3b107448da5a", "span": "Article 8, paragraph 7", "why": "The article requires the processor to maintain a record of the personal data it processes on behalf of the controller, suggesting that the record-keeping obligation may be distributed between the controller and the processor."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's claim that there are no exceptions to the record-keeping requirement is not supported by the text.", "counter_evidence": [{"id": "57844ac856d11c289650", "span": "المادة (4) حالات معالجة البيانات الشخصية بدون موافقة صاحبها", "why": "Article 4 lists exceptions to the general rule that personal data cannot be processed without consent, which may imply that there are exceptions to the record-keeping requirement."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["5d949837d7aab073cd67", "c34922f387019af45e42", "e05de90f481c9410c6e0", "9d65c2815c41a25064db", "fdfffc71ce002ff82134", "717a67a0d311f88c5fd9", "34f7595acb9df257ef5e", "0cc06e3d3b107448da5a", "9c38ab11b550755816f5", "9630e6d967b64e07d339", "674524dee00496cb5de7", "57844ac856d11c289650"], "n_llm_calls": 7, "latency_s": 341.81, "temperature": 0.0, "seed": 20260801, "id": "4337db5d10e675781098", "mutation_id": "cb0e289caaa689d0e635", "mtype": "broaden", "required": "C4", "condition": "mutation"}
{"candidates_selected": ["9cfd6fbae8182dbc0028", "ea8306cd18f9261f6413"], "candidates_excluded": [{"id": "0003cd906d382a2dcf02", "reason": "Regulates copying official identity documents; not an information duty to data subjects at collection."}, {"id": "14105f25ea49e7794aaa", "reason": "DPIA requirements; not about informing data subjects of controller identity."}, {"id": "c95a0b593cc554df0eae", "reason": "Record-keeping by controller; does not impose notice to data subjects."}, {"id": "3a56eed81feb3655d1d1", "reason": "Public interest processing controls; no duty to provide controller identity to data subjects at collection."}, {"id": "06b918a4049719ed530f", "reason": "Certification/auditing framework; not an information duty to data subjects."}, {"id": "a7597ada8323b333cc94", "reason": "Collection principles; no express requirement to provide controller identity."}, {"id": "0922609ffbfd96a70f90", "reason": "Erasure rights; unrelated to informing data subjects at collection."}, {"id": "c511c9bf7779067e64f4", "reason": "Conditions for collecting from others/other purposes; not about notice of controller identity at collection from data subject."}, {"id": "593beb6b1fe15a8fda31", "reason": "Processor selection; not an information duty to data subjects."}, {"id": "94fdbc8539498517eb98", "reason": "Complaints mechanism; not an information duty to data subjects."}], "target_frame": {"addressee": {"span": "يجب على جهة التحكم", "article": "Article 4(1)"}, "modality": {"span": "يجب على جهة التحكم اتخاذ التدابير اللازمة", "article": "Article 4(1)"}, "action": {"span": "إبلاغ صاحب البيانات الشخصية بالآتي: أ- الاسم النظامي لجهة التحكم، وبيانات التواصل الخاصة بها", "article": "Article 4(1)(أ)"}, "scope": {"span": null, "article": null}, "condition": {"span": "في حال تم جمع البيانات الشخصية من صاحبها مباشرة", "article": "Article 4(1); Article 13 (chapeau)"}, "exception": {"span": "ما لم يكن جمعها لأغراض أمنية", "article": "Article 13(3)"}, "temporal": {"span": "عند البدء في جمع بياناته", "article": "Article 13 (chapeau)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller", "target_value": "جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1); Article 13 (chapeau)"}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "يجب على جهة التحكم اتخاذ التدابير اللازمة / على جهة التحكم ... اتخاذ الوسائل الكافية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1); Article 13 (chapeau)"}, {"slot": "action", "gdpr_value": "provide the data subject with the identity of the controller", "target_value": "إبلاغ صاحب البيانات الشخصية بالاسم النظامي لجهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1)(أ)"}, {"slot": "scope", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "condition", "gdpr_value": "where personal data relating to a data subject are collected from the data subject", "target_value": "في حال/في حالة جمع البيانات الشخصية من صاحبها مباشرة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1); Article 13 (chapeau)"}, {"slot": "exception", "gdpr_value": "where and insofar as the data subject already has the information", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "temporal", "gdpr_value": "at the time when personal data are obtained", "target_value": "عند البدء في جمع بياناته", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13 (chapeau)"}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.82, "reasoning_note": "KSA PDPL Article 4(1)(a) requires informing the data subject of the controller’s legal name when collecting directly, and Article 13 fixes the timing as at the start of collection. The GDPR exception for when the data subject already has the information is not stated in the target text; instead, Article 13 includes a distinct security-related carve-out.", "label": "C2", "ru_id": "RU-054", "gdpr_article": 13, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 4, "total": 29}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["0003cd906d382a2dcf02", "14105f25ea49e7794aaa", "c95a0b593cc554df0eae", "3a56eed81feb3655d1d1", "06b918a4049719ed530f", "a7597ada8323b333cc94", "0922609ffbfd96a70f90", "9cfd6fbae8182dbc0028", "c511c9bf7779067e64f4", "ea8306cd18f9261f6413", "593beb6b1fe15a8fda31", "94fdbc8539498517eb98"], "n_llm_calls": 4, "latency_s": 186.57, "temperature": 0.0, "seed": 20260801, "id": "df076ff309027bc3be27", "mutation_id": "510bab3d1427b7f35fbd", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["db1b46495b01511abeef"], "candidates_excluded": [{"id": "6e6fc1f4d7421fb141d6", "reason": "Defines DPO selection/qualifications; no duty to inform controller/processor or employees."}, {"id": "487015f110e7b88b5c03", "reason": "Concerns controller’s policy and breach precautions; no DPO informing duty."}, {"id": "865fbf2c2a6ca6fcb814", "reason": "General exemptions from the law; not about DPO tasks or informing obligations."}, {"id": "a0a0194dd91481c29c6e", "reason": "Controller must set processing controls/procedures; does not assign DPO to inform employees."}, {"id": "3f916831456908af27d8", "reason": "Ministry’s enforcement powers; not DPO duties."}, {"id": "9afcca9ce75d4e0c23f1", "reason": "General obligation of controller/processor to follow ministry rules; no DPO informing duty."}, {"id": "a4136d70ee84d058ef85", "reason": "Publication of DPO contact details; not about informing obligations."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Requirement to publish privacy policy for data subjects; not DPO informing duty."}, {"id": "05b7537a91d92a0529ad", "reason": "Mandates designation of DPO; tasks deferred to regulation; no informing duty stated."}, {"id": "3a6219e8839cbad1f76e", "reason": "Breach notification duties; not DPO informing duty."}, {"id": "40626451a5025d77cff5", "reason": "Pre-processing notice to data subjects; not DPO informing duty."}], "target_frame": {"addressee": {"span": "مسؤول حماية البيانات الشخصية", "article": "Article 35 (chapeau)"}, "modality": {"span": "يتولى مسؤول حماية البيانات الشخصية المهام الآتية:", "article": "Article 35 (chapeau)"}, "action": {"span": "تقديم المقترحات والاستشارات للمتحكم أو المعالج فيما يتعلق بالتزاماتهما الواردة في القانون وهذه اللائحة.", "article": "Article 35(1)"}, "scope": {"span": "التزاماتهما الواردة في القانون وهذه اللائحة", "article": "Article 35(1)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data protection officer", "target_value": "مسؤول حماية البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 35 (chapeau)"}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "يتولى ... المهام (assignment of mandatory tasks)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 35 (chapeau)"}, {"slot": "action", "gdpr_value": "inform the controller or the processor and the employees who carry out processing of their data protection obligations", "target_value": "provide proposals and advice to the controller or processor regarding their obligations; monitor implementation of policies/obligations (no mention of informing employees)", "basis": "distributed", "verdict": "partial", "citation": "Article 35(1)-(3)"}, {"slot": "scope", "gdpr_value": "obligations under the GDPR and other Union or Member State data protection provisions", "target_value": "obligations under the Omani data protection law and its regulation", "basis": "conceptual", "verdict": "covered", "citation": "Article 35(1)"}, {"slot": "condition", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.7, "reasoning_note": "Agreed with the objection: Article 35 obliges the DPO to advise the controller/processor on their obligations but contains no express duty to inform employees who carry out processing. Article 13 sets controller procedures but does not allocate an informing role to the DPO. Therefore the action slot is only partially covered (controller/processor yes; employees no).", "label": "C2", "ru_id": "RU-474", "gdpr_article": 39, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 6, "total": 18}, {"round": 3, "n_queries": 4, "new": 2, "total": 20}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The target jurisdiction's provisions do not explicitly require the data protection officer to inform employees who carry out processing of their obligations.", "counter_evidence": [{"id": "db1b46495b01511abeef", "span": "يتولى مسؤول حماية البيانات الشخصية المهام الآتية: 1- تقديم المقترحات والاستشارات للمتحكم أو المعالج فيما يتعلق بالتزاماتهما الواردة في القانون وهذه اللائحة.", "why": "No explicit mention of employee notification"}], "confidence": 0.8}, {"verdict": "revise", "objection": "Lack of explicit provision requiring the data protection officer to inform employees who carry out processing of their obligations", "counter_evidence": [{"id": "db1b46495b01511abeef", "span": "Article 35(1)", "why": "No mention of informing employees who carry out processing"}, {"id": "a0a0194dd91481c29c6e", "span": "Article 13", "why": "No explicit provision requiring the data protection officer to inform employees who carry out processing of their obligations"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["6e6fc1f4d7421fb141d6", "487015f110e7b88b5c03", "865fbf2c2a6ca6fcb814", "a0a0194dd91481c29c6e", "3f916831456908af27d8", "9afcca9ce75d4e0c23f1", "db1b46495b01511abeef", "a4136d70ee84d058ef85", "bb26cffae1f1c0beb85d", "05b7537a91d92a0529ad", "3a6219e8839cbad1f76e", "40626451a5025d77cff5"], "n_llm_calls": 7, "latency_s": 300.81, "temperature": 0.0, "seed": 20260801, "id": "dc2c1cd229e22663189c", "mutation_id": "f8dd3ab6460bcc263ad1", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["5e5fa8a4888b88a04311"], "candidates_excluded": [{"id": "762372b7329c44286e43", "reason": "Sets lawful bases for processing; does not address civil liability or compensation."}, {"id": "3d71a23a91370cadf799", "reason": "Regulates processing of criminal-case data; no rule on controller liability for damage."}, {"id": "7448a27e7806f2c0c143", "reason": "Data quality principles; no civil liability rule."}, {"id": "f8344697d1f1dc661161", "reason": "Sensitive data processing conditions; no civil liability rule."}, {"id": "5bd7541a2690632a7c77", "reason": "Consent requirements; no civil liability rule."}, {"id": "9536e03a0aa7b4781fc7", "reason": "Concerns registry status of data protection officers; unrelated to liability for damage."}, {"id": "6b500d26673394f3d7e6", "reason": "Rectification/blocking/erasure rights; not a liability-for-damages provision."}, {"id": "c24849787475f274ecac", "reason": "Administrative measures and fines; only references civil liability in passing, does not establish controller liability for damages."}, {"id": "98fa9fe9b0650c71a971", "reason": "Notice of right to object to direct marketing; no civil liability rule."}, {"id": "c9145cc9a91d8ff7530c", "reason": "Liability of DPO legal persons for their agents; not controller liability for infringing processing."}, {"id": "1fdf77ac047fc519d30b", "reason": "Right to object to direct marketing; no civil liability rule."}], "target_frame": {"addressee": {"span": "مدير البيانات", "article": "Article 57"}, "modality": {"span": "يجوز لمن لحقه ضرر ... الحق في مطالبة مدير البيانات ... بالتعويض", "article": "Article 57"}, "action": {"span": "بمطالبة مدير البيانات ... بالتعويض الجابر للضرر", "article": "Article 57"}, "scope": {"span": "ضرر نشأ عن معالجة بياناته الشخصية", "article": "Article 57"}, "condition": {"span": "نشأ عن معالجة بياناته الشخصية من قِبَل مدير البيانات", "article": "Article 57"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": "التعويض الجابر للضرر", "article": "Article 57"}, "notes": "Article 57 also mentions a separate ground for DPO breach; the controller-focused branch is used here."}, "slot_verdicts": [{"gdpr_value": "controller involved in processing", "target_value": "مدير البيانات (data controller)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 57", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "Right of the data subject to claim compensation from the controller", "basis": "conceptual", "verdict": "weaker_modality", "citation": "Article 57", "slot": "modality"}, {"gdpr_value": "be liable for the damage", "target_value": "التعويض الجابر للضرر (compensation for damage)", "basis": "conceptual", "verdict": "covered", "citation": "Article 57", "slot": "action"}, {"gdpr_value": "damage caused by processing", "target_value": "ضرر نشأ عن معالجة بياناته الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 57", "slot": "scope"}, {"gdpr_value": "the processing infringes this Regulation", "target_value": "damage arises from processing by the controller (no infringement requirement stated)", "basis": "direct_textual", "verdict": "broader", "citation": "Article 57", "slot": "condition"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": "التعويض الجابر للضرر (compensatory remedy available)", "basis": "conceptual", "verdict": "broader", "citation": "Article 57", "slot": "consequence"}], "holistic_label": "covered", "confidence": 0.62, "reasoning_note": "Article 57 expressly creates a civil compensation claim against the controller for damage arising from processing, which functionally imposes liability encompassing cases where processing infringes the law. The text does not condition liability on infringement, so the condition slot is broader than GDPR; modality is framed via a right to claim rather than an explicit ‘shall be liable’ formula.", "label": "C3", "ru_id": "RU-930", "gdpr_article": 82, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 10, "total": 22}, {"round": 3, "n_queries": 4, "new": 7, "total": 29}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provisions do not explicitly support the claim that the controller is liable for damage caused by processing.", "counter_evidence": [{"id": "5e5fa8a4888b88a04311", "span": "Article 57", "why": "Only mentions the right to compensation, but does not explicitly state that the controller is liable."}, {"id": "6b500d26673394f3d7e6", "span": "Article 55", "why": "Mentions measures that can be taken when a violation is found, but does not explicitly state that the controller is liable for damage caused by processing."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The target jurisdiction's provisions do not explicitly establish a controller's liability for damage caused by processing that infringes the Regulation, and the condition for liability is broader than the GDPR requirement.", "counter_evidence": [{"id": "5e5fa8a4888b88a04311", "span": "التعويض يجوز لمن لحقه ضرر نشأ عن معالجة بياناته الشخصية من قِبَل مدير البيانات", "why": "This provision (Article 57) provides a right to compensation, but it does not explicitly establish the controller's liability for damage caused by processing that infringes the Regulation."}, {"id": "5e5fa8a4888b88a04311", "span": "عن معالجة بياناته الشخصية من قِبَل مدير البيانات", "why": "The condition for liability in Article 57 is broader than the GDPR requirement, as it does not explicitly require the processing to infringe the Regulation."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["762372b7329c44286e43", "3d71a23a91370cadf799", "7448a27e7806f2c0c143", "f8344697d1f1dc661161", "5bd7541a2690632a7c77", "9536e03a0aa7b4781fc7", "6b500d26673394f3d7e6", "c24849787475f274ecac", "98fa9fe9b0650c71a971", "5e5fa8a4888b88a04311", "c9145cc9a91d8ff7530c", "1fdf77ac047fc519d30b"], "n_llm_calls": 7, "latency_s": 338.02, "temperature": 0.0, "seed": 20260801, "id": "60e437f38e5118a41358", "mutation_id": "8f86936fe0f216233715", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["a079a5ac446830a74bfc", "6201d16404c0d4b9f63d", "0cc06e3d3b107448da5a"], "candidates_excluded": [{"id": "674524dee00496cb5de7", "reason": "Addresses controller obligations; does not establish the processor’s cross-border transfer prohibition."}, {"id": "717a67a0d311f88c5fd9", "reason": "Provides data subject information rights (including cross-border safeguards) but not the processor’s transfer prohibition."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Scope of the law; does not create the cross-border transfer rule for processors."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "General processing principles; no specific cross-border transfer prohibition for processors."}, {"id": "ebfe638a86be87347658", "reason": "Data portability right; unrelated to cross-border transfer prohibitions."}, {"id": "5bedab371a9fc40ba93a", "reason": "Restriction of processing right; not a cross-border transfer rule."}, {"id": "4a1a7742c2a181be0640", "reason": "Right to object/stop processing; not governing cross-border transfers."}, {"id": "c34922f387019af45e42", "reason": "Automated processing rights; not governing cross-border transfers."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment; not governing cross-border transfers."}], "target_frame": {"addressee": {"span": "يجب على المعالج الالتزام بما يأتي:", "article": "Article 8 (chapeau)"}, "modality": {"span": "يجوز نقل البيانات الشخصية إلى خارج الدولة في الأحوال الآتية المعتمدة من المكتب:", "article": "Article 22 (chapeau)"}, "action": {"span": "نقل ومشاركة البيانات الشخصية عبر الحدود لأغراض المعالجة", "article": "Article 22 (title)"}, "scope": {"span": "… عبر الحدود لأغراض المعالجة …", "article": "Article 23 (title)"}, "condition": {"span": "إجراء المعالجة وتنفيذها طبقاً للقواعد والاشتراطات والضوابط المحددة بهذا المرسوم بقانون ولائحته التنفيذية أو التي يصدر بموجبها تعليمات من المكتب.", "article": "Article 8(9)"}, "exception": {"span": "يجوز نقل البيانات الشخصية إلى خارج الدولة في الأحوال الآتية … (المادة 22) … واستثناءً مما ورد في المادة (22) … يجوز نقل البيانات الشخصية إلى خارج الدولة في الحالات التالية: (المادة 23)", "article": "Articles 22 (chapeau) and 23(1) (chapeau)"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "processor", "target_value": "المعالج", "basis": "direct_textual", "verdict": "covered", "citation": "Article 8 (chapeau)"}, {"slot": "modality", "gdpr_value": "prohibition", "target_value": "يجوز نقل البيانات الشخصية إلى خارج الدولة في الأحوال الآتية … (نظام ترخيص/إباحة مقيدة)", "basis": "distributed", "verdict": "covered", "citation": "Articles 22 (chapeau), 23(1) (chapeau), and 8(9)"}, {"slot": "action", "gdpr_value": "transfer personal data to a third country or to an international organisation, including onward transfers", "target_value": "نقل ومشاركة البيانات الشخصية عبر الحدود", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 22 (title), Article 22(1)-(2), Article 23(1)"}, {"slot": "scope", "gdpr_value": "personal data undergoing processing or intended for processing after transfer; includes onward transfers from the third country or international organisation to another third country or international organisation", "target_value": "… عبر الحدود لأغراض المعالجة …", "basis": "direct_textual", "verdict": "narrower", "citation": "Articles 22 (title) and 23 (title)"}, {"slot": "condition", "gdpr_value": "subject to the other provisions of the GDPR", "target_value": "إجراء المعالجة طبقاً لأحكام المرسوم بقانون ولائحته التنفيذية وتعليمات المكتب", "basis": "distributed", "verdict": "partial", "citation": "Article 8(9)"}, {"slot": "exception", "gdpr_value": "when the conditions laid down in Chapter V are complied with", "target_value": "يجوز النقل خارج الدولة عند توافر الحالات المنصوص عليها في المادتين (22) و(23)", "basis": "direct_textual", "verdict": "covered", "citation": "Articles 22 (chapeau) and 23(1) (chapeau)"}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.61, "reasoning_note": "Articles 22 and 23 establish a conditional regime for cross-border transfers that, combined with Article 8(9), functionally prohibits a processor from transferring unless those conditions are met. However, the UAE text does not explicitly address onward transfers or transfers to international organisations; it speaks generally of transfers ‘outside the State’ and of states/territories or treaties with states. This is why the action/scope slots are marked narrower despite overall functional coverage of the core prohibition.", "label": "C4", "ru_id": "RU-546", "gdpr_article": 44, "jurisdiction": "UAE", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 4, "total": 16}, {"round": 3, "n_queries": 4, "new": 2, "total": 18}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The UAE law may not have a complete counterpart to the GDPR's provision on transferring personal data to a third country or international organization, including onward transfers.", "counter_evidence": [{"id": "Art. 22", "span": "نقل ومشاركة البيانات الشخصية عبر الحدود لأغراض المعالجة", "why": "The provision only mentions cross-border transfer/sharing of personal data outside the State for processing, but does not explicitly include onward transfers."}, {"id": "Art. 8(7)", "span": "أي بيانات متعلقة بحركة ومعالجة تلك البيانات عبر الحدود", "why": "The provision mentions data related to the movement and processing of personal data across borders, but does not explicitly address onward transfers."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The UAE law does not explicitly address onward transfers to international organisations.", "counter_evidence": [{"id": "a079a5ac446830a74bfc", "span": "Article 22(1)", "why": "The article mentions transfer of personal data to 'outside the State' but does not specifically address onward transfers to international organisations."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["6201d16404c0d4b9f63d", "0cc06e3d3b107448da5a", "a079a5ac446830a74bfc", "674524dee00496cb5de7", "ebfe638a86be87347658", "c34922f387019af45e42", "5bedab371a9fc40ba93a", "743bfdd72ed773ff5ba9", "3cc10eb2dd7e95bdd0c2", "717a67a0d311f88c5fd9", "9630e6d967b64e07d339", "4a1a7742c2a181be0640"], "n_llm_calls": 7, "latency_s": 377.55, "temperature": 0.0, "seed": 20260801, "id": "b8844795660fbd4d7ce5", "mutation_id": "706054dea5e083464637", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["b157dcadab6a3e8daf5", "4ddc7494f19d84324dd8"], "candidates_excluded": [{"id": "4f65c1f467f9e61b2f46", "reason": "General scope clause; does not create an access/copy right."}, {"id": "93f989531fe30cac1ed5", "reason": "Erasure right; not about access to data."}, {"id": "a4136d70ee84d058ef85", "reason": "Right to contact DPO; procedural support, not the access/copy right itself."}, {"id": "3f916831456908af27d8", "reason": "Enforcement powers; not a data-subject access right."}, {"id": "2712fe4ebdba355a134b", "reason": "Lawful basis/consent; not access."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Requires publishing a policy and mechanisms; does not itself grant access."}, {"id": "a0040ee4dad7d4440e19", "reason": "Controller authorization content; not access."}, {"id": "caad155111190c1aa274", "reason": "Definitions; no operative access right."}, {"id": "d0bb19cb0c67952144b4", "reason": "Portability; distinct from access."}, {"id": "c62011bb3dda1c9374e5", "reason": "General protection declaration; no access right."}], "target_frame": {"addressee": {"span": "لصاحب البيانات الشخصية", "article": "Article 11"}, "modality": {"span": "الحق في", "article": "Article 11"}, "action": {"span": "الحصول على نسخة من بياناته الشخصية المعالجة", "article": "Article 11"}, "scope": {"span": "بياناته الشخصية", "article": "Article 11"}, "condition": {"span": "المعالجة (بياناته الشخصية المعالجة)", "article": "Article 11"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data subject", "target_value": "لصاحب البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "[b157dcadab6a3e8daf5] Article 11"}, {"slot": "modality", "gdpr_value": "right", "target_value": "الحق في / يحق", "basis": "direct_textual", "verdict": "covered", "citation": "[b157dcadab6a3e8daf5] Article 11; [4ddc7494f19d84324dd8] Article 19"}, {"slot": "action", "gdpr_value": "obtain access to personal data concerning the data subject", "target_value": "الحصول على نسخة من بياناته الشخصية المعالجة", "basis": "conceptual", "verdict": "covered", "citation": "[b157dcadab6a3e8daf5] Article 11(c); [4ddc7494f19d84324dd8] Article 19"}, {"slot": "scope", "gdpr_value": "personal data concerning the data subject", "target_value": "بياناته الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "[b157dcadab6a3e8daf5] Article 11(c)"}, {"slot": "condition", "gdpr_value": "where the personal data are being processed", "target_value": "بياناته الشخصية المعالجة", "basis": "direct_textual", "verdict": "covered", "citation": "[b157dcadab6a3e8daf5] Article 11(c)"}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": "[b157dcadab6a3e8daf5] Article 11; [4ddc7494f19d84324dd8] Article 19 (no exceptions stated for this right)"}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": ""}], "holistic_label": "covered", "confidence": 0.72, "reasoning_note": "The objection focuses on Article 19’s ‘request a copy’ wording, but Article 11(c) expressly grants ‘الحصول على نسخة’ (to obtain a copy) of processed personal data. Providing a copy is a standard modality of ‘access’ and functionally satisfies the GDPR unit’s requirement to obtain access where data are processed.", "label": "C1", "ru_id": "RU-123", "gdpr_article": 15, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 5, "total": 17}, {"round": 3, "n_queries": 4, "new": 2, "total": 19}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The condition 'where such personal data are being processed' is not explicitly covered by the cited provisions.", "counter_evidence": [{"id": "4ddc7494f19d84324dd8", "span": "يحق لصاحب البيانات الشخصية أن يطلب من المتحكم نسخة من بياناته الشخصية المعالجة", "why": "Article 19 provides the right to access personal data but does not explicitly state the condition of the data being processed."}, {"id": "b157dcadab6a3e8daf5f", "span": "ج- الحصول على نسخة من بياناته الشخصية المعالجة", "why": "Article 11 (ج) also provides the right to access personal data without explicitly mentioning the condition of the data being processed."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The target jurisdiction's provisions do not fully cover the GDPR requirement, as Article 19 only grants the right to request a copy of personal data, not access to it.", "counter_evidence": [{"id": "4ddc7494f19d84324dd8", "span": "يحق لصاحب البيانات الشخصية أن يطلب من المتحكم نسخة من بياناته الشخصية المعالجة", "why": "This provision only grants the right to request a copy of personal data, not access to it."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["4f65c1f467f9e61b2f46", "93f989531fe30cac1ed5", "a4136d70ee84d058ef85", "4ddc7494f19d84324dd8", "b157dcadab6a3e8daf5f", "3f916831456908af27d8", "2712fe4ebdba355a134b", "bb26cffae1f1c0beb85d", "a0040ee4dad7d4440e19", "caad155111190c1aa274", "d0bb19cb0c67952144b4", "c62011bb3dda1c9374e5"], "n_llm_calls": 7, "latency_s": 319.64, "temperature": 0.0, "seed": 20260801, "id": "727136836473daa836de", "mutation_id": "598d804b4b1b5e87166b", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["6c76988b817262e3e312", "85d05fccf5b4f57eceaf", "fcbd13532c69b340214e"], "candidates_excluded": [{"id": "455aae046cacf7979576", "reason": "Data quality and retention obligations; not a duty to review protective measures."}, {"id": "f5c366135483fe580381", "reason": "Breach notification; does not establish a review duty."}, {"id": "192caaa530952a30ad50", "reason": "Supervisory/administrative functions; not controller obligations to review measures."}, {"id": "07962910da55dbce48d3", "reason": "Cross-border data flow; unrelated to reviewing measures."}, {"id": "75852a697f66691bfbfb", "reason": "Exemptions from transparency duties; unrelated to reviewing measures."}, {"id": "a200ece03fd0ba143354", "reason": "Ministerial determination of rights procedures; not a controller review obligation."}, {"id": "dbaab43b07be19b5483e", "reason": "Transitional compliance period; not a substantive review requirement."}, {"id": "9548224453cca1301899", "reason": "Implementing regulations authority; not a direct review obligation."}, {"id": "83fae53ff99059f02f05", "reason": "General enforcement/publication clause; not about reviewing measures."}], "target_frame": {"addressee": {"span": "على المراقب", "article": "Article 11"}, "modality": {"span": "على المراقب اتخاذ الإجراءات التالية", "article": "Article 11"}, "action": {"span": "مراجعة إجراءات حماية الخصوصية", "article": "Article 11"}, "scope": {"span": "الاحتياطات الإدارية والفنية والمادية المناسبة لحماية البيانات الشخصية", "article": "Article 8(3)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "controller", "target": "المراقب", "basis": "direct_textual", "verdict": "covered", "citation": "Article 11"}, {"slot": "modality", "gdpr": "obligation", "target": "على المراقب ... اتخاذ", "basis": "direct_textual", "verdict": "covered", "citation": "Article 11"}, {"slot": "action", "gdpr": "review the measures referred to in Article 24(1)", "target": "مراجعة إجراءات حماية الخصوصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 11"}, {"slot": "scope", "gdpr": "technical and organisational measures implemented under Article 24(1)", "target": "الاحتياطات الإدارية والفنية والمادية المناسبة لحماية البيانات الشخصية", "basis": "distributed", "verdict": "covered", "citation": "Articles 11 and 8(3)"}, {"slot": "condition", "gdpr": "where necessary", "target": "no express condition on when review must occur", "basis": "absent", "verdict": "broader", "citation": "Article 11"}, {"slot": "exception", "gdpr": "None", "target": "no exception stated", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr": "None", "target": "no temporal element stated", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr": "None", "target": "no consequence stated", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "covered", "confidence": 0.78, "reasoning_note": "Article 11 imposes an express duty on the controller to review privacy protection procedures (and conduct audits), satisfying the review obligation. Articles 8(3) and 13 define the protective measures but their “necessary/appropriate” language qualifies taking precautions, not the condition for review. Thus the GDPR “where necessary” qualifier is not mirrored; the Qatari duty is broader (unconditional).", "label": "C1", "ru_id": "RU-205", "gdpr_article": 24, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 8, "total": 8}, {"round": 2, "n_queries": 4, "new": 4, "total": 12}, {"round": 3, "n_queries": 4, "new": 3, "total": 15}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The Qatari provision does not explicitly refer to Article 24(1) or technical and organizational measures, and the condition slot verdict is broader due to the lack of a qualifier like 'where necessary'.", "counter_evidence": [{"id": "6c76988b817262e3e312", "span": "مراجعة إجراءات حماية الخصوصية", "why": "The provision does not explicitly refer to Article 24(1) or technical and organizational measures."}, {"id": "6c76988b817262e3e312", "span": "No qualifier expressed (general duty to review)", "why": "The provision does not express a qualifier like 'where necessary', making the condition slot verdict broader."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The condition 'where necessary' is implicitly covered by Articles 8(3) and 13.", "counter_evidence": [{"id": "85d05fccf5b4f57eceaf", "span": "اتخاذ الاحتياطات الإدارية والفنية والمادية المناسبة لحماية البيانات الشخصية", "why": "Implies taking measures to protect personal data when necessary."}, {"id": "fcbd13532c69b340214e", "span": "يجب على كل من المراقب والمعالج اتخاذ الاحتياطات اللازمة لحماية البيانات الشخصية", "why": "Requires taking necessary measures to protect personal data."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["fcbd13532c69b340214e", "83fae53ff99059f02f05", "dbaab43b07be19b5483e", "a200ece03fd0ba143354", "07962910da55dbce48d3", "75852a697f66691bfbfb", "455aae046cacf7979576", "9548224453cca1301899", "6c76988b817262e3e312", "192caaa530952a30ad50", "f5c366135483fe580381", "85d05fccf5b4f57eceaf"], "n_llm_calls": 7, "latency_s": 315.61, "temperature": 0.0, "seed": 20260801, "id": "35ea53c9a49c7e3e7135", "mutation_id": "596da74e062c4576d425", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["d9a05a425b46428120ee", "f8f94d8d9d379713d656", "8394f801a0a97e521f68", "67a122f7dc547487996a"], "candidates_excluded": [{"id": "ea8306cd18f9261f6413", "reason": "Data-subject notice duties; not about cooperation with the supervisory authority."}, {"id": "21847c9e87d6df45a9a7", "reason": "Data accuracy duty; unrelated to authority cooperation."}, {"id": "62cc177254bb6a5bed90", "reason": "Security measures; not about cooperating with the authority."}, {"id": "04322a32135a68c65bb5", "reason": "Processing for a realized interest; not about cooperation with the authority."}, {"id": "9cfd6fbae8182dbc0028", "reason": "Right-to-be-informed details; not about authority cooperation."}, {"id": "90da7bc2380e8f3f2fb8", "reason": "Obligation to respond to data subject requests; not cooperation with the authority."}, {"id": "17d4b446ea6ed7965d08", "reason": "General procedures for data subject rights; not authority cooperation."}, {"id": "3a56eed81feb3655d1d1", "reason": "Public-interest processing by public bodies; not about cooperation with the authority."}], "target_frame": {"addressee": {"span": "جهة التحكم", "article": "Article 30(3) (d9a05a425b46428120ee)"}, "modality": {"span": "على جهة التحكم", "article": "Article 30(3) (d9a05a425b46428120ee)"}, "action": {"span": "التعاون مع الجهة المختصة", "article": "Article 30(3) (d9a05a425b46428120ee)"}, "scope": {"span": "في سبيل مباشرتها مهماتها المتعلقة بالإشراف على تطبيق أحكام النظام واللوائح", "article": "Article 30(3) (d9a05a425b46428120ee)"}, "condition": {"span": "التي تحيلها الجهة المختصة إليها", "article": "Article 30(3) (d9a05a425b46428120ee)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": "تُعاقب بالإنذار أو بغرامة لا تزيد على (خمسة ملايين) ريال، كل شخصية ذات صفة طبيعية أو اعتبارية خاصة -مشمولة بأحكام النظام- خالفت أيا من أحكام النظام أو اللوائح.", "article": "Article 36(1) (67a122f7dc547487996a)"}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": [{"id": "d9a05a425b46428120ee", "span": "على جهة التحكم التعاون مع الجهة المختصة"}], "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "على جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": [{"id": "d9a05a425b46428120ee", "span": "على جهة التحكم التعاون ..."}], "slot": "modality"}, {"gdpr_value": "cooperate with the supervisory authority", "target_value": "التعاون مع الجهة المختصة", "basis": "direct_textual", "verdict": "covered", "citation": [{"id": "d9a05a425b46428120ee", "span": "التعاون مع الجهة المختصة"}], "slot": "action"}, {"gdpr_value": "in the performance of the supervisory authority's tasks", "target_value": "في سبيل مباشرتها مهماتها المتعلقة بالإشراف على تطبيق أحكام النظام واللوائح", "basis": "direct_textual", "verdict": "covered", "citation": [{"id": "d9a05a425b46428120ee", "span": "في سبيل مباشرتها مهماتها المتعلقة بالإشراف على تطبيق أحكام النظام واللوائح"}], "slot": "scope"}, {"gdpr_value": "on request by the supervisory authority", "target_value": "التي تحيلها الجهة المختصة إليها / عند طلبها (للسجلات والوثائق)", "basis": "distributed", "verdict": "covered", "citation": [{"id": "d9a05a425b46428120ee", "span": "وعليها كذلك اتخاذ ما يلزم من إجراءات حيال المسائل ... التي تحيلها الجهة المختصة إليها"}, {"id": "d9a05a425b46428120ee", "span": "للجهة المختصة ... طلب الوثائق أو المعلومات اللازمة من جهة التحكم"}, {"id": "f8f94d8d9d379713d656", "span": "على جهة التحكم إتاحة سجلات أنشطة معالجة البيانات الشخصية للجهة المختصة عند طلبها"}], "slot": "condition"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": [], "slot": "exception"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": [], "slot": "temporal"}, {"gdpr_value": "None", "target_value": "General sanctions for violating the Law or Regulations (warning or fine up to 5 million SAR; doubled for repeat)", "basis": "direct_textual", "verdict": "broader", "citation": [{"id": "67a122f7dc547487996a", "span": "تُعاقب بالإنذار أو بغرامة لا تزيد على (خمسة ملايين) ريال ... خالفت أيا من أحكام النظام أو اللوائح."}], "slot": "consequence"}], "holistic_label": "covered", "confidence": 0.84, "reasoning_note": "KSA PDPL expressly requires cooperation with the competent authority in carrying out its supervisory tasks (Art. 30(3)) and ties cooperation to authority-initiated triggers: matters the authority refers (التي تحيلها) and document/record provision upon request (طلب الوثائق…؛ عند طلبها) (Arts. 30(4)(أ), 33(4)). Thus the “on request” condition is textually present for specific cooperation acts and, combined with the general cooperation duty, functionally meets GDPR Art. 31.", "label": "C1", "ru_id": "RU-311", "gdpr_article": 31, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 8, "total": 20}, {"round": 3, "n_queries": 4, "new": 4, "total": 24}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The KSA provisions do not explicitly support the 'on request' aspect of the GDPR requirement.", "counter_evidence": [{"id": "d9a05a425b46428120ee", "span": "على جهة التحكم التعاون مع الجهة المختصة في سبيل مباشرتها مهماتها المتعلقة بالإشراف على تطبيق أحكام النظام واللوائح", "why": "This provision does not explicitly state that cooperation is 'on request'."}, {"id": "f8f94d8d9d379713d656", "span": "على جهة التحكم إتاحة سجلات أنشطة معالجة البيانات الشخصية للجهة المختصة عند طلبها", "why": "This provision implies request-based cooperation, but it is limited to the provision of records."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The provision does not explicitly include the 'on request' condition", "counter_evidence": [{"id": "d9a05a425b46428120ee", "span": "على جهة التحكم التعاون مع الجهة المختصة في سبيل مباشرتها مهماتها المتعلقة بالإشراف على تطبيق أحكام النظام واللوائح", "why": "This provision does not explicitly include the 'on request' condition"}, {"id": "f8f94d8d9d379713d656", "span": "على جهة التحكم إتاحة سجلات أنشطة معالجة البيانات الشخصية للجهة المختصة عند طلبها", "why": "This provision implies cooperation upon request, but does not directly address the performance of the supervisory authority's tasks"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["ea8306cd18f9261f6413", "f8f94d8d9d379713d656", "21847c9e87d6df45a9a7", "62cc177254bb6a5bed90", "67a122f7dc547487996a", "d9a05a425b46428120ee", "04322a32135a68c65bb5", "8394f801a0a97e521f68", "9cfd6fbae8182dbc0028", "90da7bc2380e8f3f2fb8", "17d4b446ea6ed7965d08", "3a56eed81feb3655d1d1"], "n_llm_calls": 7, "latency_s": 334.66, "temperature": 0.0, "seed": 20260801, "id": "57bbca1fd673a5f1d60a", "mutation_id": "a3f1dcc2e55a282da69a", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["5bedab371a9fc40ba93a"], "candidates_excluded": [{"id": "c34922f387019af45e42", "reason": "Addresses objections to automated decision-making, not restriction of processing when accuracy is contested."}, {"id": "0cc06e3d3b107448da5a", "reason": "Sets processor obligations; does not confer a data subject right to restrict processing."}, {"id": "877fafe0080725188d05", "reason": "Provides rights to rectification/erasure; does not establish restriction of processing pending accuracy verification."}, {"id": "717a67a0d311f88c5fd9", "reason": "Information right (including procedures for restriction); does not itself grant the restriction right or define its duration."}, {"id": "674524dee00496cb5de7", "reason": "General controller obligations; no specific right to restriction upon contested accuracy."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment; unrelated to restriction upon contested accuracy."}, {"id": "ebfe638a86be87347658", "reason": "Data portability; unrelated to restriction upon contested accuracy."}, {"id": "80f95c322bb3204c7f65", "reason": "Consent conditions; unrelated to restriction upon contested accuracy."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "Processing principles (including accuracy) but no data subject right to restrict processing pending verification."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification duties; not about restriction upon contested accuracy."}, {"id": "9c38ab11b550755816f5", "reason": "DPO-related duties; not about restriction upon contested accuracy."}], "target_frame": {"addressee": {"span": "يحق لصاحب البيانات", "article": "Article 16(1)"}, "modality": {"span": "يحق", "article": "Article 16(1)"}, "action": {"span": "إلزام المتحكم بتقييد وإيقاف المعالجة", "article": "Article 16(1)"}, "scope": {"span": "اعتراض صاحب البيانات على دقة بياناته الشخصية، وفي هذه الحالة يتم تقييد المعالجة", "article": "Article 16(1)(أ)"}, "condition": {"span": "اعتراض صاحب البيانات على دقة بياناته الشخصية", "article": "Article 16(1)(أ)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data subject", "target_value": "صاحب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 16(1)"}, {"slot": "modality", "gdpr_value": "right", "target_value": "يحق", "basis": "direct_textual", "verdict": "covered", "citation": "Article 16(1)"}, {"slot": "action", "gdpr_value": "obtain from the controller the restriction of processing", "target_value": "إلزام المتحكم بتقييد وإيقاف المعالجة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 16(1)"}, {"slot": "scope", "gdpr_value": "processing of the data subject's personal data", "target_value": "تقييد المعالجة عند الاعتراض على دقة بياناته الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 16(1)(أ)"}, {"slot": "condition", "gdpr_value": "the accuracy of the personal data is contested by the data subject", "target_value": "اعتراض صاحب البيانات على دقة بياناته الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 16(1)(أ)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "لا توجد استثناءات منصوص عليها لهذا الأساس", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "for a period enabling the controller to verify the accuracy of the personal data", "target_value": "لا يوجد نص يحدد مدة للتقييد بغرض التحقق من الدقة", "basis": "absent", "verdict": "uncovered", "citation": "Article 16(1)(أ); Article 16(4)"}, {"slot": "consequence", "gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.78, "reasoning_note": "Article 16(1)(أ) directly grants the right to restrict processing when accuracy is contested. However, the UAE text does not specify that the restriction is for a period enabling verification; Article 16(4) only requires notification when lifting restriction, not a verification-linked timeframe. The reviewer’s objection is correct.", "label": "C2", "ru_id": "RU-166", "gdpr_article": 18, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 6, "total": 18}, {"round": 3, "n_queries": 4, "new": 1, "total": 19}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict is based on an incomplete analysis of the provisions.", "counter_evidence": [{"id": "0cc06e3d3b107448da5a", "span": "إجراء المعالجة وفق الغرض والمدة المحددة لها، وفي حال تجاوزت المعالجة المدة المحددة يجب عليه أن يخطر المتحكم بذلك ليأذن له بتمديد هذه المدة أو يصدر إليه التوجيهات المناسبة", "why": "This provision implies a temporal limitation for the processing of personal data."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The UAE law does not explicitly provide for a time limit or a period enabling the controller to verify the accuracy of the personal data, as required by the GDPR.", "counter_evidence": [{"id": "5bedab371a9fc40ba93a", "span": "Article 16(1)(أ)", "why": "The article mentions the right to restrict processing when contesting accuracy, but does not specify a time frame for verification."}, {"id": "5bedab371a9fc40ba93a", "span": "Article 16(4)", "why": "The article mentions notification when lifting the restriction, but does not specify a time frame for verification."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["5bedab371a9fc40ba93a", "c34922f387019af45e42", "0cc06e3d3b107448da5a", "877fafe0080725188d05", "717a67a0d311f88c5fd9", "674524dee00496cb5de7", "9630e6d967b64e07d339", "ebfe638a86be87347658", "80f95c322bb3204c7f65", "3cc10eb2dd7e95bdd0c2", "e05de90f481c9410c6e0", "9c38ab11b550755816f5"], "n_llm_calls": 7, "latency_s": 324.9, "temperature": 0.0, "seed": 20260801, "id": "4e6f58a4a27e20e43c53", "mutation_id": "436c817e9aec0cb02d5b", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["d9a05a425b46428120ee", "04f45ac99bac1acaa486"], "candidates_excluded": [{"id": "3e9d037ae7bf1b125ff2", "reason": "International data transfers; does not allocate or describe supervisory authority competence."}, {"id": "f8c6dae3f69fbe207307", "reason": "Disclosure bases; no rule on supervisory authority competence."}, {"id": "c511c9bf7779067e64f4", "reason": "Lawful bases for collection/processing; does not address who the competent supervisory authority is."}, {"id": "8394f801a0a97e521f68", "reason": "DPO obligations; tangential to authority competence."}, {"id": "4ba7db7571a9e08625c7", "reason": "Limits on disclosure; not about supervisory authority competence."}, {"id": "ce107f77eb9119ba01b0", "reason": "Privacy policy content; unrelated to supervisory authority competence."}, {"id": "04322a32135a68c65bb5", "reason": "Administrative requirement on documenting interests; not about authority competence."}, {"id": "e33bde5f24e463a1e604", "reason": "Certification regime; evidences authority functions but not competence allocation vis-à-vis specific processing scenarios."}, {"id": "3a56eed81feb3655d1d1", "reason": "Public bodies processing for public interest; no allocation of supervisory competence."}, {"id": "fb0cfd03e454392db4cc", "reason": "Legitimate interest conditions; unrelated to supervisory authority competence."}], "target_frame": {"addressee": {"span": "تكون الجهة المختصة الجهة المشرفة على تطبيق أحكام النظام واللوائح.", "article": "Article 30(1)"}, "modality": {"span": "للجهة المختصة ... اتخاذ ما يأتي:", "article": "Article 30(4)"}, "action": {"span": "الجهة المشرفة على تطبيق أحكام النظام واللوائح", "article": "Article 30(1)"}, "scope": {"span": "مراقبة ومتابعة التزام جهات التحكم بأحكام النظام واللوائح", "article": "Article 30(4)(ج)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "supervisory authority of the Member State concerned", "target_value": "تكون الجهة المختصة الجهة المشرفة على تطبيق أحكام النظام واللوائح.", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30(1)"}, {"slot": "modality", "gdpr_value": "power", "target_value": "للجهة المختصة ... اتخاذ ما يأتي:", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30(4)"}, {"slot": "action", "gdpr_value": "act as the competent supervisory authority for the processing operations", "target_value": "الجهة المشرفة على تطبيق أحكام النظام واللوائح", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30(1)"}, {"slot": "scope", "gdpr_value": "the Member State concerned", "target_value": "مراقبة ومتابعة التزام جهات التحكم بأحكام النظام واللوائح", "basis": "conceptual", "verdict": "covered", "citation": "Article 30(4)(ج)"}, {"slot": "condition", "gdpr_value": "processing is carried out by public authorities or private bodies acting on the basis of Article 6(1)(c) or (e)", "target_value": null, "basis": "conceptual", "verdict": "broader", "citation": "Article 30(1)"}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "covered", "confidence": 0.67, "reasoning_note": "Article 30 expressly designates the competent authority as the supervisory authority over application of the law and equips it with supervisory powers, which functionally includes any processing scenarios, including those akin to GDPR Art. 6(1)(c) and (e). The KSA text does not condition competence on specific legal bases; instead, it establishes blanket competence—hence the ‘condition’ slot is broader rather than absent. This addresses the objection: while there is no explicit conditional phrasing, the general supervisory competence necessarily covers the specified cases.", "label": "C1", "ru_id": "RU-014", "gdpr_article": 6, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 10, "total": 22}, {"round": 3, "n_queries": 4, "new": 6, "total": 28}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The KSA jurisdiction does not have a clear counterpart to the GDPR requirement unit [RU-014].", "counter_evidence": [{"id": "d9a05a425b46428120ee", "span": "المادة الثلاثون: 1- تكون الجهة المختصة الجهة المشرفة على تطبيق أحكام النظام واللوائح.", "why": "This provision does not explicitly mention that the competent authority has the power to act as the competent supervisory authority where processing is carried out by public authorities or private bodies acting on the basis of a specific article."}, {"id": "d9a05a425b46428120ee", "span": "4- للجهة المختصة في سبيل مباشرتها مهماتها المتعلقة بالإشراف على تطبيق أحكام النظام واللوائح، اتخاذ ما يأتي:", "why": "This provision mentions that the competent authority has the power to take certain actions, but it does not explicitly state that this power is related to acting as the competent supervisory authority."}], "confidence": 0.8}, {"verdict": "revise", "objection": "Lack of explicit language in KSA jurisdiction's provisions corresponding to GDPR requirement unit [RU-014]", "counter_evidence": [{"id": "d9a05a425b46428120ee", "span": "المادة الثلاثون: 1- تكون الجهة المختصة الجهة المشرفة على تطبيق أحكام النظام واللوائح.", "why": "No explicit mention of competent authority's power to act as supervisory authority for specific processing scenarios"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["d9a05a425b46428120ee", "3e9d037ae7bf1b125ff2", "04f45ac99bac1acaa486", "f8c6dae3f69fbe207307", "c511c9bf7779067e64f4", "8394f801a0a97e521f68", "4ba7db7571a9e08625c7", "ce107f77eb9119ba01b0", "04322a32135a68c65bb5", "e33bde5f24e463a1e604", "3a56eed81feb3655d1d1", "fb0cfd03e454392db4cc"], "n_llm_calls": 7, "latency_s": 358.49, "temperature": 0.0, "seed": 20260801, "id": "34e8c43bd39f124f3575", "mutation_id": "bac6d8e815309bbc320f", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
{"candidates_selected": ["5df1b1c5bce760454262", "33d22a1a65039b5be3f9", "1fc3063dbbcf8d500da0", "a7597ada8323b333cc94", "14105f25ea49e7794aaa"], "candidates_excluded": [{"id": "37d872c258760ad10ae9", "reason": "Addresses anonymisation (إخفاء الهوية) rather than pseudonymisation (الترميز) and does not provide a permission to include pseudonymisation among measures."}, {"id": "557230873031d6e5cb2c", "reason": "Marketing context; no relevance to pseudonymisation for research/archiving/statistical safeguards."}, {"id": "f10a3fa820a149065de0", "reason": "Audit and inspection framework; does not address inclusion of pseudonymisation among safeguards."}, {"id": "c95a0b593cc554df0eae", "reason": "Record-keeping of processing activities; does not speak to permission or use of pseudonymisation as a safeguard."}, {"id": "e32b4ffefbc31a6a5072", "reason": "Confidentiality duty; not about technical/organisational safeguards such as pseudonymisation."}, {"id": "8394f801a0a97e521f68", "reason": "DPO appointment and duties; no rule on including pseudonymisation among safeguards."}, {"id": "08b4c74d887bbe3b2039", "reason": "Credit data special rules; no rule germane to pseudonymisation for research/statistics safeguards."}], "target_frame": {"addressee": {"span": "على جهة التحكم عند جمع أو معالجة البيانات الشخصية لأغراض علمية أو بحثية أو إحصائية دون موافقة صاحبها الالتزام بالآتي:", "article": "Article 30 (chapeau)"}, "modality": {"span": "على جهة التحكم ... الالتزام بالآتي:", "article": "Article 30 (chapeau)"}, "action": {"span": "ترميز البيانات الشخصية التي تجري معالجتها.", "article": "Article 30(3)"}, "scope": {"span": "اتخاذ التدابير اللازمة لضمان جمع البيانات الشخصية وفق الحد الأدنى اللازم لتحقيق الأغراض المحددة.", "article": "Article 30(2)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controllers", "target_value": "جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30 (chapeau): \"على جهة التحكم ...\""}, {"slot": "modality", "gdpr_value": "permission", "target_value": "obligation (\"على جهة التحكم ... الالتزام بالآتي\") to apply pseudonymisation in the specified context", "basis": "direct_textual", "verdict": "partial", "citation": "Article 30 (chapeau) and 30(3)"}, {"slot": "action", "gdpr_value": "include pseudonymisation among the technical and organisational measures", "target_value": "\"ترميز البيانات الشخصية التي تجري معالجتها\" (pseudonymisation), with \"الترميز\" defined as a technical/administrative safeguard", "basis": "distributed", "verdict": "covered", "citation": "Article 30(3); Article 1(7) (definition of الترميز)"}, {"slot": "scope", "gdpr_value": "measures implemented under the safeguards to ensure data minimisation for archiving in the public interest, scientific or historical research, or statistical purposes", "target_value": "Data minimisation safeguards in research/scientific/statistical processing without consent (\"وفق الحد الأدنى اللازم\")", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 30 (chapeau) and 30(2)"}, {"slot": "condition", "gdpr_value": "provided that the archiving/research/statistical purposes can be fulfilled in that manner", "target_value": "No feasibility condition; instead a categorical requirement in the specified context", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": "No exception stated", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "Not specified", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "Not specified", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.72, "reasoning_note": "KSA Article 30 mandates pseudonymisation (الترميز) for scientific/research/statistical processing without consent and embeds a data-minimisation safeguard, so the action and addressee are covered. However, the GDPR’s permissive modality and feasibility condition are not mirrored; the KSA text imposes an obligation and lacks an explicit permission framing, and it does not cover archiving in the public interest.", "label": "C4", "ru_id": "RU-966", "gdpr_article": 89, "jurisdiction": "KSA", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 17, "total": 29}, {"round": 3, "n_queries": 4, "new": 6, "total": 35}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's claim that there is no counterpart for the condition is not entirely accurate.", "counter_evidence": [{"id": "5df1b1c5bce760454262", "span": "تحديد الأغراض العلمية أو البحثية أو الإحصائية بشكل واضح ودقيق في سجلات أنشطة معالجة البيانات الشخصية", "why": "This provision implies that the processing of personal data for scientific, research, or statistical purposes is allowed."}, {"id": "5df1b1c5bce760454262", "span": "اتخاذ التدابير اللازمة لضمان جمع البيانات الشخصية وفق الحد الأدنى اللازم لتحقيق الأغراض المحددة", "why": "This provision suggests that the collection of personal data for scientific, research, or statistical purposes should be limited to the minimum necessary."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict does not fully address whether the KSA jurisdiction explicitly permits pseudonymisation as part of the technical and organisational measures for the specified purposes, potentially overlooking the distinction between a mandate and a permission.", "counter_evidence": [{"id": "5df1b1c5bce760454262", "span": "Article 30(3)", "why": "Mandates pseudonymisation of personal data for scientific, research, or statistical purposes but does not explicitly frame this as a permission for controllers."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["a7597ada8323b333cc94", "37d872c258760ad10ae9", "14105f25ea49e7794aaa", "557230873031d6e5cb2c", "f10a3fa820a149065de0", "33d22a1a65039b5be3f9", "c95a0b593cc554df0eae", "5df1b1c5bce760454262", "e32b4ffefbc31a6a5072", "1fc3063dbbcf8d500da0", "8394f801a0a97e521f68", "08b4c74d887bbe3b2039"], "n_llm_calls": 7, "latency_s": 408.07, "temperature": 0.0, "seed": 20260801, "id": "9cb3eec19fe19bb98ff1", "mutation_id": "df572ede549ea253fdf6", "mtype": "slot_drop", "required": "C2", "condition": "mutation"}
