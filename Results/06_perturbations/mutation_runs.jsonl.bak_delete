{"candidates_selected": ["93f989531fe30cac1ed5", "b157dcadab6a3e8daf5f", "865fbf2c2a6ca6fcb814"], "candidates_excluded": [{"id": "ae67f8fe376642167563", "reason": "Regulates authorization for processing special categories; does not address erasure or grounds to refuse erasure."}, {"id": "40626451a5025d77cff5", "reason": "Controller notification duties; not about erasure or exceptions."}, {"id": "5eb7d76c67651fbc4fcc", "reason": "Children’s data consent; not about erasure or exceptions."}, {"id": "db6e2be94f2388e169a8", "reason": "Allows refusal of requests when repetitive or unduly burdensome; not the grounds enumerated in RU-029 (expression, legal obligation/public task, public health, archiving/research, legal claims)."}, {"id": "823830174d241884bd73", "reason": "Complaint mechanism; not about erasure or exceptions."}, {"id": "de8d26aee9201d58a52b", "reason": "Permit cancellation rules; unrelated to erasure exceptions."}, {"id": "4f65c1f467f9e61b2f46", "reason": "General scope clause; does not create a permission to refuse erasure (beyond overall applicability)."}, {"id": "a2a61b7c9316716b7e74", "reason": "Disclosure limits for special data; not about erasure exceptions."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Policy transparency obligation; not about erasure or exceptions."}], "target_frame": {"addressee": {"span": "وللمفوَّض بتحديد مقاصد ووسائل التعامل مع المعطيات", "article": "Article 18"}, "modality": {"span": "وللمفوَّض ... عند الاقتضاء، عدم قبول التماس المالك", "article": "Article 18"}, "action": {"span": "عدم قبول التماس المالك", "article": "Article 18"}, "scope": {"span": null, "article": null}, "condition": {"span": "1) للإيفاء بواجب نظامي محمول على الجهة المقرِّرة استناداً إلى تشريع أو أمر أو منطوق صادر من محكمة؛ 2) لكون خصومة ماثلة تربط الجهة المقرِّرة بمالك المعطيات الفردية؛ 3) ما لم تكن تلك المعالجة ضرورية لأغراض الحفظ والتوثيق الوطنية؛ فضلاً عن استثناءات نطاق التطبيق مثل: تنفيذ وحدات الجهاز الإداري للدولة لاختصاصاتها المقررة قانوناً، وتنفيذ التزام قانوني على عاتق المتحكم، وأغراض البحوث التاريخية أو الإحصائية أو العلمية أو الأدبية أو الاقتصادية من قبل الجهات المصرح لها شريطة عدم استخدام أي دلالة تُنسب لشخص معرف أو قابل للتعريف.", "article": "Articles 18, 11, 3"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller", "target_value": "وللمفوَّض بتحديد مقاصد ووسائل التعامل مع المعطيات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 18"}, {"slot": "modality", "gdpr_value": "permission", "target_value": "وللمفوَّض ... عند الاقتضاء، عدم قبول التماس المالك", "basis": "direct_textual", "verdict": "covered", "citation": "Article 18"}, {"slot": "action", "gdpr_value": "refrain from erasing personal data under paragraph 1", "target_value": "عدم قبول التماس المالك [لحذف/إزالة المعطيات]", "basis": "direct_textual", "verdict": "covered", "citation": "Article 18"}, {"slot": "scope", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "condition", "gdpr_value": "(a) freedom of expression/information; (b) legal obligation or public task/official authority; (c) public health under safeguards; (d) archiving in the public interest, scientific or historical research, or statistical purposes under Art. 89(1), where erasure would impair objectives; (e) establishment, exercise or defence of legal claims", "target_value": "يجوز الرفض عند: للإيفاء بواجب نظامي (تشريع/حكم/قرار قضائي)؛ وجود خصومة ماثلة؛ كون المعالجة ضرورية لأغراض الحفظ والتوثيق الوطنية؛ مع استثناءات نطاق قانونية لجهات عامة/التزام قانوني/بحوث تاريخية أو إحصائية أو علمية مشروطة بعدم نسب البيانات لمعرف.", "basis": "distributed", "verdict": "partial", "citation": "Articles 18, 11, 3"}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.66, "reasoning_note": "OMN law permits refusing erasure to comply with a legal obligation and for ongoing litigation (Article 18), and limits the erasure right where processing is necessary for national preservation/documentation (Article 11), with certain scope carve-outs for public tasks and some research (Article 3). It does not expressly cover freedom of expression/information or public health, and its research/archiving grounds are narrower (national preservation; authorized research with de-identified outputs). Accordingly, coverage is partial.", "label": "C2", "ru_id": "RU-029", "gdpr_article": 8, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 12, "total": 24}, {"round": 3, "n_queries": 4, "new": 7, "total": 31}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The condition slot verdict is not fully supported by the citations.", "counter_evidence": [{"id": "93f989531fe30cac1ed5", "span": "Article 18 (items 1–2)", "why": "The article only mentions refusal allowed for fulfilling a statutory duty or court order, and pending litigation with the data subject, but does not explicitly mention the grounds listed in the GDPR requirement unit [RU-029]."}, {"id": "b157dcadab6a3e8daf5f", "span": "Article 11 (هـ)", "why": "The article only mentions the right to request erasure of personal data, but only if the processing is not necessary for national preservation or documentation, and does not explicitly mention the grounds listed in the GDPR requirement unit [RU-029]."}, {"id": "865fbf2c2a6ca6fcb814", "span": "Article 3 (ب), (ط)", "why": "The article only mentions exceptions for processing personal data for public-interest purposes, including historical, statistical, or scientific research, but does not explicitly mention the grounds listed in the GDPR requirement unit [RU-029]."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The OMN jurisdiction does not fully cover the conditions listed in the GDPR requirement unit [RU-029], particularly with regards to freedom of expression or information, public health, archiving, research, or statistics.", "counter_evidence": [{"id": "93f989531fe30cac1ed5", "span": "Article 18 items 1-2", "why": "The provision does not explicitly mention freedom of expression or information, public health, archiving, research, or statistics as grounds for refusing the erasure request."}, {"id": "b157dcadab6a3e8daf5f", "span": "Article 11", "why": "The provision only mentions national preservation or documentation as a ground for refusing the erasure request, but does not cover other conditions listed in the GDPR requirement unit [RU-029]."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["865fbf2c2a6ca6fcb814", "ae67f8fe376642167563", "93f989531fe30cac1ed5", "40626451a5025d77cff5", "5eb7d76c67651fbc4fcc", "db6e2be94f2388e169a8", "823830174d241884bd73", "b157dcadab6a3e8daf5f", "de8d26aee9201d58a52b", "4f65c1f467f9e61b2f46", "a2a61b7c9316716b7e74", "bb26cffae1f1c0beb85d"], "n_llm_calls": 7, "latency_s": 422.98, "temperature": 0.0, "seed": 20260801, "id": "94e0becc63fafa0b179e", "mutation_id": "230f47b0691d6c742a84", "mtype": "paraphrase", "required": "C1", "condition": "mutation"}
{"candidates_selected": ["5bedab371a9fc40ba93a"], "candidates_excluded": [{"id": "c34922f387019af45e42", "reason": "Automated decision-making; not a right to restrict processing when processing is unlawful."}, {"id": "877fafe0080725188d05", "reason": "Erasure/correction right; does not establish the right to restriction of processing in lieu of erasure."}, {"id": "4a1a7742c2a181be0640", "reason": "Objection/stop processing for specific purposes (e.g., marketing, statistics); not a general restriction right tied to unlawfulness."}, {"id": "717a67a0d311f88c5fd9", "reason": "Right to information (including about procedures to restrict); procedural transparency, not the substantive right to restriction."}, {"id": "ebfe638a86be87347658", "reason": "Data portability; unrelated to restriction of processing."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Scope of the law; no right to restriction."}, {"id": "5d949837d7aab073cd67", "reason": "Complaint mechanism; not the right to restriction."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment; unrelated to restriction right."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "Processing principles; does not grant a data-subject right to restrict processing."}, {"id": "9c38ab11b550755816f5", "reason": "DPO duties/communications; not the right to restriction."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification; unrelated to restriction right."}], "target_frame": {"addressee": {"span": "يثبت لموضوع المعطيات", "article": "Article 16(1)"}, "modality": {"span": "يثبت لموضوع المعطيات تمكين الجهة المسؤولة", "article": "Article 16(1)"}, "action": {"span": "تمكين الجهة المسؤولة من حصر وتعليق التعامل", "article": "Article 16(1)"}, "scope": {"span": "التعاطي مع معطياته الذاتية", "article": "Article 16(1)(ب)"}, "condition": {"span": "عند تحقق أيٍ من الأوضاع التالية: ... ج. تكون العمليات قد جرت على خلاف مقتضيات هذا الصك التشريعي والأنظمة النافذة.", "article": "Article 16(1), 16(1)(ج)"}, "exception": {"span": "دون مساس بما سبق في الفقرة (1) من هذا الموضع، يجوز للجهة المسؤولة مواصلة مباشرة التعامل ... في أيٍ من الصور التالية: أ. عندما يكون التعامل محصوراً في حفظ المعطيات الذاتية. ب. حين يكون لازماً اتخاذ أي خطوات لطرح ادعاء أو خصومة نظامية أو لدفعهما أو لما يتصل بسير المرافعات. ج. كلما كان لازماً صون مصالح الآخرين طبقاً للقواعد النافذة. د. عندما يكون لازماً خدمة الصالح العام.", "article": "Article 16(3)(أ)-(د)"}, "temporal": {"span": null, "article": null}, "consequence": {"span": "وعلى أي حال، يتعيّن على الجهة المسؤولة، عند إزالة التعليق المبيَّن في هذا الموضع، إعلام موضوع المعطيات بذلك.", "article": "Article 16(4)"}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "data subject", "target": "موضوع المعطيات", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 16(1)"}, {"slot": "modality", "gdpr": "right", "target": "يثبت لموضوع المعطيات ...", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 16(1)"}, {"slot": "action", "gdpr": "obtain from the controller the restriction of processing", "target": "تمكين الجهة المسؤولة من حصر وتعليق التعامل", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 16(1)"}, {"slot": "scope", "gdpr": "processing of the data subject's personal data", "target": "التعاطي مع معطياته الذاتية", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 16(1)(ب)"}, {"slot": "condition", "gdpr": "the processing is unlawful and the data subject opposes erasure and requests restriction instead", "target": "يمنح الحق بتقييد/تعليق المعالجة إذا كانت العمليات قد جرت على خلاف مقتضيات هذا الصك التشريعي (من دون اشتراط معارضة المحو).", "basis": "direct_textual", "verdict": "broader", "citation": "Art. 16(1)(ج)"}, {"slot": "exception", "gdpr": "None", "target": "يجوز مواصلة المعالجة في حدود: الحفظ فقط؛ الضرورة للدعاوى؛ صون مصالح الآخرين؛ خدمة الصالح العام.", "basis": "direct_textual", "verdict": "narrower", "citation": "Art. 16(3)(أ)-(د)"}, {"slot": "temporal", "gdpr": "None", "target": "No express temporal limit stated for the unlawful-processing ground.", "basis": "absent", "verdict": "covered", "citation": "Art. 16(1)(ج)"}, {"slot": "consequence", "gdpr": "None", "target": "إعلام موضوع المعطيات عند إزالة التعليق.", "basis": "direct_textual", "verdict": "broader", "citation": "Art. 16(4)"}], "holistic_label": "partial", "confidence": 0.72, "reasoning_note": "Article 16(1)(ج) directly covers the RU-167 core scenario by granting a right to restrict when processing is unlawful, without conditioning it on the data subject’s opposition to erasure; hence we mark the condition as broader. Article 16(3) introduces carve-outs allowing limited continued processing, which narrows the effect relative to the RU-167 unit that states no exceptions. Accordingly, overall coverage is partial: the unlawful-processing trigger is covered, but with additional exceptions not present in RU-167.", "label": "C1", "ru_id": "RU-167", "gdpr_article": 18, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 5, "total": 17}, {"round": 3, "n_queries": 4, "new": 2, "total": 19}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The UAE jurisdiction does not provide a complete counterpart to the GDPR requirement unit [RU-167], specifically with regards to the right to restrict processing when the processing is unlawful and the data subject opposes erasure.", "counter_evidence": [{"id": "5bedab371a9fc40ba93a", "span": "Article 16(1)", "why": "Does not explicitly provide a right to restrict processing when the processing is unlawful."}, {"id": "5bedab371a9fc40ba93a", "span": "Article 16(1)(ج)", "why": "Does not explicitly provide a right to restrict processing when the processing is unlawful."}, {"id": "877fafe0080725188d05", "span": "Article 15", "why": "Does not explicitly address the situation where the data subject opposes erasure and requests restriction instead."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The conditions and exceptions mentioned in Article 16 of the UAE jurisdiction do not exactly match the conditions mentioned in the GDPR requirement unit [RU-167].", "counter_evidence": [{"id": "5bedab371a9fc40ba93a", "span": "Article 16(1)(ج)", "why": "The condition mentioned in this article is broader than the condition in the GDPR requirement unit [RU-167]."}, {"id": "5bedab371a9fc40ba93a", "span": "Article 16(3)", "why": "The exceptions mentioned in this article may not be entirely consistent with the GDPR requirement unit [RU-167]."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["c34922f387019af45e42", "5bedab371a9fc40ba93a", "877fafe0080725188d05", "4a1a7742c2a181be0640", "717a67a0d311f88c5fd9", "ebfe638a86be87347658", "743bfdd72ed773ff5ba9", "5d949837d7aab073cd67", "9630e6d967b64e07d339", "3cc10eb2dd7e95bdd0c2", "9c38ab11b550755816f5", "e05de90f481c9410c6e0"], "n_llm_calls": 7, "latency_s": 371.75, "temperature": 0.0, "seed": 20260801, "id": "d44446905212edb73e1f", "mutation_id": "fda522e90c93e2cf03b6", "mtype": "paraphrase", "required": "C1", "condition": "mutation"}
{"candidates_selected": ["6b500d26673394f3d7e6", "93fde8c87940ae524c86", "1fdf77ac047fc519d30b"], "candidates_excluded": [{"id": "98fa9fe9b0650c71a971", "reason": "Addresses objection to direct marketing, not rectification."}, {"id": "5a79146e04b73c99685c", "reason": "Concerns access/information about processing, not rectification."}, {"id": "5bd7541a2690632a7c77", "reason": "Defines consent; unrelated to rectification right."}, {"id": "6a403e591ecc2a5638fc", "reason": "Procedural enforcement re DPO; not about rectification."}, {"id": "4f0c7ea198f3c5b3627c", "reason": "International transfer contractual clauses; not a general rectification right."}, {"id": "14fe9b230c7ba11703d5", "reason": "Criminal penalties; not the substance of a rectification right."}, {"id": "74358e437cd9e85fdabb", "reason": "DPO duties; not the substance of a rectification right."}, {"id": "c9145cc9a91d8ff7530c", "reason": "Liability of DPO entities; not about rectification."}, {"id": "231a37f671238dbf7112", "reason": "Definitions for a decision on DPOs; not rectification."}], "target_frame": {"addressee": {"span": "الشخص المعني بالمعطيات", "article": "Article 23(1)"}, "modality": {"span": "بيان حق صاحب البيانات ... بحقِّه في أن يتم تصحيحها", "article": "Article 17(1)(ج)(3)"}, "action": {"span": "إمكانية تقديم التماس إلى المتحكم بالمعطيات ... يلتمس فيه تصويباً ... لمعطياته ذات الطابع الفردي", "article": "Article 23(1)"}, "scope": {"span": "خصوصاً إذا كانت مغلوطة أو مبتورة أو قديمة", "article": "Article 23(1)"}, "condition": {"span": "مرفقاً بما يعرّف بشخصه ... متى كان تداولها جارياً على خلاف مقتضيات التشريع", "article": "Article 23(1)"}, "exception": {"span": "ما لم يتوافر لديه مبرر نظامي وجيه", "article": "Article 23(1)"}, "temporal": {"span": "خلال 10 مواعيد دوام من يوم وروده", "article": "Article 23(1)"}, "consequence": {"span": "إبلاغ أي جهة أُخرى سبق أن نُقلت إليها تلك المعطيات بالإجراءات التصويبية ... في غضون 15 نهاراً من تاريخ امتثاله بصورة كاملة أو على نحو غير كامل", "article": "Article 23(5)"}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data subject", "target_value": "الشخص المعني بالمعطيات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(1)"}, {"slot": "modality", "gdpr_value": "right", "target_value": "بيان حق صاحب البيانات ... بحقِّه في أن يتم تصحيحها; تُتاح ... إمكانية تقديم التماس", "basis": "distributed", "verdict": "covered", "citation": "Article 17(1)(ج)(3); Article 23(1)"}, {"slot": "action", "gdpr_value": "obtain from the controller the rectification", "target_value": "يلتمس فيه تصويباً ... ويلتزم المتحكم ... بالقبول; امتثاله بصورة كاملة أو على نحو غير كامل لالتماس", "basis": "distributed", "verdict": "covered", "citation": "Article 23(1), Article 23(5)"}, {"slot": "scope", "gdpr_value": "inaccurate personal data concerning the data subject", "target_value": "خصوصاً إذا كانت مغلوطة أو مبتورة أو قديمة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(1)"}, {"slot": "condition", "gdpr_value": "None", "target_value": "مرفقاً بما يعرّف بشخصه ... متى كان تداولها جارياً على خلاف مقتضيات التشريع", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 23(1)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "ما لم يتوافر لديه مبرر نظامي وجيه", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 23(1)"}, {"slot": "temporal", "gdpr_value": "without undue delay", "target_value": "خلال 10 مواعيد دوام من يوم وروده (وكذلك إخطار خلال عشرة أيام عمل وفق إحالة المادة 23(4) إلى المادة 20(2))", "basis": "distributed", "verdict": "weaker_modality", "citation": "Article 23(1); Article 23(4) read with Article 20(2)"}, {"slot": "consequence", "gdpr_value": "None", "target_value": "إبلاغ أي جهة أُخرى ... بالإجراءات التصويبية ... في غضون 15 نهاراً", "basis": "direct_textual", "verdict": "broader", "citation": "Article 23(5)"}], "holistic_label": "partial", "confidence": 0.74, "reasoning_note": "Bahrain’s Article 23 establishes a rectification mechanism for inaccurate data and obliges the controller to comply, but it adds conditions and a refusal ground that narrow the right compared to GDPR. On timing, it sets a fixed 10 working-day response period rather than the GDPR’s flexible “without undue delay,” so the temporal protection is weaker. The texts nonetheless functionally recognize a right to rectification of inaccurate personal data.", "label": "C1", "ru_id": "RU-140", "gdpr_article": 16, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 11, "total": 23}, {"round": 3, "n_queries": 4, "new": 5, "total": 28}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The right to rectification is not absolute and has limitations and exceptions.", "counter_evidence": [{"id": "Article 23(2)", "span": "لا تُطبَّق الفقرة الأولى من هذا النص على أي منظومة قيد مفتوحة للعموم، إذا كان التشريع الذي أنشأها يقرّر ترتيبات مخصوصة للتصويب أو التقييد أو المحو.", "why": "This provision limits the right to rectification to cases where the data is not part of a public record or database with specific regulations."}, {"id": "Article 23(1)", "span": "متى كان تداولها جارياً على خلاف مقتضيات التشريع", "why": "This provision limits the right to rectification to cases where the data is processed in violation of the law."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The target jurisdiction's specific timeframe for rectification might not fully align with the GDPR's 'without undue delay' requirement.", "counter_evidence": [{"id": "Article 23(1)", "span": "within 10 working days", "why": "Specifies a timeframe that might not always ensure prompt rectification as intended by 'without undue delay'."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["6b500d26673394f3d7e6", "98fa9fe9b0650c71a971", "5a79146e04b73c99685c", "93fde8c87940ae524c86", "5bd7541a2690632a7c77", "6a403e591ecc2a5638fc", "4f0c7ea198f3c5b3627c", "14fe9b230c7ba11703d5", "74358e437cd9e85fdabb", "231a37f671238dbf7112", "1fdf77ac047fc519d30b", "c9145cc9a91d8ff7530c"], "n_llm_calls": 7, "latency_s": 430.16, "temperature": 0.0, "seed": 20260801, "id": "42f11debcb59d4fb9117", "mutation_id": "8d1ba59941970afe60ba", "mtype": "paraphrase", "required": "C1", "condition": "mutation"}
{"candidates_selected": ["c95a0b593cc554df0eae"], "candidates_excluded": [{"id": "3a56eed81feb3655d1d1", "reason": "Concerns public-interest processing by public entities; does not address providing DPO contact details to data subjects at collection."}, {"id": "f8c6dae3f69fbe207307", "reason": "Regulates disclosure conditions; unrelated to informing data subjects of DPO contact details."}, {"id": "c95a0b593cc554df0eae-Article4(3)-(5)", "reason": "Subsequent paragraphs address indirect collection and special cases; core DPO-contact duty at direct collection is already captured in 4(1)(b)."}, {"id": "7ddbf4e54143664b8b8b", "reason": "Sets rules for disclosure; no requirement to provide DPO contact details to data subjects."}, {"id": "ce107f77eb9119ba01b0", "reason": "Requires a privacy policy and its contents; does not mandate providing DPO contact details to the data subject at the time of collection."}, {"id": "ea8306cd18f9261f6413", "reason": "Transparency at direct collection but does not include DPO contact details among the required elements."}, {"id": "0922609ffbfd96a70f90", "reason": "Right to erasure; not about DPO contact details or transparency at collection."}, {"id": "c511c9bf7779067e64f4", "reason": "Specifies when collection from the subject is required/excepted; does not impose DPO contact-detail disclosure."}, {"id": "557230873031d6e5cb2c", "reason": "Marketing processing conditions; unrelated to DPO contact-details disclosure."}, {"id": "04322a32135a68c65bb5", "reason": "Processing for legitimate interest logistics; no requirement to provide DPO contact details."}, {"id": "90da7bc2380e8f3f2fb8", "reason": "Response timelines for data subject requests; unrelated to DPO contact-details disclosure."}, {"id": "c95a0b593cc554df0eae-Article4(1)(a),(c)-(g)", "reason": "Other sub-items list different information elements; only 4(1)(b) specifically concerns DPO contact details."}, {"id": "c95a0b593cc554df0eae-Article4(1) chapeau (non-temporal parts)", "reason": "Chapeau sets general notification duty; action-specific DPO contact is captured under 4(1)(b)."}, {"id": "c95a0b593cc554df0eae-Article4(2) second limb (legal conflict)", "reason": "Relevant only as an exception modifier; included in slot analysis but not a separate operative counterpart to the action."}, {"id": "c95a0b593cc554df0eae-Article4(2) first limb (already has info)", "reason": "Exception mirrors GDPR but analyzed within the exception slot; not a separate operative provision."}, {"id": "c95a0b593cc554df0eae-Article4 temporal phrase", "reason": "Temporal element considered in slot analysis; no separate provision."}, {"id": "c95a0b593cc554df0eae-Definitions (implicit)", "reason": "No explicit separate definitions provided; mapping to 'controller' handled conceptually."}, {"id": "c95a0b593cc554df0eae-Heading", "reason": "Not an operative provision."}, {"id": "c95a0b593cc554df0eae-Article4(1) preamble duplication", "reason": "Redundant to selected chapeau; core elements already captured."}, {"id": "c95a0b593cc554df0eae-Article4(1) list structure", "reason": "Structural only; specific sub-item (b) is the operative action for DPO contact."}], "target_frame": {"addressee": {"span": "الكيان المُقرِّر", "article": "Article 4(1)"}, "modality": {"span": "ملزم باعتماد الوسائل الكفيلة بإخطار موضوع المعطيات", "article": "Article 4(1)"}, "action": {"span": "سبل الارتباط بموفد صون المعطيات الذاتية —إن وُجد— المعيَّن لدى الكيان المُقرِّر.", "article": "Article 4(1)(ب)"}, "scope": {"span": null, "article": null}, "condition": {"span": "إذا استُقيت المعطيات الذاتية من موضوعها دون توسط", "article": "Article 4(1)"}, "exception": {"span": "لا تسري أحكام البند (1) إذا كانت العناصر المبينة في البنود الفرعية (أ) إلى (ز) متاحة سابقاً لموضوع المعطيات، أو إذا كان الإفصاح عنها يتعارض مع أي تشريع نافذ محلياً.", "article": "Article 4(2)"}, "temporal": {"span": "قبيل الاستقاء أو في حينه", "article": "Article 4(1)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "الكيان المُقرِّر", "basis": "conceptual", "verdict": "covered", "citation": "Article 4(1)", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "ملزم باعتماد الوسائل الكفيلة بإخطار موضوع المعطيات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1)", "slot": "modality"}, {"gdpr_value": "provide the data subject with the contact details of the data protection officer", "target_value": "سبل الارتباط بموفد صون المعطيات الذاتية —إن وُجد—", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1)(ب)", "slot": "action"}, {"gdpr_value": "None", "target_value": "No special scope stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "scope"}, {"gdpr_value": "where personal data are collected from the data subject and provision is applicable (DPO appointed)", "target_value": "إذا استُقيت المعطيات الذاتية من موضوعها دون توسط؛ وشرط \"إن وُجد\" بالنسبة لموفد صون المعطيات", "basis": "distributed", "verdict": "covered", "citation": "Article 4(1), 4(1)(ب)", "slot": "condition"}, {"gdpr_value": "unless and insofar as the data subject already has the information", "target_value": "استثناء إذا كانت المعلومات متاحة سابقاً لموضوع المعطيات، وكذلك إذا تعارض الإفصاح مع تشريع نافذ محلياً", "basis": "direct_textual", "verdict": "broader", "citation": "Article 4(2)", "slot": "exception"}, {"gdpr_value": "at the time when personal data are obtained", "target_value": "قبيل الاستقاء أو في حينه", "basis": "direct_textual", "verdict": "broader", "citation": "Article 4(1)", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.73, "reasoning_note": "Article 4(1)(b) directly requires providing the means to contact the DPO (if any) when collecting directly from the data subject, aligning with the core GDPR action. However, the KSA text allows providing this information before or at the time of collection and adds an extra exception for conflicts with local law, making the temporal and exception slots broader than GDPR. These differences are reflected in the slot verdicts, yielding an overall partial equivalence.", "label": "C1", "ru_id": "RU-058", "gdpr_article": 13, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 8, "total": 20}, {"round": 3, "n_queries": 4, "new": 4, "total": 24}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The KSA law does not explicitly require the controller to provide the contact details of the data protection officer at the time of obtaining personal data.", "counter_evidence": [{"id": "c95a0b593cc554df0eae", "span": "Article 4(1)", "why": "This provision requires the controller to inform the data subject of the contact details of the data protection officer, but does not specify the timing."}, {"id": "ea8306cd18f9261f6413", "span": "Article 13", "why": "This provision requires the controller to inform the data subject of certain information, but does not explicitly mention the contact details of the data protection officer."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The KSA provisions have subtle differences in wording and exceptions that could affect the overall equivalence with the GDPR requirement.", "counter_evidence": [{"id": "c95a0b593cc554df0eae", "span": "Article 4(1)", "why": "The provision requires the controller to provide information before or at the time of collection, whereas the GDPR requirement specifies 'at the time when personal data are obtained'."}, {"id": "c95a0b593cc554df0eae", "span": "Article 4(2)", "why": "The provision provides an exception to the requirement that is broader than the GDPR exemption."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["3a56eed81feb3655d1d1", "f8c6dae3f69fbe207307", "c95a0b593cc554df0eae", "7ddbf4e54143664b8b8b", "ce107f77eb9119ba01b0", "9cfd6fbae8182dbc0028", "ea8306cd18f9261f6413", "0922609ffbfd96a70f90", "c511c9bf7779067e64f4", "557230873031d6e5cb2c", "04322a32135a68c65bb5", "90da7bc2380e8f3f2fb8"], "n_llm_calls": 7, "latency_s": 400.23, "temperature": 0.0, "seed": 20260801, "id": "89d6bdad4508316da177", "mutation_id": "290fe8265debe29924a2", "mtype": "paraphrase", "required": "C1", "condition": "mutation"}
{"candidates_selected": ["5a79146e04b73c99685c", "93fde8c87940ae524c86"], "candidates_excluded": [{"id": "98fa9fe9b0650c71a971", "reason": "Regulates the right to object to direct marketing; does not establish a general access right."}, {"id": "34ea02d93464e8e2fa05", "reason": "Defines Privacy by Design; no operative rule on data-subject access."}, {"id": "9cd82ef51e2d36369a4f", "reason": "Journalism/arts exemption; not about data-subject access."}, {"id": "762372b7329c44286e43", "reason": "Lawful bases for processing; not about access."}, {"id": "552b4ae6d34230dd6e1f", "reason": "General definitions; not needed to ground the access right itself."}, {"id": "4f0c7ea198f3c5b3627c", "reason": "Transfer-by-contract clause requiring access enablement in cross-border contexts; not the general access right."}, {"id": "6b500d26673394f3d7e6", "reason": "Rectification/blocking/erasure rights; not access."}, {"id": "a59ada1e8ce6b7ede2c3", "reason": "Cross-border transfer conditions; unrelated to access."}, {"id": "7448a27e7806f2c0c143", "reason": "Data quality principles; not about access."}, {"id": "3d71a23a91370cadf799", "reason": "Criminal data processing; no data-subject access rule."}], "target_frame": {"addressee": {"span": "المعنيّ بالمعطيات", "article": "Article 18 (title, 18(1))"}, "modality": {"span": "بيان حق صاحب البيانات في أن يتم إخطاره، إذا ما طلب ذلك، بالبيانات الخاصة به كاملة", "article": "Article 17(1)(ج)(3)"}, "action": {"span": "المعطيات محل التشغيل على نحو غير منقوص", "article": "Article 18(1)(أ)"}, "scope": {"span": "مُعطيات ذات طبيعة فردية تخصّه", "article": "Article 18 (title); 18(1)"}, "condition": {"span": "متى قُدِّم إليه ملتمس من المعنيّ بالمعطيات مرفق بما يبرهن شخصيته، أن يبلّغ ... عمّا إذا كان المتحكِّم يُجري عمليات على مُعطيات ...؛ وإن وُجدت صورة من صور التشغيل لتلك المعطيات، وجب ... إبلاغ المعنيّ بالمعطيات", "article": "Article 18(1)"}, "exception": {"span": "للمتحكِّم الامتناع عن الاستجابة للملتمس ... متى شابه نقص ولم يُصحَّح ...؛ وله أيضاً ردُّه إذا انطوى على إساءة استعمال من المعنيّ بالمعطيات لسلطته في الاطلاع", "article": "Article 18(3)"}, "temporal": {"span": "في سقف زمني لا يجاوز 15 من أيام الدوام اعتباراً من لحظة التقديم", "article": "Article 18(1)"}, "consequence": {"span": "عند ردّ الملتمس ... أو مضي الأجل المحدد للجواب عليه دون أن يتلقى المعنيّ بالمعطيات أي تبليغ ... يكون للمعنيّ بالمعطيات رفع تظلّم لدى السلطة الرقابية على المتحكِّم", "article": "Article 18(4)"}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "المعنيّ بالمعطيات (person concerned by the data)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 18 (title, 18(1))", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "Explicit statement of a right to be notified of one’s data in full upon request, plus a correlative duty on the controller to respond", "basis": "distributed", "verdict": "covered", "citation": "Article 17(1)(ج)(3); Article 18(1)", "slot": "modality"}, {"gdpr_value": "obtain access to personal data concerning the data subject", "target_value": "Controller must inform the data subject and provide “the data being processed in an unabridged manner”", "basis": "direct_textual", "verdict": "covered", "citation": "Article 18(1)(أ)", "slot": "action"}, {"gdpr_value": "personal data concerning the data subject", "target_value": "معطيات/بيانات ذات طبيعة فردية تخصّ المعنيّ بالمعطيات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 18 (title, 18(1))", "slot": "scope"}, {"gdpr_value": "where such personal data are being processed", "target_value": "Upon a request with proof of identity; controller to state whether processing is occurring and, if so, provide the data", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 18(1)", "slot": "condition"}, {"gdpr_value": "None", "target_value": "Controller may refuse if the request is deficient and not corrected within the time allowed, or if the request constitutes an abuse of the right", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 18(3) (with related notice opportunity in 18(2))", "slot": "exception"}, {"gdpr_value": "None", "target_value": "Response deadline of no more than 15 working days from submission", "basis": "direct_textual", "verdict": "broader", "citation": "Article 18(1)", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "Right to complain to the supervisory authority if the request is refused or no timely response is given", "basis": "direct_textual", "verdict": "broader", "citation": "Article 18(4)", "slot": "consequence"}], "holistic_label": "narrower", "confidence": 0.79, "reasoning_note": "Article 18 establishes a data-subject access right functionally equivalent to GDPR Art. 15, with delivery of the data “in an unabridged manner.” However, it adds preconditions (request with identity proof) and explicit refusal grounds for deficient or abusive requests (Art. 18(3)), narrowing the right relative to the RU. Time limits and a complaint remedy are additional elements not required by the RU.", "label": "C1", "ru_id": "RU-123", "gdpr_article": 15, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 10, "total": 22}, {"round": 3, "n_queries": 4, "new": 6, "total": 28}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The citation for the condition slot does not fully support the claim that the condition is covered.", "counter_evidence": [{"id": "5a79146e04b73c99685c", "span": "Article 18(1)", "why": "The article mentions that the controller must inform the data subject if processing exists, but it does not explicitly state this as a condition for the right to access."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict does not account for the limitations on the right to access personal data as stated in Article 18(3).", "counter_evidence": [{"id": "Article 18(3)", "span": "المتحكِّم الامتناع عن الاستجابة للملتمس الوارد في الفقرة (1) من هذه المادة متى شابه نقص ولم يُصحَّح وفق ما تقتضيه الفقرة (2) بعد مضي المهلة الممنوحة للتصحيح؛ وله أيضاً ردَّه إذا انطوى على إساءة استعمال من المعنيّ بالمعطيات لسلطته في الاطلاع.", "why": "This article limits the right to access personal data by allowing the controller to refuse the request if it is deficient or constitutes an abuse of the right."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["5a79146e04b73c99685c", "98fa9fe9b0650c71a971", "34ea02d93464e8e2fa05", "9cd82ef51e2d36369a4f", "762372b7329c44286e43", "552b4ae6d34230dd6e1f", "93fde8c87940ae524c86", "4f0c7ea198f3c5b3627c", "6b500d26673394f3d7e6", "a59ada1e8ce6b7ede2c3", "7448a27e7806f2c0c143", "3d71a23a91370cadf799"], "n_llm_calls": 7, "latency_s": 398.57, "temperature": 0.0, "seed": 20260801, "id": "f4e20f96bc7ef67867be", "mutation_id": "ab0e5051a9b5c17e34f2", "mtype": "paraphrase", "required": "C1", "condition": "mutation"}
{"candidates_selected": ["129b122a7d0386567e65", "8cd7b777aa3cd8ca5f1f", "68b279470816abafcdd4"], "candidates_excluded": [{"id": "601ddc5fd8dcb81306cb", "reason": "Board governance powers; no rule on annual report content or permission to include specific lists."}, {"id": "3d71a23a91370cadf799", "reason": "Special-category (criminal) data processing; unrelated to supervisory authority annual reports."}, {"id": "bd5a2bbf9e9652a21d70", "reason": "Inspection/POA powers; no statement about annual report content or permissions."}, {"id": "7448a27e7806f2c0c143", "reason": "Data quality principles; unrelated to annual reports or permissions."}, {"id": "7e2914aa34ab2739dafd", "reason": "Security obligations; no bearing on annual report content."}, {"id": "1d8fd3d4070b1ff36d68", "reason": "Notification to the Authority about processing operations; not about infringements and not about report content."}, {"id": "e38e0bed35316765ba57", "reason": "Register of notifications/permits; does not prescribe or permit annual report contents."}, {"id": "4415e9a46823d9615000", "reason": "Delegation to law-enforcement officers for investigations; not about annual report contents."}, {"id": "a3c79315ae2d7920a38f", "reason": "Complaint submission mechanism; does not address what may be included in the Authority’s annual report."}], "target_frame": {"addressee": {"span": "الرئيس التنفيذي", "article": "Article 44(1)"}, "modality": {"span": "يتولى ... ما يأتي: هـ - إعداد تقرير سنوي عن نشاط الهيئة", "article": "Article 44(1)(هـ)"}, "action": {"span": null, "article": null}, "scope": {"span": "عن نشاط الهيئة", "article": "Article 44(1)(هـ)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": "خلال ثلاثة أشهر على الأكثر من تاريخ انتهاء السنة المالية", "article": "Article 44(1)(هـ)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "each supervisory authority", "target": "الرئيس التنفيذي (للـهيئة) مكلف بإعداد التقرير السنوي", "basis": "conceptual", "verdict": "covered", "citation": "Article 44(1)(هـ)", "slot": "addressee"}, {"gdpr": "permission", "target": "لا نص يمنح إذناً بشأن تضمين قائمة بأنواع المخالفات والتدابير؛ الموجود هو التزام بإعداد التقرير السنوي", "basis": "absent", "verdict": "uncovered", "citation": "Article 44(1)(هـ)", "slot": "modality"}, {"gdpr": "include in the annual report a list of types of infringement notified and types of measures taken in accordance with Article 58(2)", "target": "غير منصوص عليه", "basis": "absent", "verdict": "uncovered", "citation": "", "slot": "action"}, {"gdpr": "content of the annual activity report", "target": "عن نشاط الهيئة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 44(1)(هـ)", "slot": "scope"}, {"gdpr": "None", "target": "لا توجد شروط منصوص عليها", "basis": "absent", "verdict": "covered", "citation": "", "slot": "condition"}, {"gdpr": "None", "target": "لا استثناءات منصوص عليها", "basis": "absent", "verdict": "covered", "citation": "", "slot": "exception"}, {"gdpr": "None", "target": "خلال ثلاثة أشهر على الأكثر من تاريخ انتهاء السنة المالية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 44(1)(هـ)", "slot": "temporal"}, {"gdpr": "None", "target": "غير منصوص عليه", "basis": "absent", "verdict": "covered", "citation": "", "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.68, "reasoning_note": "The Bahrain texts require preparation of an annual report but do not grant permission or specify content to include a list of types of infringements and measures taken. Articles 30 and 47 show the Authority’s functions (monitoring and investigations) but do not link these to annual report content. Therefore, the GDPR unit’s specific permission and action are not expressed.", "label": "C2", "ru_id": "RU-698", "gdpr_article": 59, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 15, "total": 27}, {"round": 3, "n_queries": 4, "new": 1, "total": 28}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provision does not explicitly mention the inclusion of a list of types of infringement notified and types of measures taken in accordance with Article 58(2), and Article 58(2) is not present in the provided provisions.", "counter_evidence": [{"id": "129b122a7d0386567e65", "span": "إعداد تقرير سنوي عن نشاط الهيئة", "why": "The provision mentions the preparation of an annual report, but does not explicitly mention the inclusion of a list of types of infringement notified and types of measures taken in accordance with Article 58(2)."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The modality claim of 'permission' is not supported by the provisions, and the action of including a list of types of infringement notified and measures taken is not explicitly mentioned.", "counter_evidence": [{"id": "Article 44(1)(هـ)", "span": "إعداد تقرير سنوي عن نشاط الهيئة", "why": "The provision mentions the preparation of an annual report, but does not specify the content."}, {"id": "Article 30", "span": "مراقبة مدى الالتزام بأحكام هذا القانون", "why": "The provision lists the tasks and powers of the Authority, which includes monitoring compliance with the law."}, {"id": "Article 47", "span": "التحقيق في البلاغات والشكاوى الجدية المتعلقة بمخالفة أحكام هذا القانون", "why": "The provision states that the Authority may conduct investigations into alleged violations of the law."}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["601ddc5fd8dcb81306cb", "3d71a23a91370cadf799", "bd5a2bbf9e9652a21d70", "8cd7b777aa3cd8ca5f1f", "7448a27e7806f2c0c143", "7e2914aa34ab2739dafd", "1d8fd3d4070b1ff36d68", "68b279470816abafcdd4", "e38e0bed35316765ba57", "4415e9a46823d9615000", "a3c79315ae2d7920a38f", "129b122a7d0386567e65"], "n_llm_calls": 7, "latency_s": 451.42, "temperature": 0.0, "seed": 20260801, "id": "b2a6cc3fbba393b510b6", "mutation_id": "4dea030734e52453d54a", "mtype": "paraphrase", "required": "C1", "condition": "mutation"}
{"candidates_selected": ["9d65c2815c41a25064db", "0cc06e3d3b107448da5a"], "candidates_excluded": [{"id": "fdfffc71ce002ff82134", "reason": "DPIA obligations apply to the controller; not the processor’s security-measures duty."}, {"id": "9630e6d967b64e07d339", "reason": "Concerns DPO appointment criteria; not the substantive duty to implement security measures."}, {"id": "674524dee00496cb5de7", "reason": "Controller-only obligations; RU-316 addresses the processor."}, {"id": "57844ac856d11c289650", "reason": "Lawful-basis exceptions; not about security measures."}, {"id": "34f7595acb9df257ef5e", "reason": "DPO roles; not security measures."}, {"id": "9c38ab11b550755816f5", "reason": "Duties toward DPO; not security measures."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "General processing principles; not processor-focused and duplicative of Article 20’s specific security duty."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification; not the ex ante obligation to implement security measures."}, {"id": "5bedab371a9fc40ba93a", "reason": "Data-subject right to restrict processing; not security measures."}, {"id": "c34922f387019af45e42", "reason": "Automated-decision rights; not security measures."}], "target_frame": {"addressee": {"span": "المتحكم والمعالج", "article": "Article 20(1)"}, "modality": {"span": "يجب على", "article": "Article 20(1)"}, "action": {"span": "وضع واتخاذ إجراءات وتدابير تقنية وتنظيمية ملائمة، لضمان تطبيق مستوى أمن المعلومات الذي يتناسب مع المخاطر المصاحبة للمعالجة", "article": "Article 20(1)"}, "scope": {"span": "أمن معلومات البيانات الشخصية", "article": "Article 20 (عنوان)"}, "condition": {"span": "وفق أفضل المعايير والممارسات الدولية... يراعى عند تقييم مستوى أمن المعلومات المنصوص عليها في البند (1): أ. المخاطر المصاحبة للمعالجة... ب. تكاليف تنفيذ المعالجة وطبيعتها ونطاقها وأغراضها، وكذلك تباين المخاطر المحتملة على خصوصية وسرية البيانات الشخصية لصاحب البيانات.", "article": "Article 20(1)-(2)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "processor", "target": "المعالج (مذكور مع المتحكم)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 20(1)"}, {"slot": "modality", "gdpr": "obligation", "target": "يجب على", "basis": "direct_textual", "verdict": "covered", "citation": "Article 20(1)"}, {"slot": "action", "gdpr": "implement appropriate technical and organisational measures to ensure a level of security appropriate to the risk", "target": "وضع واتخاذ إجراءات وتدابير تقنية وتنظيمية ملائمة، لضمان تطبيق مستوى أمن المعلومات الذي يتناسب مع المخاطر المصاحبة للمعالجة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 20(1)"}, {"slot": "scope", "gdpr": "processing of personal data", "target": "أمن معلومات البيانات الشخصية ... المخاطر المصاحبة للمعالجة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 20 (title), 20(2)"}, {"slot": "condition", "gdpr": "taking into account the state of the art, costs of implementation, and the nature, scope, context and purposes of processing, as well as risks of varying likelihood and severity to the rights and freedoms of natural persons", "target": "وفق أفضل المعايير والممارسات الدولية؛ تكاليف تنفيذ المعالجة وطبيعتها ونطاقها وأغراضها؛ تباين المخاطر المحتملة على خصوصية وسرية البيانات الشخصية؛ المخاطر المصاحبة للمعالجة", "basis": "distributed", "verdict": "partial", "citation": "Article 20(1)-(2); Article 8(2)"}, {"slot": "exception", "gdpr": "None", "target": "غير منصوص عليها", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr": "None", "target": "غير منصوص عليها", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr": "None", "target": "غير منصوص عليها في المادة ذاتها", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "covered", "confidence": 0.86, "reasoning_note": "Article 20(1) expressly obliges the processor to adopt appropriate technical and organisational measures to ensure a level of security proportionate to processing risks, and Article 20(2) specifies risk- and processing-related factors to be taken into account. Article 8(2) adds a processor-specific duty to adopt suitable technical/administrative means, considering costs, nature, scope, and purposes at design and operation stages. Thus, the UAE text does provide explicit, risk-appropriate TOM guidance, with only minor narrowing (privacy/confidentiality focus) relative to GDPR’s broader ‘rights and freedoms’ framing.", "label": "C2", "ru_id": "RU-316", "gdpr_article": 32, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 11, "total": 11}, {"round": 2, "n_queries": 4, "new": 3, "total": 14}, {"round": 3, "n_queries": 4, "new": 1, "total": 15}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "The UAE law does not provide clear and explicit guidance on implementing technical and organizational measures to ensure a level of security appropriate to the risk.", "counter_evidence": [{"id": "Article 20(1)", "span": "يجب على المتحكم والمعالج وضع واتخاذ إجراءات وتدابير تقنية وتنظيمية ملائمة، لضمان تطبيق مستوى أمن المعلومات الذي يتناسب مع المخاطر المصاحبة للمعالجة", "why": "The article does not explicitly mention the level of security being appropriate to the risk."}, {"id": "Article 7(1)", "span": "يتعيّن على المتحكم الالتزام بما يأتي: اتخاذ الإجراءات والتدابير التقنية والتنظيمية الملائمة لتطبيق المعايير القياسية اللازمة لحماية وتأمين البيانات الشخصية", "why": "The article does not provide specific details on how to implement technical and organizational measures."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["0cc06e3d3b107448da5a", "fdfffc71ce002ff82134", "9d65c2815c41a25064db", "9630e6d967b64e07d339", "674524dee00496cb5de7", "57844ac856d11c289650", "34f7595acb9df257ef5e", "9c38ab11b550755816f5", "3cc10eb2dd7e95bdd0c2", "e05de90f481c9410c6e0", "5bedab371a9fc40ba93a", "c34922f387019af45e42"], "n_llm_calls": 6, "latency_s": 295.1, "temperature": 0.0, "seed": 20260801, "id": "4f97c530874e613e5dbb", "mutation_id": "57ad2e91d87c96854f08", "mtype": "paraphrase", "required": "C1", "condition": "mutation"}
{"candidates_selected": ["593beb6b1fe15a8fda31"], "candidates_excluded": [{"id": "0269f42c0015a544c475", "reason": "Addresses marketing communications consent; unrelated to sub-processing or processor notification duties."}, {"id": "a2fc439bdbcbe5a48a04", "reason": "Concerns notifying third parties of data rectification; not about sub-processor changes."}, {"id": "952167864cc3b0d724c1", "reason": "Covers withdrawal of consent and downstream deletion requests; not sub-processing."}, {"id": "14105f25ea49e7794aaa", "reason": "DPIA content and sharing; does not impose processor duty to inform about sub-processor changes."}, {"id": "17d4b446ea6ed7965d08", "reason": "General data subject rights handling; not relevant to processor sub-processing notifications."}, {"id": "4de7a5d9d6e42dc170c3", "reason": "National register of controllers; no link to sub-processing notification."}, {"id": "dd4534e9a092f99ef423", "reason": "Consent conditioning; irrelevant to sub-processing."}, {"id": "9cfd6fbae8182dbc0028", "reason": "Transparency to data subjects at collection; not about sub-processors."}, {"id": "90da2bc2380e8f3f2fb8", "reason": "Controller response timelines to data subject requests; not sub-processing."}, {"id": "78ae2c40eaf4fb3870fc", "reason": "High-level requirement to choose processors with guarantees; no specific duty to notify about sub-processor changes."}, {"id": "d9a05a425b46428120ee", "reason": "Supervisory authority powers and DPO; not sub-processing notification."}], "target_frame": {"addressee": {"span": "يلزم المُشغّل، قبيل إتمام أي عقود تالية مع مُشغّلين من الباطن، مراعاة ما يأتي:", "article": "Article 17(5)"}, "modality": {"span": "يلزم المُشغّل", "article": "Article 17(5)"}, "action": {"span": "مع إخطار المُشغّل للمُقرّر قبل إتمام تلك العقود", "article": "Article 17(5)(ج)"}, "scope": {"span": "أي عقود تالية مع مُشغّلين من الباطن", "article": "Article 17(5)"}, "condition": {"span": "استصدار إذنٍ سابق من المُقرّر", "article": "Article 17(5)(ج)"}, "exception": {"span": null, "article": null}, "temporal": {"span": "قبل إتمام تلك العقود", "article": "Article 17(5)(ج)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "processor", "target_value": "المُشغّل (processor)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(5): \"يلزم المُشغّل\"", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "يلزم (mandatory duty)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(5): \"يلزم المُشغّل\"", "slot": "modality"}, {"gdpr_value": "inform the controller of any intended changes concerning the addition or replacement of other processors", "target_value": "إخطار المُشغّل للمُقرّر قبل إتمام العقود اللاحقة مع مُشغّلين من الباطن", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(5)(ج): \"مع إخطار المُشغّل للمُقرّر قبل إتمام تلك العقود\"", "slot": "action"}, {"gdpr_value": "sub-processing", "target_value": "العقود اللاحقة مع مُشغّلين من الباطن (sub-processing)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(5): \"أي عقود تالية مع مُشغّلين من الباطن\"", "slot": "scope"}, {"gdpr_value": "where the controller has given general written authorisation to engage other processors", "target_value": "النص يشترط \"استصدار إذنٍ سابق من المُقرّر\" ولا يذكر تفويضاً عاماً تحريرياً", "basis": "absent", "verdict": "uncovered", "citation": "Article 17(5)(ج): \"استصدار إذنٍ سابق من المُقرّر\" (no mention of general written authorisation)", "slot": "condition"}, {"gdpr_value": "None", "target_value": "No exception stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "before implementing the intended changes", "target_value": "قبل إتمام تلك العقود", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(5)(ج): \"قبل إتمام تلك العقود\"", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "No explicit consequence stated for breach in this clause", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.67, "reasoning_note": "The KSA text imposes a duty on the processor to notify the controller before concluding contracts with sub-processors and to obtain prior authorization. However, it does not condition the notification duty on the controller having granted general written authorization, which is the GDPR-specific trigger for this obligation.", "label": "C2", "ru_id": "RU-226", "gdpr_article": 28, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 6, "total": 31}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The KSA jurisdiction may have a broader requirement than the GDPR, and the citation for the 'condition' slot is unsupported.", "counter_evidence": [{"id": "[593beb6b1fe15a8fda31]", "span": "استصدار إذنٍ سابق من المُقرّر", "why": "The KSA jurisdiction requires prior authorization, not just notification."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's citation for the 'condition' slot verdict does not fully support the proposition, as it does not explicitly mention 'general written authorisation' as a condition.", "counter_evidence": [{"id": "[593beb6b1fe15a8fda31]", "span": "Article 17(5)(ج): \"استصدار إذنٍ سابق من المُقرّر، مع إخطار المُشغّل للمُقرّر قبل إتمام تلك العقود\"", "why": "The provision does not explicitly mention 'general written authorisation' as a condition."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["593beb6b1fe15a8fda31", "0269f42c0015a544c475", "a2fc439bdbcbe5a48a04", "952167864cc3b0d724c1", "14105f25ea49e7794aaa", "17d4b446ea6ed7965d08", "4de7a5d9d6e42dc170c3", "dd4534e9a092f99ef423", "9cfd6fbae8182dbc0028", "90da7bc2380e8f3f2fb8", "78ae2c40eaf4fb3870fc", "d9a05a425b46428120ee"], "n_llm_calls": 7, "latency_s": 359.08, "temperature": 0.0, "seed": 20260801, "id": "42f9f582e0c54a71bc3a", "mutation_id": "d8cdddc03ac09c856e93", "mtype": "paraphrase", "required": "C1", "condition": "mutation"}
{"candidates_selected": ["2c020ba48e817e4f4c7a"], "candidates_excluded": [{"id": "e8fe267db21063b1b45f", "reason": "Scope provision; defines who the regulation applies to but does not set record-keeping content."}, {"id": "b983a5ed0e1c7a2b779a", "reason": "Legal bases for processing; no record-of-processing-activities content."}, {"id": "62dc9e8ad2aa962982ad", "reason": "Pre-service notice/consent conditions; not about the content of internal processing records."}, {"id": "9f3112d28a1b850ba61f", "reason": "Transparency to users (identification and contact information provided outwardly); not an internal record-of-processing-activities requirement."}], "target_frame": {"addressee": {"span": "يتعين على المزود إنجاز المتطلبات أدناه", "article": "2c020ba48e817e4f4c7a (Article 5)"}, "modality": {"span": "يتعين", "article": "2c020ba48e817e4f4c7a (Article 5)"}, "action": {"span": "إبقاء قيود لحركات التشغيل، شريطة أن تشتمل تلك القيود كل المعطيات كما أدناه: 4.1. التسمية ووسائل التواصل للمزود", "article": "2c020ba48e817e4f4c7a (Article 5, points 4 and 4.1)"}, "scope": {"span": "قيود لحركات التشغيل", "article": "2c020ba48e817e4f4c7a (Article 5, point 4)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "المزود (مقدم الخدمة المرخّص له الذي يجمع ويعالج البيانات الشخصية ضمن نطاق اللائحة)", "basis": "distributed", "verdict": "covered", "citation": "2c020ba48e817e4f4c7a (Art. 5); e8fe267db21063b1b45f (Art. 1)", "slot": "addressee"}, {"gdpr_value": "obligation (shall)", "target_value": "يتعين (obligation)", "basis": "direct_textual", "verdict": "covered", "citation": "2c020ba48e817e4f4c7a (Art. 5)", "slot": "modality"}, {"gdpr_value": "include the name and contact details of the controller in the record", "target_value": "إبقاء قيود لحركات التشغيل تشمل: التسمية ووسائل التواصل للمزود", "basis": "direct_textual", "verdict": "covered", "citation": "2c020ba48e817e4f4c7a (Art. 5, points 4 and 4.1)", "slot": "action"}, {"gdpr_value": "the record of processing activities maintained under Article 30(1)", "target_value": "قيود لحركات التشغيل (records of processing operations)", "basis": "direct_textual", "verdict": "covered", "citation": "2c020ba48e817e4f4c7a (Art. 5, point 4)", "slot": "scope"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None expressed specific to this slot", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "covered", "confidence": 0.77, "reasoning_note": "Article 5(4)–(4.1) explicitly requires keeping records of processing operations that include the provider’s name and contact details. While the term used is المزود (licensed service provider), Article 1 shows this actor is the entity collecting/processing personal data under the regulation, which functionally aligns with the GDPR controller for this duty. Thus, the textual requirement to include name and contact details in the record is present.", "label": "C1", "ru_id": "RU-255", "gdpr_article": 30, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 1, "total": 1}, {"round": 2, "n_queries": 4, "new": 4, "total": 5}, {"round": 3, "n_queries": 4, "new": 0, "total": 5}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's citation for the 'action' slot verdict does not clearly support the verdict, and the provision does not explicitly state that the provider shall include their name and contact details in the record.", "counter_evidence": [{"id": "2c020ba48e817e4f4c7a", "span": "إبقاء قيود لحركات التشغيل، شريطة أن تشتمل تلك القيود كل المعطيات كما أدناه: 4.1. التسمية ووسائل التواصل للمزود", "why": "This provision does not explicitly state that the provider shall include their name and contact details in the record."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The KWT law does not explicitly require the inclusion of the controller's name and contact details in the record of processing activities, and the term 'المزود' may not be equivalent to the GDPR's concept of a 'controller'.", "counter_evidence": [{"id": "2c020ba48e817e4f4c7a", "span": "التسمية ووسائل التواصل للمزود", "why": "This provision only requires the service provider to keep records of their own name and contact details, but it does not explicitly state that these records must be included in the record of processing activities."}, {"id": "2c020ba48e817e4f4c7a", "span": "المزود", "why": "The term 'المزود' may not be equivalent to the GDPR's concept of a 'controller'."}], "confidence": 0.8}], "n_candidates": 5, "candidate_ids": ["e8fe267db21063b1b45f", "b983a5ed0e1c7a2b779a", "62dc9e8ad2aa962982ad", "2c020ba48e817e4f4c7a", "9f3112d28a1b850ba61f"], "n_llm_calls": 7, "latency_s": 316.44, "temperature": 0.0, "seed": 20260801, "id": "97e4b0562f2635d2b33e", "mutation_id": "81f6b4298be9ebf7589b", "mtype": "paraphrase", "required": "C1", "condition": "mutation"}
{"candidates_selected": ["9f3112d28a1b850ba61f"], "candidates_excluded": [{"id": "b983a5ed0e1c7a2b779a", "reason": "Sets lawful bases for processing; does not establish or mention a data-subject right to restrict processing."}, {"id": "2c020ba48e817e4f4c7a", "reason": "Security and governance duties; mentions handling access/correction/deletion requests but not restriction of processing."}], "target_frame": {"addressee": {"span": "المستفيد", "article": "9f3112d28a1b850ba61f Art. 4(12)"}, "modality": {"span": "يلتزم المشغّل بإتاحة أداة ميسورة وفعّالة ومُتاحة بيسر تمكّن المستفيد...", "article": "9f3112d28a1b850ba61f Art. 4(12)"}, "action": {"span": "قصر الاطلاع عليها أو تداولها", "article": "9f3112d28a1b850ba61f Art. 4(8)"}, "scope": {"span": "المعطيات ذات الطابع الفردي", "article": "9f3112d28a1b850ba61f Art. 4(8)"}, "condition": {"span": "بيان الطريقة المتّبعة لطلب ... قصر الاطلاع عليها أو تداولها", "article": "9f3112d28a1b850ba61f Art. 4(8)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "المستفيد", "basis": "direct_textual", "verdict": "covered", "citation": "9f3112d28a1b850ba61f Art. 4(12)", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "يلتزم المشغّل بإتاحة أداة ... تمكّن المستفيد", "basis": "conceptual", "verdict": "covered", "citation": "9f3112d28a1b850ba61f Art. 4(12)", "slot": "modality"}, {"gdpr_value": "obtain from the controller the restriction of processing", "target_value": "قصر الاطلاع عليها أو تداولها؛ وإيقاف ... الاستعمال أو التداول أو إفشاء المعطيات ذات الطابع الفردي", "basis": "direct_textual", "verdict": "broader", "citation": "9f3112d28a1b850ba61f Art. 4(8), Art. 4(12)", "slot": "action"}, {"gdpr_value": "processing of the data subject's personal data", "target_value": "المعطيات ذات الطابع الفردي (بيانات شخصية) الخاصة بالمستفيد", "basis": "direct_textual", "verdict": "covered", "citation": "9f3112d28a1b850ba61f Art. 4(8), Art. 4(12)", "slot": "scope"}, {"gdpr_value": "the processing is unlawful and the data subject opposes erasure and requests restriction instead", "target_value": "تمكين طلب قصر الاطلاع أو التداول دون اشتراطات خاصة (عند الطلب)", "basis": "direct_textual", "verdict": "broader", "citation": "9f3112d28a1b850ba61f Art. 4(8)", "slot": "condition"}, {"gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "covered", "confidence": 0.78, "reasoning_note": "Article 4(8) and 4(12) impose on the operator a duty to provide tools and methods enabling the beneficiary to “restrict” (قصر) or even stop the use/processing of personal data, which functionally matches a right to obtain restriction. Although the GDPR unit ties this right to an unlawfulness/opposed-erasure condition, the target text is broader (available upon request), so the specific scenario is covered. The modality is not weaker: the operator’s obligation to enable the beneficiary’s control implies an equivalent right.", "label": "C1", "ru_id": "RU-167", "gdpr_article": 18, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 1, "total": 1}, {"round": 2, "n_queries": 4, "new": 2, "total": 3}, {"round": 3, "n_queries": 4, "new": 0, "total": 3}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provisions cited by the analyst do not explicitly mention the condition that the processing is unlawful and the data subject opposes erasure and requests restriction instead.", "counter_evidence": [{"id": "9f3112d28a1b850ba61f", "span": "Article 4(8) and Article 4(12)", "why": "The provisions do not specify the conditions under which the right to restrict access to or processing of the data can be exercised."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict claims a weaker modality, but the provisions suggest a similar modality for the right to obtain restriction of processing of personal data.", "counter_evidence": [{"id": "9f3112d28a1b850ba61f", "span": "يلتزم المشغّل بإتاحة أداة ميسورة وفعّالة ومُتاحة بيسر تمكّن المستفيد من تعديل معطياته، أو إلغاء رضاه، أو إيقاف منفعة، أو أسلوب التحصيل، أو الاستعمال أو التداول أو إفشاء معطياته ذات الطابع الفردي", "why": "This provision suggests that the data subject has the right to request restriction of processing of their personal data."}, {"id": "9f3112d28a1b850ba61f", "span": "قصر الاطلاع عليها أو تداولها", "why": "This provision suggests that the operator is obligated to restrict access to or processing of personal data."}], "confidence": 0.8}], "n_candidates": 3, "candidate_ids": ["b983a5ed0e1c7a2b779a", "2c020ba48e817e4f4c7a", "9f3112d28a1b850ba61f"], "n_llm_calls": 7, "latency_s": 351.9, "temperature": 0.0, "seed": 20260801, "id": "f917c05b5fe59356466e", "mutation_id": "905c9537a251abb7b4ae", "mtype": "paraphrase", "required": "C1", "condition": "mutation"}
{"candidates_selected": ["5e5fa8a4888b88a04311"], "candidates_excluded": [{"id": "762372b7329c44286e43", "reason": "Sets general lawful bases for processing; does not address civil liability for damages."}, {"id": "3d71a23a91370cadf799", "reason": "Regulates processing of criminal-case data; no rule on liability for damages."}, {"id": "5a79146e04b73c99685c", "reason": "Data subject access/notification right; not about liability for damage."}, {"id": "2ef716a5a0437defc8f2", "reason": "Cross-border transfer exceptions; no civil-liability rule."}, {"id": "14fe9b230c7ba11703d5", "reason": "Criminal penalties; not the civil-liability standard for damages."}, {"id": "79c959efd73d5d166449", "reason": "Concerns settlement of certain offenses; does not establish controller liability (only preserves victim's compensation right)."}, {"id": "c24849787475f274ecac", "reason": "Administrative measures and fines; not a damages-liability provision."}, {"id": "9bcb8d6e5e38974e2a1b", "reason": "Investigatory powers to obtain information; no liability rule."}, {"id": "cf6dbe21d2b4a64f32a8", "reason": "Procedural rule on DPO registration decisions; unrelated to damages liability."}, {"id": "9536e03a0aa7b4781fc7", "reason": "Procedural rule on ending DPO registration; unrelated to damages liability."}, {"id": "98fa9fe9b0650c71a971", "reason": "Obligation to inform about right to object to direct marketing; not a damages-liability norm."}], "target_frame": {"addressee": {"span": "مدير البيانات أو مراقب حماية البيانات", "article": "Article 57"}, "modality": {"span": "يجوز لمن لحقه ضرر نشأ عن معالجة بياناته الشخصية من قِبَل مدير البيانات، أو عن إخلال مراقب حماية البيانات بأحكام هذا القانون، الحق في مطالبة مدير البيانات أو مراقب حماية البيانات، بحسب الأحوال، بالتعويض الجابر للضرر.", "article": "Article 57"}, "action": {"span": "بالتعويض الجابر للضرر", "article": "Article 57"}, "scope": {"span": "ضرر نشأ عن معالجة بياناته الشخصية", "article": "Article 57"}, "condition": {"span": "نشأ عن معالجة بياناته الشخصية من قِبَل مدير البيانات", "article": "Article 57"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller involved in processing", "target_value": "مدير البيانات (controller) and also مراقب حماية البيانات (DPO)", "basis": "direct_textual", "verdict": "broader", "citation": "Article 57"}, {"slot": "modality", "gdpr_value": "obligation (shall be liable)", "target_value": "Data subject has a direct right to claim compensation from the controller (or DPO) for damage", "basis": "conceptual", "verdict": "covered", "citation": "Article 57"}, {"slot": "action", "gdpr_value": "be liable for the damage", "target_value": "التعويض الجابر للضرر (compensation for damage)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 57"}, {"slot": "scope", "gdpr_value": "damage caused by processing", "target_value": "ضرر نشأ عن معالجة بياناته الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 57"}, {"slot": "condition", "gdpr_value": "the processing infringes this Regulation", "target_value": "Damage arising from processing by the controller (no infringement requirement for controller; infringement required only for DPO breaches)", "basis": "direct_textual", "verdict": "broader", "citation": "Article 57"}, {"slot": "exception", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "covered", "confidence": 0.71, "reasoning_note": "Article 57 expressly gives data subjects a direct claim to compensation for damage arising from processing by the controller, which functionally establishes controller liability for such damage. The condition is broader than GDPR (not limited to unlawful processing), and the addressee set also includes the DPO. In light of this, the modality is adequately covered via a direct compensation right, not weaker in effect.", "label": "C4", "ru_id": "RU-930", "gdpr_article": 82, "jurisdiction": "BHR", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 2, "total": 27}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The condition slot verdict is 'broader' and the provision does not explicitly match the GDPR requirement.", "counter_evidence": [{"id": "5e5fa8a4888b88a04311", "span": "مع عدم الإخلال بأحكام القانون المدني، يجوز لمن لحقه ضرر نشأ عن معالجة بياناته الشخصية من قِبَل مدير البيانات، أو عن إخلال مراقب حماية البيانات بأحكام هذا القانون، الحق في مطالبة مدير البيانات أو مراقب حماية البيانات، بحسب الأحوال، بالتعويض الجابر للضرر", "why": "The provision focuses on the right of the data subject to claim compensation rather than explicitly imposing an obligation on the controller to be liable for damage caused by processing that infringes the Regulation."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The modality of obligation in the BHR jurisdiction, as indicated by Article 57, may not be weaker than initially assessed, given its provision for direct compensation claims for damages resulting from non-compliant data processing.", "counter_evidence": [{"id": "5e5fa8a4888b88a04311", "span": "يجوز لمن لحقه ضرر نشأ عن معالجة بياناته الشخصية من قِبَل مدير البيانات، أو عن إخلال مراقب حماية البيانات بأحكام هذا القانون، الحق في مطالبة مدير البيانات أو مراقب حماية البيانات، بحسب الأحوال، بالتعويض الجابر للضرر.", "why": "This provision directly addresses liability for damage caused by processing, suggesting a stronger obligation than initially verdicted."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["762372b7329c44286e43", "3d71a23a91370cadf799", "5a79146e04b73c99685c", "2ef716a5a0437defc8f2", "14fe9b230c7ba11703d5", "79c959efd73d5d166449", "c24849787475f274ecac", "9bcb8d6e5e38974e2a1b", "cf6dbe21d2b4a64f32a8", "9536e03a0aa7b4781fc7", "98fa9fe9b0650c71a971", "5e5fa8a4888b88a04311"], "n_llm_calls": 7, "latency_s": 366.99, "temperature": 0.0, "seed": 20260801, "id": "ec86d2e3ac9d26ff7009", "mutation_id": "c0048515bcc2a9dacb8f", "mtype": "modal_down", "required": "C3", "condition": "mutation"}
{"candidates_selected": ["85d05fccf5b4f57eceaf", "6c76988b817262e3e312", "fcbd13532c69b340214e", "455aae046cacf7979576"], "candidates_excluded": [{"id": "75db9db720e9e34a1148", "reason": "Addresses conformity of disclosures/transfers to lawful purposes, not integration of safeguards into processing."}, {"id": "f169b712b14aea8718ee", "reason": "Sets a legal basis (consent/legitimate interest), not measures or safeguards integration."}, {"id": "2bcce9feda2fcb9d35fe", "reason": "States a general right to privacy and processing principles, but no operative duty to integrate safeguards."}, {"id": "f5c366135483fe580381", "reason": "Breach notification duty; does not prescribe integrating safeguards into processing."}, {"id": "192caaa530952a30ad50", "reason": "Empowers the authority; not a controller obligation to integrate safeguards."}, {"id": "89d1bb9a58e65b732117", "reason": "Transparency/notice requirements before processing, not integration of safeguards."}], "target_frame": {"addressee": {"span": "على المراقب", "article": "Article 11"}, "modality": {"span": "يجب على كل من المراقب والمعالج", "article": "Article 13"}, "action": {"span": "وضع نظم داخلية للإدارة الفعالة للبيانات الشخصية، والإبلاغ عن أي تجاوز للإجراءات التي تهدف إلى حمايتها.", "article": "Article 11"}, "scope": {"span": "حماية البيانات الشخصية من الضياع أو التلف أو التعديل أو الإفشاء، أو الوصول إليها، أو استخدامها بشكل عارض أو غير مشروع.", "article": "Article 13"}, "condition": {"span": "قبل إدراج عمليات معالجة جديدة.", "article": "Article 11"}, "exception": {"span": null, "article": null}, "temporal": {"span": "ورصد ومتابعة ذلك بصفة مستمرة.", "article": "Article 11"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller", "target_value": "على المراقب", "basis": "direct_textual", "verdict": "covered", "citation": "Article 11 (chapeau)"}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "يجب على كل من المراقب والمعالج", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13 (first sentence)"}, {"slot": "action", "gdpr_value": "integrate the necessary safeguards into the processing", "target_value": "وضع نظم داخلية للإدارة الفعالة للبيانات الشخصية، والإبلاغ عن أي تجاوز للإجراءات التي تهدف إلى حمايتها.", "basis": "distributed", "verdict": "covered", "citation": "Article 11(5); see also Article 8(2) on design controls"}, {"slot": "scope", "gdpr_value": "safeguards necessary to meet the GDPR requirements and protect the rights of data subjects", "target_value": "حماية البيانات الشخصية من الضياع أو التلف أو التعديل أو الإفشاء، أو الوصول إليها، أو استخدامها بشكل عارض أو غير مشروع.", "basis": "distributed", "verdict": "partial", "citation": "Article 13 (security focus); complemented by Article 11(6) (enable access/review/correction) and Article 10 (data quality/retention)"}, {"slot": "condition", "gdpr_value": "as part of implementing measures under Article 25(1)", "target_value": "قبل إدراج عمليات معالجة جديدة.", "basis": "direct_textual", "verdict": "partial", "citation": "Article 11(1)"}, {"slot": "temporal", "gdpr_value": "both at the time of determining the means of processing and at the time of the processing itself", "target_value": "ورصد ومتابعة ذلك بصفة مستمرة.", "basis": "distributed", "verdict": "covered", "citation": "Article 11(1) (before new processing); Article 11(8) (continuous monitoring)"}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.67, "reasoning_note": "Qatar’s law imposes duties to set internal systems and take precautions (Articles 11 and 13), including pre‑processing review and ongoing monitoring, which functionally integrate safeguards into processing. However, the scope is centered on data security and specific rights enablement, not the broader “protect the rights of data subjects” aim of GDPR Art. 25(1), and the condition is not framed as implementation of Art. 25‑style measures (design controls in Article 8 are permissive). The counter‑evidence is valid: Article 13 does not expressly reference rights, though Article 11(6) partially addresses rights by requiring technical means to enable access/review/correction.", "label": "C2", "ru_id": "RU-211", "gdpr_article": 25, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 7, "total": 7}, {"round": 2, "n_queries": 4, "new": 2, "total": 9}, {"round": 3, "n_queries": 4, "new": 1, "total": 10}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provisions cited, while addressing data protection and safeguards, do not clearly and directly mirror the GDPR's requirement for the controller to integrate necessary safeguards into the processing as an obligation. The distributed nature of these provisions across multiple articles may indicate a gap in direct correspondence with the GDPR requirement.", "counter_evidence": [{"id": "Article 11", "span": "على المراقب اتخاذ الإجراءات التالية:", "why": "This article outlines several actions the controller must take but does not explicitly state the integration of safeguards into the processing as a direct obligation."}, {"id": "Article 13", "span": "يجب على كل من المراقب والمعالج اتخاذ الاحتياطات اللازمة", "why": "While this article discusses necessary precautions, it does not explicitly integrate these into the processing as a comprehensive safeguard requirement."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The scope of safeguards and the condition for implementing measures are not fully equivalent to the GDPR requirements.", "counter_evidence": [{"id": "Article 13", "span": "يجب على كل من المراقب والمعالج اتخاذ الاحتياطات اللازمة لحماية البيانات الشخصية من الضياع أو التلف أو التعديل أو الإفشاء، أو الوصول إليها، أو استخدامها بشكل عارض أو غير مشروع.", "why": "This provision does not explicitly mention protecting the rights of data subjects."}, {"id": "Article 11", "span": "على المراقب اتخاذ الإجراءات التالية: 1- مراجعة إجراءات حماية الخصوصية قبل إدراج عمليات معالجة جديدة.", "why": "This provision does not provide a clear condition for implementing measures equivalent to Article 25(1) of the GDPR."}], "confidence": 0.8}], "n_candidates": 10, "candidate_ids": ["75db9db720e9e34a1148", "85d05fccf5b4f57eceaf", "6c76988b817262e3e312", "f169b712b14aea8718ee", "fcbd13532c69b340214e", "2bcce9feda2fcb9d35fe", "f5c366135483fe580381", "455aae046cacf7979576", "192caaa530952a30ad50", "89d1bb9a58e65b732117"], "n_llm_calls": 7, "latency_s": 370.52, "temperature": 0.0, "seed": 20260801, "id": "6536eefb92f291daf928", "mutation_id": "dd85c9b32a5b8a6e2f1f", "mtype": "modal_down", "required": "C3", "condition": "mutation"}
{"candidates_selected": ["6c76988b817262e3e312", "85d05fccf5b4f57eceaf"], "candidates_excluded": [{"id": "a200ece03fd0ba143354", "reason": "Ministerial rules on exercise of data subject rights; no controller review of measures."}, {"id": "9548224453cca1301899", "reason": "General implementing decisions by minister; no substantive controller duty to review."}, {"id": "192caaa530952a30ad50", "reason": "Functions of the competent authority; not a controller review obligation."}, {"id": "f5c366135483fe580381", "reason": "Breach notification; does not impose or describe review of measures."}, {"id": "850decaffbbae78d371d", "reason": "Exemptions from certain provisions; no review duty."}, {"id": "75db9db720e9e34a1148", "reason": "Rules for disclosure/transfer; no review of protective measures."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "Security/public interest processing by authority; unrelated to controller review."}], "target_frame": {"addressee": {"span": "المراقب", "article": "Article 11"}, "modality": {"span": "يجوز للمراقب اتخاذ الإجراءات التالية", "article": "Article 11"}, "action": {"span": "إجراء عمليات تدقيق ومراجعة شاملة عن مدى الالتزام بحماية البيانات الشخصية", "article": "Article 11"}, "scope": {"span": "اتخاذ الاحتياطات الإدارية والفنية والمادية المناسبة لحماية البيانات الشخصية", "article": "Article 8"}, "condition": {"span": "قبل إدراج عمليات معالجة جديدة", "article": "Article 11"}, "exception": {"span": null, "article": null}, "temporal": {"span": "بصفة مستمرة", "article": "Article 11"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller", "target_value": "المراقب", "basis": "direct_textual", "verdict": "covered", "citation": "Article 11: \"يجوز للمراقب...\""}, {"slot": "modality", "gdpr_value": "shall (obligation)", "target_value": "يجوز (permission)", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 11: \"يجوز للمراقب اتخاذ الإجراءات التالية\""}, {"slot": "action", "gdpr_value": "review the measures", "target_value": "إجراء عمليات تدقيق ومراجعة شاملة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 11(7): \"إجراء عمليات تدقيق ومراجعة شاملة عن مدى الالتزام بحماية البيانات الشخصية\""}, {"slot": "scope", "gdpr_value": "technical and organisational measures implemented under Article 24(1)", "target_value": "الاحتياطات الإدارية والفنية والمادية المناسبة لحماية البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 8(3): \"اتخاذ الاحتياطات الإدارية والفنية والمادية المناسبة لحماية البيانات الشخصية\""}, {"slot": "condition", "gdpr_value": "where necessary", "target_value": "قبل إدراج عمليات معالجة جديدة (different trigger, not a necessity standard)", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "بصفة مستمرة (continuous monitoring)", "basis": "direct_textual", "verdict": "broader", "citation": "Article 11(8): \"... ورصد ومتابعة ذلك بصفة مستمرة\""}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "weaker_modality", "confidence": 0.66, "reasoning_note": "Article 11 provides for reviews/audits but frames them as permissible (“يجوز”) rather than obligatory, which weakens alignment with GDPR’s “shall.” Article 8 supplies the underlying technical/organizational safeguards akin to Art. 24(1) measures, so the subject matter matches. However, no “where necessary” trigger is imposed; instead a specific optional trigger (“قبل إدراج عمليات معالجة جديدة”) appears.", "label": "C3", "ru_id": "RU-205", "gdpr_article": 24, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 8, "total": 8}, {"round": 2, "n_queries": 4, "new": 1, "total": 9}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's claim of a weaker modality is not entirely supported by the modal wording in Article 11.", "counter_evidence": [{"id": "6c76988b817262e3e312", "span": "يجوز للمراقب اتخاذ الإجراءات التالية", "why": "The translation of 'يجوز' as 'may' may not accurately convey the modality in this context."}, {"id": "f5c366135483fe580381", "span": "يجب على المراقب إعلام الفرد والإدارة المختصة", "why": "This article implies an obligation, which contradicts the claim of a weaker modality."}, {"id": "85d05fccf5b4f57eceaf", "span": "يتعين على المراقب الالتزام بما يلي", "why": "This article also implies an obligation, which further contradicts the claim of a weaker modality."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The modality in the QAT law (permission) may not fully align with the obligation stated in the GDPR, potentially weakening the requirement.", "counter_evidence": [{"id": "6c76988b817262e3e312", "span": "يجوز للمراقب اتخاذ الإجراءات التالية", "why": "The use of 'يجوز' (may) instead of 'يجب' (shall) or an equivalent obligation modality in Article 11 could indicate a weaker requirement than the GDPR's 'shall' review the measures."}], "confidence": 0.8}], "n_candidates": 9, "candidate_ids": ["a200ece03fd0ba143354", "9548224453cca1301899", "192caaa530952a30ad50", "f5c366135483fe580381", "6c76988b817262e3e312", "85d05fccf5b4f57eceaf", "850decaffbbae78d371d", "75db9db720e9e34a1148", "3f5cc5a2c4af5fb90388"], "n_llm_calls": 6, "latency_s": 322.61, "temperature": 0.0, "seed": 20260801, "id": "3bf18aaa75ad8a3172c2", "mutation_id": "c4a780b0ca53144d14d5", "mtype": "modal_down", "required": "C3", "condition": "mutation"}
{"candidates_selected": ["743bfdd72ed773ff5ba9"], "candidates_excluded": [{"id": "674524dee00496cb5de7", "reason": "Substantive obligations of controllers; does not set territorial/applicability scope."}, {"id": "0cc06e3d3b107448da5a", "reason": "Substantive obligations of processors; does not set territorial/applicability scope."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment triggers; not territorial scope."}, {"id": "34f7595acb9df257ef5e", "reason": "DPO roles; not territorial scope."}, {"id": "9c38ab11b550755816f5", "reason": "Duties toward DPO; not territorial scope."}, {"id": "c34922f387019af45e42", "reason": "Automated decision-making rights; not territorial scope."}, {"id": "9d65c2815c41a25064db", "reason": "Security obligations; not territorial scope."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restriction; not territorial scope."}, {"id": "dec351a1e477287e3b22", "reason": "Contact methods; not territorial scope."}, {"id": "6201d16404c0d4b9f63d", "reason": "Cross-border transfer conditions; not general territorial scope."}, {"id": "5d949837d7aab073cd67", "reason": "Complaints and enforcement; not territorial scope."}], "target_frame": {"addressee": {"span": "كل متحكم أو معالج متواجد في الدولة", "article": "Art. 2(1)(ب)"}, "modality": {"span": "يجوز أن تسري أحكام هذا المرسوم بقانون", "article": "Art. 2(1) chapeau"}, "action": {"span": "يجوز أن تسري أحكام هذا المرسوم بقانون على معالجة البيانات الشخصية", "article": "Art. 2(1) chapeau"}, "scope": {"span": "على معالجة البيانات الشخصية سواء كلها أو جزء منها عن طريق وسائل الأنظمة الإلكترونية التي تعمل بشكل تلقائي وآلي، أو غيرها من الوسائل الأخرى", "article": "Art. 2(1) chapeau"}, "condition": {"span": "كل متحكم أو معالج متواجد في الدولة يقوم بمزاولة أنشطة معالجة البيانات الشخصية لأصحاب البيانات في الدولة أو خارجها", "article": "Art. 2(1)(ب)"}, "exception": {"span": "يجوز ألا تسري أحكام هذا المرسوم بقانون على ما يأتي: أ. البيانات الحكومية. ب. الجهات الحكومية المتحكمة بالبيانات الشخصية أو تلك التي تقوم بمعالجتها. ج. البيانات الشخصية لدى الجهات الأمنية والقضائية. د. صاحب البيانات الذي يقوم بمعالجة بياناته لأغراض شخصية. هـ. البيانات الشخصية الصحية التي لديها تشريع ينظم حماية ومعالجة تلك البيانات. و. البيانات والمعلومات الشخصية المصرفية والائتمانية التي لديها تشريع ينظم حماية ومعالجة تلك البيانات. ز. الشركات والمؤسسات الواقعة في المناطق الحرة في الدولة ولديها تشريعات خاصة بحماية البيانات الشخصية.", "article": "Art. 2(2)"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller or processor with an establishment in the Union", "target_value": "كل متحكم أو معالج متواجد في الدولة", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 2(1)(ب)", "slot": "addressee"}, {"gdpr_value": "obligation (must comply)", "target_value": "يجوز أن تسري أحكام هذا المرسوم بقانون (may apply)", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Art. 2(1)", "slot": "modality"}, {"gdpr_value": "comply with this Regulation for the processing of personal data", "target_value": "تسري أحكام المرسوم بقانون على المعالجة (application of the law to processing, implying compliance duties elsewhere in the statute)", "basis": "conceptual", "verdict": "partial", "citation": "Art. 2(1)", "slot": "action"}, {"gdpr_value": "processing of personal data (no categorical exclusions)", "target_value": "processing of personal data by electronic or other means, subject to exclusions (e.g., government, security/judicial, personal/household, health data with separate legislation, banking/credit with separate legislation, free zones with own DP laws)", "basis": "distributed", "verdict": "narrower", "citation": "Art. 2(1) and Art. 2(2) (esp. Art. 2(2)(هـ))", "slot": "scope"}, {"gdpr_value": "processing is in the context of the activities of an establishment of the controller or processor in the Union, regardless of where the processing takes place", "target_value": "controller or processor located in the UAE engaged in processing personal data of data subjects inside or outside the UAE", "basis": "conceptual", "verdict": "covered", "citation": "Art. 2(1)(ب)", "slot": "condition"}, {"gdpr_value": "None", "target_value": "Enumerated carve-outs, including health personal data covered by separate legislation and others", "basis": "direct_textual", "verdict": "narrower", "citation": "Art. 2(2) (incl. (هـ))", "slot": "exception"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.73, "reasoning_note": "Article 2(1)(ب) establishes applicability to controllers/processors located in the UAE, functionally aligning with GDPR’s establishment-based trigger. However, the modality is weaker (“may apply”), and Article 2(2) narrows the scope with categorical exclusions (notably health data), so the coverage of RU‑008 is only partial. The reviewer’s point about the health data exception is reflected in the narrower verdict for the scope and exception slots.", "label": "C3", "ru_id": "RU-008", "gdpr_article": 3, "jurisdiction": "UAE", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 8, "total": 20}, {"round": 3, "n_queries": 4, "new": 2, "total": 22}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The UAE regulation has different scope and exceptions compared to the GDPR", "counter_evidence": [{"id": "Article 2(1)(b)", "span": "كل متحكم أو معالج متواجد في الدولة يقوم بمزاولة أنشطة معالجة البيانات الشخصية لأصحاب البيانات في الدولة أو خارجها", "why": "The provision only applies to controllers or processors established in the UAE, and does not explicitly state that the processing must be in the context of the activities of that establishment"}, {"id": "Article 2(2)", "span": "استثناءات من سريان المرسوم بقانون (البيانات الحكومية، الجهات الحكومية، الأمن والقضاء، الأغراض الشخصية، البيانات الصحية والمصرفية ذات تشريعات خاصة، والمناطق الحرة)", "why": "The UAE regulation has exceptions for government data, national security, and public interest, which are not present in the GDPR"}], "confidence": 0.8}, {"verdict": "revise", "objection": "The provision in Article 2(2) creates an exception for health personal data, which undermines the analyst's slot verdict for the scope.", "counter_evidence": [{"id": "Article 2(2)", "span": "يجوز ألا تسري أحكام هذا المرسوم بقانون على ما يأتي: ... هـ. البيانات الشخصية الصحية التي لديها تشريع ينظم حماية ومعالجة تلك البيانات", "why": "This provision creates an exception for health personal data, which undermines the analyst's slot verdict for the scope."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["0cc06e3d3b107448da5a", "9630e6d967b64e07d339", "743bfdd72ed773ff5ba9", "9c38ab11b550755816f5", "c34922f387019af45e42", "34f7595acb9df257ef5e", "9d65c2815c41a25064db", "5bedab371a9fc40ba93a", "674524dee00496cb5de7", "5d949837d7aab073cd67", "dec351a1e477287e3b22", "6201d16404c0d4b9f63d"], "n_llm_calls": 7, "latency_s": 455.04, "temperature": 0.0, "seed": 20260801, "id": "85ddfe557b53f5e9b7da", "mutation_id": "0d8e05316c2cfde7ad03", "mtype": "modal_down", "required": "C3", "condition": "mutation"}
{"candidates_selected": ["743bfdd72ed773ff5ba9"], "candidates_excluded": [{"id": "c34922f387019af45e42", "reason": "Automated decision-making/data subject right; not territorial scope or applicability."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment triggers; not territorial scope/extraterritorial reach."}, {"id": "0cc06e3d3b107448da5a", "reason": "Processor obligations content; not about when the law applies to foreign entities."}, {"id": "9c38ab11b550755816f5", "reason": "Duties toward DPO; not territorial scope."}, {"id": "6201d16404c0d4b9f63d", "reason": "Cross-border transfer conditions; not the basic territorial scope trigger."}, {"id": "a079a5ac446830a74bfc", "reason": "Adequacy-based transfers; not territorial scope of the law to foreign controllers/processors."}, {"id": "9d65c2815c41a25064db", "reason": "Security obligations; not applicability criteria to non-UAE establishments."}, {"id": "ebfe638a86be87347658", "reason": "Data portability right; not territorial scope."}, {"id": "5d949837d7aab073cd67", "reason": "Complaints/enforcement procedure; not the extraterritorial applicability trigger."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restriction; not territorial scope."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "Processing principles; not the applicability trigger to foreign entities."}], "target_frame": {"addressee": {"span": "كل متحكم أو معالج متواجد خارج الدولة", "article": "Article 2(1)(ج)"}, "modality": {"span": "يجوز أن تسري أحكام هذا المرسوم بقانون", "article": "Article 2(1)"}, "action": {"span": "تسري أحكام هذا المرسوم بقانون على معالجة البيانات الشخصية", "article": "Article 2(1)"}, "scope": {"span": "معالجة البيانات الشخصية ... لأصحاب البيانات في الدولة", "article": "Article 2(1)(ج)"}, "condition": {"span": "يقوم بمزاولة أنشطة معالجة البيانات الشخصية لأصحاب البيانات في الدولة", "article": "Article 2(1)(ج)"}, "exception": {"span": "يجوز ألا تسري أحكام هذا المرسوم بقانون على ما يأتي: أ. البيانات الحكومية. ب. الجهات الحكومية المتحكمة بالبيانات الشخصية أو تلك التي تقوم بمعالجتها. ج. البيانات الشخصية لدى الجهات الأمنية والقضائية. د. صاحب البيانات الذي يقوم بمعالجة بياناته لأغراض شخصية. هـ. البيانات الشخصية الصحية التي لديها تشريع ينظم حماية ومعالجة تلك البيانات. و. البيانات والمعلومات الشخصية المصرفية والائتمانية التي لديها تشريع ينظم حماية ومعالجة تلك البيانات. ز. الشركات والمؤسسات الواقعة في المناطق الحرة في الدولة ولديها تشريعات خاصة بحماية البيانات الشخصية.", "article": "Article 2(2)"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller or processor not established in the Union", "target_value": "كل متحكم أو معالج متواجد خارج الدولة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 2(1)(ج)"}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "يجوز أن تسري أحكام هذا المرسوم بقانون", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 2(1)"}, {"slot": "action", "gdpr_value": "comply with this Regulation for the processing of personal data", "target_value": "تسري أحكام هذا المرسوم بقانون على معالجة البيانات الشخصية", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 2(1)"}, {"slot": "scope", "gdpr_value": "processing of personal data of data subjects who are in the Union", "target_value": "معالجة البيانات الشخصية ... لأصحاب البيانات في الدولة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 2(1)(ج)"}, {"slot": "condition", "gdpr_value": "processing relates to offering goods or services to data subjects in the Union, whether or not payment is required", "target_value": "يقوم بمزاولة أنشطة معالجة البيانات الشخصية لأصحاب البيانات في الدولة (دون قصرها على عرض السلع أو الخدمات)", "basis": "direct_textual", "verdict": "broader", "citation": "Article 2(1)(ج)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "استثناءات تطبيق القانون، بما في ذلك البيانات الحكومية والجهات الحكومية والبيانات لدى الجهات الأمنية والقضائية والمعالجة لأغراض شخصية وبعض القطاعات وتشريعات المناطق الحرة", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 2(2)"}, {"slot": "temporal", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed in the cited scope provision", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.68, "reasoning_note": "Article 2(1)(ج) establishes extraterritorial applicability to controllers/processors outside the UAE when they process personal data of data subjects in the UAE, without requiring an ‘offering goods or services’ nexus. This covers the GDPR scenario functionally but uses weaker ‘may apply’ language and is subject to enumerated carve-outs, so coverage of RU-009 is broader on condition yet weaker overall in modality.", "label": "C3", "ru_id": "RU-009", "gdpr_article": 3, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 7, "total": 19}, {"round": 3, "n_queries": 4, "new": 3, "total": 22}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The UAE provision in Article 2(1)(ج) does not explicitly state that the processing must relate to offering goods or services to data subjects in the UAE, which is a condition present in the GDPR requirement unit [RU-009].", "counter_evidence": [{"id": "743bfdd72ed773ff5ba9", "span": "ج. كل متحكم أو معالج متواجد خارج الدولة يقوم بمزاولة أنشطة معالجة البيانات الشخصية لأصحاب البيانات في الدولة.", "why": "The provision does not mention the condition of offering goods or services to data subjects in the UAE."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The UAE provisions do not explicitly state that a controller or processor not established in the UAE must comply with the regulation when processing personal data of data subjects in the UAE, in relation to offering goods or services to those data subjects.", "counter_evidence": [{"id": "743bfdd72ed773ff5ba9", "span": "المادة (2) نطاق سريان المرسوم بقانون 1. يجوز أن تسري أحكام هذا المرسوم بقانون على معالجة البيانات الشخصية سواء كلها أو جزء منها عن طريق وسائل الأنظمة الإلكترونية التي تعمل بشكل تلقائي وآلي، أو غيرها من الوسائل الأخرى، وذلك من قبل: ج. كل متحكم أو معالج متواجد خارج الدولة يقوم بمزاولة أنشطة معالجة البيانات الشخصية لأصحاب البيانات في الدولة.", "why": "The provision does not explicitly mention the condition of offering goods or services to data subjects in the UAE."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["743bfdd72ed773ff5ba9", "c34922f387019af45e42", "9630e6d967b64e07d339", "0cc06e3d3b107448da5a", "9c38ab11b550755816f5", "6201d16404c0d4b9f63d", "a079a5ac446830a74bfc", "9d65c2815c41a25064db", "ebfe638a86be87347658", "5d949837d7aab073cd67", "5bedab371a9fc40ba93a", "3cc10eb2dd7e95bdd0c2"], "n_llm_calls": 7, "latency_s": 320.55, "temperature": 0.0, "seed": 20260801, "id": "9604e6a1b9b794e230f3", "mutation_id": "e0cce40cc86006470803", "mtype": "modal_down", "required": "C3", "condition": "mutation"}
{"candidates_selected": ["4a1a7742c2a181be0640"], "candidates_excluded": [{"id": "ebfe638a86be87347658", "reason": "Data portability right; does not address objection to direct marketing."}, {"id": "877fafe0080725188d05", "reason": "Rectification/erasure; mentions objection as a trigger but does not establish the direct-marketing objection right."}, {"id": "717a67a0d311f88c5fd9", "reason": "Right to information about procedures including objection; procedural, not the substantive right."}, {"id": "c34922f387019af45e42", "reason": "Automated decision-making (including profiling) generally; not specific to direct marketing."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "General processing principles; no direct-marketing objection right."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Scope of the law; not about rights to object."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restriction; not the direct-marketing objection right."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification; unrelated to objection to marketing."}, {"id": "dec351a1e477287e3b22", "reason": "Controller contact methods; procedural facilitation only."}, {"id": "5d949837d7aab073cd67", "reason": "Complaints to authority; not the objection right."}, {"id": "fdfffc71ce002ff82134", "reason": "Data Protection Impact Assessment; unrelated to objection to marketing."}], "target_frame": {"addressee": {"span": "صاحب البيانات", "article": "Article 17(1)"}, "modality": {"span": "يجوز لصاحب البيانات الاعتراض", "article": "Article 17(1)"}, "action": {"span": "الاعتراض على معالجة بياناته الشخصية وإيقاف المعالجة", "article": "Article 17(1)"}, "scope": {"span": "لأغراض التسويق المباشر بما في ذلك التنميط ذات العلاقة بالتسويق المباشر", "article": "Article 17(1)"}, "condition": {"span": "إذا كانت المعالجة لأغراض التسويق المباشر بما في ذلك التنميط ذات العلاقة بالتسويق المباشر", "article": "Article 17(1)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": "إيقاف المعالجة", "article": "Article 17(1)"}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data subject", "target_value": "صاحب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 17(1)"}, {"slot": "modality", "gdpr_value": "right", "target_value": "يجوز لصاحب البيانات الاعتراض", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 17(1)"}, {"slot": "action", "gdpr_value": "object to processing of personal data concerning him or her for direct marketing", "target_value": "الاعتراض على معالجة بياناته الشخصية (وإيقاف المعالجة)", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 17(1)"}, {"slot": "scope", "gdpr_value": "processing for direct marketing purposes, including profiling related to such direct marketing", "target_value": "لأغراض التسويق المباشر بما في ذلك التنميط ذات العلاقة بالتسويق المباشر", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 17(1)"}, {"slot": "condition", "gdpr_value": "where personal data are processed for direct marketing purposes", "target_value": "إذا كانت المعالجة لأغراض التسويق المباشر", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 17(1)"}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "at any time", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "إيقاف المعالجة", "basis": "direct_textual", "verdict": "broader", "citation": "Art. 17(1)"}], "holistic_label": "covered", "confidence": 0.86, "reasoning_note": "Article 17(1) directly grants the data subject the ability to object to processing for direct marketing, expressly including related profiling. The only GDPR-specific element not textually mirrored is the explicit “at any time” temporal qualifier. The UAE text even goes further by indicating processing will be stopped upon objection.", "label": "C2", "ru_id": "RU-180", "gdpr_article": 21, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 9, "total": 9}, {"round": 2, "n_queries": 4, "new": 5, "total": 14}, {"round": 3, "n_queries": 4, "new": 2, "total": 16}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["4a1a7742c2a181be0640", "ebfe638a86be87347658", "877fafe0080725188d05", "717a67a0d311f88c5fd9", "c34922f387019af45e42", "3cc10eb2dd7e95bdd0c2", "743bfdd72ed773ff5ba9", "5bedab371a9fc40ba93a", "e05de90f481c9410c6e0", "dec351a1e477287e3b22", "5d949837d7aab073cd67", "fdfffc71ce002ff82134"], "n_llm_calls": 4, "latency_s": 161.69, "temperature": 0.0, "seed": 20260801, "id": "6b7ea9c16f44a3038f71", "mutation_id": "d6beb3c1cea9d966afe3", "mtype": "modal_down", "required": "C3", "condition": "mutation"}
{"candidates_selected": ["877fafe0080725188d05", "3cc10eb2dd7e95bdd0c2", "dec351a1e477287e3b22"], "candidates_excluded": [{"id": "717a67a0d311f88c5fd9", "reason": "Right to information about procedures (including correction) rather than the rectification right itself."}, {"id": "ebfe638a86be87347658", "reason": "Concerns data portability, not rectification."}, {"id": "c34922f387019af45e42", "reason": "Addresses automated decision-making, not rectification."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification duties; unrelated to rectification right."}, {"id": "5d949837d7aab073cd67", "reason": "Complaint mechanism; not the substantive rectification right."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restriction of processing; distinct from rectification."}, {"id": "4a1a7742c2a181be0640", "reason": "Right to object/stop processing; distinct from rectification."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Scope of law; not a rectification right."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment; not a rectification right."}], "target_frame": {"addressee": {"span": "يحق لصاحب البيانات", "article": "Article 15(1)"}, "modality": {"span": "يحق", "article": "Article 15(1)"}, "action": {"span": "طلب تصحيح بياناته الشخصية غير الدقيقة، أو استكمالها لدى المتحكم", "article": "Article 15(1)"}, "scope": {"span": "بياناته الشخصية غير الدقيقة", "article": "Article 15(1)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": "دون تأخير غير مبرر", "article": "Article 15(1)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data subject", "target_value": "صاحب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 15(1) [877fafe0080725188d05]"}, {"slot": "modality", "gdpr_value": "right", "target_value": "يحق", "basis": "direct_textual", "verdict": "covered", "citation": "Article 15(1) [877fafe0080725188d05]"}, {"slot": "action", "gdpr_value": "obtain from the controller the rectification of inaccurate personal data", "target_value": "طلب تصحيح بياناته الشخصية غير الدقيقة، أو استكمالها لدى المتحكم", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 15(1) [877fafe0080725188d05]"}, {"slot": "scope", "gdpr_value": "inaccurate personal data concerning the data subject", "target_value": "بياناته الشخصية غير الدقيقة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 15(1) [877fafe0080725188d05]"}, {"slot": "condition", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": "None expressed for rectification", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "without undue delay", "target_value": "دون تأخير غير مبرر", "basis": "direct_textual", "verdict": "covered", "citation": "Article 15(1) [877fafe0080725188d05]"}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.73, "reasoning_note": "The UAE text expressly gives the data subject a right to request correction and requires it to be handled without unjustified delay, matching the temporal element exactly. However, unlike the GDPR’s “right to obtain” rectification, the UAE provision frames the action as a right to request rectification, which is a weaker formulation. Controller accuracy obligations in Article 5(5) support correction generally but do not convert the data subject’s action into a right to obtain.", "label": "C1", "ru_id": "RU-140", "gdpr_article": 16, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 0, "total": 12}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The UAE jurisdiction does not explicitly state that the controller must rectify inaccurate personal data without undue delay.", "counter_evidence": [{"id": "877fafe0080725188d05", "span": "يحق لصاحب البيانات طلب تصحيح بياناته الشخصية غير الدقيقة، أو استكمالها لدى المتحكم دون تأخير غير مبرر", "why": "The provision only grants the data subject the right to request correction, but does not obligate the controller to rectify the data without undue delay."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict is not entirely supported by the provisions supplied, specifically with regards to the 'action' and 'temporal' slots.", "counter_evidence": [{"id": "877fafe0080725188d05", "span": "يحق لصاحب البيانات طلب تصحيح بياناته الشخصية غير الدقيقة، أو استكمالها لدى المتحكم دون تأخير غير مبرر", "why": "This provision only partially supports the analyst's verdict, and the 'action' slot is not fully covered."}, {"id": "3cc10eb2dd7e95bdd0c2", "span": "أ. أن تكون المعالجة بطريقة عادلة وشفافة ومشروعة.", "why": "This provision is not directly related to the right to rectification, and the 'action' slot is not fully covered."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["717a67a0d311f88c5fd9", "ebfe638a86be87347658", "877fafe0080725188d05", "c34922f387019af45e42", "e05de90f481c9410c6e0", "3cc10eb2dd7e95bdd0c2", "5d949837d7aab073cd67", "5bedab371a9fc40ba93a", "dec351a1e477287e3b22", "4a1a7742c2a181be0640", "743bfdd72ed773ff5ba9", "9630e6d967b64e07d339"], "n_llm_calls": 6, "latency_s": 267.35, "temperature": 0.0, "seed": 20260801, "id": "579bc9d14ef3bb5d6361", "mutation_id": "18ddbad20208d74cbeef", "mtype": "modal_down", "required": "C3", "condition": "mutation"}
{"candidates_selected": ["877fafe0080725188d05", "3cc10eb2dd7e95bdd0c2"], "candidates_excluded": [{"id": "c34922f387019af45e42", "reason": "Automated decision-making; not about rectification/completion rights."}, {"id": "717a67a0d311f88c5fd9", "reason": "Access-to-information right; only references procedures, not the substantive right to complete data."}, {"id": "5bedab371a9fc40ba93a", "reason": "Restriction of processing while accuracy is verified; not a right to complete data."}, {"id": "ebfe638a86be87347658", "reason": "Data portability; unrelated to completion of personal data."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification; unrelated to completion of personal data."}, {"id": "fdfffc71ce002ff82134", "reason": "Data protection impact assessment; unrelated to completion of personal data."}, {"id": "80f95c322bb3204c7f65", "reason": "Consent conditions; unrelated to rectification/completion right."}, {"id": "4a1a7742c2a181be0640", "reason": "Right to stop processing/object; not rectification/completion."}, {"id": "674524dee00496cb5de7", "reason": "Controller obligations (including recordkeeping and technical measures); not a data subject right to complete data."}, {"id": "2b337b9a20a4e33b6ad2", "reason": "Regulatory exemption power; not about rectification/completion."}], "target_frame": {"addressee": {"span": "صاحب البيانات", "article": "Article 15(1)"}, "modality": {"span": "يحق", "article": "Article 15(1)"}, "action": {"span": "طلب تصحيح بياناته الشخصية غير الدقيقة، أو استكمالها لدى المتحكم", "article": "Article 15(1)"}, "scope": {"span": "بياناته الشخصية", "article": "Article 15(1)"}, "condition": {"span": "كافية ومقتصرة على ما هو ضروري وفقاً للغرض الذي تمت المعالجة من أجله", "article": "Article 5(3)"}, "exception": {"span": null, "article": null}, "temporal": {"span": "دون تأخير غير مبرر", "article": "Article 15(1)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "صاحب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 15(1)", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "يحق", "basis": "direct_textual", "verdict": "covered", "citation": "Article 15(1)", "slot": "modality"}, {"gdpr_value": "have incomplete personal data completed, including by providing a supplementary statement", "target_value": "طلب ... أو استكمالها لدى المتحكم", "basis": "direct_textual", "verdict": "partial", "citation": "Article 15(1)", "slot": "action"}, {"gdpr_value": "incomplete personal data concerning the data subject", "target_value": "بياناته الشخصية (غير الدقيقة أو غير المكتملة) الخاصة بصاحب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 15(1)", "slot": "scope"}, {"gdpr_value": "taking into account the purposes of the processing", "target_value": "كافية ومقتصرة على ما هو ضروري وفقاً للغرض الذي تمت المعالجة من أجله (مبدأ عام، غير مقترن صراحة بحق الاستكمال)", "basis": "distributed", "verdict": "partial", "citation": "Article 5(3); Article 15(1)", "slot": "condition"}, {"gdpr_value": "None", "target_value": "None expressed for rectification/completion", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": "دون تأخير غير مبرر", "basis": "direct_textual", "verdict": "broader", "citation": "Article 15(1)", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.7, "reasoning_note": "UAE law expressly grants a right to complete personal data (Article 15(1)), but it does not mention completion via a supplementary statement. The text does not explicitly tie the right of completion to ‘taking into account the purposes of the processing’; purpose-adequacy appears as a general principle in Article 5(3), not as a condition attached to the right. Therefore, the action is covered in part, while the GDPR’s specific condition and method are not fully mirrored.", "label": "C2", "ru_id": "RU-141", "gdpr_article": 16, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 10, "total": 10}, {"round": 2, "n_queries": 4, "new": 7, "total": 17}, {"round": 3, "n_queries": 4, "new": 3, "total": 20}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The condition 'taking into account the purposes of the processing' for completing incomplete personal data is not explicitly covered in the UAE provisions as directly related to the right to complete data.", "counter_evidence": [{"id": "Article 15(1)", "span": "يحق لصاحب البيانات طلب تصحيح بياناته الشخصية غير الدقيقة، أو استكمالها لدى المتحكم دون تأخير غير مبرر", "why": "Directly supports the right to complete incomplete personal data but lacks explicit mention of considering the purposes of processing as a condition."}, {"id": "Article 5", "span": "كافية ومقتصرة على ما هو ضروري وفقاً للغرض الذي تمت المعالجة من أجله", "why": "Addresses the principle of processing being sufficient and necessary for the purpose, implying consideration of processing purposes but not directly as a condition for the right to complete data."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The UAE law does not explicitly condition the right to complete incomplete personal data on 'taking into account the purposes of the processing' as required by GDPR [RU-141], although it does discuss the importance of processing purposes in other contexts.", "counter_evidence": [{"id": "Article 15(1)", "span": "يحق لصاحب البيانات طلب تصحيح بياناته الشخصية غير الدقيقة، أو استكمالها لدى المتحكم دون تأخير غير مبرر", "why": "Directly supports the right to complete personal data but does not explicitly mention considering the purposes of processing."}, {"id": "Article 5(3)", "span": "كافية ومقتصرة على ما هو ضروري وفقاً للغرض الذي تمت المعالجة من أجله", "why": "Relates to the purpose of processing but in the context of data sufficiency and necessity, not directly to completing incomplete data."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["c34922f387019af45e42", "717a67a0d311f88c5fd9", "5bedab371a9fc40ba93a", "877fafe0080725188d05", "ebfe638a86be87347658", "3cc10eb2dd7e95bdd0c2", "e05de90f481c9410c6e0", "fdfffc71ce002ff82134", "80f95c322bb3204c7f65", "4a1a7742c2a181be0640", "674524dee00496cb5de7", "2b337b9a20a4e33b6ad2"], "n_llm_calls": 7, "latency_s": 347.04, "temperature": 0.0, "seed": 20260801, "id": "1d89d29dc33a8a6fb0c7", "mutation_id": "c8dc160d2a5cf83984e8", "mtype": "modal_down", "required": "C3", "condition": "mutation"}
{"candidates_selected": ["6ee1b976a5203de50c77", "4919410df7147924356b"], "candidates_excluded": [{"id": "557230873031d6e5cb2c", "reason": "Marketing-processing permission; does not address data-subject access rights."}, {"id": "c511c9bf7779067e64f4", "reason": "Lawful bases/derogations for collection/processing; not about data-subject access."}, {"id": "f8c6dae3f69fbe207307", "reason": "Conditions for disclosure to third parties; not the subject’s access right."}, {"id": "04322a32135a68c65bb5", "reason": "Processing for a realized interest/record-keeping; unrelated to access right."}, {"id": "21847c9e87d6df45a9a7", "reason": "Data quality/accuracy requirements; not an access right."}, {"id": "3a56eed81feb3655d1d1", "reason": "Public-interest processing by public bodies; not about access."}, {"id": "772962994f8e191e84a3", "reason": "Research/statistics processing conditions; not about access."}, {"id": "ea8306cd18f9261f6413", "reason": "Information at collection; does not grant the access right itself."}, {"id": "a7597ada8323b333cc94", "reason": "Collection principles (purpose limitation, data minimization); not access."}, {"id": "ce107f77eb9119ba01b0", "reason": "Privacy policy content (including rights/how to exercise); procedural, not the right itself."}], "target_frame": {"addressee": {"span": "صاحب البيانات الشخصية", "article": "Article 5 (6ee1b976a5203de50c77)"}, "modality": {"span": "يكون لصاحب البيانات الشخصية حق", "article": "Article 5 (6ee1b976a5203de50c77)"}, "action": {"span": "حق الوصول إلى بياناته الشخصية", "article": "Article 5 (6ee1b976a5203de50c77)"}, "scope": {"span": "بياناته الشخصية المتوافرة لدى جهة التحكم", "article": "Article 5 (6ee1b976a5203de50c77)"}, "condition": {"span": "المتوافرة لدى جهة التحكم", "article": "Article 5 (6ee1b976a5203de50c77)"}, "exception": {"span": "ألا تؤثر ممارسة الحق في الوصول إلى البيانات الشخصية سلباً على حقوق الغير، مثل: حقوق الملكية الفكرية أو الأسرار التجارية ... يجوز لجهة التحكم عند تمكين صاحب البيانات من الوصول إلى بياناته الشخصية التأكد من أن ذلك لا يتضمن الإفصاح عن بيانات شخصية تحدد هوية فرد آخر", "article": "Article 5 (6ee1b976a5203de50c77)"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "صاحب البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 5(1)", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "يكون لصاحب البيانات الشخصية حق", "basis": "direct_textual", "verdict": "covered", "citation": "Article 5(1)", "slot": "modality"}, {"gdpr_value": "obtain access to personal data concerning the data subject", "target_value": "حق الوصول إلى بياناته الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 5(1)", "slot": "action"}, {"gdpr_value": "personal data concerning the data subject", "target_value": "بياناته الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 5(1)", "slot": "scope"}, {"gdpr_value": "where the personal data concerning the data subject are being processed", "target_value": "المتوافرة لدى جهة التحكم", "basis": "conceptual", "verdict": "broader", "citation": "Article 5(1)", "slot": "condition"}, {"gdpr_value": "None", "target_value": "ألا تؤثر ممارسة الحق في الوصول على حقوق الغير ... وعدم الإفصاح عن بيانات تحدد هوية فرد آخر", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 5(1)(أ), 5(2)", "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "covered_with_qualifications", "confidence": 0.78, "reasoning_note": "KSA Article 5 expressly grants the data subject a right to access their personal data held by the controller. It does not condition the right on ‘processing’ but on data being available with the controller, and it adds limitations to protect third-party rights and identities. Article 6 (copy) complements but is not required to satisfy the RU’s core access right.", "label": "C1", "ru_id": "RU-123", "gdpr_article": 15, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 6, "total": 18}, {"round": 3, "n_queries": 4, "new": 2, "total": 20}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["557230873031d6e5cb2c", "6ee1b976a5203de50c77", "4919410df7147924356b", "c511c9bf7779067e64f4", "f8c6dae3f69fbe207307", "04322a32135a68c65bb5", "ce107f77eb9119ba01b0", "21847c9e87d6df45a9a7", "3a56eed81feb3655d1d1", "772962994f8e191e84a3", "ea8306cd18f9261f6413", "a7597ada8323b333cc94"], "n_llm_calls": 4, "latency_s": 210.44, "temperature": 0.0, "seed": 20260801, "id": "ee39331106fcda8b7e00", "mutation_id": "ea8cecff2ad420c67af1", "mtype": "modal_down", "required": "C3", "condition": "mutation"}
{"candidates_selected": ["085e0379de48628139e3"], "candidates_excluded": [{"id": "21847c9e87d6df45a9a7", "reason": "Addresses controller duty to verify accuracy generally, not a data subject right to restrict processing upon contestation."}, {"id": "04322a32135a68c65bb5", "reason": "Relates to processing for a legitimate interest and record-keeping; no right to restriction when accuracy is challenged."}, {"id": "c95a0b593cc554df0eae", "reason": "Record of processing obligations; no relevance to restriction right."}, {"id": "0922609ffbfd96a70f90", "reason": "Right to erasure; distinct from restriction of processing."}, {"id": "c511c9bf7779067e64f4", "reason": "Lawful bases and purpose compatibility; does not create a restriction right."}, {"id": "90da7bc2380e8f3f2fb8", "reason": "General obligation to respond to data subject requests; does not define the restriction right or its conditions."}, {"id": "ea8306cd18f9261f6413", "reason": "Transparency at collection; unrelated to restriction upon accuracy challenge."}, {"id": "9cfd6fbae8182dbc0028", "reason": "Right to be informed; no restriction right."}, {"id": "593beb6b1fe15a8fda31", "reason": "Processor selection and contracts; not about restriction or accuracy challenges."}, {"id": "952167864cc3b0d724c1", "reason": "Withdrawal of consent; distinct from restriction for accuracy verification."}, {"id": "d31b8876d3426a7c919a", "reason": "DPIA requirement; no bearing on the restriction right."}], "target_frame": {"addressee": {"span": "لِموضوع المعلومات الفردية", "article": "Article 7(1) [085e0379de48628139e3]"}, "modality": {"span": "لِموضوع المعلومات الفردية ... أن يلتمس", "article": "Article 7(1) [085e0379de48628139e3]"}, "action": {"span": "أن يلتمس حصر التعامل معها", "article": "Article 7(1) [085e0379de48628139e3]"}, "scope": {"span": "المعلومات الفردية ... حصر التعامل معها", "article": "Article 7(1) [085e0379de48628139e3]"}, "condition": {"span": "عند ثبوت افتقار ما بحوزة الكيان المسؤول عن تحديد مقاصد ووسائل التعامل معها إلى الدقة", "article": "Article 7(1) [085e0379de48628139e3]"}, "exception": {"span": "على ألا يُعتد بذلك الالتماس كلما خالف الإدلاء بهذه المعلومات مواد التشريع وهذه الضوابط", "article": "Article 7(1) [085e0379de48628139e3]"}, "temporal": {"span": "لمهلة يُتاح أثناءها لذلك الكيان الاستيثاق من سلامة المعلومات", "article": "Article 7(1) [085e0379de48628139e3]"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "موضوع المعلومات الفردية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7(1) [085e0379de48628139e3]", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "له أن يلتمس (حق في طلب)", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 7(1) [085e0379de48628139e3]", "slot": "modality"}, {"gdpr_value": "obtain from the controller the restriction of processing", "target_value": "يلتمس حصر التعامل مع المعلومات", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 7(1) [085e0379de48628139e3]", "slot": "action"}, {"gdpr_value": "processing of the data subject's personal data", "target_value": "التعامل مع المعلومات الفردية (البيانات الشخصية لصاحبها)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7(1) [085e0379de48628139e3]", "slot": "scope"}, {"gdpr_value": "the accuracy of the personal data is contested by the data subject", "target_value": "عند ثبوت افتقار البيانات إلى الدقة", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 7(1) [085e0379de48628139e3]", "slot": "condition"}, {"gdpr_value": "None", "target_value": "لا يُعتد بالتماس التقييد إذا خالف الإدلاء بالمعلومات التشريع والضوابط", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 7(1) [085e0379de48628139e3]", "slot": "exception"}, {"gdpr_value": "for a period enabling the controller to verify the accuracy of the personal data", "target_value": "لمهلة يُتاح أثناءها للكيان الاستيثاق من سلامة المعلومات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7(1) [085e0379de48628139e3]", "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.72, "reasoning_note": "Target text grants the data subject a right to request limiting processing for a period to verify accuracy, matching the temporal element. However, it is triggered only when inaccuracy is established (not merely contested) and allows disregarding the request in certain legal/conflict scenarios, and it frames the power as a request rather than an automatic right to obtain restriction.", "label": "C3", "ru_id": "RU-166", "gdpr_article": 18, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 10, "total": 22}, {"round": 3, "n_queries": 4, "new": 4, "total": 26}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["21847c9e87d6df45a9a7", "04322a32135a68c65bb5", "c95a0b593cc554df0eae", "0922609ffbfd96a70f90", "c511c9bf7779067e64f4", "90da7bc2380e8f3f2fb8", "085e0379de48628139e3", "ea8306cd18f9261f6413", "9cfd6fbae8182dbc0028", "593beb6b1fe15a8fda31", "952167864cc3b0d724c1", "d31b8876d3426a7c919a"], "n_llm_calls": 4, "latency_s": 175.4, "temperature": 0.0, "seed": 20260801, "id": "a8b442b515faa1e35ae7", "mutation_id": "e1f6364519359c006533", "mtype": "paraphrase", "required": "C1", "condition": "mutation"}
{"candidates_selected": ["17d4b446ea6ed7965d08"], "candidates_excluded": [{"id": "0ec82f88effbafd6a911", "reason": "Health-data specific processing controls; does not address response periods or extensions for data subject requests."}, {"id": "f8c6dae3f69fbe207307", "reason": "Sets disclosure grounds; not about timelines or extensions for responding to rights requests."}, {"id": "7ddbf4e54143664b8b8b", "reason": "Regulates disclosure procedures; no rule on extending response time to data subject requests."}, {"id": "90da7bc2380e8f3f2fb8", "reason": "General duty to respond within a period set by regulations; no express permission or maximum for extensions."}, {"id": "cf114b62f7d3612bb117", "reason": "Authority complaints handling; not about controller response-time extensions."}, {"id": "085e0379de48628139e3", "reason": "Rectification right procedures; no extension permission or timeframe."}, {"id": "0922609ffbfd96a70f90", "reason": "Erasure obligations; no response-time extension rule."}, {"id": "ea8306cd18f9261f6413", "reason": "Transparency at collection; not about responding to rights requests or extending deadlines."}, {"id": "1c2ee470fae7b5023951", "reason": "Administrative issuance of regulations; no substantive rule on extensions."}, {"id": "074719119e1aacb53bea", "reason": "Criminal penalties; unrelated to response-time extensions."}, {"id": "952167864cc3b0d724c1", "reason": "Withdrawal of consent; no rule on extending response timelines."}], "target_frame": {"addressee": {"span": "المسؤول عن تحديد غايات التعامل مع المعطيات", "article": "Article 3(1)"}, "modality": {"span": "يجوز لها", "article": "Article 3(1)(أ)"}, "action": {"span": "إطالة ذلك الأجل", "article": "Article 3(1)(أ)"}, "scope": {"span": "لدى تسلّمه التماساً من موضوع المعطيات الفردية بشأن استحقاقاته المقررة في القانون", "article": "Article 3(1)"}, "condition": {"span": "إذا استلزم الإنفاذ عناءً زائداً لم يكن محسوباً أو كان استثنائياً، أو إذا وردت إليها التماسات عديدة من موضوع المعطيات الفردية، شريطة إخطار موضوع المعطيات الفردية سلفاً بالإطالة وأسبابها.", "article": "Article 3(1)(أ)"}, "exception": {"span": null, "article": null}, "temporal": {"span": "على ألا تتخطى الإطالة 30 يوماً أخرى", "article": "Article 3(1)(أ)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller", "target_value": "المسؤول عن تحديد غايات التعامل مع المعطيات (functional equivalent of controller)", "basis": "conceptual", "verdict": "covered", "citation": "Article 3(1): \"المسؤول عن تحديد غايات التعامل مع المعطيات\""}, {"slot": "modality", "gdpr_value": "permission", "target_value": "يجوز لها (may)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 3(1)(أ): \"يجوز لها\"", "action": {"slot": "action", "gdpr_value": "extend the one-month response period by two further months", "target_value": "إطالة ذلك الأجل (extend the period)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 3(1)(أ): \"إطالة ذلك الأجل\""}, "scope": {"slot": "scope", "gdpr_value": "responding to requests under Articles 15 to 22", "target_value": "requests from the data subject regarding rights granted by the law", "basis": "conceptual", "verdict": "covered", "citation": "Article 3(1): \"لدى تسلّمه التماساً من موضوع المعطيات الفردية بشأن استحقاقاته المقررة في القانون\""}, "condition": {"slot": "condition", "gdpr_value": "where necessary, taking into account the complexity and number of the requests", "target_value": "إذا استلزم الإنفاذ عناءً زائداً ... أو كان استثنائياً، أو إذا وردت التماسات عديدة؛ مع إخطار مسبق بالأسباب", "basis": "conceptual", "verdict": "covered", "citation": "Article 3(1)(أ): \"إذا استلزم الإنفاذ عناءً زائداً ... أو كان استثنائياً، أو إذا وردت إليها التماسات عديدة ... شريطة إخطار ...\""}, "exception": {"slot": "exception", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": "No exception stated in Article 3(1)(أ)."}, "temporal": {"slot": "temporal", "gdpr_value": "extension of up to two further months", "target_value": "extension not to exceed 30 additional days", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 3(1)(أ): \"على ألا تتخطى الإطالة 30 يوماً أخرى\""}, "consequence": {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": "No distinct consequence specified."}, "modality_fix": null}], "holistic_label": "narrower", "confidence": 0.78, "reasoning_note": "KSA Article 3(1)(a) grants a permission to extend the 30-day response period when complexity or multiple requests justify it, akin to GDPR Art. 11’s rationale. However, the maximum extension is explicitly capped at 30 additional days, not two months. This directly supports the reviewer’s objection.", "label": "C1", "ru_id": "RU-035", "gdpr_article": 11, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 11, "total": 23}, {"round": 3, "n_queries": 4, "new": 2, "total": 25}], "sufficiency_met": true, "slot_completeness": 0.25, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The KSA jurisdiction's provision for extending the response period is not equivalent to the GDPR requirement, as it only allows for an extension of up to 30 days, whereas the GDPR allows for an extension of up to two further months.", "counter_evidence": [{"id": "17d4b446ea6ed7965d08", "span": "على ألا تتخطى الإطالة 30 يوماً أخرى", "why": "This provision indicates that the KSA jurisdiction only allows for an extension of up to 30 days, which is not equivalent to the GDPR requirement of up to two further months."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The KSA jurisdiction's extension period does not match the GDPR's two-month extension period.", "counter_evidence": [{"id": "17d4b446ea6ed7965d08", "span": "على ألا تتخطى الإطالة 30 يوماً أخرى", "why": "The KSA jurisdiction's Article 3 limits the extension period to 30 days, whereas the GDPR allows for an extension of up to two months."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["0ec82f88effbafd6a911", "f8c6dae3f69fbe207307", "7ddbf4e54143664b8b8b", "17d4b446ea6ed7965d08", "90da7bc2380e8f3f2fb8", "cf114b62f7d3612bb117", "085e0379de48628139e3", "0922609ffbfd96a70f90", "ea8306cd18f9261f6413", "1c2ee470fae7b5023951", "074719119e1aacb53bea", "952167864cc3b0d724c1"], "n_llm_calls": 7, "latency_s": 320.74, "temperature": 0.0, "seed": 20260801, "id": "245f07e1f86442731b31", "mutation_id": "e3cc33a734cf44ca31cb", "mtype": "paraphrase", "required": "C1", "condition": "mutation"}
{"candidates_selected": ["a079a5ac446830a74bfc", "6201d16404c0d4b9f63d", "0cc06e3d3b107448da5a", "743bfdd72ed773ff5ba9", "717a67a0d311f88c5fd9"], "candidates_excluded": [{"id": "674524dee00496cb5de7", "reason": "Obligations of the controller; does not set the cross-border transfer conditions applicable to processors."}, {"id": "ebfe638a86be87347658", "reason": "Data portability right; not about prohibitions or conditions for cross-border transfers."}, {"id": "c34922f387019af45e42", "reason": "Automated processing/right to object; unrelated to cross-border transfer conditions."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restriction; not about cross-border transfers."}, {"id": "877fafe0080725188d05", "reason": "Right to rectification/erasure; not about cross-border transfers."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment; not about cross-border transfers."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "General processing principles; does not specify the cross-border transfer prohibition/conditions."}], "target_frame": {"addressee": {"span": "المادة (8) الالتزامات العامة للمعالج يجب على المعالج الالتزام بما يأتي:", "article": "Article 8 (chapeau)"}, "modality": {"span": "يجوز نقل البيانات الشخصية إلى خارج الدولة في الأحوال الآتية المعتمدة من المكتب:", "article": "Article 22 (chapeau)"}, "action": {"span": "نقل ومشاركة البيانات الشخصية عبر الحدود ... يجوز نقل البيانات الشخصية إلى خارج الدولة", "article": "Article 22 (title; chapeau)"}, "scope": {"span": "نقل ومشاركة البيانات الشخصية عبر الحدود لأغراض المعالجة", "article": "Articles 22–23 (titles)"}, "condition": {"span": "إجراء المعالجة وتنفيذها طبقاً للقواعد والاشتراطات والضوابط المحددة بهذا المرسوم بقانون ولائحته التنفيذية أو التي يصدر بموجبها تعليمات من المكتب.", "article": "Article 8(9)"}, "exception": {"span": "استثناءً مما ورد في المادة (22) من هذا المرسوم بقانون، يجوز نقل البيانات الشخصية إلى خارج الدولة في الحالات التالية:", "article": "Article 23(1) (chapeau)"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "processor", "target": "Processor is directly regulated (\"يجب على المعالج...\") and subject to the law’s rules.", "basis": "distributed", "verdict": "covered", "citation": "Article 8 (chapeau); Article 2(1)(b)-(c)", "slot": "addressee"}, {"gdpr": "prohibition", "target": "Permission to transfer only in enumerated cases (implying prohibition otherwise).", "basis": "conceptual", "verdict": "covered", "citation": "Article 22 (chapeau); Article 23(1) (chapeau)", "slot": "modality"}, {"gdpr": "transfer personal data to a third country or to an international organisation, including onward transfers", "target": "Transfer/sharing of personal data across borders to outside the State.", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 22 (title; chapeau); Article 23 (title; chapeau)", "slot": "action"}, {"gdpr": "personal data undergoing or intended for processing after transfer; includes onward transfers from the third country/international organisation", "target": "Cross-border transfer for processing purposes.", "basis": "direct_textual", "verdict": "narrower", "citation": "Articles 22–23 (titles)", "slot": "scope"}, {"gdpr": "subject to the other provisions of the GDPR", "target": "Processing must be carried out in accordance with the Decree-Law and its executive regulations/instructions.", "basis": "conceptual", "verdict": "partial", "citation": "Article 8(9)", "slot": "condition"}, {"gdpr": "when the conditions laid down in Chapter V are complied with", "target": "Transfer allowed in the cases/conditions set out for adequate and non-adequate destinations.", "basis": "direct_textual", "verdict": "covered", "citation": "Article 22 (chapeau and items); Article 23(1)-(2)", "slot": "exception"}, {"gdpr": "None", "target": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": "No specific sanction or consequence stated in these articles.", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.64, "reasoning_note": "While the UAE PDPL does not expressly refer to international organisations or onward transfers, it functionally prohibits any cross-border transfer unless Articles 22–23 conditions are met, and processors are bound via Article 2(1)(b)-(c) and Article 8(9). Article 8 directly addresses the processor (“يجب على المعالج...”), and Article 8(7) also contemplates processor records for cross-border data movement, tying processors to the transfer regime. Accordingly, the core prohibition is covered, but the target text is narrower regarding IOs and onward transfers.", "label": "C4", "ru_id": "RU-546", "gdpr_article": 44, "jurisdiction": "UAE", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 2, "total": 14}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The UAE law does not explicitly mention international organizations in its provisions related to the transfer of personal data across borders, and the condition for transferring personal data is not fully equivalent to the GDPR's provision.", "counter_evidence": [{"id": "a079a5ac446830a74bfc", "span": "المادة (22) نقل ومشاركة البيانات الشخصية عبر الحدود لأغراض المعالجة في حال وجود مستوى حماية ملائم", "why": "This provision does not explicitly mention international organizations."}, {"id": "0cc06e3d3b107448da5a", "span": "المادة (8) الالتزامات العامة للمعالج", "why": "This provision does not explicitly state that the transfer of personal data is subject to the other provisions of the law."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The UAE law does not explicitly mention international organizations or onward transfers in the context of transferring personal data across borders, and the processor is not directly addressed in Article 8(1).", "counter_evidence": [{"id": "a079a5ac446830a74bfc", "span": "Article 22 (title; chapeau)؛ Art. 23 (title; chapeau)", "why": "The UAE law only mentions the transfer of personal data across borders to outside the state, without explicitly mentioning international organizations or onward transfers."}, {"id": "0cc06e3d3b107448da5a", "span": "Article 8(1)", "why": "The processor is not directly addressed in Article 8(1)."}, {"id": "0cc06e3d3b107448da5a", "span": "Article 8(9)", "why": "The UAE law does not explicitly reference the other provisions of the GDPR in the context of subjecting the transfer of personal data."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["6201d16404c0d4b9f63d", "0cc06e3d3b107448da5a", "a079a5ac446830a74bfc", "674524dee00496cb5de7", "ebfe638a86be87347658", "c34922f387019af45e42", "5bedab371a9fc40ba93a", "743bfdd72ed773ff5ba9", "3cc10eb2dd7e95bdd0c2", "717a67a0d311f88c5fd9", "877fafe0080725188d05", "9630e6d967b64e07d339"], "n_llm_calls": 6, "latency_s": 312.92, "temperature": 0.0, "seed": 20260801, "id": "d9684b8b6ef65dc3b8aa", "mutation_id": "f12e85d0bd48896a917c", "mtype": "modal_down", "required": "C3", "condition": "mutation"}
{"candidates_selected": ["fcbd13532c69b340214e"], "candidates_excluded": [{"id": "6c76988b817262e3e312", "reason": "Addresses controller duties (privacy reviews, training, audits, monitoring) rather than imposing security-measure obligations on the processor."}, {"id": "85d05fccf5b4f57eceaf", "reason": "Imposes security precautions on the controller, not the processor; does not establish a processor obligation to implement security measures."}, {"id": "75db9db720e9e34a1148", "reason": "Regulates the controller’s disclosure/transfer to the processor; does not set processor security-measure duties."}, {"id": "f5c366135483fe580381", "reason": "Breach notification duty on the controller; not a processor security obligation."}, {"id": "455aae046cacf7979576", "reason": "Data minimisation/accuracy/retention for the controller; unrelated to processor security measures."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "Public-interest processing exemptions; not about processor security obligations."}, {"id": "192caaa530952a30ad50", "reason": "Regulator’s functions; not a substantive processor security obligation."}, {"id": "89d1bb9a58e65b732117", "reason": "Transparency duties on the controller; not about processor security measures."}], "target_frame": {"addressee": {"span": "لكل من المراقب والمعالج", "article": "Article 13"}, "modality": {"span": "يجوز", "article": "Article 13"}, "action": {"span": "اتخاذ الاحتياطات اللازمة لحماية البيانات الشخصية من الضياع أو التلف أو التعديل أو الإفشاء، أو الوصول إليها، أو استخدامها بشكل عارض أو غير مشروع", "article": "Article 13"}, "scope": {"span": "حماية البيانات الشخصية", "article": "Article 13"}, "condition": {"span": "ويجوز أن تكون تلك الاحتياطات متناسبة مع طبيعة وأهمية البيانات الشخصية المراد حمايتها", "article": "Article 13"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "processor", "target_value": "controller and processor", "basis": "direct_textual", "verdict": "broader", "citation": "Article 13: \"لكل من المراقب والمعالج\""}, {"slot": "modality", "gdpr_value": "obligation (shall)", "target_value": "permission (may)", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 13: \"يجوز\""}, {"slot": "action", "gdpr_value": "implement appropriate technical and organisational measures to ensure a level of security appropriate to the risk", "target_value": "take necessary precautions to protect personal data from loss, damage, alteration, disclosure, access, or accidental/unlawful use", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13: \"اتخاذ الاحتياطات اللازمة لحماية البيانات الشخصية ...\""}, {"slot": "scope", "gdpr_value": "processing of personal data", "target_value": "protection of personal data", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13: \"البيانات الشخصية\""}, {"slot": "condition", "gdpr_value": "taking into account state of the art, implementation costs, and the nature, scope, context and purposes of processing, as well as risks of varying likelihood and severity to the rights and freedoms of natural persons", "target_value": "may be proportionate to the nature and importance of the personal data", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 13: \"ويجوز أن تكون تلك الاحتياطات متناسبة مع طبيعة وأهمية البيانات الشخصية\""}, {"slot": "exception", "gdpr_value": "None", "target_value": "none expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "none expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "none expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.72, "reasoning_note": "Article 13 explicitly includes the processor and describes taking necessary precautions, but uses permissive language (may) rather than an obligation and provides only a limited proportionality factor. Accordingly, addressee is broader (includes controller and processor), modality is weaker, and the action is substantively covered.", "label": "C3", "ru_id": "RU-316", "gdpr_article": 32, "jurisdiction": "QAT", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 8, "total": 8}, {"round": 2, "n_queries": 4, "new": 1, "total": 9}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The target jurisdiction's provisions do not fully align with the GDPR requirements, particularly with regards to modality and scope.", "counter_evidence": [{"id": "fcbd13532c69b340214e", "span": "يجوز لكل من المراقب والمعالج اتخاذ الاحتياطات اللازمة لحماية البيانات الشخصية من الضياع أو التلف أو التعديل أو الإفشاء، أو الوصول إليها، أو استخدامها بشكل عارض أو غير مشروع.", "why": "The provision uses 'may' (يجوز) instead of 'shall', implying permission rather than obligation."}, {"id": "fcbd13532c69b340214e", "span": "ويجوز أن تكون تلك الاحتياطات متناسبة مع طبيعة وأهمية البيانات الشخصية المراد حمايتها.", "why": "The provision only mentions proportionality to the nature and importance of the personal data, whereas the GDPR requirement mentions a broader range of factors."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's slot verdicts for addressee, modality, and action are not entirely accurate.", "counter_evidence": [{"id": "fcbd13532c69b340214e", "span": "يجوز لكل من المراقب والمعالج اتخاذ الاحتياطات اللازمة لحماية البيانات الشخصية", "why": "This provision explicitly includes the processor and mentions taking necessary precautions."}, {"id": "85d05fccf5b4f57eceaf", "span": "يتعين على المراقب الالتزام بما يلي: 1- معالجة البيانات الشخصية بأمانة ومشروعية.", "why": "This provision uses a stronger modality (must) when addressing the controller's obligations."}], "confidence": 0.8}], "n_candidates": 9, "candidate_ids": ["fcbd13532c69b340214e", "6c76988b817262e3e312", "85d05fccf5b4f57eceaf", "75db9db720e9e34a1148", "f5c366135483fe580381", "455aae046cacf7979576", "3f5cc5a2c4af5fb90388", "192caaa530952a30ad50", "89d1bb9a58e65b732117"], "n_llm_calls": 6, "latency_s": 287.91, "temperature": 0.0, "seed": 20260801, "id": "00848cf8640d9abec4ed", "mutation_id": "16b28ad7770285adac93", "mtype": "modal_down", "required": "C3", "condition": "mutation"}
{"candidates_selected": ["b983a5ed0e1c7a2b779a", "62dc9e8ad2aa962982ad"], "candidates_excluded": [{"id": "9f3112d28a1b850ba61f", "reason": "Addresses transparency, withdrawal, and marketing-consent disclosures; does not impose or describe an ability to demonstrate consent."}, {"id": "2c020ba48e817e4f4c7a", "reason": "Focuses on security and general records of processing; does not require keeping or demonstrating records of individual consents."}], "target_frame": {"addressee": {"span": "يجب على مقدم الخدمة", "article": "Article 2"}, "modality": {"span": "وفي جميع الأحوال يجوز أن يكون لمقدم الخدمة القدرة على إثبات موافقة صاحب البيانات على معالجة البيانات.", "article": "Article 3"}, "action": {"span": "القدرة على إثبات موافقة صاحب البيانات على معالجة البيانات", "article": "Article 3"}, "scope": {"span": "1. الحصول على موافقة المستخدم صاحب البيانات.", "article": "Article 3"}, "condition": {"span": "يجوز أن تكون جمع ومعالجة البيانات مشروعة ... في حال توافر إحدى الحالات التالية: 1. الحصول على موافقة المستخدم صاحب البيانات.", "article": "Article 3"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "controller", "target": "مقدم الخدمة", "basis": "conceptual", "verdict": "covered", "citation": "Art. 2", "slot": "addressee"}, {"gdpr": "obligation", "target": "يجوز (may/permitted)", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Art. 3: \"وفي جميع الأحوال يجوز أن يكون لمقدم الخدمة القدرة...\"", "slot": "modality"}, {"gdpr": "be able to demonstrate that the data subject has consented to the processing of their personal data", "target": "القدرة على إثبات موافقة صاحب البيانات على معالجة البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 3", "slot": "action"}, {"gdpr": "processing of personal data based on consent", "target": "الحصول على موافقة المستخدم صاحب البيانات (consent as a lawful basis)", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 3(1)", "slot": "scope"}, {"gdpr": "Where processing is based on consent", "target": "المشروعية إذا توافرت إحدى الحالات ومنها: الحصول على موافقة المستخدم صاحب البيانات", "basis": "distributed", "verdict": "partial", "citation": "Art. 3 (lawful bases list) + final sentence on ability to prove consent without tying it to the consent basis", "slot": "condition"}, {"gdpr": "None", "target": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr": "None", "target": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "weaker_modality", "confidence": 0.74, "reasoning_note": "Art. 3 uses the permissive verb يجوز (may), not an obligation, for the provider’s ability to prove consent, while GDPR Art. 7(1) imposes a duty to be able to demonstrate consent. Art. 2 obliges obtaining consent, but it does not convert the ability-to-demonstrate clause into an obligation. Therefore, the modality is weaker than the GDPR requirement.", "label": "C3", "ru_id": "RU-017", "gdpr_article": 7, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 2, "total": 2}, {"round": 2, "n_queries": 4, "new": 2, "total": 4}, {"round": 3, "n_queries": 4, "new": 0, "total": 4}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provision uses permissive language and does not explicitly impose an obligation to demonstrate consent", "counter_evidence": [{"id": "b983a5ed0e1c7a2b779a", "span": "يجوز أن يكون لمقدم الخدمة القدرة على إثبات موافقة صاحب البيانات على معالجة البيانات", "why": "The provision uses permissive language, indicating a possibility or permission rather than an obligation"}, {"id": "2c020ba48e817e4f4c7a", "span": "يجب على مقدم الخدمة وقبل توفير الخدمة للمستخدم أن يقوم بالتالي: ... الحصول على موافقة طالب الخدمة على جمع أو معالجة البيانات الشخصية", "why": "This provision suggests an obligation to obtain consent, but does not explicitly state that the service provider must demonstrate consent"}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's claim of a weaker modality is unsupported by the provisions.", "counter_evidence": [{"id": "b983a5ed0e1c7a2b779a", "span": "في جميع الأحوال يجوز أن يكون لمقدم الخدمة القدرة على إثبات موافقة صاحب البيانات على معالجة البيانات", "why": "This provision suggests that the service provider has the ability to demonstrate consent, but it does not necessarily imply an obligation to do so."}, {"id": "62dc9e8ad2aa962982ad", "span": "يجب على مقدم الخدمة وقبل توفير الخدمة للمستخدم أن يقوم بالتالي: ... 2. الحصول على موافقة طالب الخدمة على جمع أو معالجة البيانات الشخصية", "why": "This provision implies an obligation to obtain consent."}], "confidence": 0.8}], "n_candidates": 4, "candidate_ids": ["b983a5ed0e1c7a2b779a", "9f3112d28a1b850ba61f", "62dc9e8ad2aa962982ad", "2c020ba48e817e4f4c7a"], "n_llm_calls": 7, "latency_s": 339.65, "temperature": 0.0, "seed": 20260801, "id": "14855a2cb92cec0ba1b9", "mutation_id": "c9db0e97a5a89b7aff8d", "mtype": "modal_down", "required": "C3", "condition": "mutation"}
