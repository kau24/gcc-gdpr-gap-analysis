{"candidates_selected": [], "candidates_excluded": [{"id": "601ddc5fd8dcb81306cb", "reason": "Sets the Board’s general governance and regulatory powers; contains no duty or mechanism for the Authority to give advice to controllers on specific processing operations or in a prior-consultation context."}, {"id": "0c6c8a278f0b3b395e23", "reason": "Establishes an appeals committee and related judicial procedures; not about advisory functions on processing operations."}, {"id": "daaf1e5a7eedf0d7755e", "reason": "Details investigation procedures; does not provide for the Authority to give advice on contemplated processing operations."}, {"id": "3d71a23a91370cadf799", "reason": "Regulates processing of criminal data and authorizes the Board to set safeguards; no advisory obligation to controllers on processing operations."}, {"id": "a3c79315ae2d7920a38f", "reason": "Provides a complaints mechanism to the Authority; does not establish an advisory role on processing operations."}, {"id": "f8344697d1f1dc661161", "reason": "Sets conditions and exceptions for processing sensitive data (including references to prior authorization), but does not require the Authority to give advice on processing operations."}, {"id": "129b122a7d0386567e65", "reason": "Describes the CEO’s organizational powers and reporting duties; no text on advising controllers about processing operations."}, {"id": "4f0c7ea198f3c5b3627c", "reason": "Imposes contractual safeguards for cross-border transfers and a permit requirement; does not create an advisory function."}, {"id": "4415e9a46823d9615000", "reason": "Concerns deputizing judicial officers for investigations; unrelated to advising on processing operations."}, {"id": "6b500d26673394f3d7e6", "reason": "Grants data subjects rectification/blocking/erasure rights; no advisory duty for the Authority."}, {"id": "2ef716a5a0437defc8f2", "reason": "Provides transfer exceptions and potential Authority authorization; does not speak to giving advice on processing 