ce": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "churches and religious associations", "target_value": "جهة التحكم (all controllers, which would include any religious entities acting as controllers)", "basis": "conceptual", "verdict": "broader", "citation": "Article 30(3)"}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "على جهة التحكم التعاون", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30(3)"}, {"slot": "action", "gdpr_value": "be subject to the supervision of an independent supervisory authority", "target_value": "تكون الجهة المختصة الجهة المشرفة على تطبيق أحكام النظام واللوائح؛ ولها طلب الوثائق أو المعلومات اللازمة من جهة التحكم للتأكد من التزامها", "basis": "distributed", "verdict": "partial", "citation": "Article 30(1), 30(4)(أ); see also Article 37(1)"}, {"slot": "scope", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "condition", "gdpr_value": "they apply comprehensive rules in accordance with Article 91(1)", "target_value": "No equivalent condition; supervision applies generally to controllers", "basis": "absent", "verdict": "broader", "citation": "Article 30(1)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "temporal", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": ""}], "holistic_label": "partial", "confidence": 0.58, "reasoning_note": "KSA PDPL establishes a supervisory mechanism via the competent authority (Art. 30) with oversight powers that apply to all controllers, which could include religious entities. However, the text does not create a church/religious-specific regime contingent on applying their own comprehensive rules, nor does it state that the supervising authority is independent. Hence only partial textual equivalence to GDPR Art. 91(2).", "label": "C4", "ru_id": "RU-977", "gdpr_article": 91, "jurisdiction": "KSA", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 7, "total": 19}, {"round": 3, "n_queries": 4, "new": 9, "total": 28}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "The presence of a supervisory mechanism in the KSA jurisdiction, but the need for clearer application to churches and religious associations under specific conditions.", "counter_evidence": [{"id": "d9a05a425b46428120ee", "span": "Article 30(1), Article 30(3), Article 30(4)", "why": "These provisions establish a framework for supervision by an independent authority, which could potentially apply to churches and religious associations under certain conditions."}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["f8c6dae3f69fbe207307", "c511c9bf7779067e64f4", "4ba7db7571a9e08625c7", "04322a32135a68c65bb5", "d9a05a425b46428120ee", "ce107f77eb9119ba01b0", "7ddbf4e54143664b8b8b", "ba8aef540689169aa848", "62cc177254bb6a5bed90", "f10a3fa820a149065de0", "e33bde5f24e463a1e604", "04f45ac99bac1acaa486"], "n_llm_calls": 6, "latency_s": 501.15, "temperature": 0.7, "seed": 20260801, "id": "4070b144343301133b0f", "condition": "stability", "rep": 0}
