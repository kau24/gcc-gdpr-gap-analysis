916", "gdpr_article": 79, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 4, "total": 4}, {"round": 2, "n_queries": 4, "new": 10, "total": 14}, {"round": 3, "n_queries": 4, "new": 4, "total": 18}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "Potential for counterpart under different terminology or distribution across provisions", "counter_evidence": [{"id": "ca31304d94e06fa35850", "span": "Article 29", "why": "Implies a judicial mechanism for addressing violations"}, {"id": "850decaffbbae78d371d", "span": "Article 32", "why": "Suggests a framework for enforcing the Law"}, {"id": "85e94dba24cbfb8955cd", "span": "Article 6", "why": "Provides individual rights that imply a form of redress"}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["75db9db720e9e34a1148", "3f5cc5a2c4af5fb90388", "32f2136681f29047cd6a", "85e94dba24cbfb8955cd", "ca31304d94e06fa35850", "f169b712b14aea8718ee", "dce663972f2d5e58176e", "6c76988b817262e3e312", "850decaffbbae78d371d", "192caaa530952a30ad50", "83fae53ff99059f02f05", "85d05fccf5b4f57eceaf"], "n_llm_calls": 6, "latency_s": 590.51, "temperature": 0.7, "seed": 20260803, "id": "836176124f5e7c827232", "condition": "stability", "rep": 2}
{"candidates_selected": ["952167864cc3b0d724c1", "0922609ffbfd96a70f90"], "candidates_excluded": [{"id": "c511c9bf7779067e64f4", "reason": "General purpose-limitation and lawful-basis rules; no data-subject right to restriction or mechanism triggered by unlawfulness."}, {"id": "04322a32135a68c65bb5", "reason": "Administrative requirement to document a legitimate interest; unrelated to restriction of processing."}, {"id": "f8c6dae3f69fbe207307", "reason": "Conditions for disclosure; does not create a right to restriction."}, {"id": "ea8306cd18f9261f6413", "reason": "Transparency at collection; no restriction right."}, {"id": "4919410df7147924356b", "reason": "Right to a copy; no restriction right."}, {"id": "6ee1b976a5203de50c77", "reason": "Right of access; no restriction right."}, {"id": "a79606d0fb564d3b2b5d", "reason": "Breach notification; unrelated to restriction."}, {"id": "c95a0b593cc554df0eae", "reason": "Record-keeping; no restriction right."}, {"id": "90da7bc2380e8f3f2fb8", "reason": "Procedural duty to respond to rights; does not establish a right to restriction or the specific conditions for it."}, {"id": "ba8aef540689169aa848", "reason": "Conditions for processing when data not collected from the subject; no restriction right."}], "target_frame": {"addressee": {"span": "لصاحب البيانات الشخصية العدول عن موافقته على معالجة بياناته الشخصية", "article": "Article 12(1)"}, "modality": {"span": "لصاحب البيانات الشخصية العدول عن موافقته", "article": "Article 12(1)"}, "action": {"span": "فيجب على جهة التحكم إيقاف المعالجة", "article": "Article 12(3)"}, "scope": {"span": "معالجة بياناته الشخصية", "article": "Article 12(1)"}, "condition": {"span": "إذا علمت أن البيانات الشخصية تجرى معالجتها بطريقة مخالفة للنظام", "article": "Article 8(1)(د)"}, "exception": {"span": null, "article": null}, "temporal": {"span": "دون تأخير غير مبرر", "article": "Article 12(3)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "صاحب البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 12(1)", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "لصاحب البيانات الشخصية العدول عن موافقته (حق العدول)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 12(1)", "slot": "modality"}, {"gdpr_value": "obtain from the controller the restriction of processing", "target_value": "إيقاف المعالجة (توقف كامل لا تقييد جزئي)", "basis": "conceptual", "verdict": "broader", "citation": "Article 12(3)", "slot": "action"}, {"gdpr_value": "processing of the data subject's personal data", "target_value": "معالجة بياناته الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 12(1)", "slot": "scope"}, {"gdpr_value": "the processing is unlawful and the data subject opposes erasure of the personal data and requests restriction of their use instead", "target_value": "إذا علمت أن البيانات الشخصية تجرى معالجتها بطريقة مخالفة للنظام (لا نص على معارضة الإتلاف وطلب التقييد بدلاً منه)", "basis": "direct_textual", "verdict": "partial", "citation": "Article 8(1)(د)", "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": "دون تأخير غير مبرر", "basis": "direct_textual", "verdict": "broader", "citation": "Article 12(3)", "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.62, "reasoning_note": "I considered distributed counterparts: Article 12(3) requires stopping processing upon withdrawal of consent, and Article 8(1)(د) mandates erasure when processing is unlawful. However, there is no right for the data subject to obtain restriction of processing in lieu of erasure when processing is unlawful; the statute instead obliges erasure in that case.", "label": "C2", "ru_id": "RU-167", "gdpr_article": 18, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 17, "total": 29}, {"round": 3, "n_queries": 4, "new": 5, "total": 34}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provided provisions do not explicitly address the right to restrict processing as an alternative to erasure when processing is unlawful, suggesting a need for a more detailed analysis of potential implicit coverage or future legal developments.", "counter_evidence": [{"id": "0922609ffbfd96a70f90", "span": "المادة الثامنة: الحق في طلب إتلاف البيانات الشخصية", "why": "This article discusses erasure but does not explicitly mention restriction of processing as an alternative."}, {"id": "4919410df7147924356b", "span": "المادة السادسة: الحق في طلب الحصول على البيانات الشخصية", "why": "This article provides rights related to accessing personal data but does not directly address the restriction of processing."}], "confidence": 0.7}, {"verdict": "revise", "objection": "Potential counterparts to the GDPR requirement exist under different terminology or distribution across provisions", "counter_evidence": [{"id": "Article 12(3)", "span": "في حال العدول عن الموافقة، فيجب على جهة التحكم إيقاف المعالجة دون تأخير غير مبرر", "why": "This provision could be interpreted as a basis for restricting processing upon withdrawal of consent"}, {"id": "Article 8(1)(د)", "span": "إذا علمت أن البيانات الشخصية تجرى معالجتها بطريقة مخالفة للنظام", "why": "This provision mentions erasure of personal data when processing contravenes regulations, which could be related to restricting processing when it is unlawful"}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["c511c9bf7779067e64f4", "0922609ffbfd96a70f90", "04322a32135a68c65bb5", "952167864cc3b0