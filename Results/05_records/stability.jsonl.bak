{"candidates_selected": ["c511c9bf7779067e64f4"], "candidates_excluded": [{"id": "f8c6dae3f69fbe207307", "reason": "Addresses conditions for disclosure generally; does not create a category-specific rule for criminal convictions/offences or require processing only under official authority or specific legal authorization with safeguards."}, {"id": "6f4fee23b0aedf942410", "reason": "Limits data subject access; not about processing of criminal convictions/offences data."}, {"id": "952167864cc3b0d724c1", "reason": "Concerns withdrawal of consent; no special rule for criminal convictions/offences data."}, {"id": "4919410df7147924356b", "reason": "Concerns right to obtain a copy of personal data; not relevant to the prohibition or exceptions for criminal convictions/offences data."}, {"id": "c95a0b593cc554df0eae", "reason": "Record-keeping obligations; does not address processing conditions for criminal convictions/offences data."}, {"id": "ea8306cd18f9261f6413", "reason": "Transparency at collection; no category-specific prohibition or exceptions for criminal convictions/offences data."}, {"id": "a79606d0fb564d3b2b5d", "reason": "Breach notification; unrelated to conditions for processing criminal convictions/offences data."}, {"id": "21847c9e87d6df45a9a7", "reason": "Data accuracy obligations; does not regulate processing of criminal convictions/offences data."}, {"id": "90da7bc2380e8f3f2fb8", "reason": "Response timelines for data subject requests; not about processing grounds for criminal convictions/offences data."}, {"id": "8394f801a0a97e521f68", "reason": "DPO designation; no rule on processing criminal convictions/offences data."}, {"id": "6ee1b976a5203de50c77", "reason": "Access right; not about prohibitions/authorizations for processing criminal convictions/offences data."}], "target_frame": {"addressee": {"span": "جهة التحكم", "source": "Article 10"}, "modality": {"span": "لا تجوز كذلك معالجة تلك البيانات إلا لتحقيق الغرض الذي جمعت من أجله.", "source": "Article 10"}, "action": {"span": "معالجة البيانات الشخصية", "source": "Article 10"}, "scope": {"span": null, "source": null}, "condition": {"span": null, "source": null}, "exception": {"span": "إذا كانت جهة التحكم جهة عامة، وكان جمع البيانات الشخصية أو معالجتها؛ مطلوباً لأغراض المصلحة العامة أو لأغراض أمنية أو لتنفيذ نظام آخر أو لاستيفاء متطلبات قضائية.", "source": "Article 10"}, "temporal": {"span": null, "source": null}, "consequence": {"span": null, "source": null}}, "slot_verdicts": [{"gdpr": "controller", "target": "جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 10", "slot": "addressee"}, {"gdpr": "prohibition", "target": "لا تجوز كذلك معالجة تلك البيانات إلا لتحقيق الغرض الذي جمعت من أجله.", "basis": "direct_textual", "verdict": "covered", "citation": "Article 10", "slot": "modality"}, {"gdpr": "process personal data relating to criminal convictions and offences or related security measures", "target": "معالجة البيانات الشخصية", "basis": "direct_textual", "verdict": "broader", "citation": "Article 10", "slot": "action"}, {"gdpr": "personal data relating to criminal convictions and offences or related security measures", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr": "the processing is based on Article 6(1) GDPR", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr": "when under control of official authority; or when authorised by law with appropriate safeguards", "target": "إذا كانت جهة التحكم جهة عامة ... أو لتنفيذ نظام آخر أو لاستيفاء متطلبات قضائية.", "basis": "conceptual", "verdict": "partial", "citation": "Article 10", "slot": "exception"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.64, "reasoning_note": "Article 10 introduces general source and purpose limitations with exceptions for public bodies, security, and legal/judicial needs, but it does not single out criminal convictions/offences (or related security measures) as a protected category. Nor does it impose a prohibition on processing such data absent control by official authority or specific legal authorization with safeguards. Accordingly, GDPR RU-030 lacks a functional counterpart in the cited KSA provisions.", "label": "C2", "ru_id": "RU-030", "gdpr_article": 10, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 18, "total": 30}, {"round": 3, "n_queries": 4, "new": 5, "total": 35}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Counterpart exists under different terminology or distributed across several provisions", "counter_evidence": [{"id": "c511c9bf7779067e64f4", "span": "المادة العاشرة: لا يجوز لجهة التحكم جمع البيانات الشخصية إلا من صاحبها مباشرة، ولا تجوز كذلك معالجة تلك البيانات إلا لتحقيق الغرض الذي جمعت من أجله.", "why": "Article 10 discusses the collection and processing of personal data, including sensitive data."}, {"id": "21847c9e87d6df45a9a7", "span": "المادة الرابعة عشرة: لا يجوز لجهة التحكم أن تعالج البيانات الشخصية دون اتخاذ خطوات كافية للتحقق من دقتها واكتمالها وحداثتها وارتباطها بالغرض الذي جمعت من أجله وفقاً لأحكام النظام.", "why": "Article 14 requires the controller to verify the accuracy and relevance of personal data before processing it."}], "confidence": 0.8}, {"verdict": "revise", "objection": "Potential counterpart exists in Article 10, although with different terminology and scope", "counter_evidence": [{"id": "c511c9bf7779067e64f4", "span": "لا يجوز لجهة التحكم جمع البيانات الشخصية إلا من صاحبها مباشرة، ولا تجوز كذلك معالجة تلك البيانات إلا لتحقيق الغرض الذي جمعت من أجله", "why": "Article 10 provides exceptions to the rule, including public interest, security, or judicial purposes, which might be related to the GDPR requirement"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["f8c6dae3f69fbe207307", "c511c9bf7779067e64f4", "6f4fee23b0aedf942410", "952167864cc3b0d724c1", "4919410df7147924356b", "c95a0b593cc554df0eae", "ea8306cd18f9261f6413", "a79606d0fb564d3b2b5d", "21847c9e87d6df45a9a7", "90da7bc2380e8f3f2fb8", "8394f801a0a97e521f68", "6ee1b976a5203de50c77"], "n_llm_calls": 7, "latency_s": 695.47, "temperature": 0.7, "seed": 20260803, "id": "f0da97dd46a960a15c2b", "condition": "stability", "rep": 2}
