{"candidates_selected": ["d9a05a425b46428120ee", "e33bde5f24e463a1e604", "f10a3fa820a149065de0"], "candidates_excluded": [{"id": "04f45ac99bac1acaa486", "reason": "Inspection/enforcement powers; does not establish accreditation of bodies to monitor codes of conduct."}, {"id": "8394f801a0a97e521f68", "reason": "DPO appointment and duties; unrelated to accrediting monitoring bodies for codes of conduct."}, {"id": "4de7a5d9d6e42dc170c3", "reason": "National register of controllers; no link to accrediting monitoring bodies."}, {"id": "3a56eed81feb3655d1d1", "reason": "Public interest processing conditions; unrelated to accreditation of monitoring bodies."}, {"id": "94fdbc8539498517eb98", "reason": "Complaint mechanism to the authority; does not create or accredit independent bodies to monitor codes of conduct."}, {"id": "67a122f7dc547487996a", "reason": "Sanctions and procedure; no accreditation mechanism for monitoring bodies."}, {"id": "ea8306cd18f9261f6413", "reason": "Transparency at collection; unrelated to accreditation of monitoring bodies."}, {"id": "4ba7db7571a9e08625c7", "reason": "Disclosure prohibitions; unrelated to accreditation of monitoring bodies."}, {"id": "78ae2c40eaf4fb3870fc", "reason": "Controller’s selection of processors; no accreditation of code-monitoring bodies."}], "target_frame": {"addressee": {"span": "للجهة المختصة ... اتخاذ ما يأتي", "article": "Article 30(4)"}, "modality": {"span": "للجهة المختصة ... اتخاذ ما يأتي", "article": "Article 30(4)"}, "action": {"span": "الترخيص لجهات تتولى التدقيق أو الفحص لأنشطة معالجة البيانات الشخصية", "article": "Article 36(3)"}, "scope": {"span": "جهات تتولى التدقيق أو الفحص لأنشطة معالجة البيانات الشخصية", "article": "Article 36(3)"}, "condition": {"span": "تقديم هذه الخدمات بشكل مستقل وفق المعايير المهنية المتبعة ... وضع الإجراءات والضوابط الإدارية والتنظيمية اللازمة للتأكد من دقة وسلامة ما يصدر عنها", "article": "Article 36(2)(أ)-(ب)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "competent supervisory authority", "target_value": "الجهة المختصة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30(4)", "slot": "addressee"}, {"gdpr_value": "power", "target_value": "للجهة المختصة ... اتخاذ ما يأتي", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30(4)", "slot": "modality"}, {"gdpr_value": "accredit a body to monitor compliance with a code of conduct", "target_value": "الترخيص لجهات تتولى التدقيق أو الفحص لأنشطة معالجة البيانات الشخصية; إصدار القواعد المنظمة للترخيص لجهات تتولى إصدار شهادات الاعتماد", "basis": "distributed", "verdict": "uncovered", "citation": "Article 36(3); Article 35", "slot": "action"}, {"gdpr_value": "accreditation of a body referred to in Article 41(1) (monitoring bodies for codes of conduct)", "target_value": "جهات التدقيق/الفحص أو جهات منح شهادات الاعتماد (لا ذكر لأجسام تراقب الالتزام بمدونات سلوك)", "basis": "direct_textual", "verdict": "uncovered", "citation": "Article 36(3); Article 35", "slot": "scope"}, {"gdpr_value": "body demonstrates independence and expertise; has procedures for eligibility, monitoring, periodic review; has transparent complaint-handling; demonstrates no conflict of interest", "target_value": "تقديم الخدمات بشكل مستقل وفق المعايير المهنية؛ وضع إجراءات وضوابط للتأكد من دقة وسلامة المخرجات (لا ذكر لمدونات سلوك أو آليات لقبول المنتسبين، المراجعة الدورية، الشكاوى، أو تضارب المصالح)", "basis": "direct_textual", "verdict": "partial", "citation": "Article 36(2)(أ)-(ب)", "slot": "condition"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.62, "reasoning_note": "Articles 30(4)–(5) confer general supervisory and delegation powers, and Article 34 provides a complaint pathway, but none establish an accreditation scheme for independent bodies that monitor compliance with codes of conduct or set the Article 41(2) criteria. The closest KSA texts (Arts 35 and 36) concern licensing certification/audit entities for processing activities, which is adjacent but not a code-of-conduct monitoring regime. Therefore RU-504 is not covered in the target framework.", "label": "C2", "ru_id": "RU-504", "gdpr_article": 41, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 6, "total": 18}, {"round": 3, "n_queries": 4, "new": 1, "total": 19}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Potential counterpart provision in Article 35 and Article 36", "counter_evidence": [{"id": "e33bde5f24e463a1e604", "span": "جهات منح شهادات الاعتماد", "why": "Mentions certification bodies, which could be related to monitoring compliance with codes of conduct"}, {"id": "f10a3fa820a149065de0", "span": "ترخيص جهات للتدقيق/الفحص", "why": "Mentions licensing of auditing/examining bodies, which could be related to monitoring compliance with codes of conduct"}, {"id": "d9a05a425b46428120ee", "span": "اتخاذ ما يأتي", "why": "Mentions the power to take necessary measures to ensure compliance with regulations, which could include accrediting a body to monitor compliance with a code of conduct"}], "confidence": 0.8}, {"verdict": "revise", "objection": "Potential counterparts to GDPR requirement unit [RU-504] exist in Articles 30(4), 30(5), and 34", "counter_evidence": [{"id": "Article 30(4)", "span": "للجهة المختصة ... اتخاذ ما يأتي", "why": "Provides general supervisory powers to the competent supervisory authority"}, {"id": "Article 30(5)", "span": "يجوز للجهة المختصة -وفق ما تقدره- تفويض غيرها من الجهات في مباشرة بعض المهمات الموكولة إليها", "why": "Allows the competent supervisory authority to delegate tasks to other entities"}, {"id": "Article 34", "span": "يجوز لصاحب البيانات الشخصية التقدم إلى الجهة المختصة بأي شكوى ناشئة من تطبيق النظام واللوائح", "why": "Provides a mechanism for monitoring compliance with the regulations"}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["d9a05a425b46428120ee", "04f45ac99bac1acaa486", "e33bde5f24e463a1e604", "f10a3fa820a149065de0", "8394f801a0a97e521f68", "4de7a5d9d6e42dc170c3", "3a56eed81feb3655d1d1", "94fdbc8539498517eb98", "67a122f7dc547487996a", "ea8306cd18f9261f6413", "4ba7db7571a9e08625c7", "78ae2c40eaf4fb3870fc"], "n_llm_calls": 7, "latency_s": 621.66, "temperature": 0.7, "seed": 20260803, "id": "5d4875babef50e67e1ab", "condition": "stability", "rep": 2}
{"candidates_selected": [], "candidates_excluded": [{"id": "877fafe0080725188d05", "reason": "Data subject rectification/erasure rights; no rule for courts treating related proceedings."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification duties; no judicial procedural consolidation or related-actions rule."}, {"id": "674524dee00496cb5de7", "reason": "Controller obligations; reference to judicial authority for information requests does not address court treatment of related proceedings."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "Processing principles; no provisions on court proceedings or related actions."}, {"id": "57844ac856d11c289650", "reason": "Lawful bases without consent; no rule on courts consolidating or treating proceedings as related."}, {"id": "9d65c2815c41a25064db", "reason": "Security of personal data; unrelated to court procedure for related proceedings."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restriction of processing; no court-related proceedings treatment."}, {"id": "ffb151edc5703b569765", "reason": "Administrative grievance against Office decisions; does not govern courts treating closely connected proceedings."}, {"id": "c34922f387019af45e42", "reason": "Automated decision-making objections; no judicial consolidation or related-actions rule."}, {"id": "9c38ab11b550755816f5", "reason": "DPO-related duties; no provisions on court proceedings."}, {"id": "fdfffc71ce002ff82134", "reason": "Data protection impact assessment; no rule for related court proceedings."}, {"id": "0cc06e3d3b107448da5a", "reason": "Processor obligations; no judicial procedural provisions."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "courts", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "modality", "gdpr_value": "obligation", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "action", "gdpr_value": "treat proceedings as related", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "scope", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "condition", "gdpr_value": "the proceedings are so closely connected that it is expedient to hear and determine them together to avoid the risk of irreconcilable judgments from separate proceedings", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.86, "reasoning_note": "All provided UAE PDPL provisions deal with data protection obligations and procedures, not court civil-procedure rules. None instruct courts to treat closely connected proceedings as related to avoid irreconcilable judgments. Therefore, the GDPR requirement is not addressed by the candidate texts.", "label": "C5", "ru_id": "RU-1012", "gdpr_article": 263, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 5, "total": 5}, {"round": 2, "n_queries": 4, "new": 10, "total": 15}, {"round": 3, "n_queries": 4, "new": 3, "total": 18}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_