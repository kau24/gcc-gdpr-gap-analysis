, "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 0, "total": 0}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 0, "candidate_ids": [], "n_llm_calls": 2, "latency_s": 98.25, "temperature": 0.7, "seed": 20260802, "id": "4fb526f9667320166f9e", "condition": "stability", "rep": 1}
{"candidates_selected": ["823830174d241884bd73", "b9380a5b8800d55add8c", "3f916831456908af27d8"], "candidates_excluded": [{"id": "93f989531fe30cac1ed5", "reason": "Substantive erasure right; no mention of judicial remedies or court action."}, {"id": "b157dcadab6a3e8daf5", "reason": "Lists data subject rights (access, rectification, portability, etc.), but not a right to a judicial remedy."}, {"id": "38c6f7484322711d7d32", "reason": "Breach-handling guidance for the administration; no judicial remedy for data subjects."}, {"id": "a0040ee4dad7d4440e19", "reason": "Controller authorization content; unrelated to remedies."}, {"id": "db6e2be94f2388e169a8", "reason": "Controller may refuse certain requests; not about judicial remedies."}, {"id": "546cfd19de051c612c06", "reason": "Procedures for exercising rights with the controller; no court remedy."}, {"id": "3a6219e8839cbad1f76e", "reason": "Breach notification duties; no judicial remedy."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Policy transparency requirement; does not create a judicial remedy."}, {"id": "de5924c49336b5580d1e", "reason": "Representation of incapacitated persons; no judicial remedy."}], "target_frame": {"addressee": {"span": "صاحب البيانات الشخصية", "article": "823830174d241884bd73 (Article 12)"}, "modality": {"span": "يجوز لصاحب البيانات الشخصية التقدم بشكوى إلى الوزارة", "article": "823830174d241884bd73 (Article 12)"}, "action": {"span": null, "article": null}, "scope": {"span": "يجوز لصاحب البيانات الشخصية أو لأي شخص آخر ذي مصلحة التقدم بشكوى أو بلاغ للإدارة المختصة عن أي مخالفة لأحكام القانون وهذه اللائحة", "article": "b9380a5b8800d55add8c (Article 41)"}, "condition": {"span": "إذا رأى أو اعتبر أن معالجة بياناته الشخصية لا تتوافق مع أحكام هذا القانون", "article": "823830174d241884bd73 (Article 12)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "data subject", "target": "صاحب البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "823830174d241884bd73"}, {"slot": "modality", "gdpr": "right", "target": "يجوز ... التقدم بشكوى (permission to file an administrative complaint)", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "action", "gdpr": "seek an effective judicial remedy before a court against a controller or processor", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "scope", "gdpr": "in addition to administrative or non-judicial remedies, including lodging a complaint with a supervisory authority", "target": "Administrative complaint mechanism exists (complaint/notification to the competent administration)", "basis": "direct_textual", "verdict": "partial", "citation": "b9380a5b8800d55add8c"}, {"slot": "condition", "gdpr": "data subject considers GDPR rights infringed by non-compliant processing", "target": "إذا رأى أو اعتبر أن معالجة بياناته الشخصية لا تتوافق مع أحكام هذا القانون", "basis": "direct_textual", "verdict": "partial", "citation": "823830174d241884bd73"}, {"slot": "exception", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.86, "reasoning_note": "The OMN texts provide administrative complaint routes and administrative enforcement powers, but contain no textual grant of a judicial remedy before a court against a controller or processor. Thus, the GDPR Article 79 core (effective judicial remedy) is missing, even though non-judicial complaint mechanisms exist.", "label": "C2", "ru_id": "RU-915", "gdpr_article": 79, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 5, "total": 17}, {"round": 3, "n_queries": 4, "new": 3, "total": 20}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provisions do not explicitly provide for the right to seek an effective judicial remedy against a controller or processor for infringement of GDPR rights due to non-compliant processing.", "counter_evidence": [{"id": "Article 12", "span": "يجوز لصاحب البيانات الشخصية التقدم بشكوى إلى الوزارة", "why": "This article provides for an administrative remedy, not a judicial one."}, {"id": "Article 41", "span": "يجوز لصاحب البيانات الشخصية أو لأي شخص آخر ذي مصلحة التقدم بشكوى أو بلاغ للإدارة المختصة", "why": "This article also discusses an administrative or non-judicial complaint process."}], "confidence": 0.9}, {"verdict": "revise", "objection": "The provisions do not explicitly provide for an effective judicial remedy as a counterpart to the GDPR's requirements.", "counter_evidence": [{"id": "823830174d241884bd73", "span": "يجوز لصاحب البيانات الشخصية التقدم بشكوى إلى الوزارة إذا رأى أو اعتبر أن معالجة بياناته الشخصية لا تتوافق مع أحكام هذا القانون", "why": "This provision indicates a mechanism for complaint but does not explicitly mention a judicial remedy."}, {"id": "b9380a5b8800d55add8c", "span": "يجوز لصاحب البيانات الشخصية أو لأي شخص آخر ذي مصلحة التقدم بشكوى أو بلاغ للإدارة المختصة عن أي مخالفة لأحكام القانون", "why": "Similar to the previous, this provision outlines a complaint mechanism to the administration but lacks reference to a judicial remedy."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["93f989531fe30cac1ed5", "823830174d241884bd73", "3f916831456908af27d8", "b157dcadab6a3e8daf5f", "38c6f7484322711d7d32", "a0040ee4dad7d4440e19", "db6e2be94f2388e169a8", "546cfd19de051c612c06", "3a6219e8839cbad1f76e", "bb26cffae1f1c0beb85d", "b9380a5b8800d55add8c", "de5924c49336b5580d1e"], "n_llm_calls": 7, "latency_s": 635.44, "temperature": 0.7, "seed": 20260802, "id": "b27a548b34b4b1c83cb3", "condition": "stability", "rep": 1}
{"candidates_selected": [], "candidates_excluded": [{"id": "9b42add02f4d45cf8a57", "reason": "Addresses the authority's power to issue guidance and apply penalties against providers; does not grant data subjects a right to obtain a judicial remedy before a court, does not establish a complaint mechanism, and contains no timeline for authority inaction."}, {"id": "a418980931b429c7909a", "reason": "Regulates breach notification duties to the authority and data subjects; does not confer any judicial remedy to data subjects, does not address complaints to the authority, and does not provide recourse for authority inaction."}, {"id": "b983a5ed0e1c7a2b779a", "reason": "Sets lawfulness bases for processing; unrelated to judicial remedies, supervisory complaints, or court access for data subjects."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "each data subject", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "addressee"}, {"gdpr_value": "right", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "modality"}, {"gdpr_value": "obtain an effective judicial remedy before a court", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr_value": "regarding a complaint lodged under Article 77", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr_value": "where the supervisory authority competent under Articles 55 and 56 does not handle the complaint or does not inform the data subject on its progress or outcome within three months", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr_value": "Without prejudice to any other administrative or non-judicial remedy", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.86, "reasoning_note": "Even considering distributed norms and different terminology, the cited Kuwaiti provisions do not create a data subject’s right to obtain a judicial remedy before a court for supervisory authority inaction on a complaint. Article 7 concerns the authority’s sanctioning powers over providers, and Article 6 concerns breach notifications—neither mentions complaints, courts, data-subject standing, or a three‑month inaction trigger. Thus, no functional counterpart to GDPR Article 78 is present in the provided texts.", "label": "C5", "ru_id": "RU-912", "gdpr_article": 78, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 1, "total": 1}, {"round": 2, "n_queries": 4, "new": 2, "total": 3}, {"round": 3, "n_queries": 4, "new": 0, "total": 3}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "Counterpart exists under different terminology and distribution across provisions", "counter_evidence": [{"id": "9b42add02f4d45cf8a57", "span": "المادة السابعة: أحكام عامة", "why": "Implies authority's power to take action against non-compliant parties, potentially as a form of judicial remedy"}, {"id": "a418980931b429c7909a", "span": "المادة السادسة: الإخطار عند حدوث الاختراقات", "why": "Mentions notification and potential action in case of data breaches, which could be related to judicial remedy"}], "confidence": 0.7}], "n_candidates": 3, "candidate_ids": ["b983a5ed0e1c7a2b779a", "9b42add02f4d45cf8a57", "a418980931b429c7909a"], "n_llm_calls": 6, "latency_s": 438.24, "temperature": 0.7, "seed": 20260802, "id": "8f201c25f819853c72ee", "condition": "stability", "rep": 1}
{"candidates_selected": ["85d05fccf5b4f57eceaf", "6c76988b817262e3e312", "fcbd13532c69b340214e", "75db9db720e9e34a1148"], "candidates_excluded": [{"id": "850decaffbbae78d371d", "reason": "Creates exemptions from other articles; does not impose technical/organizational measures or a demonstrability duty on controllers."}, {"id": "192caaa530952a30ad50", "reason": "Empowers the competent administration; not a controller obligation to implement measures or demonstrate compliance."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "National security and similar carve-outs; not an obligation to implement measures or demonstrate compliance."}, {"id": "75852a697f66691bfbfb", "reason": "Exempts from Article 6 duties in certain cases; does not address implementation of measures or demonstrability."}, {"id": "ca31304d94e06fa35850", "reason": "Enforcement powers of officials; no controller-side duty to implement measures or to demonstrate compliance."}, {"id": "a200ece03fd0ba143354", "reason": "Procedures for data subject rights; not about controller’s technical/organizational measures or demonstrability."}, {"id": "f5c366135483fe580381", "reason": "Breach notification duty; ancillary to security but not the Art. 24-style duty to implement measures and be able to demonstrate overall compliance."}, {"id": "89d1bb9a58e65b732117", "reason": "Transparency to data subjects; not about implementing measures or demonstrating compliance."}], "target_frame": {"addressee": {"span": "يتعين على المراقب", "article": "Article 8"}, "modality": {"span": "يجب", "article": "Article 13"}, "action": {"span": "اتخاذ الاحتياطات الإدارية والفنية والمادية المناسبة لحماية البيانات الشخصية، وفقاً لما تحدده الإدارة المختصة", "article": "Article 8"}, "scope": {"span": "معالجة البيانات الشخصية", "article": "Article 8"}, "condition": {"span": "ويجب أن تكون تلك الاحتياطات متناسبة مع طبيعة وأهمية البيانات الشخصية المراد حمايتها", "article": "Article 13"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller", "target_value": "المراقب", "basis": "direct_textual", "verdict": "covered", "citation": "Article 8 [85d05fccf5b4f57eceaf]"}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "يجب / يتعين", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13 [fcbd13532c69b340214e]"}, {"slot": "action", "gdpr_value": "implement appropriate technical and organisational measures to ensure and to be able to demonstrate that processing is performed in accordance with this Regulation", "target_value": "اتخاذ الاحتياطات الإدارية والفنية والمادية المناسبة لحماية البيانات الشخصية ... وإجراء عمليات تدقيق ومراجعة شاملة عن مدى الالتزام بحماية البيانات الشخصية", "basis": "distributed", "verdict": "partial", "citation": "Article 8(3) [85d05fccf5b4f57eceaf]; Article 11(7) [6c76988b817262e3e312]; plus context in Article 12 [75db9db720e9e34a1148]"}, {"slot": "scope", "gdpr_value": "processing under the controller’s responsibility", "target_value": "Obligations stated for المراقب with respect to معالجة البيانات الشخصية", "basis": "conceptual", "verdict": "covered", "citation": "Article 8(1) [85d05fccf5b4f57eceaf]"}, {"slot": "condition", "gdpr_value": "taking into account the nature, scope, context and purposes of processing and the risks of varying likelihood and severity for the rights and freedoms of natural persons", "target_value": "متناسبة مع طبيعة وأهمية البيانات الشخصية المراد حمايتها", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 13 (sentence 2) [fcbd13532c69b340214e]"}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.62, "reasoning_note": "While no provision literally requires the controller to be able to demonstrate compliance with the law, Article 11(7) obliges controllers to conduct comprehensive audits of compliance, which functionally supports demonstrability, and Article 11 sets multiple internal governance controls. However, the Qatar text frames measures primarily as security/protection duties and ties proportionality to the nature/importance of data, not to a broader risk-to-rights analysis or an explicit “demonstrate compliance with the law” standard, so coverage is partial.", "label": "C2", "ru_id": "RU-204", "gdpr_article": 24, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 8, "total": 8}, {"round": 2, "n_queries": 4, "new": 7, "total": 15}, {"round": 3, "n_queries": 4, "new": 1, "total": 16}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict of 'partial' coverage for the GDPR requirement of 'taking into account the nature, scope, context and purposes of processing and risks to rights and freedoms' may be too narrow, as the target jurisdiction's provisions can be interpreted to implicitly encompass these aspects.", "counter_evidence": [{"id": "fcbd13532c69b340214e", "span": "متناسبة مع طبيعة وأهمية البيانات الشخصية", "why": "This provision implies consideration of the nature and importance of personal data, which can be seen as related to the scope, context, and purposes of processing."}, {"id": "6c76988b817262e3e312", "span": "مراجعة إجراءات حماية الخصوصية قبل إدراج عمليات معالجة جديدة", "why": "This provision requires the controller to review privacy protection procedures before implementing new processing operations, which could be seen as related to considering the scope and context of processing."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The provisions supplied do not explicitly require the controller to demonstrate compliance with the Regulation.", "counter_evidence": [{"id": "85d05fccf5b4f57eceaf", "span": "يتعين على المراقب الالتزام بما يلي: 1- معالجة البيانات الشخصية بأمانة ومشروعية. 2- مراعاة الضوابط الخاصة بتصميم أو تغيير أو تطوير المنتجات والنظم والخدمات المتعلقة بمعالجة البيانات الشخصية.", "why": "This article does not explicitly require the controller to demonstrate compliance with the Regulation."}, {"id": "6c76988b817262e3e312", "span": "على المراقب اتخاذ الإجراءات التالية: 1- مراجعة إجراءات حماية الخصوصية قبل إدراج عمليات معالجة جديدة.", "why": "This article does not explicitly require the controller to demonstrate compliance with the Regulation."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["850decaffbbae78d371d", "85d05fccf5b4f57eceaf", "75db9db720e9e34a1148", "192caaa530952a30ad50", "3f5cc5a2c4af5fb90388", "6c76988b817262e3e312", "75852a697f66691bfbfb", "ca31304d94e06fa35850", "a200ece03fd0ba143354", "fcbd13532c69b340214e", "f5c366135483fe580381", "89d1bb9a58e65b732117"], "n_llm_calls": 7, "latency_s": 664.2, "temperature": 0.7, "seed": 20260802, "id": "a8c7ab825f0386e0cb97", "condition": "stability", "rep": 1}
{"candidates_selected": ["83fae53ff99059f02f05", "192caaa530952a30ad50", "9548224453cca1301899", "ca31304d94e06fa35850"], "candidates_excluded": [{"id": "85d05fccf5b4f57eceaf", "reason": "Obligations on controllers for data processing and privacy policies; does not address state measures to implement penalties."}, {"id": "dbaab43b07be19b5483e", "reason": "Transitional compliance timeline for regulated entities; not about ensuring implementation of penalties."}, {"id": "18cb1cd8191cffb1c314", "reason": "Exemption from giving reasons for refusal of data subject rights; unrelated to implementing penalties."}, {"id": "a200ece03fd0ba143354", "reason": "Minister to set procedures for exercising individual rights; not directed at ensuring penalty implementation."}, {"id": "ebf74cfd82d3e6cbc442", "reason": "Civil nullity of contracts contrary to the law; not a state duty to implement penalties."}, {"id": "75852a697f66691bfbfb", "reason": "Further exemptions from data subject rights; unrelated to implementing penalties."}, {"id": "455aae046cacf7979576", "reason": "Data quality obligations for controllers; not about state implementation of penalties."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "Security and public interest processing exemptions; not about penalty implementation."}], "target_frame": {"addressee": {"span": "جميع الجهات المختصة، كل فيما يخصه", "article": "Article 32"}, "modality": {"span": "على جميع الجهات المختصة، كل فيما يخصه، تنفيذ هذا القانون.", "article": "Article 32"}, "action": {"span": "للإدارة المختصة، في سبيل تطبيق وتنفيذ أحكام هذا القانون، أن تتخذ جميع الإجراءات اللازمة لذلك", "article": "Article 27"}, "scope": {"span": "تطبيق وتنفيذ أحكام هذا القانون", "article": "Article 27"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "Member States", "target_value": "جميع الجهات المختصة، كل فيما يخصه (and specifically: الوزير؛ الإدارة المختصة)", "basis": "conceptual", "verdict": "covered", "citation": "Art 32; Art 31; Art 27"}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "على ... تنفيذ هذا القانون", "basis": "direct_textual", "verdict": "covered", "citation": "Art 32"}, {"slot": "action", "gdpr_value": "take all measures necessary to ensure that the penalties laid down under Article 84(1) are implemented", "target_value": "أن تتخذ جميع الإجراءات اللازمة ... في سبيل تطبيق وتنفيذ أحكام هذا القانون", "basis": "distributed", "verdict": "partial", "citation": "Art 27; Art 31; Art 29; Art 32"}, {"slot": "scope", "gdpr_value": "None", "target_value": "أحكام هذا القانون (general implementation of the law)", "basis": "absent", "verdict": "covered", "citation": "Art 27"}, {"slot": "condition", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.55, "reasoning_note": "Qatari provisions impose a general obligation on competent authorities to implement the law and empower them to take all necessary measures, with ministerial decisions and enforcement powers supporting implementation. However, they do not expressly require ensuring that statutory penalties are implemented, leaving a gap relative to the GDPR unit’s penalty-specific focus. Hence the action slot is only partially covered.", "label": "C2", "ru_id": "RU-949", "gdpr_article": 84, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 4, "total": 16}, {"round": 3, "n_queries": 4, "new": 4, "total": 20}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Deontic modality claim may not be fully supported by Article 27's modal wording", "counter_evidence": [{"id": "192caaa530952a30ad50", "span": "للإدارة المختصة، في سبيل تطبيق وتنفيذ أحكام هذا القانون، أن تتخذ جميع الإجراءات اللازمة لذلك", "why": "The phrase 'shall take all necessary measures' suggests an obligation, potentially contradicting the weaker modality claim"}], "confidence": 0.8}, {"verdict": "revise", "objection": "The cited provisions do not explicitly mention the implementation of penalties, which is the core requirement of the GDPR provision.", "counter_evidence": [{"id": "Article 27", "span": "للإدارة المختصة، في سبيل تطبيق وتنفيذ أحكام هذا القانون، أن تتخذ جميع الإجراءات اللازمة لذلك", "why": "This article discusses general measures for implementing the law, but does not specifically mention penalties."}, {"id": "Article 31", "span": "يصدر الوزير القرارات اللازمة لتنفيذ أحكام هذا القانون", "why": "This article mentions the Minister's role in issuing decisions to implement the law, but does not explicitly mention penalties."}, {"id": "Article 29", "span": "يكون لموظفي الوزارة، الذين يصدر بتخويلهم صفة مأموري الضبط القضائي، ضبط وإثبات الجرائم التي تقع بالمخالفة لأحكام هذا القانون", "why": "This article discusses the powers of the Ministry's employees to investigate crimes, but does not explicitly state that they are responsible for implementing penalties."}, {"id": "Article 32", "span": "على جميع الجهات المختصة، كل فيما يخصه، تنفيذ هذا القانون", "why": "This article states that all concerned parties shall implement the law, but does not specify how penalties are to be implemented."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["83fae53ff99059f02f05", "192caaa530952a30ad50", "9548224453cca1301899", "85d05fccf5b4f57eceaf", "dbaab43b07be19b5483e", "18cb1cd8191cffb1c314", "a200ece03fd0ba143354", "ebf74cfd82d3e6cbc442", "ca31304d94e06fa35850", "75852a697f66691bfbfb", "455aae046cacf7979576", "3f5cc5a2c4af5fb90388"], "n_llm_calls": 7, "latency_s": 609.05, "temperature": 0.7, "seed": 20260802, "id": "667a09a58f0a9ac98a81", "condition": "stability", "rep": 1}
{"candidates_selected": [], "candidates_excluded": [{"id": "9630e6d967b64e07d339", "reason": "Addresses appointment of Data Protection Officer; no supervisory authority annual report or permission to include infringement/measure lists."}, {"id": "0897840c01b58a706cd5", "reason": "Defines acts constituting violations and administrative penalties by Cabinet; does not address SA annual reporting or content permissions."}, {"id": "5d949837d7aab073cd67", "reason": "Sets complaint handling and sanctioning by the Office; no provision on annual reports or listing infringements/measures."}, {"id": "9c38ab11b550755816f5", "reason": "Obligations of controller/processor toward DPO; unrelated to SA annual reporting."}, {"id": "dec351a1e477287e3b22", "reason": "Controller communication methods; no link to SA annual reporting."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification to the Office and possible sanctions; no rule about Office annual report content."}, {"id": "34f7595acb9df257ef5e", "reason": "DPO roles; no supervisory authority annual report content."}, {"id": "717a67a0d311f88c5fd9", "reason": "Data subject right to information from controller; not about SA reporting."}, {"id": "c34922f387019af45e42", "reason": "Automated processing rights; not about SA reporting."}, {"id": "2b337b9a20a4e33b6ad2", "reason": "Office authority to exempt establishments; no annual report provision."}, {"id": "9d65c2815c41a25064db", "reason": "Security measures; not about SA reporting."}, {"id": "674524dee00496cb5de7", "reason": "General controller obligations; not about SA reporting."}], "target_frame": {"addressee": {"span": null, "source": null}, "modality": {"span": null, "source": null}, "action": {"span": null, "source": null}, "scope": {"span": null, "source": null}, "condition": {"span": null, "source": null}, "exception": {"span": null, "source": null}, "temporal": {"span": null, "source": null}, "consequence": {"span": null, "source": null}}, "slot_verdicts": [{"gdpr_value": "each supervisory authority", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "addressee"}, {"gdpr_value": "permission", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "modality"}, {"gdpr_value": "include in the annual report a list of types of infringement notified and types of measures taken", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr_value": "content of the annual activity report", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.73, "reasoning_note": "The provided UAE PDPL excerpts contain no rule about the supervisory authority (the Office) issuing an annual report or being permitted to include lists of infringement types and measures. Provisions on violations, penalties, complaints, and breach notifications do not establish any annual reporting content or permissions. Hence the GDPR unit is not reflected in the target text.", "label": "C5", "ru_id": "RU-698", "gdpr_article": 59, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 6, "total": 18}, {"round": 3, "n_queries": 4, "new": 0, "total": 18}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["9630e6d967b64e07d339", "0897840c01b58a706cd5", "5d949837d7aab073cd67", "9c38ab11b550755816f5", "dec351a1e477287e3b22", "e05de90f481c9410c6e0", "34f7595acb9df257ef5e", "717a67a0d311f88c5fd9", "c34922f387019af45e42", "2b337b9a20a4e33b6ad2", "9d65c2815c41a25064db", "674524dee00496cb5de7"], "n_llm_calls": 4, "latency_s": 349.03, "temperature": 0.7, "seed": 20260802, "id": "32e39921b0b26b3133f0", "condition": "stability", "rep": 1}
{"candidates_selected": ["fca1aa50445ca4475333", "e54c53229ed1382a5fb4"], "candidates_excluded": [{"id": "85e94dba24cbfb8955cd", "reason": "Access/notice/copy rights; no restriction-of-processing remedy."}, {"id": "07962910da55dbce48d3", "reason": "Cross-border data flow restriction; not a data-subject right to restrict processing."}, {"id": "75db9db720e9e34a1148", "reason": "Controller duties on disclosure/transfer; no data-subject restriction right."}, {"id": "f169b712b14aea8718ee", "reason": "Legal bases for processing; does not create a restriction right."}, {"id": "dce663972f2d5e58176e", "reason": "Scope clause; no relevant right."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "Public-interest exemptions; not a data-subject restriction right."}, {"id": "2bcce9feda2fcb9d35fe", "reason": "General privacy right; no specific restriction-of-processing entitlement."}, {"id": "f5c366135483fe580381", "reason": "Breach notification; not a data-subject restriction right."}, {"id": "6c76988b817262e3e312", "reason": "Controller must handle access/correction/deletion requests; no restriction request provided."}, {"id": "fcbd13532c69b340214e", "reason": "Security safeguards; not a data-subject restriction right."}], "target_frame": {"addressee": {"span": "يجوز للفرد، في أي وقت، ما يلي:", "article": "Article 5"}, "modality": {"span": "يجوز للفرد ... الاعتراض على معالجة بياناته الشخصية", "article": "Article 5"}, "action": {"span": "وقف معالجة أية بيانات شخصية تم جمعها من الطفل أو عنه، إذا طلب ولي الأمر ذلك.", "article": "Article 17"}, "scope": {"span": "بياناته الشخصية", "article": "Article 5"}, "condition": {"span": "إذا كانت غير ضرورية لتحقيق الأغراض التي جمعت من أجلها، أو كانت زائدة على متطلباتها، أو تمييزية أو مجحفة أو مخالفة للقانون.", "article": "Article 5"}, "exception": {"span": null, "article": null}, "temporal": {"span": "في أي وقت", "article": "Article 5"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "الفرد", "basis": "direct_textual", "verdict": "covered", "citation": "Article 5", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "يجوز للفرد ...", "basis": "direct_textual", "verdict": "covered", "citation": "Article 5", "slot": "modality"}, {"gdpr_value": "obtain from the controller the restriction of processing", "target_value": "الاعتراض على المعالجة (عام)؛ وقف المعالجة (في سياق مواقع الأطفال فقط)", "basis": "distributed", "verdict": "partial", "citation": "Article 5; Article 17", "slot": "action"}, {"gdpr_value": "processing of the data subject's personal data", "target_value": "بياناته الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 5", "slot": "scope"}, {"gdpr_value": "processing is unlawful AND the data subject opposes erasure and requests restriction instead", "target_value": "الاعتراض إذا كانت المعالجة غير ضرورية/زائدة/تمييزية/مجحفة/مخالفة للقانون (لا نص على تفضيل التقييد بدل الحذف عند عدم المشروعية)", "basis": "direct_textual", "verdict": "partial", "citation": "Article 5", "slot": "condition"}, {"gdpr_value": "None", "target_value": "no specific exception stated for these rights", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": "في أي وقت", "basis": "direct_textual", "verdict": "covered", "citation": "Article 5", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "no specific consequence stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.63, "reasoning_note": "Art. 5 does grant a right to object when processing is unlawful (and in other cases), and Art. 17 allows stopping processing in the narrow child-website context. However, there is no general right to obtain restriction of processing as an alternative to erasure when processing is unlawful, nor any text linking an objection to a duty to restrict rather than delete. Therefore the match remains partial rather than fully covered.", "label": "C2", "ru_id": "RU-167", "gdpr_article": 18, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 8, "total": 8}, {"round": 2, "n_queries": 4, "new": 7, "total": 15}, {"round": 3, "n_queries": 4, "new": 2, "total": 17}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provisions do not explicitly mention the right to request restriction of processing instead of erasure when the processing is unlawful, but related rights are provided.", "counter_evidence": [{"id": "fca1aa50445ca4475333", "span": "2- الاعتراض على معالجة بياناته الشخصية إذا كانت غير ضرورية لتحقيق الأغراض التي جمعت من أجلها، أو كانت زائدة على متطلباتها، أو تمييزية أو مجحفة أو مخالفة للقانون.", "why": "This provision allows the individual to object to the processing of their personal data if it is unlawful, but does not explicitly mention the right to request restriction of processing instead of erasure."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict of C2 (partial match) may be too conservative, as there is some evidence to support a more comprehensive match.", "counter_evidence": [{"id": "fca1aa50445ca4475333", "span": "يجوز للفرد، في أي وقت، ما يلي: 1- سحب موافقته السابقة على معالجة بياناته الشخصية. 2- الاعتراض على معالجة بياناته الشخصية إذا كانت غير ضرورية لتحقيق الأغراض التي جمعت من أجلها، أو كانت زائدة على متطلباتها، أو تمييزية أو مجحفة أو مخالفة للقانون.", "why": "This article provides the individual with the right to object to the processing of their personal data if it is unlawful or unnecessary."}, {"id": "e54c53229ed1382a5fb4", "span": "حذف أو محو أو وقف معالجة أية بيانات شخصية تم جمعها من الطفل أو عنه، إذا طلب ولي الأمر ذلك.", "why": "This article mentions the right to stop processing personal data in the context of child-directed websites, which could be seen as a partial counterpart to the GDPR requirement."}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["85e94dba24cbfb8955cd", "fca1aa50445ca4475333", "07962910da55dbce48d3", "75db9db720e9e34a1148", "f169b712b14aea8718ee", "dce663972f2d5e58176e", "3f5cc5a2c4af5fb90388", "2bcce9feda2fcb9d35fe", "f5c366135483fe580381", "6c76988b817262e3e312", "fcbd13532c69b340214e", "e54c53229ed1382a5fb4"], "n_llm_calls": 7, "latency_s": 654.38, "temperature": 0.7, "seed": 20260802, "id": "275035f69508403835f7", "condition": "stability", "rep": 1}
{"candidates_selected": ["1d9b90bc8d164f514dc3"], "candidates_excluded": [{"id": "3d71a23a91370cadf799", "reason": "Regulates processing of criminal case data; does not address breach notification to the authority."}, {"id": "74358e437cd9e85fdabb", "reason": "DPO roles and escalation duties generally; not a controller duty to notify the authority of a data breach."}, {"id": "6a403e591ecc2a5638fc", "reason": "DPO disciplinary procedures; unrelated to breach notification."}, {"id": "6b500d26673394f3d7e6", "reason": "Data subject rights to rectification/blocking/erasure; not about authority notification of breaches."}, {"id": "231a37f671238dbf7112", "reason": "Definitions concerning DPO registry; no breach notification content."}, {"id": "7448a27e7806f2c0c143", "reason": "Data quality principles; not breach notification."}, {"id": "f8344697d1f1dc661161", "reason": "Sensitive data processing conditions; not breach notification."}, {"id": "a3c79315ae2d7920a38f", "reason": "Complaint mechanism to the authority; not the controller’s breach notification duty."}, {"id": "7e2914aa34ab2739dafd", "reason": "Security of processing measures; no authority notification trigger."}, {"id": "074363ee1a72941c8326", "reason": "Procedures for DPO internal registry applications; not breach notification."}, {"id": "cf6dbe21d2b4a64f32a8", "reason": "Procedures for DPO external registry applications; not breach notification."}], "target_frame": {"addressee": {"span": "يجب على مدير البيانات", "article": "Article 4(b)"}, "modality": {"span": "يجب عليه وضع إجراءات محددة لإخطار الهيئة ... خلال مدة لا تجاوز اثنان وسبعين ساعة", "article": "Article 4(b)"}, "action": {"span": "إخطار الهيئة بحدوث خرق أو انتهاك للبيانات", "article": "Article 4(b)"}, "scope": {"span": "الهيئة", "article": "Article 4(b)"}, "condition": {"span": "حدوث خرق أو انتهاك للبيانات", "article": "Article 4(b)"}, "exception": {"span": "ما لم يكن من غير المحتمل أن يؤدي خرق البيانات إلى خطر يُهدد حقوق أصحاب البيانات", "article": "Article 4(b)"}, "temporal": {"span": "خلال مدة لا تجاوز اثنان وسبعين ساعة من وقت اكتشافه", "article": "Article 4(b)"}, "consequence": {"span": "وفي حال لم يلتزم المدير بإخطار الهيئة في المدة المحددة، يجب أن يكون الإخطار مشفوعاً بمبررات التأخير", "article": "Article 4(b)"}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller", "target_value": "مدير البيانات (data controller)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(b): \"يجب على مدير البيانات\""}, {"slot": "modality", "gdpr_value": "obligation (shall notify)", "target_value": "obligation via \"يجب/يلتزم\" to notify the authority", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(b): \"يجب عليه ... لإخطار الهيئة ...\""}, {"slot": "action", "gdpr_value": "notify the competent supervisory authority of the personal data breach", "target_value": "إخطار الهيئة بحدوث خرق أو انتهاك للبيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(b)"}, {"slot": "scope", "gdpr_value": "to the supervisory authority competent in accordance with Article 55", "target_value": "to the national authority (الهيئة)", "basis": "conceptual", "verdict": "covered", "citation": "Article 4(b)"}, {"slot": "condition", "gdpr_value": "in the case of a personal data breach", "target_value": "upon حدوث خرق أو انتهاك للبيانات and from وقت اكتشافه", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(b)"}, {"slot": "exception", "gdpr_value": "unless the breach is unlikely to result in a risk to the rights and freedoms of natural persons", "target_value": "ما لم يكن من غير المحتمل أن يؤدي خرق البيانات إلى خطر يُهدد حقوق أصحاب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(b)"}, {"slot": "temporal", "gdpr_value": "without undue delay after becoming aware of the breach", "target_value": "within 72 hours of discovery; if later, the notice must include reasons for delay", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 4(b): \"خلال مدة لا تجاوز اثنان وسبعين ساعة من وقت اكتشافه ... وإذا لم يلتزم ... مشفوعاً بمبررات التأخير\""}, {"slot": "consequence", "gdpr_value": "None specified", "target_value": "If not within the specified period, notice must include justifications for the delay", "basis": "direct_textual", "verdict": "broader", "citation": "Article 4(b): \"وفي حال لم يلتزم المدير ... مشفوعاً بمبررات التأخير\""}], "holistic_label": "partial", "confidence": 0.72, "reasoning_note": "Bahrain’s Article 4(b) establishes the controller’s duty to notify the authority of a personal data breach and includes the GDPR-like risk-based exception. However, it uses a fixed 72-hour deadline (with late notice allowed if justified) rather than the GDPR’s “without undue delay” standard, so the temporal modality is assessed as weaker. All other elements are textually covered.", "label": "C1", "ru_id": "RU-345", "gdpr_article": 33, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 16, "total": 28}, {"round": 3, "n_queries": 4, "new": 2, "total": 30}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The exception slot might not be narrower as initially thought, as both the GDPR requirement unit and the target jurisdiction's provision provide similar exceptions.", "counter_evidence": [{"id": "Article 4(b)", "span": "ما لم يكن من غير المحتمل أن يؤدي خرق البيانات إلى خطر يُهدد حقوق أصحاب البيانات", "why": "This provision provides a similar exception to the GDPR requirement unit, suggesting that the target jurisdiction's provision might be more aligned than initially thought."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The BHR law requires notification within 72 hours, whereas the GDPR requires notification 'without undue delay'", "counter_evidence": [{"id": "1d9b90bc8d164f514dc3", "span": "يلتزم مدير البيانات بتوثيق حالات خرق أو انتهاك البيانات، وبيان أسبابها، والآثار المترتبة على وقوعها، والإجراءات التصحيحية المُتخَذة", "why": "The BHR law requires notification within 72 hours, which may not fully align with the GDPR's requirement of 'without undue delay'"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["3d71a23a91370cadf799", "1d9b90bc8d164f514dc3", "74358e437cd9e85fdabb", "6a403e591ecc2a5638fc", "6b500d26673394f3d7e6", "231a37f671238dbf7112", "7448a27e7806f2c0c143", "f8344697d1f1dc661161", "a3c79315ae2d7920a38f", "7e2914aa34ab2739dafd", "074363ee1a72941c8326", "cf6dbe21d2b4a64f32a8"], "n_llm_calls": 7, "latency_s": 643.22, "temperature": 0.7, "seed": 20260802, "id": "53fa290fdc5591963538", "condition": "stability", "rep": 1}
