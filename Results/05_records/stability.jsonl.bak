alue": "processing of personal data received in the framework of a particular inquiry", "target_value": "security investigations and related practices are expressly out of scope", "basis": "direct_textual", "verdict": "uncovered", "citation": "Art.1: ولا تطبق أحكام هذه اللائحة على الممارسات المتعلقة بالتحريات الأمنية..."}, {"slot": "condition", "gdpr_value": "receipt of personal data in a particular inquiry in accordance with law", "target_value": "no corresponding condition; such inquiry-related activities are excluded", "basis": "absent", "verdict": "uncovered", "citation": "Art.1 (scope exclusion)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "no exception stated for any analogous rule", "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "temporal", "gdpr_value": "None", "target_value": "not specified", "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "consequence", "gdpr_value": "None", "target_value": "not specified", "basis": "absent", "verdict": "covered", "citation": ""}], "holistic_label": "uncovered", "confidence": 0.78, "reasoning_note": "Articles 4 and 5 do impose processing-in-line-with-purpose and protection obligations, but only on licensed service providers. RU-012 targets public authorities receiving data in a particular inquiry; Article 1 expressly excludes security investigations and similar practices from the regulation’s scope. Therefore, no functionally equivalent counterpart exists under different terminology.", "label": "C2", "ru_id": "RU-012", "gdpr_article": 4, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 3, "total": 3}, {"round": 2, "n_queries": 4, "new": 1, "total": 4}, {"round": 3, "n_queries": 4, "new": 0, "total": 4}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "Counterpart exists under different terminol