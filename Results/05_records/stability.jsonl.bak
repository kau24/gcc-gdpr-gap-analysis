{"candidates_selected": ["d9a05a425b46428120ee", "04f45ac99bac1acaa486", "06b918a4049719ed530f"], "candidates_excluded": [{"id": "3a56eed81feb3655d1d1", "reason": "Substantive processing conditions for public interest; does not address supervisory authority competence or territorial scope."}, {"id": "f8c6dae3f69fbe207307", "reason": "Disclosure conditions; no rules about the supervisory authority's powers or territorial competence."}, {"id": "c511c9bf7779067e64f4", "reason": "Lawful-basis exceptions for collection/processing; not about supervisory authority competence."}, {"id": "ce107f77eb9119ba01b0", "reason": "Controller privacy policy obligations; not about supervisory authority powers or territorial remit."}, {"id": "c95a0b593cc554df0eae", "reason": "Record-keeping by controllers; only indirectly relates to supervision and does not state authority competence/territory."}, {"id": "04322a32135a68c65bb5", "reason": "Narrow rule on processing for realized interest; unrelated to supervisory authority competence."}, {"id": "8394f801a0a97e521f68", "reason": "DPO designation and tasks within controllers; not the supervisory authority's competence or territorial scope."}, {"id": "4de7a5d9d6e42dc170c3", "reason": "National register framework; does not define the authority’s general competence or territorial remit."}, {"id": "62cc177254bb6a5bed90", "reason": "Security obligations for controllers; not about supervisory authority competence."}], "target_frame": {"addressee": {"span": "تكون الجهة المختصة الجهة المشرفة على تطبيق أحكام النظام واللوائح.", "article": "Article 30(1)"}, "modality": {"span": "للجهة المختصة ... اتخاذ ما يأتي:", "article": "Article 30(4)"}, "action": {"span": "في سبيل مباشرتها مهماتها المتعلقة بالإشراف على تطبيق أحكام النظام واللوائح", "article": "Article 30(4)"}, "scope": {"span": "اشتراطات ممارسة الأنشطة التجارية أو المهنية أو غير الربحية المرتبطة بحماية البيانات الشخصية في المملكة", "article": "Article 33(1)"}, "condition": {"span": "الإشراف على تطبيق أحكام النظام واللوائح", "article": "Article 30(1)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "supervisory authority", "target_value": "الجهة المختصة الجهة المشرفة على تطبيق أحكام النظام واللوائح", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30(1)"}, {"slot": "modality", "gdpr_value": "power", "target_value": "للجهة المختصة ... اتخاذ ما يأتي", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30(4); Article 37(1)"}, {"slot": "action", "gdpr_value": "be competent for the performance of the tasks assigned to it", "target_value": "مباشرتها مهماتها المتعلقة بالإشراف على تطبيق أحكام النظام واللوائح", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30(4); Article 30(1)"}, {"slot": "scope", "gdpr_value": "on the territory of its own Member State", "target_value": "في المملكة", "basis": "distributed", "verdict": "broader", "citation": "Article 33(1) (في المملكة); Article 33(4) (في خارج المملكة)"}, {"slot": "condition", "gdpr_value": "in accordance with this Regulation", "target_value": "الإشراف على تطبيق أحكام النظام واللوائح", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30(1); Article 30(4)"}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "covered_broader", "confidence": 0.69, "reasoning_note": "Article 30(1) establishes the competent authority as the supervisor for applying the Law/Regulations and Article 30(4) grants it explicit powers to perform its supervisory tasks. Territorial linkage appears in Article 33(1) (in the Kingdom), while Article 33(4) adds extraterritorial follow-up for entities outside the Kingdom; thus the authority’s remit includes domestic territory (meeting the GDPR’s core idea) and goes beyond it.", "label": "C4", "ru_id": "RU-649", "gdpr_article": 55, "jurisdiction": "KSA", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 6, "total": 18}, {"round": 3, "n_queries": 4, "new": 7, "total": 25}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The scope of the supervisory authority's power in the KSA jurisdiction may be broader than the GDPR requirement", "counter_evidence": [{"id": "Article 33(4)", "span": "تتولى الجهة المختصة تحديد الأدوات والآليات المناسبة لمتابعة التزام الجهات التي في خارج المملكة بالتزاماتها المقررة بموجب أحكام النظام واللوائح", "why": "This provision suggests that the supervisory authority's power may extend to entities outside the Kingdom"}], "confidence": 0.8}, {"verdict": "revise", "objection": "The KSA jurisdiction does not have a clear counterpart to the GDPR requirement that each supervisory authority has the power to perform tasks on the territory of its own Member State.", "counter_evidence": [{"id": "d9a05a425b46428120ee", "span": "المادة الثلاثون: 1- مع عدم الإخلال بأحكام النظام، وما للبنك المركزي السعودي من صلاحيات وفقاً لما تقضي به النصوص النظامية ذات العلاقة، تكون الجهة المختصة الجهة المشرفة على تطبيق أحكام النظام واللوائح.", "why": "This provision does not explicitly state that the competent authority has the power to perform tasks on the territory of its own Member State."}, {"id": "d9a05a425b46428120ee", "span": "4- للجهة المختصة في سبيل مباشرتها مهماتها المتعلقة بالإشراف على تطبيق أحكام النظام واللوائح، اتخاذ ما يأتي: أ- طلب الوثائق أو المعلومات اللازمة من جهة التحكم للتأكد من التزامها بأحكام النظام واللوائح.", "why": "This provision does not specify that the actions taken by the competent authority are limited to the territory of its own Member State."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["3a56eed81feb3655d1d1", "f8c6dae3f69fbe207307", "c511c9bf7779067e64f4", "d9a05a425b46428120ee", "ce107f77eb9119ba01b0", "c95a0b593cc554df0eae", "04f45ac99bac1acaa486", "04322a32135a68c65bb5", "8394f801a0a97e521f68", "4de7a5d9d6e42dc170c3", "62cc177254bb6a5bed90", "06b918a4049719ed530f"], "n_llm_calls": 7, "latency_s": 586.03, "temperature": 0.7, "seed": 20260802, "id": "13a1de1d8311a100c813", "condition": "stability", "rep": 1}
{"candidates_selected": ["fd2c91edc2e3ff926c6b", "a0040ee4dad7d4440e19"], "candidates_excluded": [{"id": "a0a0194dd91481c29c6e", "reason": "General requirement to set internal controls and procedures, including for transfers, but does not require specifying transfer sets, categories of data, purposes, data-subject types, or destination countries."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Concerns publishing a data protection policy and the mechanism for data subject rights; does not require specification of transfers or their attributes."}, {"id": "9afcca9ce75d4e0c23f1", "reason": "General obligation to follow Ministry-decided procedures; no content requirements for transfer specification."}, {"id": "05b7537a91d92a0529ad", "reason": "Designation of a data protection officer; unrelated to specifying transfers."}, {"id": "6e6fc1f4d7421fb141d6", "reason": "DPO qualifications; unrelated to specifying transfers."}, {"id": "d0bb19cb0c67952144b4", "reason": "Data portability right; not about specifying organizational transfer rules."}, {"id": "40626451a5025d77cff5", "reason": "Pre-processing notice to data subjects (purpose, description, disclosure levels); does not require identifying destination countries, data-subject types, or detailed transfer sets."}, {"id": "b59c6e3df96d0cdf91f8", "reason": "External auditor appointment/reporting; no transfer specification content."}, {"id": "a37f6f979ece2e1de6bf", "reason": "Cooperation with the Ministry; no content requirements for transfers."}, {"id": "6ada991a77a31372fb4c", "reason": "Conditions for appointing an external auditor; not about transfer specification."}], "target_frame": {"addressee": {"span": "يجب على المتحكم", "article": "Article 39"}, "modality": {"span": "يجب", "article": "Article 39"}, "action": {"span": "1- وصفاً لطبيعة وحجم البيانات الشخصية المراد نقلها أو تحويلها، ودرجة حساسيتها. 2- الغرض من معالجة البيانات الشخصية ونطاق المعالجة والجهات التي سيتم مشاركة البيانات الشخصية معها. 3- المدة الزمنية لمعالجة البيانات الشخصية، وما إذا كانت ستتم بشكل مقيد أو عرضي لمرة واحدة فقط أو بشكل متكرر ومنتظم خلال مدة محدودة. 4- مراحل نقل أو تحويل البيانات الشخصية والدول التي قد تمر بها، وتحديد الوجهة النهائية للبيانات الشخصية. 5- الآثار والمخاطر التي قد تترتب على عملية النقل أو التحويل، ومدى تأثيرها على صاحب البيانات الشخصية.", "article": "Article 39"}, "scope": {"span": "إجراء تقييم لمستوى الحماية التي توفرها جهة المعالجة الخارجية ومخاطر نقل أو تحويل البيانات الشخصية", "article": "Article 39"}, "condition": {"span": "لمستوى الحماية التي توفرها جهة المعالجة الخارجية ومخاطر نقل أو تحويل البيانات الشخصية", "article": "Article 39"}, "exception": {"span": null, "article": null}, "temporal": {"span": "قبل معالجة أي من البيانات الشخصية", "article": "Article 5"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller or processor adopting binding corporate rules", "target_value": "يجب على المتحكم", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 39", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "يجب / يلتزم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 39", "slot": "modality"}, {"gdpr_value": "specify the data transfers or sets of transfers, including the categories of personal data, the type of processing and its purposes, the type of data subjects affected, and the identification of the third country or countries", "target_value": "تضمين التقييم وصف طبيعة وحجم البيانات ودرجة حساسيتها، الغرض ونطاق المعالجة والجهات المشاركة، المدة، ومراحل النقل والدول التي قد تمر بها وتحديد الوجهة النهائية", "basis": "direct_textual", "verdict": "partial", "citation": "Article 39; Article 5", "slot": "action"}, {"gdpr_value": "content of binding corporate rules", "target_value": "محتوى تقييم مخاطر/حماية نقل البيانات عبر جهة معالجة خارجية أو طلب التصريح", "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr_value": "None", "target_value": "ارتباط الالتزام بنقل أو تحويل البيانات الشخصية إلى جهة معالجة خارجية", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 39", "slot": "condition"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": "قبل معالجة أي من البيانات الشخصية (بالنسبة للتصريح)", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 5", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.58, "reasoning_note": "OMN texts do not establish binding corporate rules, so the BCR-specific scope is absent. However, Article 39 obliges controllers to detail key transfer elements (categories/nature, purposes/scope, recipients, routes and destination countries) in a transfer risk assessment, and Article 5 requires permit applications to include categories, purposes, recipients, and transfer/storage locations. The element ‘types of data subjects’ and coverage of processors are missing, so only partial functional equivalence exists.", "label": "C4", "ru_id": "RU-584", "gdpr_article": 47, "jurisdiction": "OMN", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 11, "total": 23}, {"round": 3, "n_queries": 4, "new": 1, "total": 24}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "The OMN jurisdiction's provisions do not explicitly require the controller to specify the relevant data transfers or sets of transfers, including categories of personal data, types and purposes of processing, types of data subjects affected, and the identification of the third country or countries.", "counter_evidence": [{"id": "a0040ee4dad7d4440e19", "span": "Article 5", "why": "Article 5 requires the controller to obtain a permit from the Ministry before processing any personal data, but does not explicitly require the specification of data transfers or sets of transfers."}, {"id": "fd2c91edc2e3ff926c6b", "span": "Article 39", "why": "Article 39 requires an assessment of the risks associated with the transfer or transmission of personal data, but does not provide a direct counterpart to the GDPR requirement."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["a0a0194dd91481c29c6e", "bb26cffae1f1c0beb85d", "9afcca9ce75d4e0c23f1", "05b7537a91d92a0529ad", "6e6fc1f4d7421fb141d6", "d0bb19cb0c67952144b4", "40626451a5025d77cff5", "b59c6e3df96d0cdf91f8", "a37f6f979ece2e1de6bf", "fd2c91edc2e3ff926c6b", "6ada991a77a31372fb4c", "a0040ee4dad7d4440e19"], "n_llm_calls": 6, "latency_s": 467.55, "temperature": 0.7, "seed": 20260802, "id": "f4d32102f79266042d88", "condition": "stability", "rep": 1}
{"candidates_selected": ["9f3112d28a1b850ba61f"], "candidates_excluded": [{"id": "62dc9e8ad2aa962982ad", "reason": "Sets general pre-service information duties but does not require providing contact details of a representative; not specific to the representative or to timing at data collection."}, {"id": "b983a5ed0e1c7a2b779a", "reason": "Addresses lawful bases and proof of consent; contains no transparency duty to provide contact details nor any exception tied to the data subject already having such information, and no mention of a representative."}], "target_frame": {"addressee": {"span": "يجب على مقدم الخدمة", "article": "Article 4 (chapeau)"}, "modality": {"span": "يجب على", "article": "Article 4 (chapeau)"}, "action": {"span": "تحديد هوية ومكان مقدم الخدمة، بما في ذلك معلومات عن كيفية الاتصال بهم بشأن ممارساتهم ومعالجة البيانات الشخصية.", "article": "Article 4(3)"}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": "أثناء توفير الخدمة أو بعد انتهائها", "article": "Article 4 (chapeau)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "controller", "target": "مقدم الخدمة (service provider)", "basis": "conceptual", "verdict": "covered", "citation": "Article 4 (chapeau)", "slot": "addressee"}, {"gdpr": "obligation", "target": "يجب على", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4 (chapeau)", "slot": "modality"}, {"gdpr": "provide the data subject with the contact details of the controller's representative", "target": "تحديد هوية ومكان مقدم الخدمة، بما في ذلك معلومات عن كيفية الاتصال بهم", "basis": "direct_textual", "verdict": "partial", "citation": "Article 4(3)", "slot": "action"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "scope"}, {"gdpr": "where personal data are collected from the data subject and the controller has a representative", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr": "unless and insofar as the data subject already has the information", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "exception"}, {"gdpr": "at the time when personal data are obtained", "target": "أثناء توفير الخدمة أو بعد انتهائها", "basis": "direct_textual", "verdict": "broader", "citation": "Article 4 (chapeau)", "slot": "temporal"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.66, "reasoning_note": "No provision mentions a controller’s representative or an exception where the data subject already has that information. Article 4 requires providing contact details of the service provider, not a representative, and ties this to during/after service rather than at collection. The cited Article 3 sentence only requires the provider to be able to prove consent; it does not create an exception to information duties.", "label": "C2", "ru_id": "RU-057", "gdpr_article": 13, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 1, "total": 1}, {"round": 2, "n_queries": 4, "new": 2, "total": 3}, {"round": 3, "n_queries": 4, "new": 0, "total": 3}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Potential counterparts for 'action' and 'condition' slots exist in the target jurisdiction's provisions", "counter_evidence": [{"id": "9f3112d28a1b850ba61f", "span": "تحديد هوية ومكان مقدم الخدمة، بما في ذلك معلومات عن كيفية الاتصال بهم بشأن ممارساتهم ومعالجة البيانات الشخصية", "why": "This provision requires the service provider to provide contact information, which might be related to the GDPR requirement of providing contact details of the controller's representative"}, {"id": "62dc9e8ad2aa962982ad", "span": "يجب على مقدم الخدمة وقبل توفير الخدمة للمستخدم أن يقوم بالتالي: ... 2. الحصول على موافقة طالب الخدمة على جمع أو معالجة البيانات الشخصية", "why": "This provision implies that the service provider must obtain consent from the data subject before collecting or processing their personal data, which is similar to the GDPR condition"}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's slot verdict for the 'exception' slot is unsupported by the provisions.", "counter_evidence": [{"id": "b983a5ed0e1c7a2b779a", "span": "جوب أن يكون لمقدم الخدمة القدرة على إثبات موافقة صاحب البيانات على معالجة البيانات", "why": "This provision implies that the service provider must have already obtained the necessary information from the data subject, which could be interpreted as covering the GDPR exception."}], "confidence": 0.8}], "n_candidates": 3, "candidate_ids": ["b983a5ed0e1c7a2b779a", "62dc9e8ad2aa962982ad", "9f3112d28a1b850ba61f"], "n_llm_calls": 7, "latency_s": 575.51, "temperature": 0.7, "seed": 20260802, "id": "ed5bd02ef6db5b73d7ec", "condition": "stability", "rep": 1}
{"candidates_selected": ["f1d11d7b0c4a6479bbe4", "3f916831456908af27d8", "de8d26aee9201d58a52b", "32b9a27e5465ffb47819"], "candidates_excluded": [{"id": "caad155111190c1aa274", "reason": "Definitions; does not establish penalties or rule-making duties."}, {"id": "a2a61b7c9316716b7e74", "reason": "Substantive prohibition on disclosure; not about penalties framework."}, {"id": "a0040ee4dad7d4440e19", "reason": "Permit application content; not penalties or rule-laying."}, {"id": "3a6219e8839cbad1f76e", "reason": "Breach notification obligation; not penalties framework."}, {"id": "823830174d241884bd73", "reason": "Complaint right; not penalties or rule-laying."}, {"id": "c62011bb3dda1c9374e5", "reason": "General protection clause; not penalties or rule-laying."}, {"id": "4f65c1f467f9e61b2f46", "reason": "Scope of law; not penalties framework."}, {"id": "dcd007160208896c8632", "reason": "Breach notification timing/content; not penalties framework."}], "target_frame": {"addressee": {"span": "الوزارة", "article": "Article 32"}, "modality": {"span": "يجوز", "article": "Article 32"}, "action": {"span": "فرض جزاءات إدارية", "article": "Article 32"}, "scope": {"span": "على المخالفات التي يتم ارتكابها بالمخالفة لأحكام هذا القانون أو اللائحة أو القرارات الصادرة تنفيذاً له", "article": "Article 32"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "Member States", "target_value": "الوزارة", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 32", "slot": "addressee"}, {"gdpr_value": "obligation (shall)", "target_value": "يجوز (may)", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 32", "slot": "modality"}, {"gdpr_value": "lay down rules on other penalties applicable to infringements of this Regulation", "target_value": "فرض جزاءات إدارية؛ إنذار/تصحيح أو محو/وقف المعالجة أو التحويل؛ إلغاء التصريح؛ عقوبات على الجرائم المبينة في القانون", "basis": "distributed", "verdict": "partial", "citation": "Article 32; Article 8; Article 10; Article 24", "slot": "action"}, {"gdpr_value": "particularly for infringements not subject to administrative fines under Article 83", "target_value": "على المخالفات لأحكام هذا القانون أو اللائحة أو القرارات الصادرة تنفيذاً له (دون تخصيص لحالات غير الخاضعة للغرامات الإدارية)", "basis": "direct_textual", "verdict": "partial", "citation": "Article 32", "slot": "scope"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.62, "reasoning_note": "Article 32 uses ‘يجوز’ (may), so the modality is weaker than the GDPR’s ‘shall’. The target provisions establish and authorize penalties/measures (administrative sanctions, revocation, and criminal penalties) but do not impose a duty to lay down such rules, nor do they specify the ‘particularly where not subject to administrative fines’ focus. Adjustments address the reviewer’s objections on modality and action coverage.", "label": "C3", "ru_id": "RU-948", "gdpr_article": 84, "jurisdiction": "OMN", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 1, "total": 26}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict may be incorrect, as the target jurisdiction (OMN) may have a counterpart to the GDPR provision.", "counter_evidence": [{"id": "f1d11d7b0c4a6479bbe4", "span": "مع عدم الإخلال بالعقوبات المنصوص عليها في هذا القانون، يجوز للوزارة فرض جزاءات إدارية على المخالفات التي يتم ارتكابها بالمخالفة لأحكام هذا القانون أو اللائحة أو القرارات الصادرة تنفيذاً له", "why": "This provision suggests that the Ministry has the authority to impose administrative penalties, which could be considered as 'laying down rules on other penalties'."}, {"id": "32b9a27e5465ffb47819", "span": "مع عدم الإخلال بأي عقوبة أشد ينص عليها قانون الجزاء أو أي قانون آخر، يعاقب على الجرائم المبينة في هذا القانون بالعقوبات المنصوص عليها فيه", "why": "This provision implies that there are other penalties applicable to infringements, particularly those not subject to administrative fines."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The modality slot verdict is not supported by the modal wording in Article 32, and the action slot verdict is not fully covered by the provisions cited.", "counter_evidence": [{"id": "f1d11d7b0c4a6479bbe4", "span": "يجوز للوزارة فرض جزاءات إدارية", "why": "The modal wording 'يجوز' (may) does not imply an obligation to lay down rules on other penalties applicable to infringements of the GDPR."}, {"id": "f1d11d7b0c4a6479bbe4", "span": "فرض جزاءات إدارية؛ إجراءات أخرى (إنذار، تصحيح/محو، وقف المعالجة/التحويل)؛ إلغاء التصريح؛ وبيان عقوبات لجرائم هذا القانون", "why": "This provision does not explicitly state that the Ministry shall lay down rules on other penalties applicable to infringements of the GDPR."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["caad155111190c1aa274", "a2a61b7c9316716b7e74", "3f916831456908af27d8", "a0040ee4dad7d4440e19", "3a6219e8839cbad1f76e", "823830174d241884bd73", "f1d11d7b0c4a6479bbe4", "de8d26aee9201d58a52b", "c62011bb3dda1c9374e5", "4f65c1f467f9e61b2f46", "dcd007160208896c8632", "32b9a27e5465ffb47819"], "n_llm_calls": 7, "latency_s": 677.06, "temperature": 0.7, "seed": 20260802, "id": "6b26219bf6ac9d32a153", "condition": "stability", "rep": 1}
{"candidates_selected": ["14fe9b230c7ba11703d5"], "candidates_excluded": [{"id": "34ea02d93464e8e2fa05", "reason": "Definitions; does not establish or mandate penalties."}, {"id": "762372b7329c44286e43", "reason": "Lawful-basis conditions for processing; not about penalties."}, {"id": "6b500d26673394f3d7e6", "reason": "Data subject rectification/blocking/erasure rights; not penalties."}, {"id": "10e6e0e9f2f36b4c7b42", "reason": "Rules on public registers; not penalties."}, {"id": "3d71a23a91370cadf799", "reason": "Substantive rules for criminal-justice data; not penalties."}, {"id": "cf27d7263418b5d502ef", "reason": "Definitions; not penalties."}, {"id": "803cdc5aa2ea085c3461", "reason": "Cross-border transfer conditions; not penalties (though referenced by the penalties article)."}, {"id": "5e5fa8a4888b88a04311", "reason": "Civil compensation remedy; not a penalty regime."}, {"id": "79c959efd73d5d166449", "reason": "Settlement procedure; regulates disposition of certain offenses but does not itself lay down penalties."}, {"id": "74358e437cd9e85fdabb", "reason": "DPO functions/obligations; not penalties."}, {"id": "6a403e591ecc2a5638fc", "reason": "Administrative investigation of DPO; not general penalties for infringements."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "article": null}, "action": {"span": "العقوبات ... يعاقَب بالحبس مدة لا تزيد على سنة وبالغرامة التي لا تقل عن ألف دينار ولا تتجاوز عشرين ألف دينار، أو بإحدى هاتين العقوبتين، كلُّ مَن: أ - عالج بيانات شخصية حساسة بالمخالفة لحكم المادة (5) من هذا القانون. ب - نقل بيانات شخصية خارج المملكة إلى بلد أو إقليم بالمخالفة لحكم أيٍّ من المادتين (12) و(13) من هذا القانون. ج - عالج بيانات شخصية دون إخطار الهيئة بذلك بالمخالفة لحكم البند (1) من المادة (14) من هذا القانون. ...", "article": "Article 58"}, "scope": {"span": "كلُّ مَن: أ - عالج بيانات شخصية حساسة بالمخالفة لحكم المادة (5) ... ب - نقل بيانات شخصية خارج المملكة ... ج - عالج بيانات شخصية دون إخطار الهيئة ... د - تخلَّف عن إخطار الهيئة ... هـ - عالج بيانات شخصية دون تصريح مسبق من الهيئة ... و - قدَّم إلى الهيئة أو إلى صاحب البيانات بيانات كاذبة أو مضلِّلة ... ز - حَجَب عن الهيئة أية بيانات أو معلومات ... ح - تسبَّب في إعاقة أو تعطيل عمل مفتشي الهيئة ... ط - أفصح عن أية بيانات أو معلومات ...", "article": "Article 58(1)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "Member States", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "modality", "gdpr_value": "obligation (shall)", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "action", "gdpr_value": "lay down rules on other penalties applicable to infringements of this Regulation", "target_value": "العقوبات ... يعاقَب بالحبس ... وبالغرامة ... لكل من [ارتكب المخالفات المبينة]", "basis": "conceptual", "verdict": "covered", "citation": "Article 58"}, {"slot": "scope", "gdpr_value": "particularly for infringements not subject to administrative fines under Article 83", "target_value": "تطبق العقوبات على قائمة محددة من مخالفات قانون حماية البيانات الشخصية الواردة في المادة 58(1)-(3)", "basis": "direct_textual", "verdict": "partial", "citation": "Article 58(1)-(3)"}, {"slot": "condition", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.66, "reasoning_note": "Bahrain’s PDPL directly sets out criminal penalties for specified infringements, thereby functionally satisfying the idea of laying down penalties. However, the text does not contain a meta-obligation on the state to legislate such penalties nor the GDPR-specific emphasis on cases not subject to administrative fines. Hence partial coverage.", "label": "C2", "ru_id": "RU-948", "gdpr_article": 84, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 11, "total": 23}, {"round": 3, "n_queries": 4, "new": 1, "total": 24}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["34ea02d93464e8e2fa05", "762372b7329c44286e43", "6b500d26673394f3d7e6", "10e6e0e9f2f36b4c7b42", "3d71a23a91370cadf799", "cf27d7263418b5d502ef", "803cdc5aa2ea085c3461", "14fe9b230c7ba11703d5", "5e5fa8a4888b88a04311", "79c959efd73d5d166449", "74358e437cd9e85fdabb", "6a403e591ecc2a5638fc"], "n_llm_calls": 4, "latency_s": 332.1, "temperature": 0.7, "seed": 20260802, "id": "96de31abd5ca9be6dae4", "condition": "stability", "rep": 1}
{"candidates_selected": ["c24849787475f274ecac"], "candidates_excluded": [{"id": "a3c79315ae2d7920a38f", "reason": "Complaints procedure; does not set criteria for imposing or sizing administrative fines."}, {"id": "7e2914aa34ab2739dafd", "reason": "Security obligations for controllers/processors; no relevance to administrative fine assessment factors."}, {"id": "8cd7b777aa3cd8ca5f1f", "reason": "Defines authority’s tasks/powers generally; does not prescribe factors for fines."}, {"id": "8e585010f3f5f3f24dbb", "reason": "Inspection and investigation; no criteria for administrative fines."}, {"id": "5a79146e04b73c99685c", "reason": "Data subject’s right to be informed; unrelated to administrative fines."}, {"id": "14fe9b230c7ba11703d5", "reason": "Criminal sanctions by courts; not administrative fine-setting by the authority."}, {"id": "cbcb4f73e9dfbf01c9bf", "reason": "Internal investigation by controllers; no relevance to authority’s fine assessment."}, {"id": "74358e437cd9e85fdabb", "reason": "DPO duties and registration; does not address fine criteria."}, {"id": "5e5fa8a4888b88a04311", "reason": "Civil compensation; distinct from administrative fines."}, {"id": "1d8fd3d4070b1ff36d68", "reason": "Prior notification to authority; not relevant to fine assessment criteria."}, {"id": "3daba86dc4c13ff4e918", "reason": "DPIA requirements; no criteria for fines."}], "target_frame": {"addressee": {"span": "مجلس الإدارة", "article": "c24849787475f274ecac"}, "modality": {"span": "يتعيَّن عند تقدير الغرامة مراعاة ...", "article": "c24849787475f274ecac"}, "action": {"span": "عند تقدير الغرامة مراعاة جسامة المخالفة، والعنت الذي بدا من المخالف، والمنافع التي جناها، والضرر الذي أصاب صاحب البيانات", "article": "c24849787475f274ecac"}, "scope": {"span": "جسامة المخالفة، والعنت الذي بدا من المخالف، والمنافع التي جناها، والضرر الذي أصاب صاحب البيانات", "article": "c24849787475f274ecac"}, "condition": {"span": "في الحالتين المنصوص عليهما في البندين (1/ب) و(1/ج)", "article": "c24849787475f274ecac"}, "exception": {"span": null, "article": null}, "temporal": {"span": "عند تقدير الغرامة", "article": "c24849787475f274ecac"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "each supervisory authority", "target_value": "مجلس الإدارة (الجهة التي تُصدر قرار الغرامة في إطار الهيئة)", "basis": "conceptual", "verdict": "covered", "citation": "Article 55(1): \"يأمر مجلس الإدارة ... توقيع غرامة إدارية\"", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "يتعيَّن ... مراعاة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 55(2): \"يتعيَّن عند تقدير الغرامة مراعاة ...\"", "slot": "modality"}, {"gdpr_value": "give due regard to the nature, gravity and duration of the infringement", "target_value": "مراعاة جسامة المخالفة، والعنت الذي بدا من المخالف، والمنافع التي جناها، والضرر الذي أصاب صاحب البيانات", "basis": "direct_textual", "verdict": "partial", "citation": "Article 55(2): \"يتعيَّن عند تقدير الغرامة مراعاة جسامة المخالفة، والعنت ... والمنافع ... والضرر ...\" (no mention of nature or duration)", "slot": "action"}, {"gdpr_value": "including the nature, scope or purpose of the processing concerned, the number of data subjects affected, and the level of damage suffered by them", "target_value": "جسامة المخالفة، العنت، المنافع المتحصلة، الضرر الذي أصاب صاحب البيانات", "basis": "direct_textual", "verdict": "partial", "citation": "Article 55(2): considers gravity, intent/obstinacy, benefits, and harm; does not mention nature/scope/purpose, number of data subjects.", "slot": "scope"}, {"gdpr_value": "None", "target_value": "قصر مراعاة المعايير على حالتي الغرامة التهديدية والغرامة الإدارية: \"في الحالتين المنصوص عليهما في البندين (1/ب) و(1/ج)\"", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 55(2)", "slot": "condition"}, {"gdpr_value": "None", "target_value": "None stated", "basis": "absent", "verdict": "covered", "citation": "", "slot": "exception"}, {"gdpr_value": "when deciding whether to impose an administrative fine and when deciding on the amount in each individual case", "target_value": "عند تقدير الغرامة (مرحلة تقدير مبلغ الغرامة فقط)", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 55(2): \"عند تقدير الغرامة\" (does not address the decision whether to impose)", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None stated", "basis": "absent", "verdict": "covered", "citation": "", "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.66, "reasoning_note": "Article 55(2) obliges the authority to consider certain factors when assessing the fine amount, but it does not list duration of the infringement, nor the nature/scope/purpose of processing or number of affected data subjects. It also frames the obligation at the fine-amount stage (and only for two fine types), not at the decision whether to impose a fine. This directly addresses the objection: duration is not mentioned in the Bahraini text.", "label": "C2", "ru_id": "RU-938", "gdpr_article": 83, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 12, "total": 24}, {"round": 3, "n_queries": 4, "new": 6, "total": 30}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The BHR law does not explicitly mention all the factors required by the GDPR, such as the nature, scope or purpose of the processing concerned and the number of data subjects affected.", "counter_evidence": [{"id": "c24849787475f274ecac", "span": "Article 55(2): \"عند تقدير الغرامة مراعاة جسامة المخالفة، والعنت الذي بدا من المخالف، والمنافع التي جناها، والضرر الذي أصاب صاحب البيانات نتيجة لذلك\"", "why": "This provision does not mention all the factors required by the GDPR."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The BHR law does not explicitly mention considering the duration of the infringement as a factor when determining the fine.", "counter_evidence": [{"id": "c24849787475f274ecac", "span": "جسامة المخالفة، والعنت الذي بدا من المخالف، والمنافع التي جناها، والضرر الذي أصاب صاحب البيانات", "why": "Article 55(2) mentions considering the gravity, intent, benefits, and harm, but not the duration of the infringement."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["a3c79315ae2d7920a38f", "7e2914aa34ab2739dafd", "8cd7b777aa3cd8ca5f1f", "8e585010f3f5f3f24dbb", "5a79146e04b73c99685c", "c24849787475f274ecac", "14fe9b230c7ba11703d5", "cbcb4f73e9dfbf01c9bf", "74358e437cd9e85fdabb", "5e5fa8a4888b88a04311", "1d8fd3d4070b1ff36d68", "3daba86dc4c13ff4e918"], "n_llm_calls": 7, "latency_s": 553.44, "temperature": 0.7, "seed": 20260802, "id": "12df64e59473cc2a5913", "condition": "stability", "rep": 1}
{"candidates_selected": ["c95a0b593cc554df0eae"], "candidates_excluded": [{"id": "0269f42c0015a544c475", "reason": "Addresses marketing communications requirements, not contents of records of processing."}, {"id": "14105f25ea49e7794aaa", "reason": "DPIA content and process; does not regulate record-of-processing content about controller identity."}, {"id": "a409908037f5e17f0eba", "reason": "Data minimization; no obligation about record contents."}, {"id": "0ec82f88effbafd6a911", "reason": "Health-data specific safeguards; unrelated to record-of-processing content."}, {"id": "c44e3478969c6bbb366c", "reason": "Mentions including purpose in records for certain repurposing scenarios, but does not require including the controller’s name or contact details."}, {"id": "0922609ffbfd96a70f90", "reason": "Right to erasure; unrelated to record-of-processing content."}, {"id": "4de7a5d9d6e42dc170c3", "reason": "National register of controllers; not the controller’s internal records of processing."}, {"id": "08b4c74d887bbe3b2039", "reason": "Credit-data processing rules; no record-of-processing content about controller identity."}, {"id": "04322a32135a68c65bb5", "reason": "Retention of proof of a legitimate interest; not general record-of-processing content."}, {"id": "c511c9bf7779067e64f4", "reason": "Legal bases and exceptions for collection/processing; no requirement about record content."}, {"id": "90da7bc2380e8f3f2fb8", "reason": "Timelines for responding to data-subject requests; not record-of-processing content."}], "target_frame": {"addressee": {"span": "جهة التحكم", "article": "Article 31"}, "modality": {"span": "على أن تشمل السجلات حدا أدنى من البيانات الآتية", "article": "Article 31"}, "action": {"span": "تفاصيل الاتصال الخاصة بجهة التحكم.", "article": "Article 31"}, "scope": {"span": "سجلات لمدة تحددها اللوائح لأنشطة معالجة البيانات الشخصية بحسب طبيعة النشاط الذي تمارسه جهة التحكم", "article": "Article 31"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller", "target_value": "جهة التحكم (controller)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 31"}, {"slot": "modality", "gdpr_value": "obligation (shall)", "target_value": "على أن تشمل السجلات … (mandatory minimum content)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 31"}, {"slot": "action", "gdpr_value": "include the name and contact details of the controller in the record", "target_value": "include the controller’s contact details in the records", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 31 (item 1)"}, {"slot": "scope", "gdpr_value": "the record of processing activities maintained under Article 30(1)", "target_value": "records of personal data processing activities", "basis": "direct_textual", "verdict": "covered", "citation": "Article 31"}, {"slot": "condition", "gdpr_value": "None", "target_value": "None stated", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": "None stated", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "None stated for inclusion of contact details", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None stated", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.78, "reasoning_note": "Article 31 expressly requires including the controller’s contact details in the records but does not mention the controller’s name. Therefore, the target text only partially covers the GDPR requirement, which calls for both name and contact details. This directly addresses the objection: the KSA text omits an explicit requirement to record the controller’s name.", "label": "C1", "ru_id": "RU-255", "gdpr_article": 30, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 9, "total": 21}, {"round": 3, "n_queries": 4, "new": 3, "total": 24}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "The KSA jurisdiction does not explicitly require the controller's name to be included in the record.", "counter_evidence": [{"id": "c95a0b593cc554df0eae", "span": "المادة الحادية والثلاثون: دون إخلال بما ورد في المادة (الثامنة عشرة) من النظام، تحتفظ جهة التحكم بسجلات لمدة تحددها اللوائح لأنشطة معالجة البيانات الشخصية بحسب طبيعة النشاط الذي تمارسه جهة التحكم؛ لتكون متاحة عندما تطلبها الجهة المختصة. على أن تشمل السجلات حدا أدنى من البيانات الآتية: 1- تفاصيل الاتصال الخاصة بجهة التحكم.", "why": "The provision only mentions the contact details of the controller, but not the controller's name."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["c95a0b593cc554df0eae", "0269f42c0015a544c475", "14105f25ea49e7794aaa", "a409908037f5e17f0eba", "0ec82f88effbafd6a911", "c44e3478969c6bbb366c", "0922609ffbfd96a70f90", "4de7a5d9d6e42dc170c3", "08b4c74d887bbe3b2039", "04322a32135a68c65bb5", "c511c9bf7779067e64f4", "90da7bc2380e8f3f2fb8"], "n_llm_calls": 6, "latency_s": 431.73, "temperature": 0.7, "seed": 20260802, "id": "c6caf0e597c493174f81", "condition": "stability", "rep": 1}
{"candidates_selected": ["[9b42add02f4d45cf8a57]"], "candidates_excluded": [{"id": "[2c020ba48e817e4f4c7a]", "reason": "Operational security and record-keeping obligations; no provision laying down or referencing a penalty regime."}, {"id": "[a418980931b429c7909a]", "reason": "Breach notification duties; does not establish or reference rules on penalties."}, {"id": "[e8fe267db21063b1b45f]", "reason": "Scope clause; no penalties framework."}, {"id": "[b983a5ed0e1c7a2b779a]", "reason": "Lawfulness bases for processing; no penalties framework."}], "target_frame": {"addressee": {"span": "للھيئة ... تطبيق الجزاءات والغرامات", "article": "Article 7(3)"}, "modality": {"span": "يجوز للهيئة", "article": "Article 7(3)"}, "action": {"span": "تطبيق الجزاءات والغرامات المنصوص عليها بالقانون رقم 37 لسنة 2014 ...", "article": "Article 7(3)"}, "scope": {"span": "في حال ثبوت مخالفة أحكام هذه اللائحة أو قوانين دولة الكويت", "article": "Article 7(3)"}, "condition": {"span": "في حال ثبوت مخالفة أحكام هذه اللائحة أو قوانين دولة الكويت", "article": "Article 7(3)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "Member States", "target_value": "الهيئة العامة للاتصالات وتقنية المعلومات (الهيئة)", "basis": "conceptual", "verdict": "narrower", "citation": "Article 7(3)", "slot": "addressee"}, {"gdpr_value": "obligation (shall)", "target_value": "permission (يجوز)", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 7(3)", "slot": "modality"}, {"gdpr_value": "lay down rules on other penalties applicable to infringements of this Regulation", "target_value": "apply sanctions and fines provided in Law No. 37 of 2014 (as amended)", "basis": "direct_textual", "verdict": "partial", "citation": "Article 7(3)", "slot": "action"}, {"gdpr_value": "particularly for infringements not subject to administrative fines under Article 83", "target_value": "violations of this Regulation or laws of Kuwait; reference to 'sanctions and fines' indicating penalties beyond fines but without an explicit focus on non-fined infringements", "basis": "direct_textual", "verdict": "partial", "citation": "Article 7(3)", "slot": "scope"}, {"gdpr_value": "None", "target_value": "في حال ثبوت مخالفة أحكام هذه اللائحة أو قوانين دولة الكويت", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 7(3)", "slot": "condition"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": "No temporal element expressed for laying down penalty rules", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.62, "reasoning_note": "Article 7(3) directly references a penalty framework (“sanctions and fines”) in another law, evidencing the existence of penalties beyond fines. However, it authorizes application rather than laying down rules itself and does not single out infringements not subject to fines, so coverage of the GDPR’s specific focus is only partial. Modality is also weaker (may vs shall).", "label": "C3", "ru_id": "RU-948", "gdpr_article": 84, "jurisdiction": "KWT", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 3, "total": 3}, {"round": 2, "n_queries": 4, "new": 2, "total": 5}, {"round": 3, "n_queries": 4, "new": 0, "total": 5}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict of 'uncovered' for the addressee slot and 'weaker_modality' for the modality slot might be too strict, as Article 7(3) provides a rule for applying sanctions and fines.", "counter_evidence": [{"id": "[9b42add02f4d45cf8a57] Article 7(3)", "span": "للهيئة في حال ثبوت مخالفة أحكام هذه اللائحة أو قوانين دولة الكويت تطبيق الجزاءات والغرامات المنصوص عليها بالقانون رقم 37 لسنة 2014 لإنشاء الهيئة العامة للاتصالات وتقنية المعلومات والمعدل بالقانون رقم (98) لسنة 2015", "why": "This provision establishes a rule for applying sanctions and fines in case of infringements, which could be seen as a form of obligation."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's claim that there is no counterpart for 'particularly for infringements not subject to administrative fines under Article 83' is potentially unsupported. A more thorough review of the provisions is needed to confirm the absence of a counterpart.", "counter_evidence": [{"id": "[9b42add02f4d45cf8a57]", "span": "تطبيق الجزاءات والغرامات المنصوص عليها بالقانون رقم 37 لسنة 2014", "why": "This provision mentions the application of penalties and fines according to a specific law, which might be related to the GDPR's Article 83. Further analysis is required to determine if this provision or any other provision addresses the issue of infringements not subject to administrative fines."}], "confidence": 0.7}], "n_candidates": 5, "candidate_ids": ["2c020ba48e817e4f4c7a", "a418980931b429c7909a", "9b42add02f4d45cf8a57", "e8fe267db21063b1b45f", "b983a5ed0e1c7a2b779a"], "n_llm_calls": 7, "latency_s": 601.99, "temperature": 0.7, "seed": 20260802, "id": "757fed9d994111f375ca", "condition": "stability", "rep": 1}
{"candidates_selected": ["9cfd6fbae8182dbc0028"], "candidates_excluded": [{"id": "952167864cc3b0d724c1", "reason": "Addresses withdrawal of consent; does not concern providing DPO contact details or collection-time information duties."}, {"id": "c95a0b593cc554df0eae", "reason": "Concerns record-keeping for authorities; mentions controller contact details in records, not informing data subjects of DPO contact details."}, {"id": "8394f801a0a97e521f68", "reason": "Defines/mandates DPO appointment and duties; does not impose an obligation to provide DPO contact details to data subjects."}, {"id": "a79606d0fb564d3b2b5d", "reason": "Breach notification; unrelated to providing DPO contact details at collection."}, {"id": "7780dca28ee02b6e0f07", "reason": "Concerns legal guardian matters; not about informing data subjects of DPO contact details."}, {"id": "ea8306cd18f9261f6413", "reason": "General collection-time notice under the statute; does not require providing DPO contact details."}, {"id": "3a56eed81feb3655d1d1", "reason": "Public interest processing by public bodies; not about DPO contact details to data subjects."}, {"id": "0922609ffbfd96a70f90", "reason": "Erasure; unrelated to providing DPO contact details at collection."}, {"id": "c511c9bf7779067e64f4", "reason": "Alternate lawful bases and indirect collection; no duty to provide DPO contact details to data subjects."}, {"id": "f8c6dae3f69fbe207307", "reason": "Disclosure conditions; not about informing data subjects or DPO contact details."}, {"id": "557230873031d6e5cb2c", "reason": "Marketing processing conditions; not about providing DPO contact details."}], "target_frame": {"addressee": {"span": "على جهة التحكم", "article": "Article 4(1) [9cfd6fbae8182dbc0028]"}, "modality": {"span": "يجب على جهة التحكم", "article": "Article 4(1) [9cfd6fbae8182dbc0028]"}, "action": {"span": "بيانات الاتصال بمسؤول حماية البيانات الشخصية -إن وجد- المعين من قبل جهة التحكم.", "article": "Article 4(1)(b) [9cfd6fbae8182dbc0028]"}, "scope": {"span": null, "article": null}, "condition": {"span": "في حال تم جمع البيانات الشخصية من صاحبها مباشرة", "article": "Article 4(1) [9cfd6fbae8182dbc0028]"}, "exception": {"span": "لا يطبق ما ورد في الفقرة (1) من هذه المادة في حال كانت المعلومات الموضحة في الفقرات الفرعية (أ) إلى (ز) متوفرة مسبقاً لصاحب البيانات الشخصية، أو إذا كان تقديم تلك المعلومات يتعارض مع أي من الأنظمة السارية في المملكة.", "article": "Article 4(2) [9cfd6fbae8182dbc0028]"}, "temporal": {"span": "قبل أو عند جمع البيانات", "article": "Article 4(1) [9cfd6fbae8182dbc0028]"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "controller", "target": "جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1)", "slot": "addressee"}, {"gdpr": "obligation", "target": "يجب على جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1)", "slot": "modality"}, {"gdpr": "provide the data subject with the contact details of the data protection officer", "target": "بيانات الاتصال بمسؤول حماية البيانات الشخصية -إن وجد- المعين من قبل جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1)(b)", "slot": "action"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "scope"}, {"gdpr": "where personal data are collected from the data subject and provision is applicable", "target": "في حال تم جمع البيانات الشخصية من صاحبها مباشرة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1)", "slot": "condition"}, {"gdpr": "unless and insofar as the data subject already has the information", "target": "لا يطبق ما ورد في الفقرة (1) ... إذا كانت المعلومات ... متوفرة مسبقاً ... أو إذا كان تقديم تلك المعلومات يتعارض مع أي من الأنظمة السارية في المملكة", "basis": "direct_textual", "verdict": "broader", "citation": "Article 4(2)", "slot": "exception"}, {"gdpr": "at the time when personal data are obtained", "target": "قبل أو عند جمع البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(1)", "slot": "temporal"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.78, "reasoning_note": "Article 4(1)(b) expressly requires informing data subjects of the DPO’s contact details (if any) before or at the point of collection, which encompasses the GDPR’s “at the time” requirement. However, Article 4(2) adds an extra exception (conflict with laws in force) beyond the GDPR’s ‘already has the information’ carve‑out. Thus, timing is covered, but the exception is broader than GDPR.", "label": "C1", "ru_id": "RU-058", "gdpr_article": 13, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 11, "total": 23}, {"round": 3, "n_queries": 4, "new": 3, "total": 26}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The KSA jurisdiction's provisions do not explicitly require the controller to provide the contact details of the data protection officer at the time of data collection, and the exception in Article 4(2) may be broader than the exception in the GDPR.", "counter_evidence": [{"id": "9cfd6fbae8182dbc0028", "span": "Article 4(1)(b)", "why": "Does not explicitly state that the contact details of the data protection officer must be provided at the time of data collection."}, {"id": "9cfd6fbae8182dbc0028", "span": "Article 4(2)", "why": "Provides an exception to the requirement that may be broader than the exception in the GDPR."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The KSA jurisdiction may not have a complete counterpart to the GDPR requirement unit [RU-058], as the timing of providing the contact details of the data protection officer is not explicitly stated, and the exception in Article 4(2) may not be equivalent to the GDPR's exception.", "counter_evidence": [{"id": "9cfd6fbae8182dbc0028", "span": "Article 4(1)(b)", "why": "The provision requires the controller to provide the data subject with the contact details of the data protection officer, but it does not explicitly state that this information must be provided at the time of data collection."}, {"id": "9cfd6fbae8182dbc0028", "span": "Article 4(2)", "why": "The exception in this provision may not be entirely equivalent to the GDPR's exception, as it allows for an exception if the information is already available to the data subject or if providing it would contradict any regulations in force in the Kingdom."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["952167864cc3b0d724c1", "c95a0b593cc554df0eae", "8394f801a0a97e521f68", "a79606d0fb564d3b2b5d", "7780dca28ee02b6e0f07", "9cfd6fbae8182dbc0028", "ea8306cd18f9261f6413", "3a56eed81feb3655d1d1", "0922609ffbfd96a70f90", "c511c9bf7779067e64f4", "f8c6dae3f69fbe207307", "557230873031d6e5cb2c"], "n_llm_calls": 7, "latency_s": 565.5, "temperature": 0.7, "seed": 20260802, "id": "d4d79167564c7a1268e6", "condition": "stability", "rep": 1}
{"candidates_selected": ["498c9cb637b86367567b"], "candidates_excluded": [{"id": "a0040ee4dad7d4440e19", "reason": "General permitting/authorization requirement for processing (likely for certain categories) imposed on controllers; does not confer a state-level permission to issue employment-specific rules or mention collective agreements."}, {"id": "2712fe4ebdba355a134b", "reason": "Sets general processing principles and consent requirements for controllers; no meta-level permission for the state to adopt sector-specific (employment) rules."}, {"id": "a0a0194dd91481c29c6e", "reason": "Obliges controllers to establish controls and procedures; not a provision empowering state bodies to issue more specific rules for employment processing."}, {"id": "a2a61b7c9316716b7e74", "reason": "Prohibits disclosure except as legally permitted; a substantive rule for controllers, not a permission for state adoption of employment-specific rules."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Requires publication of a privacy policy; controller-facing obligation, not state permission regarding employment-specific rules."}, {"id": "b157dcadab6a3e8daf5f", "reason": "Enumerates data subject rights generally; does not address the state’s ability to issue employment-context rules."}, {"id": "a37f6f979ece2e1de6bf", "reason": "Duty to cooperate with the ministry; unrelated to state permission to create employment-specific data rules."}, {"id": "c62011bb3dda1c9374e5", "reason": "Declares personal data protected by the law; no empowerment or employment-specific scope."}, {"id": "93f989531fe30cac1ed5", "reason": "Erasure right conditions; substantive rights, not permission for state to issue employment-specific provisions."}, {"id": "865fbf2c2a6ca6fcb814", "reason": "Exclusions from the law’s scope; does not provide permission to set employment-specific rules."}, {"id": "caad155111190c1aa274", "reason": "Definitions; no operative permission relevant to employment-specific rules."}], "target_frame": {"addressee": {"span": "الوزارة", "article": "Article 7"}, "modality": {"span": "ولها على الأخص الآتي", "article": "Article 7"}, "action": {"span": "أ- إعداد واعتماد الضوابط والإجراءات المتعلقة بحماية البيانات الشخصية بما في ذلك تحديد الضمانات الضرورية والتدابير اللازمة وقواعد السلوك المتعلقة بحماية البيانات الشخصية. ب- إصدار الضوابط والإجراءات اللازمة لمعالجة البيانات الشخصية والتحقق من التزام المتحكم والمعالج بها.", "article": "Article 7"}, "scope": {"span": "المتعلقة بحماية البيانات الشخصية ... الضوابط والإجراءات اللازمة لمعالجة البيانات الشخصية", "article": "Article 7"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "Member States", "target_value": "الوزارة", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 7"}, {"slot": "modality", "gdpr_value": "permission (may)", "target_value": "ولها على الأخص الآتي (empowerment/authority)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7"}, {"slot": "action", "gdpr_value": "provide more specific rules by law or by collective agreements", "target_value": "إعداد واعتماد/إصدار الضوابط والإجراءات وقواعد السلوك المتعلقة بحماية البيانات الشخصية", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 7"}, {"slot": "scope", "gdpr_value": "processing of employees' personal data in the employment context for listed employment-related purposes", "target_value": "عامة: حماية ومعالجة البيانات الشخصية (دون نص خاص بسياق العمل أو الأغراض الوظيفية)", "basis": "direct_textual", "verdict": "partial", "citation": "Article 7"}, {"slot": "condition", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.62, "reasoning_note": "Only Article 7 provides a state-level empowerment to issue more specific rules, but it is general and does not single out the employment context or allow collective agreements. The counter-evidence provisions are controller-facing, substantive obligations and do not supply the meta-level permission Art. 88 contemplates. Thus, coverage is partial at best and employment-specific tailoring is not expressed.", "label": "C4", "ru_id": "RU-960", "gdpr_article": 88, "jurisdiction": "OMN", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 8, "total": 20}, {"round": 3, "n_queries": 4, "new": 5, "total": 25}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's citation of Article 7 does not support the claim that the target jurisdiction has a broader scope than the GDPR requirement, and the provision does not explicitly mention 'processing of employees' personal data in the employment context for listed employment-related purposes.'", "counter_evidence": [{"id": "498c9cb637b86367567b", "span": "مع عدم الإخلال بالاختصاصات المقررة لمركز الدفاع الإلكتروني، تتولى الوزارة مسؤولية تطبيق أحكام هذا القانون، ولها على الأخص الآتي:", "why": "The provision does not explicitly mention 'processing of employees' personal data in the employment context for listed employment-related purposes.'"}], "confidence": 0.8}, {"verdict": "revise", "objection": "The scope of the GDPR requirement unit may be partially covered in the target jurisdiction under different terminology or distributed across several provisions.", "counter_evidence": [{"id": "a0040ee4dad7d4440e19", "span": "Article 5", "why": "This provision mentions the processing of personal data, including the requirement for a permit from the Ministry before processing any personal data, which could be related to employment purposes."}, {"id": "2712fe4ebdba355a134b", "span": "Article 10", "why": "This provision states that personal data shall not be processed except in the context of transparency, honesty, and respect for human dignity, and after the explicit consent of the data subject, which could be related to the protection of employees' personal data in the employment context."}, {"id": "a0a0194dd91481c29c6e", "span": "Article 13", "why": "This provision requires the controller to establish controls and procedures for the processing of personal data, including the identification of risks to the data subject and measures to ensure the security of the data, which could be related to the protection of employees' personal data in the employment context."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["498c9cb637b86367567b", "a2a61b7c9316716b7e74", "a0040ee4dad7d4440e19", "bb26cffae1f1c0beb85d", "b157dcadab6a3e8daf5f", "a37f6f979ece2e1de6bf", "c62011bb3dda1c9374e5", "93f989531fe30cac1ed5", "a0a0194dd91481c29c6e", "865fbf2c2a6ca6fcb814", "2712fe4ebdba355a134b", "caad155111190c1aa274"], "n_llm_calls": 7, "latency_s": 578.43, "temperature": 0.7, "seed": 20260802, "id": "cbbd72899c821045fb28", "condition": "stability", "rep": 1}
{"candidates_selected": ["4919410df7147924356b"], "candidates_excluded": [{"id": "3e9d037ae7bf1b125ff2", "reason": "Regulates cross-border transfers by controllers; does not grant a data subject right to portability or direct controller-to-controller transmission."}, {"id": "557230873031d6e5cb2c", "reason": "Marketing-purpose processing; unrelated to data subject portability or transmission rights."}, {"id": "a79606d0fb564d3b2b5d", "reason": "Breach notification duties; no portability or transmission right."}, {"id": "c95a0b593cc554df0eae", "reason": "Record-keeping obligations; does not create a portability or direct transfer right."}, {"id": "c511c9bf7779067e64f4", "reason": "Legal bases and purpose limitation exceptions; not a data portability or direct transfer right."}, {"id": "6ee1b976a5203de50c77", "reason": "Access right; while related to data access, it does not provide for direct controller-to-controller transmission and is duplicative of the safeguards already captured in Article 6."}, {"id": "0922609ffbfd96a70f90", "reason": "Erasure right; not portability or direct transfer."}, {"id": "9cfd6fbae8182dbc0028", "reason": "Transparency/notice obligations; not portability or direct transfer."}, {"id": "04322a32135a68c65bb5", "reason": "Controller interest documentation; not a data subject right to portability or transfer."}, {"id": "ba8aef540689169aa848", "reason": "Rules for collecting from third parties; not portability or direct transfer."}, {"id": "fa368b0d433d7765b715", "reason": "Non-derogation clause; does not itself establish a portability or direct transfer right."}], "target_frame": {"addressee": {"span": "يكون لصاحب البيانات الشخصية", "article": "Article 6"}, "modality": {"span": "الحق", "article": "Article 6"}, "action": {"span": "الحق في طلب الحصول على نسخة من بياناته الشخصية بصيغة مقروءة وواضحة", "article": "Article 6"}, "scope": {"span": null, "article": null}, "condition": {"span": "تُقدَّم البيانات الشخصية إلى صاحب البيانات الشخصية بصيغة إلكترونية شائعة الاستخدام، ولصاحب البيانات الشخصية طلب نسخة مطبوعة منها متى ما كان تنفيذ ذلك ممكناً.", "article": "Article 6"}, "exception": {"span": "ألا تؤثر ممارسة الحق في الحصول على البيانات الشخصية سلباً على حقوق الغير، مثل: حقوق الملكية الفكرية أو الأسرار التجارية.", "article": "Article 6"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "data subject", "target": "صاحب البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 6"}, {"slot": "modality", "gdpr": "right", "target": "الحق", "basis": "direct_textual", "verdict": "covered", "citation": "Article 6"}, {"slot": "action", "gdpr": "have the personal data transmitted directly from one controller to another", "target": "الحصول على نسخة من البيانات الشخصية (تُقدَّم إلى صاحب البيانات الشخصية)", "basis": "direct_textual", "verdict": "uncovered", "citation": "Article 6"}, {"slot": "scope", "gdpr": "In exercising portability under Art. 20(1); direct controller-to-controller transfer; without prejudice to Art. 17", "target": "No portability framing or controller-to-controller element expressed", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "condition", "gdpr": "Technically feasible; and only where processing is based on consent or contract and carried out by automated means", "target": "صيغة إلكترونية شائعة الاستخدام؛ نسخة مطبوعة متى ما كان التنفيذ ممكناً (لا ذكر لقابلية النقل التقنية بين جهات التحكم أو لأساس الموافقة/العقد أو لكون المعالجة آلية).", "basis": "direct_textual", "verdict": "uncovered", "citation": "Article 6(2)"}, {"slot": "exception", "gdpr": "Not applicable to tasks in the public interest or exercise of official authority; exercise must not adversely affect the rights and freedoms of others", "target": "ألا تؤثر ممارسة الحق سلباً على حقوق الغير (لا ذكر لاستثناء المصلحة العامة/السلطة الرسمية).", "basis": "direct_textual", "verdict": "partial", "citation": "Article 6(1)"}, {"slot": "temporal", "gdpr": "None", "target": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr": "None", "target": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.83, "reasoning_note": "KSA PDPL Article 6 creates a right to obtain a copy of personal data (often in a commonly used electronic format) with safeguards for third-party rights, but it does not provide a right to have data transmitted directly from one controller to another. It also lacks GDPR’s specific conditions and public interest/official authority carveout. Thus, the core GDPR portability-direct-transfer element is missing.", "label": "C2", "ru_id": "RU-177", "gdpr_article": 20, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 11, "total": 23}, {"round": 3, "n_queries": 4, "new": 11, "total": 34}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["3e9d037ae7bf1b125ff2", "557230873031d6e5cb2c", "a79606d0fb564d3b2b5d", "c95a0b593cc554df0eae", "c511c9bf7779067e64f4", "6ee1b976a5203de50c77", "0922609ffbfd96a70f90", "9cfd6fbae8182dbc0028", "04322a32135a68c65bb5", "ba8aef540689169aa848", "fa368b0d433d7765b715", "4919410df7147924356b"], "n_llm_calls": 4, "latency_s": 338.05, "temperature": 0.7, "seed": 20260802, "id": "d2c45c8bed58f8c472c9", "condition": "stability", "rep": 1}
{"candidates_selected": ["192caaa530952a30ad50", "07962910da55dbce48d3", "85d05fccf5b4f57eceaf"], "candidates_excluded": [{"id": "a200ece03fd0ba143354", "reason": "Procedural rules for exercising data subject rights; no relation to codes of conduct or transfer safeguards."}, {"id": "75db9db720e9e34a1148", "reason": "Addresses disclosure/transfer from controller to processor domestically; no cross-border transfer safeguards or codes of conduct."}, {"id": "18cb1cd8191cffb1c314", "reason": "Exemption from explaining refusals of rights; unrelated to codes of conduct or transfers."}, {"id": "6c76988b817262e3e312", "reason": "Internal governance and compliance duties; no mechanism for codes of conduct or international transfer safeguards."}, {"id": "f5c366135483fe580381", "reason": "Breach notification; not about codes of conduct or transfer safeguards."}, {"id": "75852a697f66691bfbfb", "reason": "Derogations from rights for third-party interests; unrelated to codes of conduct or transfers."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "National security and similar exemptions; not about codes of conduct or transfer safeguards."}, {"id": "fcbd13532c69b340214e", "reason": "Security precautions generally; does not establish adherence to codes of conduct or transfer safeguards."}, {"id": "850decaffbbae78d371d", "reason": "General derogations from duties; not about codes of conduct or international transfer safeguards."}], "target_frame": {"addressee": {"span": "المراقب", "article": "Article 8 [85d05fccf5b4f57eceaf]"}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": "الحد من تدفق البيانات الشخصية عبر الحدود", "article": "Article 15 [07962910da55dbce48d3]"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "Controllers or processors not subject to the Regulation pursuant to Article 3", "target_value": "المراقب", "basis": "direct_textual", "verdict": "uncovered", "citation": "Art. 8 [85d05fccf5b4f57eceaf]"}, {"slot": "modality", "gdpr_value": "permission", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "action", "gdpr_value": "adhere to approved and generally valid codes of conduct", "target_value": null, "basis": "conceptual", "verdict": "uncovered", "citation": "Art. 27(1) encourages \"تشجيع وتطوير التنظيم الذاتي\" but does not provide permission for adherence nor establish codes as safeguards [192caaa530952a30ad50]"}, {"slot": "scope", "gdpr_value": "To provide appropriate safeguards for personal data transfers to third countries or international organisations under Article 46(2)(e)", "target_value": "الحد من تدفق البيانات الشخصية عبر الحدود", "basis": "direct_textual", "verdict": "partial", "citation": "Art. 15 [07962910da55dbce48d3]"}, {"slot": "condition", "gdpr_value": "The code of conduct is approved pursuant to paragraph 5 and has general validity pursuant to paragraph 9", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.62, "reasoning_note": "While Article 27 promotes self-regulation and Article 8 mandates protective measures set by the authority, the target text does not establish a system of approved codes of conduct with general validity, nor a permission for non-subject entities to adhere to them as international transfer safeguards. There is also no linkage of any self-regulatory instrument to serving as ‘appropriate safeguards’ for cross-border transfers. Consequently, the GDPR requirement lacks a functional counterpart in the cited Qatari provisions.", "label": "C2", "ru_id": "RU-487", "gdpr_article": 40, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 3, "total": 3}, {"round": 2, "n_queries": 4, "new": 9, "total": 12}, {"round": 3, "n_queries": 4, "new": 0, "total": 12}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The QAT jurisdiction has provisions that could be considered as a counterpart to the GDPR requirement, such as Article 27 and Article 8.", "counter_evidence": [{"id": "192caaa530952a30ad50", "span": "للإدارة المختصة، في سبيل تطبيق وتنفيذ أحكام هذا القانون، أن تتخذ جميع الإجراءات اللازمة لذلك", "why": "This provision implies that the competent authority may work with organizations to develop guidelines or codes of conduct for the protection of personal data."}, {"id": "85d05fccf5b4f57eceaf", "span": "يتعين على المراقب الالتزام بما يلي: 1- معالجة البيانات الشخصية بأمانة ومشروعية.", "why": "This provision requires the controller to process personal data in a lawful and legitimate manner, which could be considered as a counterpart to the GDPR requirement."}], "confidence": 0.8}, {"verdict": "revise", "objection": "Potential for self-regulation and adherence to protective measures as a counterpart to GDPR's codes of conduct under different terminology or structure.", "counter_evidence": [{"id": "192caaa530952a30ad50", "span": "التنسيق مع أي مجموعة أو رابطة مهنية وأي رابطة أخرى تمثل المراقبين أو مشغلي مواقع الإنترنت، وذلك بهدف تشجيع وتطوير التنظيم الذاتي", "why": "Implies promotion of self-regulatory practices among controllers and processors."}, {"id": "8", "span": "اتخاذ الاحتياطات الإدارية والفنية والمادية المناسبة لحماية البيانات الشخصية، وفقاً لما تحدده الإدارة المختصة", "why": "Requires controllers to adhere to protective measures determined by the competent authority, potentially serving as a form of code of conduct."}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["a200ece03fd0ba143354", "75db9db720e9e34a1148", "18cb1cd8191cffb1c314", "6c76988b817262e3e312", "f5c366135483fe580381", "192caaa530952a30ad50", "07962910da55dbce48d3", "75852a697f66691bfbfb", "85d05fccf5b4f57eceaf", "3f5cc5a2c4af5fb90388", "fcbd13532c69b340214e", "850decaffbbae78d371d"], "n_llm_calls": 7, "latency_s": 582.04, "temperature": 0.7, "seed": 20260802, "id": "a2cdabbb498e9412a7cd", "condition": "stability", "rep": 1}
{"candidates_selected": ["9afcca9ce75d4e0c23f1", "a0a0194dd91481c29c6e"], "candidates_excluded": [{"id": "caad155111190c1aa274", "reason": "Definitions; does not set territorial scope or general compliance trigger."}, {"id": "b59c6e3df96d0cdf91f8", "reason": "External auditor appointment; not about territorial applicability or general compliance obligation."}, {"id": "6ada991a77a31372fb4c", "reason": "Details on external auditor; unrelated to territorial scope or baseline compliance duty."}, {"id": "a2a61b7c9316716b7e74", "reason": "Substantive prohibition on disclosure; not about territorial scope/applicability."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Policy transparency requirement; not about territorial applicability."}, {"id": "c62011bb3dda1c9374e5", "reason": "General statement that personal data are protected; does not articulate territorial scope or trigger."}, {"id": "6e6fc1f4d7421fb141d6", "reason": "DPO qualifications; not about territorial scope or baseline compliance trigger."}, {"id": "05b7537a91d92a0529ad", "reason": "DPO designation; not about territorial scope/applicability."}, {"id": "a37f6f979ece2e1de6bf", "reason": "Cooperation with authority; not about territorial scope/applicability."}, {"id": "b08fd8d6893cd6de53e8", "reason": "Record-keeping; not about territorial scope/applicability."}], "target_frame": {"addressee": {"span": "المتحكم والمعالج", "article": "Article 15"}, "modality": {"span": "يلتزم", "article": "Article 15"}, "action": {"span": "ضمان أن معالجة البيانات الشخصية تمت وفقاً لأحكام هذا القانون", "article": "Article 15"}, "scope": {"span": "معالجة البيانات الشخصية", "article": "Article 15"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller or processor with an establishment in the Union", "target_value": "المتحكم والمعالج", "basis": "direct_textual", "verdict": "partial", "citation": "Article 15", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "يلتزم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 15", "slot": "modality"}, {"gdpr_value": "comply with this Regulation for the processing of personal data", "target_value": "ضمان أن معالجة البيانات الشخصية تمت وفقاً لأحكام هذا القانون", "basis": "direct_textual", "verdict": "covered", "citation": "Article 15", "slot": "action"}, {"gdpr_value": "processing of personal data", "target_value": "معالجة البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 15; Article 13", "slot": "scope"}, {"gdpr_value": "processing is in the context of the activities of an establishment of the controller or processor in the Union, regardless of where the processing takes place", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.62, "reasoning_note": "OMN provisions impose an obligation on controllers/processors to ensure processing complies with the law, matching modality, action, and scope. However, they do not articulate a territorial trigger like GDPR Art. 3 (establishment criterion and location-irrelevance), leaving the key condition unexpressed. Thus the mapping is only partial.", "label": "C2", "ru_id": "RU-008", "gdpr_article": 3, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 12, "total": 24}, {"round": 3, "n_queries": 4, "new": 6, "total": 30}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["9afcca9ce75d4e0c23f1", "caad155111190c1aa274", "a0a0194dd91481c29c6e", "b59c6e3df96d0cdf91f8", "6ada991a77a31372fb4c", "a2a61b7c9316716b7e74", "bb26cffae1f1c0beb85d", "c62011bb3dda1c9374e5", "6e6fc1f4d7421fb141d6", "05b7537a91d92a0529ad", "a37f6f979ece2e1de6bf", "b08fd8d6893cd6de53e8"], "n_llm_calls": 4, "latency_s": 338.09, "temperature": 0.7, "seed": 20260802, "id": "d4a691cc476efa60befe", "condition": "stability", "rep": 1}
{"candidates_selected": ["2c020ba48e817e4f4c7a"], "candidates_excluded": [{"id": "9f3112d28a1b850ba61f", "reason": "General security and processing principles, but no mention (direct or functional) of pseudonymisation as a security measure."}, {"id": "a418980931b429c7909a", "reason": "Breach-notification obligations; not about designing/including specific security measures such as pseudonymisation."}, {"id": "8df6b1810850e58a6a30", "reason": "Definitions only; no operative obligation to include pseudonymisation among security measures."}], "target_frame": {"addressee": {"span": "على مقدم الخدمة اتخاذ الآتي", "article": "Article 5"}, "modality": {"span": "يجب أن تكون هذه التدابير ملائمة", "article": "Article 5"}, "action": {"span": "توفير التدابير الأمنية المناسبة ... بما في ذلك الأمور التالية: 1.1. معالجة وتشفير البيانات الشخصية", "article": "Article 5"}, "scope": {"span": "البيانات الشخصية المرسلة أو المخزنة أو التي يتم معالجتها بطرق أخرى", "article": "Article 5"}, "condition": {"span": "ويجب أن تكون هذه التدابير ملائمة لطبيعة ونطاق أنشطته وحساسية أي بيانات شخصية يتم جمعها وتخزينها", "article": "Article 5"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "مقدم الخدمة (المرخص له)", "basis": "conceptual", "verdict": "covered", "citation": "Article 5", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "على مقدم الخدمة ... ويجب أن تكون هذه التدابير", "basis": "direct_textual", "verdict": "covered", "citation": "Article 5", "slot": "modality"}, {"gdpr_value": "include pseudonymisation in the implemented security measures", "target_value": "توفير تدابير أمنية مناسبة، بما في ذلك معالجة وتشفير البيانات الشخصية", "basis": "absent", "verdict": "uncovered", "citation": "Article 5", "slot": "action"}, {"gdpr_value": "personal data processed", "target_value": "البيانات الشخصية المرسلة أو المخزنة أو التي يتم معالجتها بطرق أخرى", "basis": "direct_textual", "verdict": "covered", "citation": "Article 5", "slot": "scope"}, {"gdpr_value": "as appropriate to the risk", "target_value": "ملائمة لطبيعة ونطاق الأنشطة وحساسية البيانات", "basis": "conceptual", "verdict": "partial", "citation": "Article 5", "slot": "condition"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.66, "reasoning_note": "Article 5 expressly lists encryption but nowhere indicates replacing identifiers, key separation, or other hallmarks of pseudonymisation; GDPR treats pseudonymisation and encryption as distinct measures. While encryption is a security control, it is not a functional equivalent of pseudonymisation on the text alone. Therefore, the specific obligation to include pseudonymisation remains unexpressed.", "label": "C2", "ru_id": "RU-317", "gdpr_article": 32, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 2, "total": 2}, {"round": 2, "n_queries": 4, "new": 2, "total": 4}, {"round": 3, "n_queries": 4, "new": 0, "total": 4}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provisions do not explicitly require pseudonymisation as part of the security measures.", "counter_evidence": [{"id": "2c020ba48e817e4f4c7a", "span": "Article 5: \"توفير التدابير الأمنية المناسبة لحماية البيانات الشخصية للمستخدم ضد الخسارة أو الضرر أو الإفصاح أو الاختراق من طرف آخر غير مصرح له أو استبدال البيانات أو المعلومات بأخرى غير صحيحة أو إضافة معلومات غير صحيحة.\"", "why": "This provision outlines security measures but does not mention pseudonymisation explicitly."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict of 'uncovered' for pseudonymisation might be too strict, as Article 5 mentions processing and encrypting personal data, which could be interpreted as including pseudonymisation.", "counter_evidence": [{"id": "2c020ba48e817e4f4c7a", "span": "معالجة وتشفير البيانات الشخصية", "why": "This provision could be interpreted as including pseudonymisation, as it mentions processing and encrypting personal data."}], "confidence": 0.7}], "n_candidates": 4, "candidate_ids": ["2c020ba48e817e4f4c7a", "a418980931b429c7909a", "9f3112d28a1b850ba61f", "8df6b1810850e58a6a30"], "n_llm_calls": 7, "latency_s": 636.5, "temperature": 0.7, "seed": 20260802, "id": "7c21319b7a723e2e9097", "condition": "stability", "rep": 1}
{"candidates_selected": ["a023625d7c33737b6c29", "b08fd8d6893cd6de53e8", "5483caf68765f09059fb"], "candidates_excluded": [{"id": "9afcca9ce75d4e0c23f1", "reason": "General compliance duty; does not establish or refer to a record of processing activities."}, {"id": "40626451a5025d77cff5", "reason": "Data subject notice content; unrelated to maintaining a record of processing activities."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Privacy policy display; not a duty to maintain a record of processing activities."}, {"id": "a37f6f979ece2e1de6bf", "reason": "Cooperation and provision of information to the authority; not a record-keeping requirement per se."}, {"id": "487015f110e7b88b5c03", "reason": "Submission of a data protection policy with a permit request; not a record of processing activities."}, {"id": "09d77a4e064de5fe6273", "reason": "Breach log documentation; a distinct register focused on incidents, not the general ROPA."}, {"id": "6ada991a77a31372fb4c", "reason": "External auditor access to records; does not itself impose a duty to maintain a ROPA."}, {"id": "b59c6e3df96d0cdf91f8", "reason": "Appointment of an external auditor; unrelated to maintaining a ROPA."}, {"id": "495e30846d7a1f70c077", "reason": "Security measures; not a record of processing activities requirement."}], "target_frame": {"addressee": {"span": "المتحكم", "source": "Article 29"}, "modality": {"span": "يجب", "source": "Article 29"}, "action": {"span": "تحديث سجل أنشطة المعالجة", "source": "Article 29"}, "scope": {"span": "سجل أنشطة المعالجة", "source": "Article 29"}, "condition": {"span": null, "source": null}, "exception": {"span": null, "source": null}, "temporal": {"span": "بشكل مستمر", "source": "Article 29"}, "consequence": {"span": null, "source": null}}, "slot_verdicts": [{"gdpr": "controller", "target": "المتحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 29: \"يجب على المتحكم ...\"", "slot": "addressee"}, {"gdpr": "obligation (shall)", "target": "يجب / يلتزم", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 29: \"يجب\"; Art. 17: \"يلتزم\"", "slot": "modality"}, {"gdpr": "maintain a record of processing activities", "target": "تحديث سجل أنشطة المعالجة؛ الاحتفاظ بمستندات عمليات المعالجة", "basis": "distributed", "verdict": "covered", "citation": "Art. 29: \"تحديث سجل أنشطة المعالجة\"; Art. 17: \"الاحتفاظ بمستندات عمليات المعالجة\"; Art. 27", "slot": "action"}, {"gdpr": "processing activities under the controller's responsibility (all such activities)", "target": "سجل أنشطة المعالجة (no explicit qualifier that it covers all activities under the controller’s responsibility)", "basis": "conceptual", "verdict": "partial", "citation": "Art. 29: \"سجل أنشطة المعالجة\"", "slot": "scope"}, {"gdpr": "None", "target": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "condition"}, {"gdpr": "Does not apply to organisations with <250 employees unless risk/non-occasional/special-category processing", "target": "No exception stated", "basis": "absent", "verdict": "broader", "citation": null, "slot": "exception"}, {"gdpr": "None", "target": "بشكل مستمر (continuous updating); retention periods set by regulation/fit for purpose", "basis": "direct_textual", "verdict": "broader", "citation": "Art. 29: \"بشكل مستمر\"; Art. 17: \"وفقاً للمدد\"; Art. 27: \"تحديد مدة زمنية للاحتفاظ\"", "slot": "temporal"}, {"gdpr": "None", "target": "None stated in cited provisions", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "covered", "confidence": 0.66, "reasoning_note": "OMN Art. 29 and 17/27 impose an obligation on controllers to keep and continuously update a record/processing documents, functionally covering the GDPR duty to maintain a ROPA. However, the target text does not expressly state that the record must encompass all processing activities under the controller’s responsibility, so the scope slot is marked partial. No small-entity exception appears, making the target stricter (broader) than GDPR on that dimension.", "label": "C2", "ru_id": "RU-253", "gdpr_article": 30, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 3, "total": 15}, {"round": 3, "n_queries": 4, "new": 5, "total": 20}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "The provisions cited do not explicitly state that the record of processing activities should include all processing activities under the controller's responsibility, and the exception slot verdict is unclear.", "counter_evidence": [{"id": "a023625d7c33737b6c29", "span": "يجب على المتحكم تحديث سجل أنشطة المعالجة بشكل مستمر", "why": "This provision requires the controller to update the record of processing activities continuously, but it does not specify that the record should include all processing activities under the controller's responsibility."}, {"id": "b08fd8d6893cd6de53e8", "span": "يلتزم المتحكم والمعالج بالاحتفاظ بمستندات عمليات المعالجة", "why": "This provision requires the controller and processor to keep documents of processing operations, but it does not specify that the documents should include all processing activities under the controller's responsibility."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["b08fd8d6893cd6de53e8", "a023625d7c33737b6c29", "9afcca9ce75d4e0c23f1", "40626451a5025d77cff5", "bb26cffae1f1c0beb85d", "a37f6f979ece2e1de6bf", "5483caf68765f09059fb", "487015f110e7b88b5c03", "09d77a4e064de5fe6273", "6ada991a77a31372fb4c", "b59c6e3df96d0cdf91f8", "495e30846d7a1f70c077"], "n_llm_calls": 6, "latency_s": 490.04, "temperature": 0.7, "seed": 20260802, "id": "e6145db4bca741b4ecd7", "condition": "stability", "rep": 1}
{"candidates_selected": ["9b42add02f4d45cf8a57", "e8fe267db21063b1b45f"], "candidates_excluded": [{"id": "b983a5ed0e1c7a2b779a", "reason": "Addresses lawful bases for processing and consent; does not concern penalties or state measures to implement penalties."}], "target_frame": {"addressee": {"span": "للهيئة ... تطبيق الجزاءات والغرامات", "article": "Article 7(3)"}, "modality": {"span": "للهيئة ... تطبيق", "article": "Article 7(3)"}, "action": {"span": "تطبيق الجزاءات والغرامات المنصوص عليها بالقانون رقم 37 لسنة 2014 ...", "article": "Article 7(3)"}, "scope": {"span": "تطبق هذه اللائحة على جميع مقدمي الخدمة المرخص لهم من قبل الهيئة", "article": "Article 1"}, "condition": {"span": "في حال ثبوت مخالفة أحكام هذه اللائحة أو قوانين دولة الكويت", "article": "Article 7(3)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "Member States", "target": "الهيئة (هيئة عامة تنظيمية للدولة)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7(3): \"للهيئة ... تطبيق الجزاءات والغرامات\""}, {"slot": "modality", "gdpr": "obligation (shall)", "target": "للهيئة ... تطبيق (سلطة/جواز)", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 7(3): \"للهيئة ... تطبيق\"; lacks mandatory terms like \"يجب\" or \"تلتزم\""}, {"slot": "action", "gdpr": "take all measures necessary to ensure that the penalties are implemented", "target": "تطبيق الجزاءات والغرامات المنصوص عليها بالقانون رقم 37 لسنة 2014", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 7(3)"}, {"slot": "scope", "gdpr": "None", "target": "تطبق هذه اللائحة على جميع مقدمي الخدمة المرخص لهم من قبل الهيئة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 1"}, {"slot": "condition", "gdpr": "None", "target": "في حال ثبوت مخالفة أحكام هذه اللائحة أو قوانين دولة الكويت", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7(3)"}, {"slot": "exception", "gdpr": "None", "target": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr": "None", "target": "None expressed (no timeframe attached to sanction application)", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr": "None", "target": "None expressed as a separate consequence term", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.62, "reasoning_note": "On addressee: the enforcement clause (Article 7(3)) expressly addresses the Authority (\"للهيئة\"), not service providers; Article 1 only defines who the regulation applies to. On modality: \"للهيئة ... تطبيق\" grants the Authority power/discretion, not a mandatory duty (no \"يجب/تلتزم\"), which is weaker than GDPR’s \"shall take all measures necessary\". The action also lacks the \"all measures necessary to ensure\" dimension, limiting itself to applying specified sanctions.", "label": "C3", "ru_id": "RU-949", "gdpr_article": 84, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 2, "total": 2}, {"round": 2, "n_queries": 4, "new": 1, "total": 3}, {"round": 3, "n_queries": 4, "new": 0, "total": 3}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's claim of a weaker modality and narrower scope is not supported by the provisions.", "counter_evidence": [{"id": "9b42add02f4d45cf8a57", "span": "للهيئة في حال ثبوت مخالفة أحكام هذه اللائحة أو قوانين دولة الكويت تطبيق الجزاءات والغرامات المنصوص عليها بالقانون رقم 37 لسنة 2014 لإنشاء الهيئة العامة للاتصالات وتقنية المعلومات والمعدل بالقانون رقم (98) لسنة 2015", "why": "This provision implies an obligation to apply penalties and fines in case of non-compliance."}, {"id": "e8fe267db21063b1b45f", "span": "تطبق هذه اللائحة على جميع مقدمي الخدمة المرخص لهم من قبل الهيئة", "why": "This provision suggests a broader scope than what the analyst claimed."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The modality of the target jurisdiction's provision is not weaker than the GDPR requirement, and the addressee of the provision is not the Authority, but rather the service providers.", "counter_evidence": [{"id": "9b42add02f4d45cf8a57", "span": "للهيئة ... تطبيق الجزاءات والغرامات", "why": "The language used indicates an obligation, similar to the GDPR requirement."}, {"id": "e8fe267db21063b1b45f", "span": "تطبق هذه اللائحة على جميع مقدمي الخدمة المرخص لهم من قبل الهيئة", "why": "The addressee of the provision is not the Authority, but rather the service providers."}], "confidence": 0.8}], "n_candidates": 3, "candidate_ids": ["b983a5ed0e1c7a2b779a", "9b42add02f4d45cf8a57", "e8fe267db21063b1b45f"], "n_llm_calls": 7, "latency_s": 642.27, "temperature": 0.7, "seed": 20260802, "id": "89e75c5df6c8715bdc74", "condition": "stability", "rep": 1}
{"candidates_selected": ["b157dcadab6a3e8daf5f", "4ddc7494f19d84324dd8"], "candidates_excluded": [{"id": "2712fe4ebdba355a134b", "reason": "Sets consent requirements for processing; does not grant a right to receive data or specify format."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Obliges publication of a policy and procedures; procedural transparency, not the substantive right or format."}, {"id": "93f989531fe30cac1ed5", "reason": "Right to erasure; unrelated to receiving a copy or data portability format."}, {"id": "40626451a5025d77cff5", "reason": "Information notice including mention of rights; does not itself grant the receive/format right."}, {"id": "a4136d70ee84d058ef85", "reason": "Concerns DPO contact details; not about the right to receive data or its format."}, {"id": "a0040ee4dad7d4440e19", "reason": "Controller permitting obligations; not about data subject portability/receipt."}, {"id": "4f65c1f467f9e61b2f46", "reason": "General scope of the law; no right to receive data."}, {"id": "79ac84c7165bc6aa1c06", "reason": "Record-keeping by controllers/processors; not about data subject rights to receive/format."}, {"id": "d0bb19cb0c67952144b4", "reason": "Addresses controller-to-controller transfer when legally obliged; not the data subject’s right to receive a copy."}, {"id": "a3d16e47b198e1ecb3c6", "reason": "Sets consent validity conditions; does not define the right to receive data or its format/conditions."}], "target_frame": {"addressee": {"span": "لصاحب البيانات الشخصية", "article": "Article 19"}, "modality": {"span": "يحق", "article": "Article 19"}, "action": {"span": "الحصول على نسخة من بياناته الشخصية المعالجة", "article": "Article 11 (ج)"}, "scope": {"span": "نسخة من بياناته الشخصية المعالجة بصيغة مقروءة وواضحة إلكترونية أو ورقية، شريطة التأكد من خلو النسخة التي قدمها من أي بيانات شخصية تحدد هوية شخص آخر", "article": "Article 19"}, "condition": {"span": null, "article": null}, "exception": {"span": "شريطة التأكد من خلو النسخة التي قدمها من أي بيانات شخصية تحدد هوية شخص آخر", "article": "Article 19"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "لصاحب البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 19", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "يحق", "basis": "direct_textual", "verdict": "covered", "citation": "Article 19", "slot": "modality"}, {"gdpr_value": "receive the personal data provided by the data subject to a controller in a structured, commonly used and machine-readable format", "target_value": "الحصول على نسخة من بياناته الشخصية المعالجة", "basis": "direct_textual", "verdict": "partial", "citation": "Articles 11(c), 19", "slot": "action"}, {"gdpr_value": "Personal data provided by the data subject; format must be structured, commonly used and machine-readable; exercise without prejudice to Article 17", "target_value": "بياناته الشخصية المعالجة بصيغة مقروءة وواضحة إلكترونية أو ورقية، مع استبعاد أي بيانات تحدد هوية شخص آخر", "basis": "direct_textual", "verdict": "partial", "citation": "Article 19", "slot": "scope"}, {"gdpr_value": "Processing based on consent or a contract and carried out by automated means", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr_value": "No applicability where processing is necessary for public interest/official authority; exercise shall not adversely affect rights and freedoms of others", "target_value": "استبعاد بيانات شخصية تحدد هوية شخص آخر من النسخة المقدمة", "basis": "direct_textual", "verdict": "partial", "citation": "Article 19", "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.66, "reasoning_note": "Articles 11 and 19 grant a right to obtain a copy of personal data in a “readable and clear” electronic or paper format and require exclusion of others’ identifying data. They do not specify a “structured, commonly used and machine-readable” format and do not condition the right on consent/contract or automated processing. There is also no public-interest/official-authority carve-out, so coverage of GDPR Art. 20 is only partial.", "label": "C2", "ru_id": "RU-174", "gdpr_article": 20, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 5, "total": 30}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The OMN law provides a partial match to the GDPR requirement, but the format and conditions are not entirely equivalent.", "counter_evidence": [{"id": "4ddc7494f19d84324dd8", "span": "يحق لصاحب البيانات الشخصية أن يطلب من المتحكم نسخة من بياناته الشخصية المعالجة بصيغة مقروءة وواضحة إلكترونية أو ورقية", "why": "This provision grants the data subject the right to request a copy of their personal data, but does not explicitly mention the format being 'structured, commonly used, and machine-readable'."}, {"id": "b157dcadab6a3e8daf5f", "span": "لا ينص النص على قصر الحق على أساس قانون المعالجة أو على الأتمتة", "why": "This provision suggests that the OMN law does not limit the right to receive personal data to cases where the processing is based on consent or contract and carried out by automated means."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The provisions do not explicitly support the claim that the data subject has the right to receive their personal data in a structured, commonly used, and machine-readable format.", "counter_evidence": [{"id": "4ddc7494f19d84324dd8", "span": "صيغة مقروءة وواضحة إلكترونية أو ورقية", "why": "Article 19 does not explicitly mention a structured, commonly used, and machine-readable format."}, {"id": "a3d16e47b198e1ecb3c6", "span": "لا تُذكر شروط تتعلق بأساس المعالجة أو الأتمتة لاقتناء النسخة/النقل", "why": "The provisions do not specify the conditions under which the data subject can request their personal data, including the format."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["2712fe4ebdba355a134b", "bb26cffae1f1c0beb85d", "93f989531fe30cac1ed5", "40626451a5025d77cff5", "a4136d70ee84d058ef85", "a0040ee4dad7d4440e19", "4f65c1f467f9e61b2f46", "b157dcadab6a3e8daf5f", "79ac84c7165bc6aa1c06", "4ddc7494f19d84324dd8", "d0bb19cb0c67952144b4", "a3d16e47b198e1ecb3c6"], "n_llm_calls": 7, "latency_s": 639.27, "temperature": 0.7, "seed": 20260802, "id": "3df919ce58f2bdebd9b4", "condition": "stability", "rep": 1}
{"candidates_selected": ["93fde8c87940ae524c86", "98fa9fe9b0650c71a971"], "candidates_excluded": [{"id": "7e2914aa34ab2739dafd", "reason": "Security of processing; no duty to inform data subjects about actions on their requests or applicable timelines."}, {"id": "7448a27e7806f2c0c143", "reason": "Data quality principles; does not regulate responses to data subject requests or timing."}, {"id": "762372b7329c44286e43", "reason": "Lawful bases for processing; no provision on responding to data subject requests."}, {"id": "34ea02d93464e8e2fa05", "reason": "Definitions/Privacy by Design; no operative rule on DSAR handling or timelines."}, {"id": "f8344697d1f1dc661161", "reason": "Sensitive data processing conditions; unrelated to informing data subjects about actions on their requests."}, {"id": "074363ee1a72941c8326", "reason": "Administrative timeframe for authority decision on DPO registration; not a controller duty to respond to data subject requests."}, {"id": "cf6dbe21d2b4a64f32a8", "reason": "Administrative timeframe for authority decision on external DPO registration; not about DSAR responses."}, {"id": "14fe9b230c7ba11703d5", "reason": "Sanctions provision; does not establish an obligation or timeframe to inform data subjects of action on their requests."}, {"id": "408dbb9b6c020c67f01f", "reason": "Authority notification to stakeholders in investigations; not about controller responses to data subject requests."}, {"id": "6a403e591ecc2a5638fc", "reason": "DPO disciplinary investigation; no rule on DSAR response duties or timing."}], "target_frame": {"addressee": {"span": "على مدير البيانات إحاطته", "article": "Article 17(1)"}, "modality": {"span": "على مدير البيانات", "article": "Article 17(1)"}, "action": {"span": null, "article": null}, "scope": {"span": "بيان حق صاحب البيانات في أن يتم إخطاره، إذا ما طلب ذلك، بالبيانات الخاصة به كاملة وبحقه في أن يتم تصحيحها.", "article": "Article 17(1)(ج)(3)"}, "condition": {"span": "إذا ما طلب ذلك", "article": "Article 17(1)(ج)(3)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "controller", "target": "مدير البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(1)", "slot": "addressee"}, {"gdpr": "obligation", "target": "على مدير البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(1)", "slot": "modality"}, {"gdpr": "provide the data subject with information on action taken on a request", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr": "requests under Articles 15 to 22", "target": "حق الإخطار بالبيانات الخاصة وحق التصحيح (وعلى نحو متصل الحق في الاعتراض على التسويق المباشر)", "basis": "distributed", "verdict": "narrower", "citation": "Article 17(1)(ج)(3); Article 19", "slot": "scope"}, {"gdpr": "upon receipt of the data subject's request", "target": "إذا ما طلب ذلك", "basis": "conceptual", "verdict": "partial", "citation": "Article 17(1)(ج)(3)", "slot": "condition"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr": "without undue delay and in any event within one month of receipt of the request", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.64, "reasoning_note": "I checked for indirect/distributed counterparts: Article 17 imposes certain information duties and references requests, and Article 19 adds a marketing-objection notice, but neither creates a duty to inform the data subject about action taken on a rights request. Timeframes in Articles 7/11 concern authority decisions, not DSAR handling, and no one‑month or analogous response period appears.", "label": "C4", "ru_id": "RU-034", "gdpr_article": 11, "jurisdiction": "BHR", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 4, "total": 29}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "Potential for indirect or distributed counterparts under different terminology or across several provisions", "counter_evidence": [{"id": "93fde8c87940ae524c86", "span": "Article 17", "why": "Discusses information to be provided to the data subject, suggesting some level of transparency and accountability"}, {"id": "074363ee1a72941c8326", "span": "Article 11", "why": "Mentions timeframes for administrative actions, indicating some alignment with the principle of timely responses"}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["7e2914aa34ab2739dafd", "7448a27e7806f2c0c143", "762372b7329c44286e43", "34ea02d93464e8e2fa05", "98fa9fe9b0650c71a971", "f8344697d1f1dc661161", "074363ee1a72941c8326", "cf6dbe21d2b4a64f32a8", "93fde8c87940ae524c86", "14fe9b230c7ba11703d5", "408dbb9b6c020c67f01f", "6a403e591ecc2a5638fc"], "n_llm_calls": 6, "latency_s": 520.72, "temperature": 0.7, "seed": 20260802, "id": "b00eae9a695ebde22c1c", "condition": "stability", "rep": 1}
{"candidates_selected": ["3ea4b464db31878217fb", "e11ad67296feba46e5be"], "candidates_excluded": [{"id": "38c6f7484322711d7d32", "reason": "Addresses authority actions after breach notifications (support, directing notification to data subjects), not informing complainants about judicial remedies."}, {"id": "3f916831456908af27d8", "reason": "Sets Ministry enforcement powers; no duty to inform complainants of judicial remedies."}, {"id": "caad155111190c1aa274", "reason": "Definitions; no operative duty to inform about judicial remedies."}, {"id": "6e8de83975a220288296", "reason": "Promulgation clause; no substantive rules on complaints or remedies."}, {"id": "3a6219e8839cbad1f76e", "reason": "Controller’s duty to notify breaches; unrelated to complaint handling or informing of remedies."}, {"id": "f1d11d7b0c4a6479bbe4", "reason": "Provides general framework for administrative penalties; no complainant-information duty."}, {"id": "14d93ec3a517dd1d4e42", "reason": "Permit application decisions and ministerial grievance for applicants; not about complaints by data subjects or informing them of judicial remedies."}, {"id": "4e5f395d8298f891d644", "reason": "Governs controller’s right to respond to a complaint; no supervisory authority duty to inform complainants of remedies."}, {"id": "dcd007160208896c8632", "reason": "Controller’s breach notification content; unrelated to complaint remedy information."}, {"id": "a0040ee4dad7d4440e19", "reason": "Pre-processing permit content; no linkage to complaint remedies."}], "target_frame": {"addressee": {"span": "الإدارة المختصة", "article": "Article 43"}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": "البَتّ في الشكوى أو البلاغ", "article": "Article 43"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "the supervisory authority with which the complaint has been lodged", "target_value": "الإدارة المختصة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 43"}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "No obligation to inform identified", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "action", "gdpr_value": "inform the complainant of the possibility of a judicial remedy pursuant to Article 78", "target_value": "No duty to inform of judicial remedy found; Article 45 provides a ministerial grievance for sanctioned parties, not an information duty toward complainants and not a court remedy", "basis": "absent", "verdict": "uncovered", "citation": "Article 45 (context only, not an information duty)"}, {"slot": "scope", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "condition", "gdpr_value": "if a complaint has been lodged with the supervisory authority", "target_value": "البَتّ في الشكوى أو البلاغ", "basis": "direct_textual", "verdict": "covered", "citation": "Article 43"}, {"slot": "exception", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "None expressed for any information duty", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.68, "reasoning_note": "While Article 45 creates an administrative grievance to the minister, it applies to sanctioned parties and is not a judicial court remedy. More importantly, no text obliges the supervisory authority to inform a complainant of any judicial (or administrative) remedy. Thus the GDPR-specific information duty remains textually uncovered.", "label": "C2", "ru_id": "RU-910", "gdpr_article": 77, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 9, "total": 21}, {"round": 3, "n_queries": 4, "new": 4, "total": 25}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict may not fully account for the potential implications of Article 45, which provides a mechanism for individuals to appeal administrative penalties.", "counter_evidence": [{"id": "e11ad67296feba46e5be", "span": "يجوز لمن وقع عليه أي من الجزاءات الإدارية المنصوص عليها في هذه اللائحة، أن يتظلم إلى الوزير خلال(60) ستين يوماً من تاريخ إخطاره بقرار المخالفة أو علمه به علماً يقينياً", "why": "This article provides a mechanism for individuals to appeal administrative penalties, which could be interpreted as a form of judicial remedy."}], "confidence": 0.6}, {"verdict": "revise", "objection": "The analyst's verdict might be too definitive given the potential for interpreting appeal mechanisms as access to judicial remedies, but the absence of explicit language supports the verdict to some extent.", "counter_evidence": [{"id": "Article 45", "span": "يجوز لمن وقع عليه أي من الجزاءات الإدارية المنصوص عليها في هذه اللائحة، أن يتظلم إلى الوزير خلال(60) ستين يوماً من تاريخ إخطاره بقرار المخالفة أو علمه به علماً يقينياً", "why": "This article provides a mechanism for appeal, which could be seen as a form of judicial remedy, potentially contradicting the 'uncovered' verdict for the action slot."}], "confidence": 0.6}], "n_candidates": 12, "candidate_ids": ["38c6f7484322711d7d32", "3f916831456908af27d8", "caad155111190c1aa274", "6e8de83975a220288296", "3a6219e8839cbad1f76e", "3ea4b464db31878217fb", "f1d11d7b0c4a6479bbe4", "14d93ec3a517dd1d4e42", "e11ad67296feba46e5be", "4e5f395d8298f891d644", "dcd007160208896c8632", "a0040ee4dad7d4440e19"], "n_llm_calls": 7, "latency_s": 635.23, "temperature": 0.7, "seed": 20260802, "id": "d3a9ded7a2649fd9934f", "condition": "stability", "rep": 1}
{"candidates_selected": ["8cd7b777aa3cd8ca5f1f", "c24849787475f274ecac"], "candidates_excluded": [{"id": "762372b7329c44286e43", "reason": "Substantive lawful-basis rules for processing; no supervisory power over certification bodies or certification issuance."}, {"id": "2ef716a5a0437defc8f2", "reason": "International data transfers and Authority permissions; no certification scheme or orders to certification bodies."}, {"id": "f8344697d1f1dc661161", "reason": "Sensitive data processing conditions; no link to certification bodies or issuance powers."}, {"id": "3d71a23a91370cadf799", "reason": "Criminal data processing exceptions; unrelated to certification powers."}, {"id": "f8e27ed18c61ec00ea9c", "reason": "DPO registration procedures; not about certification bodies or Authority orders concerning certifications."}, {"id": "9bcb8d6e5e38974e2a1b", "reason": "Investigation committee power to obtain information from third parties; not about certification issuance."}, {"id": "4415e9a46823d9615000", "reason": "Delegation to law-enforcement officers for investigation; no certification context."}, {"id": "348fe2ada83b7d57f33a", "reason": "Confidentiality of information held by the Authority; no certification-related powers."}, {"id": "9536e03a0aa7b4781fc7", "reason": "Ending or cancelling DPO registration; not certification schemes or orders to certification bodies."}, {"id": "6a403e591ecc2a5638fc", "reason": "Referral of DPO to investigation; unrelated to certification issuance."}], "target_frame": {"addressee": {"span": "الهيئة", "article": "Article 30"}, "modality": {"span": "يأمر مجلس الإدارة", "article": "Article 55"}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "supervisory authority", "target_value": "الهيئة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30", "slot": "addressee"}, {"gdpr_value": "power", "target_value": "يأمر مجلس الإدارة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 55", "slot": "modality"}, {"gdpr_value": "order the certification body not to issue a certification", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr_value": "certifications under Articles 42 and 43", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr_value": "the requirements for the certification are not or are no longer met", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.66, "reasoning_note": "The Bahrain provisions identify the Authority and its general enforcement powers but contain no textual basis for ordering a certification body not to issue a certification or for any certification scheme at all. Article 30’s powers (including prior authorizations) and Article 55’s orders address permits and violations generally, not certification issuance by third-party bodies. Therefore the core action, scope, and condition required by RU-146 are absent.", "label": "C2", "ru_id": "RU-146", "gdpr_article": 17, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 12, "total": 24}, {"round": 3, "n_queries": 4, "new": 10, "total": 34}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "The provisions do not explicitly address the power to order a certification body not to issue a certification if the requirements are not met, suggesting a potential gap in directly matching the GDPR requirement unit [RU-146].", "counter_evidence": [{"id": "Article 30", "span": "منْح التصاريح المسبقة", "why": "This article mentions the authority's power to grant prior approvals but does not directly address the condition of not issuing a certification if requirements are not met."}, {"id": "Article 55", "span": "يأمر مجلس الإدارة المخالف بالتوقف عن المخالفة", "why": "This article discusses enforcement measures for violations but does not explicitly cover the certification process or the specific condition related to not issuing certifications."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["762372b7329c44286e43", "2ef716a5a0437defc8f2", "f8344697d1f1dc661161", "3d71a23a91370cadf799", "f8e27ed18c61ec00ea9c", "9bcb8d6e5e38974e2a1b", "4415e9a46823d9615000", "8cd7b777aa3cd8ca5f1f", "348fe2ada83b7d57f33a", "c24849787475f274ecac", "9536e03a0aa7b4781fc7", "6a403e591ecc2a5638fc"], "n_llm_calls": 6, "latency_s": 518.34, "temperature": 0.7, "seed": 20260802, "id": "b322bd9ebf4605dac6cb", "condition": "stability", "rep": 1}
{"candidates_selected": ["9630e6d967b64e07d339", "34f7595acb9df257ef5", "9c38ab11b550755816f5"], "candidates_excluded": [{"id": "c34922f387019af45e42", "reason": "Automated decision-making rights; no relation to appointing a representative."}, {"id": "5d949837d7aab073cd67", "reason": "Complaint handling by the authority; no representative designation rule."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restriction; not about representation."}, {"id": "4a1a7742c2a181be0640", "reason": "Right to object/stop processing; not about representation."}, {"id": "877fafe0080725188d05", "reason": "Rectification/erasure rights; not about representation."}, {"id": "717a67a0d311f88c5fd9", "reason": "Access to information; does not require appointing a representative."}, {"id": "0cc06e3d3b107448da5a", "reason": "Processor obligations and record-keeping; no representative requirement."}, {"id": "6201d16404c0d4b9f63d", "reason": "Cross-border transfer mechanisms; no representative designation."}, {"id": "80f95c322bb3204c7f65", "reason": "Consent conditions; unrelated to representative appointment."}], "target_frame": {"addressee": {"span": "على المتحكم والمعالج", "article": "Article 10(1)"}, "modality": {"span": "يجب", "article": "Article 10(1)"}, "action": {"span": "تعيين مسؤول لحماية البيانات", "article": "Article 10(1)"}, "scope": {"span": "العمل كحلقة وصل بين المتحكم أو المعالج حسب الأحوال والمكتب بشأن قيامهما بتطبيق أحكام معالجة البيانات الشخصية المنصوص عليها في هذا المرسوم بقانون.", "article": "Article 11(1)(د)"}, "condition": {"span": "وذلك في أي من الأحوال الآتية: أ. إذا كانت المعالجة من شأنها إحداث خطر ذو مستوى عالي على سرية وخصوصية البيانات الشخصية لصاحب البيانات نتيجة اعتماد تقنيات جديدة أو مرتبطة بحجم البيانات. ب. إذا كانت المعالجة ستتضمن تقييم ممنهج وشامل للبيانات الشخصية الحساسة بما يشمل التنميط والمعالجة المؤتمتة. ج. إذا كانت المعالجة ستتم على حجم كبير من البيانات الشخصية الحساسة.", "article": "Article 10(1)(أ-ج)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller or processor to whom Article 3(2) GDPR applies", "target_value": "على المتحكم والمعالج", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 10(1)"}, {"slot": "modality", "gdpr_value": "obligation (shall)", "target_value": "يجب", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 10(1)"}, {"slot": "action", "gdpr_value": "designate in writing a representative established in the Union", "target_value": "تعيين مسؤول لحماية البيانات (DPO) وتحديد عنوان الاتصال به", "basis": "conceptual", "verdict": "uncovered", "citation": "Art. 10(1), 10(3); Art. 11(1)(د)"}, {"slot": "scope", "gdpr_value": "representation for processing activities to which Article 3(2) applies", "target_value": "دور مسؤول حماية البيانات كحلقة وصل مع المكتب بشأن تطبيق أحكام القانون", "basis": "conceptual", "verdict": "uncovered", "citation": "Art. 11(1)(د)"}, {"slot": "condition", "gdpr_value": "Where Article 3(2) GDPR applies (non-EU entities targeting/monitoring in the Union)", "target_value": "تعيين مسؤول حماية البيانات إذا تحققت حالات مخاطر عالية/تقييم منهجي/حجم كبير من البيانات الحساسة", "basis": "direct_textual", "verdict": "uncovered", "citation": "Art. 10(1)(أ-ج)"}, {"slot": "exception", "gdpr_value": "Exemption for occasional processing without large-scale special/criminal data and low risk; and for public authorities/bodies", "target_value": "لا توجد استثناءات مقابلة لتعيين ممثل؛ الشروط تتعلق فقط بمواضع تعيين مسؤول حماية البيانات", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "None stated", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None stated", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.7, "reasoning_note": "Article 10 requires appointing a Data Protection Officer in certain high-risk scenarios, which is not functionally equivalent to designating an EU-style representative for extraterritorial processing. Notably, Article 10(2) allows the DPO to be inside or outside the State, and there is no requirement to appoint a representative established in the UAE (or analogous territorial representative), nor are the GDPR Art. 27-style conditions/exemptions reflected. Therefore, the GDPR Art. 27 obligation is not present under different terminology in the cited UAE provisions.", "label": "C2", "ru_id": "RU-220", "gdpr_article": 27, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 9, "total": 21}, {"round": 3, "n_queries": 4, "new": 1, "total": 22}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's label C5 is incorrect because a counterpart to the GDPR requirement exists in the UAE jurisdiction, specifically in Article 10.", "counter_evidence": [{"id": "9630e6d967b64e07d339", "span": "المادة (10) تعيين مسؤول حماية البيانات", "why": "This article discusses the appointment of a data protection officer, which is similar to the concept of a representative in the GDPR."}], "confidence": 0.8}, {"verdict": "revise", "objection": "Counterpart exists under different terminology", "counter_evidence": [{"id": "9630e6d967b64e07d339", "span": "المادة (10) تعيين مسؤول حماية البيانات", "why": "This article discusses the appointment of a data protection officer, which seems to be related to the concept of designating a representative."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["c34922f387019af45e42", "5d949837d7aab073cd67", "9c38ab11b550755816f5", "5bedab371a9fc40ba93a", "4a1a7742c2a181be0640", "9630e6d967b64e07d339", "877fafe0080725188d05", "717a67a0d311f88c5fd9", "34f7595acb9df257ef5e", "0cc06e3d3b107448da5a", "6201d16404c0d4b9f63d", "80f95c322bb3204c7f65"], "n_llm_calls": 7, "latency_s": 626.1, "temperature": 0.7, "seed": 20260802, "id": "2bd5241508b73b71155c", "condition": "stability", "rep": 1}
