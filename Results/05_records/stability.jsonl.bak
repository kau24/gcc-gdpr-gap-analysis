{"candidates_selected": ["93fde8c87940ae524c86", "7448a27e7806f2c0c143"], "candidates_excluded": [{"id": "98fa9fe9b0650c71a971", "reason": "Addresses objection to direct marketing; does not concern rectification or completion of personal data."}, {"id": "5e5fa8a4888b88a04311", "reason": "Provides compensation for damage; no right to rectification/completion."}, {"id": "3d71a23a91370cadf799", "reason": "Special rules for criminal data; unrelated to rectification/completion rights."}, {"id": "eb633917dcbabe34df47", "reason": "Automated decision-making safeguards; not about rectification/completion."}, {"id": "9cd82ef51e2d36369a4f", "reason": "Journalism/art/literature exception with accuracy/update obligations, but not a general data subject right to completion."}, {"id": "762372b7329c44286e43", "reason": "Lawful bases for processing; no rectification/completion right."}, {"id": "5a79146e04b73c99685c", "reason": "Access/notification right; does not grant rectification or completion."}, {"id": "10e6e0e9f2f36b4c7b42", "reason": "Public registers conditions; unrelated to rectification/completion."}, {"id": "f8344697d1f1dc661161", "reason": "Sensitive data processing conditions; no rectification/completion right."}, {"id": "14fe9b230c7ba11703d5", "reason": "Penalties; not a substantive rectification/completion right."}], "target_frame": {"addressee": {"span": "حق صاحب البيانات", "article": "Article 17(1)(ج)(3)"}, "modality": {"span": "حق", "article": "Article 17(1)(ج)(3)"}, "action": {"span": "وبحقه في أن يتم تصحيحها", "article": "Article 17(1)(ج)(3)"}, "scope": {"span": "بالبيانات الخاصة به", "article": "Article 17(1)(ج)(3)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data subject", "target_value": "صاحب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(1)(ج)(3)"}, {"slot": "modality", "gdpr_value": "right", "target_value": "حق", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(1)(ج)(3)"}, {"slot": "action", "gdpr_value": "have incomplete personal data completed, including by providing a supplementary statement", "target_value": "تصحيح البيانات الشخصية", "basis": "distributed", "verdict": "narrower", "citation": "Article 17(1)(ج)(3); Article 3(4)"}, {"slot": "scope", "gdpr_value": "incomplete personal data concerning the data subject", "target_value": "البيانات الخاصة بصاحب البيانات (دون قصر على حالة عدم الاكتمال)", "basis": "direct_textual", "verdict": "broader", "citation": "Article 17(1)(ج)(3)"}, {"slot": "condition", "gdpr_value": "taking into account the purposes of the processing", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.58, "reasoning_note": "BHR law text provides a right to correction (تصحيح) and general data quality duties but does not expressly confer a right to complete incomplete data or allow completion via a supplementary statement, nor does it tie completeness to processing purposes. The reviewer’s point stands: Article 17(1)(ج)(3) mentions correction only, so the GDPR unit is only partially matched.", "label": "C4", "ru_id": "RU-141", "gdpr_article": 16, "jurisdiction": "BHR", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 9, "total": 21}, {"round": 3, "n_queries": 4, "new": 8, "total": 29}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict might be too broad, as specific rights like completing incomplete personal data are not directly addressed in the provided provisions.", "counter_evidence": [{"id": "Article 18", "span": "طلب صاحب البيانات إخطاره بمعالجة بيانات شخصية خاصة به", "why": "While Article 18 provides a mechanism for data subjects to request information about their data, it does not explicitly address the completion of incomplete personal data."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The BHR law does not explicitly provide for the completion of incomplete personal data taking into account the purposes of the processing.", "counter_evidence": [{"id": "93fde8c87940ae524c86", "span": "Article 17(1)(ج)(3)", "why": "Does not explicitly mention completion of incomplete data in the context of processing purposes."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["98fa9fe9b0650c71a971", "5e5fa8a4888b88a04311", "3d71a23a91370cadf799", "7448a27e7806f2c0c143", "eb633917dcbabe34df47", "9cd82ef51e2d36369a4f", "93fde8c87940ae524c86", "762372b7329c44286e43", "5a79146e04b73c99685c", "10e6e0e9f2f36b4c7b42", "f8344697d1f1dc661161", "14fe9b230c7ba11703d5"], "n_llm_calls": 7, "latency_s": 686.46, "temperature": 0.7, "seed": 20260803, "id": "c2d365fb19aa844d4fd6", "condition": "stability", "rep": 2}
{"candidates_selected": ["6e9c9892919d23a9a4da"], "candidates_excluded": [{"id": "26ab9db083b17ff619f2", "reason": "Addresses prior consent for sending marketing materials, not the post-objection duty to cease processing/marketing."}, {"id": "2712fe4ebdba355a134b", "reason": "Sets a general consent baseline for processing; does not establish a specific obligation upon objection to direct marketing."}, {"id": "b157dcadab6a3e8daf5f", "reason": "Provides general data subject rights (withdraw consent, block, erase) but not a specific halt to marketing upon objection."}, {"id": "93f989531fe30cac1ed5", "reason": "Erasure right in certain cases; not a direct rule to stop marketing processing upon objection."}, {"id": "40626451a5025d77cff5", "reason": "Transparency/notice content; does not regulate response to a marketing objection."}, {"id": "79ac84c7165bc6aa1c06", "reason": "Record-keeping of processing activities; not about objection to direct marketing."}, {"id": "3f916831456908af27d8", "reason": "Enforcement powers of the authority; not a controller duty upon objection."}, {"id": "de8d26aee9201d58a52b", "reason": "License revocation grounds; not related to data subject objections to marketing."}, {"id": "db1b46495b01511abeef", "reason": "DPO tasks; no rule about stopping marketing upon objection."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Requires a published privacy policy and rights mechanisms; does not specify stopping marketing upon objection."}, {"id": "d0bb19cb0c67952144b4", "reason": "Portability right; unrelated to direct marketing objections."}], "target_frame": {"addressee": {"span": "يجب على المتحكم", "article": "6e9c9892919d23a9a4da"}, "modality": {"span": "التوقف عن إرسال المواد الإعلانية أو التسويقية أو التجارية فور تلقي طلب الإيقاف", "article": "6e9c9892919d23a9a4da"}, "action": {"span": "إرسال المواد الإعلانية أو التسويقية أو التجارية", "article": "6e9c9892919d23a9a4da"}, "scope": {"span": "المواد الإعلانية أو التسويقية أو التجارية", "article": "6e9c9892919d23a9a4da"}, "condition": {"span": "فور تلقي طلب الإيقاف من صاحب البيانات الشخصية", "article": "6e9c9892919d23a9a4da"}, "exception": {"span": null, "article": null}, "temporal": {"span": "فور تلقي طلب الإيقاف", "article": "6e9c9892919d23a9a4da"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "المتحكم", "basis": "direct_textual", "verdict": "covered", "citation": "6e9c9892919d23a9a4da", "slot": "addressee"}, {"gdpr_value": "prohibition (shall no longer process)", "target_value": "وجوب التوقف عن الإرسال عند طلب الإيقاف", "basis": "direct_textual", "verdict": "covered", "citation": "6e9c9892919d23a9a4da", "slot": "modality"}, {"gdpr_value": "process the personal data", "target_value": "إرسال المواد الإعلانية/التسويقية", "basis": "direct_textual", "verdict": "narrower", "citation": "6e9c9892919d23a9a4da", "slot": "action"}, {"gdpr_value": "for direct marketing purposes", "target_value": "المواد الإعلانية أو التسويقية أو التجارية (الإرسال)", "basis": "direct_textual", "verdict": "narrower", "citation": "6e9c9892919d23a9a4da", "slot": "scope"}, {"gdpr_value": "where the data subject objects to processing for direct marketing purposes", "target_value": "فور تلقي طلب الإيقاف من صاحب البيانات الشخصية (عن استقبال المواد)", "basis": "direct_textual", "verdict": "covered", "citation": "6e9c9892919d23a9a4da", "slot": "condition"}, {"gdpr_value": "None", "target_value": "None stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": "فور (immediately upon request)", "basis": "direct_textual", "verdict": "broader", "citation": "6e9c9892919d23a9a4da", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "narrower", "confidence": 0.72, "reasoning_note": "The OMN Article 22(4) compels controllers to stop sending marketing materials upon the data subject’s stop request, which addresses opt-out of messages but not all processing for marketing (e.g., profiling, retention). No cited OMN provision extends this specific objection-triggered duty beyond sending. Therefore, the counterpart is narrower than GDPR Art. 21’s ban on any further processing for direct marketing once objected.", "label": "C4", "ru_id": "RU-181", "gdpr_article": 21, "jurisdiction": "OMN", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 4, "total": 29}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provisions do not explicitly state that the controller shall no longer process the personal data for direct marketing purposes when the data subject objects to such processing.", "counter_evidence": [{"id": "[6e9c9892919d23a9a4da]", "span": "Article 22(4)", "why": "Only mentions stopping the sending of advertising or marketing materials, but does not explicitly state that the controller shall no longer process the personal data for direct marketing purposes."}, {"id": "[b157dcadab6a3e8daf5f]", "span": "Article 11(h)", "why": "Only mentions the right to request the erasure of personal data, but does not explicitly state that the controller shall no longer process the personal data for direct marketing purposes when the data subject objects to such processing."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The OMN jurisdiction's provision (Article 22(4)) might be narrower than the GDPR requirement, as it only mentions stopping the sending of materials, which might not encompass all types of processing for direct marketing purposes.", "counter_evidence": [{"id": "6e9c9892919d23a9a4da", "span": "التوقف عن إرسال المواد الإعلانية أو التسويقية أو التجارية", "why": "This provision only mentions stopping the sending of materials, which might not be equivalent to ceasing all processing for direct marketing purposes."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["93f989531fe30cac1ed5", "6e9c9892919d23a9a4da", "d0bb19cb0c67952144b4", "b157dcadab6a3e8daf5f", "40626451a5025d77cff5", "79ac84c7165bc6aa1c06", "2712fe4ebdba355a134b", "26ab9db083b17ff619f2", "3f916831456908af27d8", "de8d26aee9201d58a52b", "db1b46495b01511abeef", "bb26cffae1f1c0beb85d"], "n_llm_calls": 7, "latency_s": 674.65, "temperature": 0.7, "seed": 20260803, "id": "b58968be842883fa9089", "condition": "stability", "rep": 2}
{"candidates_selected": ["a79606d0fb564d3b2b5d"], "candidates_excluded": [{"id": "4ba7db7571a9e08625c7", "reason": "Limits disclosure in specified harm scenarios; does not govern breach notification to an authority."}, {"id": "952167864cc3b0d724c1", "reason": "Addresses withdrawal of consent and related controller duties; not about breach notification."}, {"id": "62cc177254bb6a5bed90", "reason": "Sets security measures to prevent breaches; no duty to notify a supervisory authority."}, {"id": "5df1b1c5bce760454262", "reason": "Rules for scientific/research/statistical processing; unrelated to breach notification."}, {"id": "3a56eed81feb3655d1d1", "reason": "Public-interest processing by public bodies; not about breach notification."}, {"id": "90da7bc2380e8f3f2fb8", "reason": "Response timelines to data subject rights requests; not breach notification."}, {"id": "c95a0b593cc554df0eae", "reason": "Record-keeping for processing activities; no breach notification duty."}, {"id": "7ddbf4e54143664b8b8b", "reason": "Conditions for disclosing personal data; not notification of breaches to an authority."}, {"id": "21847c9e87d6df45a9a7", "reason": "Data accuracy obligations; not breach notification."}, {"id": "9cfd6fbae8182dbc0028", "reason": "Right to be informed at/after collection; does not create an exception to authority breach notification."}, {"id": "c511c9bf7779067e64f4", "reason": "Legal bases and permitted departures from purpose and direct collection; not breach notification."}], "target_frame": {"addressee": {"span": "جهة التحكم", "article": "Article 20(1)"}, "modality": {"span": "تشعر", "article": "Article 20(1)"}, "action": {"span": "تشعر جهة التحكم الجهة المختصة", "article": "Article 20(1)"}, "scope": {"span": "الجهة المختصة", "article": "Article 20(1)"}, "condition": {"span": "عند علمها بحدوث تسرب لبيانات شخصية أو تلفها أو وصول غير مشروع إليها", "article": "Article 20(1)"}, "exception": {"span": null, "article": null}, "temporal": {"span": "عند علمها ... وفقاً لما تحدده اللوائح", "article": "Article 20(1)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 20(1) [a79606d0fb564d3b2b5d]", "slot": "addressee"}, {"gdpr_value": "obligation (shall)", "target_value": "تشعر", "basis": "direct_textual", "verdict": "covered", "citation": "Article 20(1) [a79606d0fb564d3b2b5d]", "slot": "modality"}, {"gdpr_value": "notify the competent supervisory authority of the personal data breach", "target_value": "تشعر جهة التحكم الجهة المختصة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 20(1) [a79606d0fb564d3b2b5d]", "slot": "action"}, {"gdpr_value": "to the supervisory authority competent in accordance with Article 55", "target_value": "الجهة المختصة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 20(1) [a79606d0fb564d3b2b5d]", "slot": "scope"}, {"gdpr_value": "in the case of a personal data breach", "target_value": "عند علمها بحدوث تسرب لبيانات شخصية أو تلفها أو وصول غير مشروع إليها", "basis": "direct_textual", "verdict": "covered", "citation": "Article 20(1) [a79606d0fb564d3b2b5d]", "slot": "condition"}, {"gdpr_value": "unless the breach is unlikely to result in a risk to the rights and freedoms of natural persons", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "exception"}, {"gdpr_value": "without undue delay after becoming aware", "target_value": "عند علمها ... وفقاً لما تحدده اللوائح", "basis": "direct_textual", "verdict": "partial", "citation": "Article 20(1) [a79606d0fb564d3b2b5d]", "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.79, "reasoning_note": "KSA Article 20(1) directly obliges the controller to notify the competent authority upon becoming aware of a breach event, but it does not state the GDPR’s “without undue delay” standard, instead deferring specifics to implementing regulations. The statute contains no exception threshold for authority notification, so the GDPR exception is not covered. Article 4 (right to be informed) concerns collection notices and does not supply an exception or timing rule for breach notifications to the authority.", "label": "C2", "ru_id": "RU-345", "gdpr_article": 33, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 14, "total": 26}, {"round": 3, "n_queries": 4, "new": 4, "total": 30}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The exception 'unless the personal data breach is unlikely to result in a risk to the rights and freedoms of natural persons' is partially covered in Article 16 of the target jurisdiction.", "counter_evidence": [{"id": "4ba7db7571a9e08625c7", "span": "أنه يمثل خطراً على الأمن، أو يسيء إلى سمعة المملكة، أو يتعارض مع مصالحها.", "why": "This provision mentions exceptions to the disclosure of personal data, including cases where the disclosure would pose a risk to the rights and freedoms of natural persons."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The KSA provisions do not explicitly cover all aspects of the GDPR requirement, but some provisions could be interpreted as related to the exception and temporal slots.", "counter_evidence": [{"id": "a79606d0fb564d3b2b5d", "span": "تشعر جهة التحكم الجهة المختصة عند علمها بحدوث تسرب لبيانات شخصية أو تلفها أو وصول غير مشروع إليها؛ وفقاً لما تحدده اللوائح", "why": "This provision mentions notification in the event of a personal data breach, but does not explicitly state the temporal requirement or the exception."}, {"id": "9cfd6fbae8182dbc0028", "span": "الحق في العلم", "why": "This provision mentions the right to be informed, which includes the right to know the contact details of the controller and the purpose of the processing, and could be seen as related to the exception slot."}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["4ba7db7571a9e08625c7", "a79606d0fb564d3b2b5d", "952167864cc3b0d724c1", "62cc177254bb6a5bed90", "5df1b1c5bce760454262", "3a56eed81feb3655d1d1", "90da7bc2380e8f3f2fb8", "c95a0b593cc554df0eae", "7ddbf4e54143664b8b8b", "21847c9e87d6df45a9a7", "9cfd6fbae8182dbc0028", "c511c9bf7779067e64f4"], "n_llm_calls": 7, "latency_s": 702.72, "temperature": 0.7, "seed": 20260803, "id": "6b8be6b1b51483faac81", "condition": "stability", "rep": 2}
{"candidates_selected": ["c24849787475f274ecac"], "candidates_excluded": [{"id": "74358e437cd9e85fdabb", "reason": "Concerns duties, independence, and registration of Data Protection Officers; does not govern the authority’s power to impose administrative fines."}, {"id": "6a403e591ecc2a5638fc", "reason": "Provides for investigation/discipline of DPOs; not about supervisory authority’s administrative fines."}, {"id": "2ef716a5a0437defc8f2", "reason": "Substantive rules and exceptions for international transfers; not a fining power provision."}, {"id": "7e2914aa34ab2739dafd", "reason": "Security obligations and processor arrangements; not about administrative fines."}, {"id": "cf27d7263418b5d502ef", "reason": "Definitions for a decision; no fining framework."}, {"id": "5e5fa8a4888b88a04311", "reason": "Civil compensation right; not an administrative fine by the authority."}, {"id": "803cdc5aa2ea085c3461", "reason": "Criminal penalties set by courts for specified offenses; not the supervisory authority’s administrative fining cap or framework."}, {"id": "1d8fd3d4070b1ff36d68", "reason": "Notification to the authority; not a fining power provision."}, {"id": "14fe9b230c7ba11703d5", "reason": "Criminal sanctions for various offenses and related matters; not the administrative fining powers of the authority."}, {"id": "88af48316f67d59351aa", "reason": "Data subject’s right to object; not a fining framework."}, {"id": "34ea02d93464e8e2fa05", "reason": "Definitions (privacy by design) in a decision; no fining power."}], "target_frame": {"addressee": {"span": "يأمر مجلس الإدارة المخالف بالتوقف عن المخالفة ... فإن لمجلس الإدارة أن يصدر قراراً...", "article": "Article 55(1)"}, "modality": {"span": "توقيع غرامة إدارية بما لا يجاوِز عشرين ألف دينار.", "article": "Article 55(1)(ج)"}, "action": {"span": "توقيع غرامة إدارية", "article": "Article 55(1)(ج)"}, "scope": {"span": "يتعيَّن عند تقدير الغرامة مراعاة جسامة المخالفة، والعنت الذي بدا من المخالف، والمنافع التي جناها، والضرر الذي أصاب صاحب البيانات نتيجة لذلك.", "article": "Article 55(2)"}, "condition": {"span": "عند ثبوت المخالفة", "article": "Article 55(1)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "supervisory authority", "target_value": "مجلس الإدارة لدى الهيئة (السلطة الإشرافية)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 55(1)"}, {"slot": "modality", "gdpr_value": "prohibition (shall not impose fine exceeding cap)", "target_value": "بما لا يجاوز (not exceeding) 20,000 BHD", "basis": "direct_textual", "verdict": "covered", "citation": "Article 55(1)(ج)"}, {"slot": "action", "gdpr_value": "impose an administrative fine exceeding the higher of 20,000,000 EUR or, for undertakings, 4% of worldwide annual turnover", "target_value": "توقيع غرامة إدارية بما لا يجاوز عشرين ألف دينار (fixed cap; no turnover-based component)", "basis": "direct_textual", "verdict": "partial", "citation": "Article 55(1)(ج)"}, {"slot": "scope", "gdpr_value": "in accordance with paragraph 2 (aggravating/mitigating factors)", "target_value": "يتعيَّن عند تقدير الغرامة مراعاة جسامة المخالفة... والمنافع... والضرر الذي أصاب صاحب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 55(2)"}, {"slot": "condition", "gdpr_value": "for infringements of the data subjects' rights pursuant to Articles 12 to 22", "target_value": "عند ثبوت المخالفة (general violations; not limited to specific rights articles)", "basis": "direct_textual", "verdict": "broader", "citation": "Article 55(1)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "No explicit exception stated for the fining cap", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "No temporal element stated for the fining cap", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "No separate consequence attached to exceeding the cap", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.73, "reasoning_note": "Article 55 establishes the authority’s power to impose administrative fines, a fixed maximum (not exceeding 20,000 BHD), and factors to consider, thereby functionally paralleling the GDPR’s fining framework but without the GDPR’s specific cap formula (EUR 20M/4% worldwide turnover) or limitation to rights in Arts. 12–22. Article 58 indeed contains fines, but they are criminal sanctions imposed by courts, not administrative fines by the supervisory authority. Hence the requirement is only partially met by the target text.", "label": "C2", "ru_id": "RU-514", "gdpr_article": 42, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 22, "total": 34}, {"round": 3, "n_queries": 4, "new": 4, "total": 38}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The BHR law's upper limit for administrative fines and the conditions for their imposition do not fully align with the GDPR's requirements.", "counter_evidence": [{"id": "c24849787475f274ecac", "span": "Article 55(1)(ج) - توقيع غرامة إدارية بما لا يجاوز عشرين ألف دينار", "why": "The fine's upper limit in BHR law is significantly lower than the GDPR's upper limit, and the conditions for imposition may not fully cover infringements of data subjects' rights as per GDPR Articles 12-22."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The target jurisdiction has provisions related to imposing fines, although with different terminology and structures.", "counter_evidence": [{"id": "c24849787475f274ecac", "span": "Article 55(1)(ج) and Article 55(2)", "why": "These provisions indicate a framework for imposing fines, considering factors like severity, obstinacy, benefits, and harm."}, {"id": "803cdc5aa2ea085c3461", "span": "Article 58(1)", "why": "This provision mentions a range of fines for various offenses, demonstrating a more nuanced approach to imposing fines."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["74358e437cd9e85fdabb", "c24849787475f274ecac", "6a403e591ecc2a5638fc", "2ef716a5a0437defc8f2", "7e2914aa34ab2739dafd", "cf27d7263418b5d502ef", "5e5fa8a4888b88a04311", "803cdc5aa2ea085c3461", "1d8fd3d4070b1ff36d68", "14fe9b230c7ba11703d5", "88af48316f67d59351aa", "34ea02d93464e8e2fa05"], "n_llm_calls": 7, "latency_s": 694.94, "temperature": 0.7, "seed": 20260803, "id": "16553f77d1c0d3ef1e6f", "condition": "stability", "rep": 2}
{"candidates_selected": [], "candidates_excluded": [{"id": "7ddbf4e54143664b8b8b", "reason": "Deals with disclosure conditions; no mention of automated decisions or a right to obtain human intervention."}, {"id": "ba8aef540689169aa848", "reason": "Concerns processing when data are collected from someone other than the data subject; no automated-decision or human-intervention right."}, {"id": "04322a32135a68c65bb5", "reason": "Addresses processing for a realized interest and record-keeping; no relevant right to human intervention."}, {"id": "c511c9bf7779067e64f4", "reason": "Sets lawful bases and exceptions for collection/processing; does not create a right to human intervention in automated decisions."}, {"id": "ea8306cd18f9261f6413", "reason": "Transparency at collection; no right to human intervention in automated decisions."}, {"id": "59abf8ad06d6b694538c", "reason": "Enumerates data subject rights (knowledge, access, copy, rectification, erasure); does not include a right to obtain human intervention."}, {"id": "04f45ac99bac1acaa486", "reason": "Inspection/enforcement powers; not about data subject rights or automated decisions."}, {"id": "d31b8876d3426a7c919a", "reason": "Requires impact assessment for products/services; does not grant a right to human intervention."}, {"id": "78ae2c40eaf4fb3870fc", "reason": "Controller’s duty when appointing processors; unrelated to automated-decision rights."}, {"id": "9cfd6fbae8182dbc0028", "reason": "Right-to-be-informed obligations; even though it references automated decision-making contextually, it does not confer a data subject right to obtain human intervention."}, {"id": "90da7bc2380e8f3f2fb8", "reason": "Obligation to respond to rights requests generally; does not establish a right to obtain human intervention."}, {"id": "6f4fee23b0aedf942410", "reason": "Regulates access right and its limits; no mention of automated-decision safeguards or human intervention."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "addressee"}, {"gdpr_value": "right", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "modality"}, {"gdpr_value": "obtain human intervention on the part of the controller", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr_value": "decisions permitted under Article 22(2)(a) or 22(2)(c)", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.86, "reasoning_note": "None of the cited KSA provisions creates a data subject right to obtain human intervention in automated decisions. Article 21 only requires controllers to respond to rights requests generally, and Article 22 concerns impact assessments; neither provides the specific safeguard. Therefore, the GDPR requirement is not represented in the target text.", "label": "C5", "ru_id": "RU-189", "gdpr_article": 22, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 20, "total": 32}, {"round": 3, "n_queries": 4, "new": 8, "total": 40}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's label is incorrect, and a counterpart is present but with significant differences.", "counter_evidence": [{"id": "90da7bc2380e8f3f2fb8", "span": "على جهة التحكم الاستجابة لطلبات صاحب البيانات الشخصية المتعلقة بحقوقه المنصوص عليها في النظام خلال مدة محددة وعبر وسيلة مناسبة تبينهما اللوائح.", "why": "This provision suggests that the controller has an obligation to respond to requests from the data subject, which could include providing human intervention."}, {"id": "9cfd6fbae8182dbc0028", "span": "يكون لصاحب البيانات الشخصية -وفًقا للأحكام الواردة في النظام وما تحدده اللوائح- الحقوق الآتية: ... 2- الحق في وصوله إلى بياناته الشخصية المتوافرة لدى جهة التحكم، وفق الضوابط والإجراءات التي تحددها اللوائح، دون إخلال بما ورد في المادة (التاسعة) من النظام.", "why": "This provision provides the data subject with the right to access their personal data, which could include the right to obtain human intervention."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict is not fully supported by the provisions, as there is no direct reference to the right to obtain human intervention on the part of the controller in decisions permitted under Article 22(2)(a) or 22(2)(c).", "counter_evidence": [{"id": "90da7bc2380e8f3f2fb8", "span": "المادة الحادية والعشرون: على جهة التحكم الاستجابة لطلبات صاحب البيانات الشخصية المتعلقة بحقوقه المنصوص عليها في النظام خلال مدة محددة وعبر وسيلة مناسبة تبينهما اللوائح.", "why": "This article provides a general right for the data subject to request the controller to respond to their requests related to their rights, but it does not explicitly address the right to obtain human intervention."}, {"id": "d31b8876d3426a7c919a", "span": "المادة الثانية والعشرون: على جهة التحكم إجراء تقويم للآثار المترتبة على معالجة البيانات الشخصية لأي منتج أو خدمة تقدم للعموم بحسب طبيعة النشاط الذي تمارسه جهة التحكم، وتحدد اللوائح الأحكام اللازمة لذلك.", "why": "This article is about the controller's obligation to conduct an assessment of the impact of processing personal data, but it does not explicitly address the right to obtain human intervention."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["7ddbf4e54143664b8b8b", "ba8aef540689169aa848", "04322a32135a68c65bb5", "c511c9bf7779067e64f4", "ea8306cd18f9261f6413", "59abf8ad06d6b694538c", "04f45ac99bac1acaa486", "d31b8876d3426a7c919a", "78ae2c40eaf4fb3870fc", "9cfd6fbae8182dbc0028", "90da7bc2380e8f3f2fb8", "6f4fee23b0aedf942410"], "n_llm_calls": 7, "latency_s": 669.14, "temperature": 0.7, "seed": 20260803, "id": "5ecdb3c29dbf9abccd2c", "condition": "stability", "rep": 2}
{"candidates_selected": ["05b7537a91d92a0529ad", "6e6fc1f4d7421fb141d6", "a4136d70ee84d058ef85"], "candidates_excluded": [{"id": "6822d8664264bc19842c", "reason": "Addresses confidentiality and publication with consent; unrelated to appointing or sharing a DPO across a group."}, {"id": "2712fe4ebdba355a134b", "reason": "Concerns consent and transparency of processing, not DPO appointment or accessibility."}, {"id": "a2a61b7c9316716b7e74", "reason": "Limits disclosure of special categories; does not concern DPO structure or group appointment."}, {"id": "db1b46495b01511abeef", "reason": "Defines DPO tasks; does not authorize a single DPO for a group or set accessibility-from-each-establishment conditions."}, {"id": "a0040ee4dad7d4440e19", "reason": "Requires including DPO contact details in a permit application; no rule on group-level DPO or the GDPR condition."}, {"id": "c62011bb3dda1c9374e5", "reason": "General protection clause; no DPO or group appointment content."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Relates to publishing a privacy policy; no DPO group-appointment or accessibility condition."}, {"id": "a0a0194dd91481c29c6e", "reason": "Processing controls; no relevance to appointing a single DPO for a group or accessibility."}, {"id": "3a6219e8839cbad1f76e", "reason": "Breach notification; unrelated to DPO appointment structure or accessibility."}], "target_frame": {"addressee": {"span": "المتحكم", "article": "Article 20"}, "modality": {"span": "يلتزم", "article": "Article 20"}, "action": {"span": "تحديد مسؤول حماية البيانات الشخصية", "article": "Article 20"}, "scope": {"span": null, "article": null}, "condition": {"span": "يجب على المتحكم نشر البيانات المتعلقة بمسؤول حماية البيانات الشخصية، والتي تتضمن اسمه وبيانات التواصل معه بأي وسيلة، ولصاحب البيانات الشخصية الحق في الاتصال بمسؤول حماية البيانات الشخصية في كل المسائل المتعلقة بمعالجة بياناته الشخصية.", "article": "Article 36"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "a