: "uncovered", "confidence": 0.22, "reasoning_note": "No candidate provisions were provided for the Kuwait jurisdiction, so there is no textual basis to map or infer equivalents. All substantive slots remain uncovered. Temporal and consequence are not required by the GDPR unit and are therefore treated as covered-by-absence.", "label": "C5", "ru_id": "RU-503", "gdpr_article": 41, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 0, "total": 0}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 0, "candidate_ids": [], "n_llm_calls": 2, "latency_s": 161.81, "temperature": 0.7, "seed": 20260803, "id": "d5ecd928ca97743f24a6", "condition": "stability", "rep": 2}
{"candidates_selected": ["0c6c8a278f0b3b395e23"], "candidates_excluded": [{"id": "2ef716a5a0437defc8f2", "reason": "Regulates exceptions for international transfers; no rules on courts or inter-court communication."}, {"id": "803cdc5aa2ea085c3461", "reason": "Sets adequacy/authorization framework for cross-border data transfers; unrelated to judicial coordination."}, {"id": "9bcb8d6e5e38974e2a1b", "reason": "Concerns investigation committee powers to obtain documents; not about court duties or related proceedings."}, {"id": "3d71a23a91370cadf799", "reason": "Addresses processing of criminal case data; no provisions on appeals against authority decisions or contacting foreign courts."}, {"id": "6b500d26673394f3d7e6", "reason": "Grants data subjects rectification/block/erasure rights; no court-to-court communication obligations."}, {"id": "cf27d7263418b5d502ef", "reason": "Definitions for a decision on binding corporate rules; not about judicial proceedings."}, {"id": "348fe2ada83b7d57f33a", "reason": "Confidentiality and authority-to-authority cooperation; does not impose obligations on courts or require contacting foreign courts."}, {"id": "4f0c7ea198f3c5b3627c", "reason": "Contractual safeguards for transfers; unrelated to judicial proceedings."}, {"id": "bd5a2bbf9e9652a21d70", "reason": "Inspection powers of the authority; no link to courts or inter-jurisdictional case checks."}, {"id": "68b279470816abafcdd4", "reason": "Authority investigation procedures; not about court obligations in appeals."}, {"id": "bcc7ee2c6007b34ff5a5", "reason": "Witness-hearing by investigation committee; not about courts confirming parallel proceedings."}], "target_frame": {"addressee": {"span": "تنشأ في الهيئة لجنة قضائية ( تسمى لجنة الطعون) ، تختص بالفصل في الطعون المقدمة إليها استناداً لحكم البند (1) من هذه المادة", "article": "Article 34(2)"}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": "لكل ذي شأن، بعد سداد الرسم المقرر