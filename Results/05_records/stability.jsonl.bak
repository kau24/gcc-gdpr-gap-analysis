erdicts": [{"gdpr_value": "Union or Member State legislator", "target_value": "الجهة المختصة", "basis": "direct_textual", "verdict": "partial", "citation": "Art. 33(1): \"تضع الجهة المختصة اشتراطات...\"", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "تضع", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 33(1)", "slot": "modality"}, {"gdpr_value": "ensure the legislative measure contains specific provisions as to the categories of personal data", "target_value": "وتبين اللوائح الأحكام والضوابط والإجراءات المتعلقة بما ورد في الفقرات من (2) إلى (7) من هذه المادة", "basis": "distributed", "verdict": "partial", "citation": "Art. 10 (final sentence); Art. 33(1)", "slot": "action"}, {"gdpr_value": "any legislative measure adopted under Article 23(1)", "target_value": "بما ورد في الفقرات من (2) إلى (7) من هذه المادة", "basis": "distributed", "verdict": "narrower", "citation": "Art. 10 (final sentence); Art. 27 (final sentence: \"وتحدد اللوائح الضوابط اللازمة لما ورد في هذه المادة.\")", "slot": "scope"}, {"gdpr_value": "where relevant", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": "", "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": "", "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": "", "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": "", "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.53, "reasoning_note": "Art. 33 and Art. 10 show that KSA’s competent authority/regulations set detailed rules, addressing the reviewer’s point that there is an ‘ensure/specifics’ function. However, no text requires legislative or regulatory measures to contain specific provisions about the categories of personal data, and the addressed actor is not the legislator; hence only partial alignment.", "label": "C4", "ru_id": "RU-197", "gdpr_article": 23, "jurisdiction": "KSA", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 11, "total": 23}, {"round": 3, "n_queries": 4, "new": 2, "total": 25}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict is too broad, and there is some evidence to suggest that the KSA jurisdiction has a counterpart to the GDPR requirement.", "counter_evidence": [{"id": "06b918a4049719ed530f", "span": "تضع الجهة المختصة اشتراطات ممارسة الأنشطة التجارية أو المهنية أو غير الربحية المرتبطة بحماية البيانات الشخصية في المملكة", "why": "This provision suggests that the competent authority in the KSA jurisdiction has the responsibility to establish requirements and regulations for the protection of personal data."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict for the 'action' slot can be falsified", "counter_evidence": [{"id": "06b918a4049719ed530f", "span": "تضع الجهة المختصة اشتراطات", "why": "This provision can be interpreted as a counterpart for the action 'ensure the legislative measure contains specific provisions'"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["04322a32135a68c65bb5", "772962994f8e191e84a3", "4919410df7147924356b", "90da7bc2380e8f3f2fb8", "914fd2814b8a65e8cae6", "33d22a1a65039b5be3f9", "06b918a4049719ed530f", "7780dca28ee02b6e0f07", "ba8aef540689169aa848", "557230873031d6e5cb2c", "c511c9bf7779067e64f4", "78ae2c40eaf4fb3870fc"], "n_llm_calls": 7, "latency_s": 688.54, "temperature": 0.7, "seed": 20260801, "id": "12151d3d5149bb650d6a", "condition": "stability", "rep": 0}
{"candidates_selected": ["f6764b5004b8f04e4aa5", "de8d26aee9201d58a52b", "ae67f8fe376642167563"], "candidates_excluded": [{"id": "a37f6f979ece2e1de6bf", "reason": "Cooperation duty; no power to prevent issuance/suspension, no certification/permit issuance context."}, {"id": "9afcca9ce75d4e0c23f1", "reason": "General compliance duty; does not confer authority power re certification/permit issuance."}, {"id": "a2a61b7c9316716b7e74", "reason": "Substantive processing constraint on disclosure; unrelated to authority power over certification/permit."}, {"id": "5eb7d76c67651fbc4fcc", "reason": "Child data processing consent rule; no authority power to bar issuance."}, {"id": "db6e2be94f2388e169a8", "reason": "Controller may refuse data-subject requests; no link to certification/permit or authority orders."}, {"id": "4053c4a22e1e688ad0dd", "reason": "Child data disclosure consent; no authority power over certification/permit."}, {"id": "26ab9db083b17ff619f2", "reason": "Marketing consent; no authority power over certification/permit issuance."}, {"id": "e11ad67296feba46e5be", "reason": "Appeal of administrative sanctions; procedural, not a power to prevent issuance."}, {"id": "b59c6e3df96d0cdf91f8", "reason": "External auditor appointment; unrelated to ordering non-issuance or suspension/cancellation of certification."}], "target_frame": {"addressee": {"span": "الوزير", "article": "Article 44"}, "modality": {"span": "يجوز", "article": "Article 44"}, "action": {"span": "وقف التصريح لحين إزالة المخالفة", "article": "Article 44"}, "scope": {"span": "تصريح من الوزارة", "article": "Article 5"}, "condition": {"span": "في حالة مخالفة أحكام هذه اللائحة", "article": "Article 44"}, "exception": {"span": null, "article": null}, "temporal": {"span": "لحين إزالة المخالفة", "article": "Article 44"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "supervisory authority", "target_value": "الوزير", "basis": "conceptual", "verdict": "covered", "citation": "Article 44"}, {"slot": "modality", "gdpr_value": "power", "target_value": "يجوز", "basis": "direct_textual", "verdict": "covered", "citation": "Article 44"}, {"slot": "action", "gdpr_value": "order the certification body not to issue a certification", "target_value": "وقف التصريح (وكذلك إلغاء التصريح)", "basis": "conceptual", "verdict": "partial", "citation": "Article 44"}, {"slot": "scope", "gdpr_value": "certifications under Articles 42 and 43", "target_value": "تصريح من الوزارة لمعالجة بيانات معينة", "basis": "distributed", "verdict": "uncovered", "citation": "Articles 44, 5"}, {"slot": "condition", "gdpr_value": "the requirements for the certification are not or are no longer met", "target_value": "في حالة مخالفة أحكام هذه اللائحة (ومنها حالات إلغاء التصريح في المادة 10)", "basis": "distributed", "verdict": "partial", "citation": "Articles 44, 10"}, {"slot": "exception", "gdpr_value": "None", "target_value": "None", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "لحين إزالة المخالفة", "basis": "direct_textual", "verdict": "broader", "citation": "Article 44"}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.53, "reasoning_note": "I considered the reviewer’s point and treated “وقف التصريح” as the closest analogue, since it halts the effect of an authorization. However, the text empowers the minister to suspend/cancel a governmental permit to process data, not to order a separate certification body not to issue a certification, and the scheme is a permit regime rather than GDPR-style certification under Articles 42–43. Thus only partial similarity exists on action/condition, with core scope and mechanism missing.", "label": "C2", "ru_id": "RU-146", "gdpr_article": 17, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 15, "total": 27}, {"round": 3, "n_queries": 4, "new": 2, "total": 29}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Counterpart exists under different terminology", "counter_evidence": [{"id": "f6764b5004b8f04e4aa5", "span": "يجوز للوزير توقيع أحد الجزاءات الإدارية الآتية في حالة مخالفة أحكام هذه اللائحة: 1- الإنذار. 2- وقف التصريح لحين إزالة المخالفة.", "why": "The Minister has the power to impose administrative sanctions, including suspending the license, which could be considered a power to order a certification body not to issue a certification."}, {"id": "de8d26aee9201d58a52b", "span": "يلغى التصريح في إحدى الحالات الآتية: 1- بناءً على طلب المتحكم. 2- إذا ارتكب المتحكم مخالفة لأحكام القانون أو هذه اللائحة.", "why": "The license can be revoked if the controller commits a violation of the law or regulations, which could be considered a counterpart to the GDPR requirement."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's interpretation of the action slot might be too narrow, considering the potential relationship between suspending certification and ordering not to issue a certification.", "counter_evidence": [{"id": "f6764b5004b8f04e4aa5", "span": "وقف التصريح", "why": "This provision indicates the Minister's power to suspend certification, which could be related to ordering a certification body not to issue a certification under certain conditions."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["a37f6f979ece2e1de6bf", "9afcca9ce75d4e0c23f1", "a2a61b7c9316716b7e74", "de8d26aee9201d58a52b", "5eb7d76c67651fbc4fcc", "db6e2be94f2388e169a8", "4053c4a22e1e688ad0dd", "ae67f8fe376642167563", "26ab9db083b17ff619f2", "e11ad67296feba46e5be", "f6764b5004b8f04e4aa5", "b59c6e3df96d0cdf91f8"], "n_llm_calls": 7, "latency_s": 677.92, "temperature": 0.7, "seed": 20260801, "id": "f3373cff25e034bc3cd7", "condition": "stability", "rep": 0}
{"candidates_selected": ["b157dcadab6a3e8daf5", "546cfd19de051c612c06", "40626451a5025d77cff5"], "candidates_excluded": [{"id": "93f989531fe30cac1ed5", "reason": "Addresses erasure, not rectification."}, {"id": "d0bb19cb0c67952144b4", "reason": "Addresses data portability, not rectification."}, {"id": "4ddc7494f19d84324dd8", "reason": "Provides access/copy right, not rectification."}, {"id": "a4136d70ee84d058ef85", "reason": "DPO contact details; not about rectification rights."}, {"id": "3a6219e8839cbad1f76e", "reason": "Breach notification; not about rectification rights."}, {"id": "2712fe4ebdba355a134b", "reason": "Consent requirement; not about rectification rights."}, {"id": "caad155111190c1aa274", "reason": "Definitions; no operative rectification right."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Requires publishing mechanisms to exercise rights; does not substantively define rectification right."}, {"id": "823830174d241884bd73", "reason": "Complaint to authority; not the rectification right."}], "target_frame": {"addressee": {"span": "لصاحب البيانات الشخصية", "article": "Article 11 [b157dcadab6a3e8daf5]"}, "modality": {"span": "يكون لصاحب البيانات الشخصية الحق في الآتي:", "article": "Article 11 [b157dcadab6a3e8daf5]"}, "action": {"span": "حقوق صاحب البيانات الشخصية بما في ذلك حق الوصول إلى البيانات، وتصحيحها، ونقلها، وتحديثها.", "article": "Article 14 [40626451a5025d77cff5]"}, "scope": {"span": "بياناته الشخصية", "article": "Article 11(b) [b157dcadab6a3e8daf5]"}, "condition": {"span": "يجوز لصاحب البيانات الشخصية تقديم طلب كتابي للمتحكم ... وذلك بدون مقابل", "article": "Article 16 [546cfd19de051c612c06]"}, "exception": {"span": null, "article": null}, "temporal": {"span": "ويجب على المتحكم البت في الطلب خلال مدة لا تتجاوز (45) خمسة وأربعين يوماً من تاريخ تسلمه الطلب.", "article": "Article 16 [546cfd19de051c612c06]"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "صاحب البيانات الشخصية (data subject)", "basis": "direct_textual", "verdict": "covered", "citation": ["Article 11 [b157dcadab6a3e8daf5]"], "slot": "addressee"}, {"gdpr_value": "right", "target_value": "الحق (a right) to act regarding personal data", "basis": "direct_textual", "verdict": "covered", "citation": ["Article 11 [b157dcadab6a3e8daf5]"], "slot": "modality"}, {"gdpr_value": "obtain from the controller the rectification", "target_value": "right/request to correct or amend/update personal data", "basis": "distributed", "verdict": "partial", "citation": ["Article 14 [40626451a5025d77cff5]", "Article 11(b) [b157dcadab6a3e8daf5]"], "slot": "action"}, {"gdpr_value": "inaccurate personal data concerning the data subject", "target_value": "personal data of the data subject (not limited to inaccuracy)", "basis": "direct_textual", "verdict": "broader", "citation": ["Article 11(b) [b157dcadab6a3e8daf5]", "Article 14 [40626451a5025d77cff5]"], "slot": "scope"}, {"gdpr_value": "None", "target_value": "written request to the controller; free of charge", "basis": "direct_textual", "verdict": "narrower", "citation": ["Article 16 [546cfd19de051c612c06]"], "slot": "condition"}, {"gdpr_value": "None", "target_value": "No exceptions specified for rectification", "basis": "absent", "verdict": "covered", "citation": [], "slot": "exception"}, {"gdpr_value": "without undue delay", "target_value": "controller must decide on the request within 45 days", "basis": "direct_textual", "verdict": "weaker_modality", "citation": ["Article 16 [546cfd19de051c612c06]"], "slot": "temporal"}, {"gdpr_value": "None", "target_value": "No consequence specified", "basis": "absent", "verdict": "covered", "citation": [], "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.68, "reasoning_note": "OMN law/regulations recognize a data subject right to correct or amend personal data and set a procedure, but they frame it as a request with a 45‑day decision period rather than an entitlement to obtain rectification without undue delay. The scope appears broader (not limited to inaccuracies), while additional procedural conditions (written request) and the fixed timeline make it weaker compared to GDPR Art. 16 on immediacy and unconditional obtainability.", "label": "C4", "ru_id": "RU-140", "gdpr_article": 16, "jurisdiction": "OMN", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 12, "total": 24}, {"round": 3, "n_queries": 4, "new": 1, "total": 25}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["93f989531fe30cac1ed5", "b157dcadab6a3e8daf5f", "d0bb19cb0c67952144b4", "4ddc7494f19d84324dd8", "a4136d70ee84d058ef85", "3a6219e8839cbad1f76e", "2712fe4ebdba355a134b", "546cfd19de051c612c06", "caad155111190c1aa274", "40626451a5025d77cff5", "bb26cffae1f1c0beb85d", "823830174d241884bd73"], "n_llm_calls": 4, "latency_s": 357.95, "temperature": 0.7, "seed": 20260801, "id": "4f57e2177a28494403f1", "condition": "stability", "rep": 0}
{"candidates_selected": ["2c020ba48e817e4f4c7a", "9f3112d28a1b850ba61f", "a418980931b429c7909a"], "candidates_excluded": [{"id": "62dc9e8ad2aa962982ad", "reason": "Pre-contract transparency/consent requirements; does not impose technical/organisational design-or-operation measures."}, {"id": "b983a5ed0e1c7a2b779a", "reason": "Lawfulness bases for processing; not about implementing technical/organisational measures."}, {"id": "8df6b1810850e58a6a30", "reason": "Preambular/contextual text; not an operative obligation."}], "target_frame": {"addressee": {"span": "على مقدم الخدمة اتخاذ الآتي:", "article": "Article 5"}, "modality": {"span": "يجب على مقدم الخدمة أثناء توفير الخدمة أو بعد انتهائها أن يقوم بجمع ومعالجة البيانات وفقاً للشروط التالية:", "article": "Article 4"}, "action": {"span": "توفير التدابير الأمنية المناسبة لحماية البيانات الشخصية للمستخدم ضد الخسارة أو الضرر أو الإفصاح أو الاختراق...", "article": "Article 5(1)"}, "scope": {"span": "معالجة البيانات بطريقة تضمن حماية البيانات الشخصية ... وذلك باستخدام التدابير الفنية والتنظيمية المناسبة (\"السلامة والسرية\").", "article": "Article 4(4)"}, "condition": {"span": "ويجب أن تكون هذه التدابير ملائمة لطبيعة ونطاق أنشطته وحساسية أي بيانات شخصية يتم جمعها وتخزينها،", "article": "Article 5(1)"}, "exception": {"span": null, "article": null}, "temporal": {"span": "مراعاة الضوابط الخاصة بتصميم أو تغيير أو تطوير المنتجات والنظم والخدمات والتي من الممكن أن تؤثر على معالجة البيانات الشخصية.", "article": "Article 5(6)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "مقدم الخدمة", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 5: \"على مقدم الخدمة اتخاذ الآتي:\"", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "صياغة إلزامية (\"يجب\" / \"على مقدم الخدمة\")", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4 (chapeau): \"يجب على مقدم الخدمة...\"; Article 5 (chapeau): \"على مقدم الخدمة...\"", "slot": "modality"}, {"gdpr_value": "implement appropriate technical and organisational measures for the processing", "target_value": "توفير التدابير الأمنية المناسبة واستخدام التدابير الفنية والتنظيمية المناسبة لضمان أمن المعالجة", "basis": "distributed", "verdict": "covered", "citation": "Article 5(1): \"توفير التدابير الأمنية المناسبة...\"; Article 4(4): \"...باستخدام التدابير الفنية والتنظيمية المناسبة\"; Article 5(1.4): \"اختبار وتقييم فعالية التدابير التقنية والتنظيمية\"", "slot": "action"}, {"gdpr_value": "measures may include pseudonymisation and aim to meet GDPR requirements and protect data subjects’ rights", "target_value": "حماية السلامة والسرية (بما في ذلك التشفير) وتمكين ممارسة حقوق الوصول والتصحيح", "basis": "distributed", "verdict": "partial", "citation": "Article 4(4): \"...التدابير الفنية والتنظيمية المناسبة (السلامة والسرية)\"; Article 5(1.1): \"معالجة وتشفير البيانات الشخصية\"; Article 4(6): \"استخدام الوسائل التكنولوجية... تمكن المستخدمين من ممارسة حقهم في الوصول... وتصحيحها\"", "slot": "scope"}, {"gdpr_value": "taking into account the state of the art, the cost of implementation, the nature, scope, context and purposes of processing, and the risks to rights and freedoms", "target_value": "ملاءمة التدابير لطبيعة ونطاق الأنشطة وحساسية البيانات، والالتزام بإدارة المخاطر", "basis": "distributed", "verdict": "partial", "citation": "Article 5(1): \"...ملائمة لطبيعة ونطاق أنشطته وحساسية أي بيانات...\"; Article 5(3): \"الالتزام بالسياسات... وإدارة المخاطر\"", "slot": "condition"}, {"gdpr_value": "None", "target_value": "لا يُذكر استثناء لتطبيق التدابير؛ الصياغة إلزامية غير مشروطة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 5 (chapeau): \"على مقدم الخدمة اتخاذ الآتي:\"; Article 4 (chapeau): \"يجب على مقدم الخدمة...\"", "slot": "exception"}, {"gdpr_value": "both at design stage and during processing", "target_value": "عند التصميم/التغيير/التطوير وأثناء تقديم الخدمة وبعدها", "basis": "distributed", "verdict": "covered", "citation": "Article 5(6): \"مراعاة الضوابط الخاصة بتصميم أو تغيير أو تطوير المنتجات...\"; Article 4 (chapeau): \"أثناء توفير الخدمة أو بعد انتهائها\"", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "لا يُذكر جزاء مرتبط مباشرة بهذا الالتزام في النصوص المستشهد بها", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.67, "reasoning_note": "Kuwaiti rules impose mandatory technical and organisational measures, including at design and operational stages, and include several GDPR-like elements. However, the addressee is limited to service providers and the risk/‘state of the art’/cost factors are only partially reflected. The exception slot is supported with explicit citations to the unconditional obligation language.", "label": "C4", "ru_id": "RU-209", "gdpr_article": 25, "jurisdiction": "KWT", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 1, "total": 1}, {"round": 2, "n_queries": 4, "new": 4, "total": 5}, {"round": 3, "n_queries": 4, "new": 1, "total": 6}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "The claim of 'covered' for the exception slot without a citation may not accurately reflect the presence or absence of such an exception in the target jurisdiction's legal framework.", "counter_evidence": [{"id": "null", "span": "null", "why": "The absence of a citation for the exception slot verdict suggests a potential gap in the analysis regarding how exceptions to implementing appropriate measures are handled in the target jurisdiction."}], "confidence": 0.8}], "n_candidates": 6, "candidate_ids": ["a418980931b429c7909a", "b983a5ed0e1c7a2b779a", "2c020ba48e817e4f4c7a", "62dc9e8ad2aa962982ad", "9f3112d28a1b850ba61f", "8df6b1810850e58a6a30"], "n_llm_calls": 6, "latency_s": 602.86, "temperature": 0.7, "seed": 20260801, "id": "a9fecabd4d6d574be7c1", "condition": "stability", "rep": 0}
{"candidates_selected": ["6c76988b817262e3e312", "85d05fccf5b4f57eceaf", "192caaa530952a30ad50"], "candidates_excluded": [{"id": "3f5cc5a2c4af5fb90388", "reason": "National security/public interest exemptions from certain provisions; does not create a prior consultation duty or DPIA-based trigger."}, {"id": "f5c366135483fe580381", "reason": "Breach notification to the individual and competent authority upon serious harm; post-incident, not prior consultation tied to DPIA."}, {"id": "85e94dba24cbfb8955cd", "reason": "Data subject access rights; no relation to prior consultation or DPIA."}, {"id": "fcbd13532c69b340214e", "reason": "Security safeguards and processor-to-controller breach/threat notices; no supervisory authority consultation requirement."}, {"id": "75db9db720e9e34a1148", "reason": "Controller-to-processor disclosure safeguards; unrelated to prior consultation or DPIA."}, {"id": "75852a697f66691bfbfb", "reason": "Exemptions from access obligations; no DPIA or prior consultation mechanism."}, {"id": "07962910da55dbce48d3", "reason": "Cross-border data flow constraint; not a DPIA or prior consultation duty."}, {"id": "89d1bb9a58e65b732117", "reason": "Pre-processing information to the individual; no authority consultation."}, {"id": "f169b712b14aea8718ee", "reason": "Legal bases for processing (consent/legitimate purpose); no DPIA or prior consultation component."}], "target_frame": {"addressee": {"span": "المراقب", "article": "Article 11"}, "modality": {"span": "يتعين على المراقب", "article": "Article 8"}, "action": {"span": null, "article": null}, "scope": {"span": "عمليات معالجة جديدة", "article": "Article 11(1)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": "قبل إدراج عمليات معالجة جديدة", "article": "Article 11(1)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "controller", "target": "المراقب", "basis": "direct_textual", "verdict": "covered", "citation": "Article 11: \"على المراقب اتخاذ الإجراءات التالية:\"", "slot": "addressee"}, {"gdpr": "obligation", "target": "يتعين على المراقب", "basis": "direct_textual", "verdict": "covered", "citation": "Article 8: \"يتعين على المراقب الالتزام بما يلي:\"", "slot": "modality"}, {"gdpr": "consult the supervisory authority", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr": "intended processing", "target": "عمليات معالجة جديدة", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 11(1): \"مراجعة إجراءات حماية الخصوصية قبل إدراج عمليات معالجة جديدة.\"", "slot": "scope"}, {"gdpr": "where a DPIA under Art. 35 indicates high risk absent mitigating measures", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr": "prior to processing", "target": "قبل إدراج عمليات معالجة جديدة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 11(1): \"قبل إدراج عمليات معالجة جديدة\"", "slot": "temporal"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.78, "reasoning_note": "Art. 27 empowers the competent administration to act (“أن تتخذ جميع الإجراءات اللازمة”) but does not impose a duty on controllers to consult it, nor tie any action to a DPIA/high-risk trigger. Art. 8 (privacy-by-design obligations) and Art. 11(1) (internal review before new processing) reflect internal risk/design controls, not prior consultation with the authority when a DPIA shows high risk.", "label": "C4", "ru_id": "RU-415", "gdpr_article": 36, "jurisdiction": "QAT", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 11, "total": 11}, {"round": 2, "n_queries": 4, "new": 3, "total": 14}, {"round": 3, "n_queries": 4, "new": 2, "total": 16}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provisions do not explicitly address consulting the supervisory authority based on a DPIA indicating high risk, suggesting a potential gap in coverage.", "counter_evidence": [{"id": "6c76988b817262e3e312", "span": "على المراقب اتخاذ الإجراءات التالية: 1- مراجعة إجراءات حماية الخصوصية قبل إدراج عمليات معالجة جديدة.", "why": "Article 11 discusses the controller's obligations before new processing operations but does not explicitly mention consulting the supervisory authority or DPIA conditions."}, {"id": "192caaa530952a30ad50", "span": "للإدارة المختصة، في سبيل تطبيق وتنفيذ أحكام هذا القانون، أن تتخذ جميع الإجراءات اللازمة لذلك", "why": "Article 27 implies the administration's role in enforcing the law but does not directly address the consultation requirement based on DPIA findings."}], "confidence": 0.8}, {"verdict": "revise", "objection": "Potential counterpart found in Article 27 and Article 8", "counter_evidence": [{"id": "192caaa530952a30ad50", "span": "للإدارة المختصة، في سبيل تطبيق وتنفيذ أحكام هذا القانون، أن تتخذ جميع الإجراءات اللازمة لذلك", "why": "Implies some level of oversight and consultation"}, {"id": "85d05fccf5b4f57eceaf", "span": "يتعين على المراقب الالتزام بما يلي: 1- معالجة البيانات الشخصية بأمانة ومشروعية. 2- مراعاة الضوابط الخاصة بتصميم أو تغيير أو تطوير المنتجات والنظم والخدمات المتعلقة بمعالجة البيانات الشخصية.", "why": "Related to the concept of a data protection impact assessment"}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["3f5cc5a2c4af5fb90388", "f5c366135483fe580381", "85e94dba24cbfb8955cd", "85d05fccf5b4f57eceaf", "fcbd13532c69b340214e", "75db9db720e9e34a1148", "6c76988b817262e3e312", "75852a697f66691bfbfb", "192caaa530952a30ad50", "07962910da55dbce48d3", "89d1bb9a58e65b732117", "f169b712b14aea8718ee"], "n_llm_calls": 7, "latency_s": 594.71, "temperature": 0.7, "seed": 20260801, "id": "44fd61e452a1c7ae4c7a", "condition": "stability", "rep": 0}
{"candidates_selected": ["6b500d26673394f3d7e6", "7448a27e7806f2c0c143"], "candidates_excluded": [{"id": "98fa9fe9b0650c71a971", "reason": "Direct marketing objection right; not about rectification/completion of personal data."}, {"id": "eb633917dcbabe34df47", "reason": "Automated decision-making objections; unrelated to rectification/completion."}, {"id": "3d71a23a91370cadf799", "reason": "Criminal proceedings data processing; sectoral limits not addressing rectification right."}, {"id": "93fde8c87940ae524c86", "reason": "Transparency at collection; does not grant a rectification/completion right."}, {"id": "d958c933b41c24227c12", "reason": "Confidentiality and processing prohibitions; no rectification right."}, {"id": "5a79146e04b73c99685c", "reason": "Access/information upon request; primarily disclosure, not rectification/completion."}, {"id": "10e6e0e9f2f36b4c7b42", "reason": "Public registers conditions; not the rectification right itself (addressed specifically in Art. 23(2))."}, {"id": "762372b7329c44286e43", "reason": "Lawful bases for processing; no rectification right."}, {"id": "f8344697d1f1dc661161", "reason": "Sensitive data processing conditions; no rectification right."}, {"id": "552b4ae6d34230dd6e1f", "reason": "Definitions; do not establish a rectification/completion right."}], "target_frame": {"addressee": {"span": "يجوز لكل صاحب بيانات أن يتقدم إلى مدير البيانات بطلب، مشفوع بما يثبت هويته", "article": "Article 23(1)"}, "modality": {"span": "يجوز لكل صاحب بيانات أن يتقدم ... بطلب ... وعلى مدير البيانات، ما لم يكن لديه مسوِّغ مقبول قانوناً، الاستجابة للطلب دون مقابل", "article": "Article 23(1)"}, "action": {"span": "لتصحيح أو حَجْب أو مسح البيانات الشخصية الخاصة به بحسب الأحوال", "article": "Article 23(1)"}, "scope": {"span": "البيانات الشخصية الخاصة به ... إذا كانت البيانات غير صحيحة أو ناقصة أو غير محدَّثة", "article": "Article 23(1)"}, "condition": {"span": "إذا كانت معالجتها تتم بالمخالفة لأحكام القانون، وعلى الأخص إذا كانت البيانات غير صحيحة أو ناقصة أو غير محدَّثة، أو إذا كانت معالجتها غير مشروعة", "article": "Article 23(1)"}, "exception": {"span": "ما لم يكن لديه مسوِّغ مقبول قانوناً", "article": "Article 23(1)"}, "temporal": {"span": "على أن يكون ذلك خلال عشرة أيام عمل من تاريخ تسلُّم الطلب", "article": "Article 23(1)"}, "consequence": {"span": "على مدير البيانات، خلال خمسة عشر يوماً من تاريخ استجابته - كلياً أو جزئياً - لطلب ... إخطار أيّ طرف ثالث أفصح له عن تلك البيانات عن التصحيح أو المسح أو الحَجْب الذي تم", "article": "Article 23(5)"}}, "slot_verdicts": [{"gdpr": "data subject", "target": "صاحب البيانات (data subject)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(1): \"يجوز لكل صاحب بيانات\"", "slot": "addressee"}, {"gdpr": "right", "target": "إمكانية التقدم بطلب مع التزام على مدير البيانات بالاستجابة دون مقابل", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(1): \"يجوز لكل صاحب بيانات أن يتقدم... وعلى مدير البيانات... الاستجابة للطلب دون مقابل\"", "slot": "modality"}, {"gdpr": "have incomplete personal data completed, including by providing a supplementary statement", "target": "طلب تصحيح البيانات الشخصية، بما يشمل حالة كونها ناقصة", "basis": "direct_textual", "verdict": "partial", "citation": "Article 23(1): \"لتصحيح... البيانات الشخصية الخاصة به... إذا كانت البيانات... ناقصة\" (لا يَرِدُ نصٌّ صريح يجيز الإكمال عن طريق بيان تفسيري مكمل)", "slot": "action"}, {"gdpr": "incomplete personal data concerning the data subject", "target": "البيانات الشخصية الخاصة بصاحب البيانات إذا كانت ناقصة أو غير صحيحة أو غير محدَّثة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(1): \"البيانات الشخصية الخاصة به... إذا كانت البيانات غير صحيحة أو ناقصة أو غير محدَّثة\"", "slot": "scope"}, {"gdpr": "taking into account the purposes of the processing", "target": "يشترط للطلب أن تكون المعالجة بالمخالفة للقانون أو أن تكون البيانات غير صحيحة أو ناقصة؛ كما تُقرِّر قواعد جودة البيانات الارتباط بالغرض", "basis": "distributed", "verdict": "partial", "citation": "Article 23(1): \"إذا كانت معالجتها تتم بالمخالفة لأحكام القانون... أو إذا كانت البيانات... ناقصة\"؛ Article 3(2): \"أن تكون قد جُمِعت لغرض مشروع ومحدَّد وواضح... على نحو لا يتوافق مع الغرض\" (يربط التقييم بالغرض)", "slot": "condition"}, {"gdpr": "None", "target": "يجوز عدم الاستجابة إذا وُجد مسوِّغ قانوني مقبول، واستثناء خاص بالسجلات العامة", "basis": "direct_textual", "verdict": "broader", "citation": "Article 23(1): \"ما لم يكن لديه مسوِّغ مقبول قانوناً\"؛ Article 23(2): \"لا يسري حكم البند (1)... على أيّ سجل متاح للجمهور...\"", "slot": "exception"}, {"gdpr": "None", "target": "الاستجابة خلال عشرة أيام عمل", "basis": "direct_textual", "verdict": "broader", "citation": "Article 23(1): \"خلال عشرة أيام عمل من تاريخ تسلُّم الطلب\"", "slot": "temporal"}, {"gdpr": "None", "target": "التزام بإخطار الغير الذي أُفصح له عن البيانات خلال 15 يوماً بعد التصحيح/المسح/الحجب", "basis": "direct_textual", "verdict": "broader", "citation": "Article 23(5): \"على مدير البيانات، خلال خمسة عشر يوماً... إخطار أيّ طرف ثالث...\"", "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.74, "reasoning_note": "Bahrain’s law grants a rectification right that includes incomplete data, but it does not expressly allow completion via a supplementary statement. While Article 23 sets the rectification conditions, Article 3(2) (and 3(3)) supply the purpose-based data quality context, so the ‘purposes’ qualifier is only indirectly reflected. Exceptions and timelines in Article 23 narrow/modify the GDPR construct.", "label": "C2", "ru_id": "RU-141", "gdpr_article": 16, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 8, "total": 20}, {"round": 3, "n_queries": 4, "new": 3, "total": 23}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provisions provide some support for the data subject's rights, but the coverage is not complete.", "counter_evidence": [{"id": "Article 23(1)", "span": "يجوز لكل صاحب بيانات أن يتقدم ... بطلب لتصحيح أو حَجْب أو مسح البيانات الشخصية الخاصة به", "why": "The article grants the right to request rectification, but does not explicitly mention completing incomplete personal data via a supplementary statement."}, {"id": "Article 3(4)", "span": "أن تكون صحيحة ودقيقة، وتخضع لعمليات التحديث عندما يكون لذلك مقتضىً", "why": "The article mentions that personal data should be accurate and up-to-date, which could be interpreted to include completing incomplete personal data."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's slot verdict for the 'condition' slot is unsupported by the citation. Article 3(2) provides a basis for considering the purposes of the processing.", "counter_evidence": [{"id": "3d71a23a91370cadf799", "span": "أن تكون قد جُمِعت لغرض مشروع ومحدَّد وواضح، وألا تتم معالجتها لاحقاً، وألا يتم إجراء معالجة لاحقة لها على نحو لا يتوافق مع الغرض الذي جُمِعت من أجله", "why": "This provision implies that the purpose of the processing should be taken into account when collecting and processing personal data."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["98fa9fe9b0650c71a971", "eb633917dcbabe34df47", "3d71a23a91370cadf799", "7448a27e7806f2c0c143", "93fde8c87940ae524c86", "d958c933b41c24227c12", "5a79146e04b73c99685c", "10e6e0e9f2f36b4c7b42", "762372b7329c44286e43", "6b500d26673394f3d7e6", "f8344697d1f1dc661161", "552b4ae6d34230dd6e1f"], "n_llm_calls": 7, "latency_s": 687.88, "temperature": 0.7, "seed": 20260801, "id": "a262732d24203e386513", "condition": "stability", "rep": 0}
{"candidates_selected": ["6e9c9892919d23a9a4da"], "candidates_excluded": [{"id": "b157dcadab6a3e8daf5f", "reason": "General data subject rights (withdraw consent, block, erase) not specifically tied to an objection to direct marketing, and no explicit duty to cease processing for direct marketing upon such objection."}, {"id": "546cfd19de051c612c06", "reason": "Procedural right to request exercising rights and to halt processing pending a decision; not a substantive, unconditional stop of direct marketing processing upon objection."}, {"id": "93f989531fe30cac1ed5", "reason": "Erasure in certain cases; does not address objection to direct marketing or a prohibition on further processing for that purpose."}, {"id": "2712fe4ebdba355a134b", "reason": "General consent requirement; does not create a specific right to object to direct marketing processing nor an explicit prohibition upon such objection."}, {"id": "823830174d241884bd73", "reason": "Complaint mechanism; not an operative norm governing cessation of direct marketing processing upon objection."}, {"id": "40626451a5025d77cff5", "reason": "Transparency notice content; does not regulate objection to direct marketing or cessation of processing."}, {"id": "79ac84c7165bc6aa1c06", "reason": "Record-keeping obligation; no bearing on objection to direct marketing or cessation of processing."}, {"id": "a0040ee4dad7d4440e19", "reason": "Permit application content; unrelated to objection to direct marketing processing."}, {"id": "4f65c1f467f9e61b2f46", "reason": "Law’s scope clause; not an operative norm on objections to direct marketing."}, {"id": "caad155111190c1aa274", "reason": "Definitions/administrative terms; no operative rule on objection to direct marketing processing."}, {"id": "d0bb19cb0c67952144b4", "reason": "Portability; unrelated to objection to direct marketing or cessation of processing."}], "target_frame": {"addressee": {"span": "يجب على المتحكم", "article": "Article 22"}, "modality": {"span": "يجب ... التوقف عن إرسال", "article": "Article 22(4)"}, "action": {"span": "التوقف عن إرسال المواد الإعلانية أو التسويقية أو التجارية", "article": "Article 22(4)"}, "scope": {"span": "إرسال المواد الإعلانية أو التسويقية أو التجارية", "article": "Article 22(4)"}, "condition": {"span": "فور تلقي طلب الإيقاف من صاحب البيانات الشخصية", "article": "Article 22(4)"}, "exception": {"span": null, "article": null}, "temporal": {"span": "فور تلقي طلب الإيقاف", "article": "Article 22(4)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "المتحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 22", "slot": "addressee"}, {"gdpr_value": "prohibition", "target_value": "واجب على المتحكم التوقف (التزام ملزم)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 22(4)", "slot": "modality"}, {"gdpr_value": "process the personal data for direct marketing purposes", "target_value": "إرسال المواد الإعلانية/التسويقية (واجب التوقف عن الإرسال)", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 22(4)", "slot": "action"}, {"gdpr_value": "processing for direct marketing purposes", "target_value": "إرسال مواد إعلانية أو تسويقية أو تجارية", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 22(4)", "slot": "scope"}, {"gdpr_value": "where the data subject objects to processing for direct marketing purposes", "target_value": "عند تلقي طلب إيقاف استقبال المواد الإعلانية/التسويقية", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 22(4)", "slot": "condition"}, {"gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": "فور (إيقاف فوري)", "basis": "direct_textual", "verdict": "broader", "citation": "Article 22(4)", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.66, "reasoning_note": "Article 22(4) requires the controller to immediately stop sending marketing materials upon a stop request, which covers an opt-out from communications but not a general prohibition on further processing of personal data for direct marketing purposes. The target text lacks an express rule that all processing for direct marketing must cease upon objection. Therefore OMN only partially covers RU-181, aligning with the reviewer’s objection.", "label": "C4", "ru_id": "RU-181", "gdpr_article": 21, "jurisdiction": "OMN", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 17, "total": 29}, {"round": 3, "n_queries": 4, "new": 2, "total": 31}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "The OMN jurisdiction does not fully cover the GDPR requirement unit [RU-181] as Article 22(4) only addresses stopping the sending of marketing materials, but does not explicitly prohibit the processing of personal data for direct marketing purposes.", "counter_evidence": [{"id": "6e9c9892919d23a9a4da", "span": "يجب على المتحكم قبل إرسال أي مادة إعلانية أو تسويقية أو ذات أغراض تجارية لصاحب البيانات الشخصية الالتزام بالآتي: ... 4- التوقف عن إرسال المواد الإعلانية أو التسويقية أو التجارية فور تلقي طلب الإيقاف من صاحب البيانات الشخصية وبدون مقابل.", "why": "Article 22(4) only mentions stopping the sending of marketing materials, but does not explicitly prohibit the processing of personal data for direct marketing purposes."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["93f989531fe30cac1ed5", "6e9c9892919d23a9a4da", "d0bb19cb0c67952144b4", "823830174d241884bd73", "b157dcadab6a3e8daf5f", "40626451a5025d77cff5", "caad155111190c1aa274", "546cfd19de051c612c06", "79ac84c7165bc6aa1c06", "a0040ee4dad7d4440e19", "4f65c1f467f9e61b2f46", "2712fe4ebdba355a134b"], "n_llm_calls": 6, "latency_s": 510.32, "temperature": 0.7, "seed": 20260801, "id": "85d21a649c62d70309d5", "condition": "stability", "rep": 0}
{"candidates_selected": ["a79606d0fb564d3b2b5d"], "candidates_excluded": [{"id": "5df1b1c5bce760454262", "reason": "Focuses on processing for scientific/research/statistical purposes; no breach-notification duty to an authority."}, {"id": "a7597ada8323b333cc94", "reason": "General collection principles (purpose relation, methods, data minimization); not about breach notification."}, {"id": "4ba7db7571a9e08625c7", "reason": "Sets limits on disclosure in sensitive cases; does not regulate breach notification to an authority."}, {"id": "ba8aef540689169aa848", "reason": "Addresses processing when data are collected indirectly; no breach-notification rule."}, {"id": "952167864cc3b0d724c1", "reason": "Concerns withdrawal of consent; unrelated to notifying authorities of breaches."}, {"id": "90da7bc2380e8f3f2fb8", "reason": "Concerns response to data subject rights requests; not breach notification."}, {"id": "0922609ffbfd96a70f90", "reason": "Right to erasure/destruction; no authority notification obligation."}, {"id": "17d4b446ea6ed7965d08", "reason": "General provisions on handling data subject rights requests; not breach notification."}, {"id": "c95a0b593cc554df0eae", "reason": "Record-keeping obligations; does not address notifying authorities of breaches."}, {"id": "7780dca28ee02b6e0f07", "reason": "Rules on legal guardians; no breach-notification content."}, {"id": "21847c9e87d6df45a9a7", "reason": "Data accuracy requirement; not about breach notification."}], "target_frame": {"addressee": {"span": "جهة التحكم", "article": "Article 20(1)"}, "modality": {"span": "تشعر", "article": "Article 20(1)"}, "action": {"span": "تشعر جهة التحكم الجهة المختصة", "article": "Article 20(1)"}, "scope": {"span": "الجهة المختصة", "article": "Article 20(1)"}, "condition": {"span": "عند علمها بحدوث تسرب لبيانات شخصية أو تلفها أو وصول غير مشروع إليها", "article": "Article 20(1)"}, "exception": {"span": null, "article": null}, "temporal": {"span": "عند علمها", "article": "Article 20(1)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "controller", "target": "جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 20(1)", "slot": "addressee"}, {"gdpr": "obligation (shall)", "target": "تشعر (normative present imperative)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 20(1)", "slot": "modality"}, {"gdpr": "notify the competent supervisory authority of the personal data breach", "target": "تشعر ... الجهة المختصة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 20(1)", "slot": "action"}, {"gdpr": "to the supervisory authority competent in accordance with Article 55", "target": "إلى \"الجهة المختصة\" (competent authority)", "basis": "conceptual", "verdict": "covered", "citation": "Article 20(1)", "slot": "scope"}, {"gdpr": "in the case of a personal data breach", "target": "عند علمها بحدوث تسرب لبيانات شخصية أو تلفها أو وصول غير مشروع إليها", "basis": "conceptual", "verdict": "covered", "citation": "Article 20(1)", "slot": "condition"}, {"gdpr": "unless the breach is unlikely to result in a risk to the rights and freedoms of natural persons", "target": "No exception stated for notifying the authority", "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "exception"}, {"gdpr": "without undue delay after becoming aware", "target": "عند علمها (trigger tied to awareness; no 'without undue delay' qualifier)", "basis": "direct_textual", "verdict": "partial", "citation": "Article 20(1)", "slot": "temporal"}, {"gdpr": "None", "target": "Not specified", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.73, "reasoning_note": "Article 20(1) creates an obligation for the controller to notify the competent authority upon becoming aware of leakage/damage/unauthorized access, but it does not include the GDPR’s risk-based exception nor the ‘without undue delay’ qualifier. Article 20(2) introduces a threshold only for notifying data subjects, not the authority. The clause “وفقاً لما تحدده اللوائح” delegates procedural details, but no exception appears in the provided text.", "label": "C2", "ru_id": "RU-345", "gdpr_article": 33, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 16, "total": 28}, {"round": 3, "n_queries": 4, "new": 1, "total": 29}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's claim about the absence of an exception in the KSA regulations for breaches unlikely to result in a risk to the rights and freedoms of natural persons may be incomplete or incorrect based on Article 20(2).", "counter_evidence": [{"id": "a79606d0fb564d3b2b5d", "span": "إذا كان من شأن حدوث تسرب لبيانات شخصية أو تلفها أو وصول غير مشروع إليها أن يرتب ضرراً على بياناته أو يتعارض مع حقوقه أو مصالحه", "why": "This provision implies an exception for notifying the data subject based on the potential risk of the breach."}], "confidence": 0.8}, {"verdict": "revise", "objection": "Potential implicit or explicit provision for exception in Article 20(1) and (2)", "counter_evidence": [{"id": "a79606d0fb564d3b2b5d", "span": "Article 20(1) and (2)", "why": "Implicit or explicit provision for exception"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["5df1b1c5bce760454262", "a7597ada8323b333cc94", "4ba7db7571a9e08625c7", "a79606d0fb564d3b2b5d", "ba8aef540689169aa848", "952167864cc3b0d724c1", "90da7bc2380e8f3f2fb8", "0922609ffbfd96a70f90", "17d4b446ea6ed7965d08", "c95a0b593cc554df0eae", "7780dca28ee02b6e0f07", "21847c9e87d6df45a9a7"], "n_llm_calls": 7, "latency_s": 657.8, "temperature": 0.7, "seed": 20260801, "id": "2f7883f636a08329f4fb", "condition": "stability", "rep": 0}
{"candidates_selected": ["c24849787475f274ecac", "8cd7b777aa3cd8ca5f1f", "88af48316f67d59351aa", "6b500d26673394f3d7e6"], "candidates_excluded": [{"id": "74358e437cd9e85fdabb", "reason": "Concerns Data Protection Officer duties/registration; not about supervisory authority fines or fining caps."}, {"id": "6a403e591ecc2a5638fc", "reason": "Administrative investigation of DPOs; not a fining-cap or SA sanction rule."}, {"id": "7e2914aa34ab2739dafd", "reason": "Security obligations for controllers/processors; no rule on administrative fine ceilings."}, {"id": "5e5fa8a4888b88a04311", "reason": "Civil compensation; not an administrative fine imposed by the supervisory authority."}, {"id": "1d8fd3d4070b1ff36d68", "reason": "Notification regime to the authority; not about administrative fines or their maxima."}, {"id": "14fe9b230c7ba11703d5", "reason": "Criminal penalties; GDPR RU addresses administrative fine ceilings by the supervisory authority."}, {"id": "1d9b90bc8d164f514dc3", "reason": "Breach-notification duties; not an SA fining-cap rule."}, {"id": "c9145cc9a91d8ff7530c", "reason": "Liability of corporate DPO providers; not related to SA administrative fine ceilings."}], "target_frame": {"addressee": {"span": "يأمر مجلس الإدارة المخالف بالتوقف عن المخالفة وإزالة أسبابها أو آثارها", "article": "Article 55(1)"}, "modality": {"span": "توقيع غرامة إدارية بما لا يجاوِز عشرين ألف دينار", "article": "Article 55(1)(ج)"}, "action": {"span": "توقيع غرامة إدارية", "article": "Article 55(1)(ج)"}, "scope": {"span": "يتعيَّن عند تقدير الغرامة مراعاة جسامة المخالفة، والعنت الذي بدا من المخالف، والمنافع التي جناها، والضرر الذي أصاب صاحب البيانات نتيجة لذلك.", "article": "Article 55(2)"}, "condition": {"span": "عند ثبوت المخالفة", "article": "Article 55(1)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "supervisory authority", "target_value": "مجلس الإدارة (الهيئة) يباشر اتخاذ التدابير ويصدر قرارات بالعقوبات", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 55(1); see also Art. 30"}, {"slot": "modality", "gdpr_value": "prohibition", "target_value": "صيغة حدّ أقصى «بما لا يجاوز» تُحظر تجاوز السقف", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 55(1)(ج)"}, {"slot": "action", "gdpr_value": "impose an administrative fine exceeding the higher of 20 000 000 EUR or 4% worldwide turnover", "target_value": "توقيع غرامة إدارية بسقف أقصاه 20,000 دينار بحريني", "basis": "direct_textual", "verdict": "broader", "citation": "Art. 55(1)(ج)"}, {"slot": "scope", "gdpr_value": "in accordance with paragraph 2 (assessment factors)", "target_value": "مراعاة جسامة المخالفة والعنت والمنافع المتحصلة والضرر لصاحب البيانات عند تقدير الغرامة", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 55(2)"}, {"slot": "condition", "gdpr_value": "for infringements of the data subjects' rights pursuant to Articles 12 to 22", "target_value": "تُفرض التدابير «عند ثبوت المخالفة» وتشمل المخالفات لحقوق أصحاب البيانات (مثل حق الاعتراض وحق التصحيح/الحجب/المسح)", "basis": "distributed", "verdict": "broader", "citation": "Art. 55(1); Art. 21; Art. 23"}, {"slot": "exception", "gdpr_value": "None", "target_value": "لا استثناء منصوصاً عليه لسقف الغرامة الإدارية", "basis": "absent", "verdict": "covered", "citation": "Art. 55(1)"}, {"slot": "temporal", "gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "covered", "confidence": 0.73, "reasoning_note": "Bahrain’s law empowers the supervisory authority’s board to impose administrative fines with a hard cap of 20,000 BHD and requires assessment factors, functionally mirroring a fining-ceiling regime. While the Bahraini cap and triggers are structured differently and not tied specifically to a subset of rights, the regime applies to rights infringements as part of all violations, thus covering the GDPR unit’s functional core. The reviewer’s point is accepted: rights (e.g., objection, rectification/erasure) exist and are within the fining framework.", "label": "C1", "ru_id": "RU-514", "gdpr_article": 42, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 10, "total": 22}, {"round": 3, "n_queries": 4, "new": 9, "total": 31}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The counterpart for the scope of the GDPR's administrative fine is not explicitly mentioned in the provisions.", "counter_evidence": [{"id": "c24849787475f274ecac", "span": "Article 55(1)(ج)", "why": "The article mentions an administrative fine not exceeding 20,000 BHD, but does not explicitly mention the scope of the fine."}, {"id": "14fe9b230c7ba11703d5", "span": "Article 58", "why": "The article mentions various penalties, but does not explicitly mention an administrative fine exceeding the higher of 20,000,000 EUR or 4% of the total worldwide annual turnover of the preceding financial year."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict of 'uncovered' for the slot 'for infringements of the data subjects' rights pursuant to Articles 12 to 22' is incorrect, as a counterpart to the GDPR provision exists in the target jurisdiction.", "counter_evidence": [{"id": "6b500d26673394f3d7e6", "span": "الحق في الاعتراض على المعالَجة التي تُلحِق بصاحب البيانات أو غيره ضرراً مادياً أو معنوياً", "why": "This provision implies that the data subject has rights that are protected under the law, which corresponds to the GDPR provision."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["74358e437cd9e85fdabb", "c24849787475f274ecac", "6a403e591ecc2a5638fc", "7e2914aa34ab2739dafd", "5e5fa8a4888b88a04311", "1d8fd3d4070b1ff36d68", "14fe9b230c7ba11703d5", "88af48316f67d59351aa", "6b500d26673394f3d7e6", "1d9b90bc8d164f514dc3", "8cd7b777aa3cd8ca5f1f", "c9145cc9a91d8ff7530c"], "n_llm_calls": 7, "latency_s": 686.51, "temperature": 0.7, "seed": 20260801, "id": "c3e1e3c38f31905392e8", "condition": "stability", "rep": 0}
{"candidates_selected": ["59abf8ad06d6b694538c", "d31b8876d3426a7c919a"], "candidates_excluded": [{"id": "f8c6dae3f69fbe207307", "reason": "Addresses disclosure exceptions; no right to human intervention in automated decisions."}, {"id": "6ee1b976a5203de50c77", "reason": "Right of access only; no mention of automated decisions or human intervention."}, {"id": "4919410df7147924356b", "reason": "Right to obtain a copy; no link to automated decisions or human intervention."}, {"id": "ba8aef540689169aa848", "reason": "Requirements for processing when data are collected indirectly; unrelated to human intervention in decisions."}, {"id": "ea8306cd18f9261f6413", "reason": "Transparency at collection; does not create a right to human intervention in automated decision-making."}, {"id": "78ae2c40eaf4fb3870fc", "reason": "Controller’s duty when selecting processors; no data-subject right to human intervention."}, {"id": "7ddbf4e54143664b8b8b", "reason": "Disclosure safeguards; no right to human intervention in automated decisions."}, {"id": "67a122f7dc547487996a", "reason": "Sanctions framework; not a substantive right for data subjects."}, {"id": "04322a32135a68c65bb5", "reason": "Processing for a realized interest; no data-subject right to human intervention."}, {"id": "06b918a4049719ed530f", "reason": "Accreditation/oversight mechanisms; no data-subject right to human intervention."}], "target_frame": {"addressee": {"span": "صاحب البيانات الشخصية", "article": "Article 4"}, "modality": {"span": "يكون لصاحب البيانات الشخصية -وفًقا للأحكام الواردة في النظام وما تحدده اللوائح- الحقوق الآتية", "article": "Article 4"}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "data subject", "target": "صاحب البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "59abf8ad06d6b694538c (Art. 4)"}, {"slot": "modality", "gdpr": "right", "target": "يكون لصاحب البيانات الشخصية ... الحقوق الآتية", "basis": "direct_textual", "verdict": "covered", "citation": "59abf8ad06d6b694538c (Art. 4)"}, {"slot": "action", "gdpr": "obtain human intervention on the part of the controller", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "scope", "gdpr": "decisions permitted under Article 22(2)(a) or 22(2)(c)", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "condition", "gdpr": "None", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "exception", "gdpr": "None", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "temporal", "gdpr": "None", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "consequence", "gdpr": "None", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.79, "reasoning_note": "Art. 22 (KSA) imposes a controller duty to conduct impact assessments for public products/services but does not grant a data-subject right to obtain human intervention in automated decisions. Art. 4 confirms certain data-subject rights (knowledge, access, copy, rectification, deletion), yet none concern human intervention or the scope of automated decisions. Therefore, there is no textual counterpart to GDPR Art. 22(3)(a) in the provided KSA texts.", "label": "C2", "ru_id": "RU-189", "gdpr_article": 22, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 18, "total": 30}, {"round": 3, "n_queries": 4, "new": 4, "total": 34}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's label of C5 is incorrect, as there are provisions in the KSA jurisdiction that provide some level of counterpart to the GDPR requirement.", "counter_evidence": [{"id": "59abf8ad06d6b694538c", "span": "المادة الرابعة: يكون لصاحب البيانات الشخصية -وفًقا للأحكام الواردة في النظام وما تحدده اللوائح- الحقوق الآتية:", "why": "This provision grants the data subject several rights, including the right to access their personal data and the right to request correction or completion of their personal data."}, {"id": "6ee1b976a5203de50c77", "span": "المادة الخامسة: الحق في الوصول إلى البيانات الشخصية", "why": "This provision provides that the data subject has the right to access their personal data."}, {"id": "4919410df7147924356b", "span": "المادة السادسة: الحق في طلب الحصول على البيانات الشخصية", "why": "This provision provides that the data subject has the right to request a copy of their personal data."}], "confidence": 0.8}, {"verdict": "revise", "objection": "Lack of direct evidence for the right to human intervention in decisions under Article 22(2)(a) or 22(2)(c), but presence of relevant rights and assessments", "counter_evidence": [{"id": "d31b8876d3426a7c919a", "span": "المادة الثانية والعشرون: على جهة التحكم إجراء تقويم للآثار المترتبة على معالجة البيانات الشخصية لأي منتج أو خدمة تقدم للعموم بحسب طبيعة النشاط الذي تمارسه جهة التحكم", "why": "Related to the scope of decisions involving human intervention"}, {"id": "59abf8ad06d6b694538c", "span": "المادة الرابعة: يكون لصاحب البيانات الشخصية -وفًقا للأحكام الواردة في النظام وما تحدده اللوائح- الحقوق الآتية", "why": "Grants several rights to the data subject, potentially implying some form of intervention or oversight"}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["f8c6dae3f69fbe207307", "6ee1b976a5203de50c77", "4919410df7147924356b", "59abf8ad06d6b694538c", "ba8aef540689169aa848", "d31b8876d3426a7c919a", "ea8306cd18f9261f6413", "78ae2c40eaf4fb3870fc", "7ddbf4e54143664b8b8b", "67a122f7dc547487996a", "04322a32135a68c65bb5", "06b918a4049719ed530f"], "n_llm_calls": 7, "latency_s": 645.14, "temperature": 0.7, "seed": 20260801, "id": "cfd09b657f41aba09cb3", "condition": "stability", "rep": 0}
{"candidates_selected": ["6e6fc1f4d7421fb141d6", "05b7537a91d92a0529ad", "a4136d70ee84d058ef85"], "candidates_excluded": [{"id": "db1b46495b01511abeef", "reason": "Defines DPO tasks; does not address permission for a group to appoint a single DPO or accessibility from each establishment."}, {"id": "c62011bb3dda1c9374e5", "reason": "General protection clause; no bearing on group DPO appointment."}, {"id": "a0040ee4dad7d4440e19", "reason": "Administrative filing content (includes DPO details); does not create or recognize group-level single DPO permission."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Privacy policy requirements; not about DPO appointment or group structures."}, {"id": "3a6219e8839cbad1f76e", "reason": "Breach notification; unrelated to group DPO appointment."}, {"id": "93f989531fe30cac1ed5", "reason": "Erasure right; unrelated to DPO appointment modality."}, {"id": "3f916831456908af27d8", "reason": "Enforcement measures; does not address DPO appointment or accessibility."}, {"id": "d0bb19cb0c67952144b4", "reason": "Data portability; unrelated to DPO appointment."}, {"id": "79ac84c7165bc6aa1c06", "reason": "Record-keeping includes DPO details; does not authorize a single DPO for a group or address establishment-level accessibility."}], "target_frame": {"addressee": {"span": "المتحكم", "article": "Article 34"}, "modality": {"span": "يلتزم", "article": "Article 34"}, "action": {"span": "بتحديد مسؤول حماية البيانات الشخصية", "article": "Article 34"}, "scope": {"span": null, "article": null}, "condition": {"span": "يجب على المتحكم نشر البيانات المتعلقة بمسؤول حماية البيانات الشخصية، والتي تتضمن اسمه وبيانات التواصل معه بأي وسيلة، ولصاحب البيانات الشخصية الحق في الاتصال بمسؤول حماية البيانات الشخصية في كل المسائل المتعلقة بمعالجة بياناته الشخصية.", "article": "Article 36"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "group of undertakings", "target": "المتحكم", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 34; Article 20 (05b7537a91d92a0529ad)"}, {"slot": "modality", "gdpr": "permission", "target": "يلتزم (obligation to designate a DPO)", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 34; Article 20 (05b7537a91d92a0529ad)"}, {"slot": "action", "gdpr": "appoint a single data protection officer for the group", "target": "بتحديد مسؤول حماية البيانات الشخصية (per controller)", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 34; Article 20 (05b7537a91d92a0529ad)"}, {"slot": "scope", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "condition", "gdpr": "provided that a data protection officer is easily accessible from each establishment", "target": "يجب على المتحكم نشر بيانات ومسارات التواصل مع مسؤول حماية البيانات الشخصية؛ ولصاحب البيانات الحق في الاتصال به", "basis": "direct_textual", "verdict": "partial", "citation": "Article 36"}, {"slot": "exception", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.72, "reasoning_note": "Target texts obligate each controller to designate a DPO and do not contain any clause permitting a single DPO to serve a group of undertakings. The only accessibility requirement is publication of DPO contact details and a right to contact the DPO, not accessibility from each establishment. Accordingly, the GDPR permission is not reflected and the target modality is narrower/stricter.", "label": "C4", "ru_id": "RU-432", "gdpr_article": 37, "jurisdiction": "OMN", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 10, "total": 22}, {"round": 3, "n_queries": 4, "new": 6, "total": 28}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's claim that there is no counterpart to the GDPR requirement is not entirely accurate, as some provisions suggest the presence of a data protection officer concept.", "counter_evidence": [{"id": "6e6fc1f4d7421fb141d6", "span": "يلتزم المتحكم بتحديد مسؤول حماية البيانات الشخصية", "why": "This provision implies the appointment of a data protection officer, which is similar to the GDPR requirement."}, {"id": "a4136d70ee84d058ef85", "span": "يجب على المتحكم نشر البيانات المتعلقة بمسؤول حماية البيانات الشخصية", "why": "This provision requires the controller to publish data related to the data protection officer, which suggests the presence of a data protection officer concept."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The target jurisdiction does not explicitly permit a group of undertakings to appoint a single data protection officer for the group, and the modality in the target jurisdiction is actually narrower than the GDPR requirement.", "counter_evidence": [{"id": "6e6fc1f4d7421fb141d6", "span": "يلتزم المتحكم بتحديد مسؤول حماية البيانات الشخصية", "why": "This provision requires the controller to appoint a data protection officer, but it does not explicitly permit a group of undertakings to appoint a single data protection officer for the group."}, {"id": "6e6fc1f4d7421fb141d6", "span": "يلتزم", "why": "This term implies an obligation, whereas the GDPR requirement uses the term 'permission'."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["05b7537a91d92a0529ad", "a4136d70ee84d058ef85", "db1b46495b01511abeef", "c62011bb3dda1c9374e5", "a0040ee4dad7d4440e19", "6e6fc1f4d7421fb141d6", "bb26cffae1f1c0beb85d", "3a6219e8839cbad1f76e", "93f989531fe30cac1ed5", "3f916831456908af27d8", "d0bb19cb0c67952144b4", "79ac84c7165bc6aa1c06"], "n_llm_calls": 7, "latency_s": 543.13, "temperature": 0.7, "seed": 20260801, "id": "c09f97b57daeac29b629", "condition": "stability", "rep": 0}
{"candidates_selected": ["43a894c88a019f80b1d4"], "candidates_excluded": [{"id": "ca31304d94e06fa35850", "reason": "Article 29 grants certain ministry employees powers as judicial seizure officers to detect and establish violations (ضبط وإثبات الجرائم). It does not confer on individuals any right to obtain a judicial remedy before a court, nor does it address supervisory authority inaction or court review of complaints. Therefore, it is not a counterpart to GDPR Art. 78."}, {"id": "85e94dba24cbfb8955cd", "reason": "Establishes access rights (Art. 6); does not address judicial remedies for complaints or supervisory authority inaction."}, {"id": "75852a697f66691bfbfb", "reason": "Exemptions from access obligations (Art. 21); no judicial remedy or complaint-handling provisions."}, {"id": "850decaffbbae78d371d", "reason": "General exemptions (Art. 19); unrelated to judicial remedies or complaint inaction."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "National security/public interest processing exemptions (Art. 18); no judicial remedy for complaints."}, {"id": "dbaab43b07be19b5483e", "reason": "Transitional compliance period (Art. 30); unrelated."}, {"id": "8e42fa09dd797a4c0ce1", "reason": "Penalties for violations (Art. 23); does not create individual court remedies for complaint inaction."}, {"id": "ee1ae0df2d9432ae32a5", "reason": "Corporate penalties (Art. 25); unrelated to individual judicial remedies."}, {"id": "18cb1cd8191cffb1c314", "reason": "Limits on disclosing reasons for refusing individual rights (Art. 20); no court remedy mechanism."}, {"id": "a200ece03fd0ba143354", "reason": "Minister to set procedures for exercising rights in prior articles (Art. 7); does not establish judicial remedies for complaints."}, {"id": "ebf74cfd82d3e6cbc442", "reason": "Nullity of contracts contrary to the law (Art. 28); unrelated."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "each data subject", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "modality", "gdpr": "right", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "action", "gdpr": "obtain an effective judicial remedy before a court", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "scope", "gdpr": "regarding a complaint lodged under Article 77", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "condition", "gdpr": "where the supervisory authority does not handle the complaint or does not inform on progress/outcome within three months", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "exception", "gdpr": "without prejudice to any other administrative or non-judicial remedy", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "temporal", "gdpr": "none", "target": "none", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr": "none", "target": "none", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.78, "reasoning_note": "Article 26 creates an administrative complaint mechanism but does not grant data subjects a right to obtain a judicial remedy if the authority fails to act or inform within a set period. Article 29 concerns investigatory powers of ministry staff and does not provide any individual right to go to court. No cited provision mentions court access by data subjects tied to supervisory authority inaction.", "label": "C2", "ru_id": "RU-912", "gdpr_article": 78, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 5, "total": 5}, {"round": 2, "n_queries": 4, "new": 5, "total": 10}, {"round": 3, "n_queries": 4, "new": 4, "total": 14}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Counterpart exists under different terminology", "counter_evidence": [{"id": "43a894c88a019f80b1d4", "span": "للفرد أن يتقدم بشكوى إلى الإدارة المختصة، في حالة مخالفة أحكام هذا القانون والقرارات الصادرة تنفيذاً له.", "why": "Provides a mechanism for individuals to lodge complaints with the competent authority"}, {"id": "43a894c88a019f80b1d4", "span": "ويجوز للمراقب أو المعالج التظلم من هذا القرار، إلى الوزير، خلال ستين يوماً من تاريخ إخطاره به.", "why": "Provides a mechanism for appeal to the Minister"}], "confidence": 0.8}, {"verdict": "revise", "objection": "Counterpart to GDPR requirement found in Article 29", "counter_evidence": [{"id": "ca31304d94e06fa35850", "span": "يكون لموظفي الوزارة، الذين يصدر بتخويلهم صفة مأموري الضبط القضائي، قرار من النائب العام بالاتفاق مع الوزير، ضبط وإثبات الجرائم التي تقع بالمخالفة لأحكام هذا القانون", "why": "Mentions the role of judicial investigators in investigating crimes related to the violation of this law, which could be interpreted as a form of judicial remedy"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["43a894c88a019f80b1d4", "85e94dba24cbfb8955cd", "75852a697f66691bfbfb", "850decaffbbae78d371d", "3f5cc5a2c4af5fb90388", "dbaab43b07be19b5483e", "ca31304d94e06fa35850", "8e42fa09dd797a4c0ce1", "ee1ae0df2d9432ae32a5", "18cb1cd8191cffb1c314", "a200ece03fd0ba143354", "ebf74cfd82d3e6cbc442"], "n_llm_calls": 7, "latency_s": 591.05, "temperature": 0.7, "seed": 20260801, "id": "8f46eb627243346b6879", "condition": "stability", "rep": 0}
{"candidates_selected": ["8cd7b777aa3cd8ca5f1f"], "candidates_excluded": [{"id": "2ef716a5a0437defc8f2", "reason": "Regulates cross‑border transfers and related exceptions; no mention of annual reports or listing infringements/measures."}, {"id": "3d71a23a91370cadf799", "reason": "Concerns processing of criminal case data; not about supervisory authority annual reporting."}, {"id": "762372b7329c44286e43", "reason": "Sets lawful bases for processing; no provisions on supervisory authority annual reports."}, {"id": "601ddc5fd8dcb81306cb", "reason": "Board governance (budget, internal reports); does not address public annual activity reports or permission to include infringement/measure lists."}, {"id": "7e2914aa34ab2739dafd", "reason": "Security of processing obligations; unrelated to supervisory authority reporting."}, {"id": "5e5fa8a4888b88a04311", "reason": "Civil compensation; no annual report content or permissions."}, {"id": "1d8fd3d4070b1ff36d68", "reason": "Controller notification to the authority; not about the authority’s annual report or listing infringements/measures."}, {"id": "e38e0bed35316765ba57", "reason": "Register of notifications/permits and public access; not an annual activity report of infringements or measures."}, {"id": "4415e9a46823d9615000", "reason": "Delegation of enforcement officials; no reporting content."}, {"id": "b334fb41dcb796c50b6b", "reason": "Urgent interim measures; no provision on annual reports."}, {"id": "a3c79315ae2d7920a38f", "reason": "Complaints procedure; does not address annual report content."}], "target_frame": {"addressee": {"span": "تتولى الهيئة مباشرة كافة المهام والصلاحيات اللازمة لحماية البيانات الشخصية", "article": "Article 30"}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "each supervisory authority", "target_value": "الهيئة (سلطة حماية البيانات الشخصية)", "basis": "conceptual", "verdict": "covered", "citation": "Article 30", "slot": "addressee"}, {"gdpr_value": "permission", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "modality"}, {"gdpr_value": "include in the annual report a list of types of infringement notified and types of measures taken in accordance with Article 58(2)", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr_value": "content of the annual activity report", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.73, "reasoning_note": "The Bahraini law provisions provided do not establish an annual activity report for the authority or any permission to include lists of infringements and measures therein. Only the existence and general mandate of the authority are textually identifiable. Therefore the GDPR permission regarding annual report content is not reflected.", "label": "C2", "ru_id": "RU-698", "gdpr_article": 59, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 14, "total": 26}, {"round": 3, "n_queries": 4, "new": 3, "total": 29}], "suf