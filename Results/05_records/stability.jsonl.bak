{"candidates_selected": [], "candidates_excluded": [{"id": "743bfdd72ed773ff5ba9", "reason": "Jurisdictional scope of the law; no duty on the supervisory authority to develop international cooperation mechanisms."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "General processing principles for controllers; no content on supervisory authorities’ international cooperation for enforcement."}, {"id": "674524dee00496cb5de7", "reason": "Controller obligations (security, records, etc.); does not address supervisory authority duties or international enforcement cooperation."}, {"id": "0cc06e3d3b107448da5a", "reason": "Processor obligations; no supervisory authority role or international cooperation mechanism."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification regime; addresses controllers/processors and the Office domestically, not international cooperation."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment conditions; no international cooperation duties for supervisory authorities."}, {"id": "34f7595acb9df257ef5e", "reason": "DPO roles (including liaison with the Office) are internal/domestic; no international cooperation mandate for the Office."}, {"id": "9c38ab11b550755816f5", "reason": "Controller/processor duties toward the DPO; unrelated to supervisory authorities’ international cooperation."}, {"id": "9d65c2815c41a25064db", "reason": "Security measures; no supervisory authority or international cooperation aspect."}, {"id": "dec351a1e477287e3b22", "reason": "Controller communication methods with data subjects; no supervisory authority international cooperation content."}, {"id": "a079a5ac446830a74bfc", "reason": "Cross-border transfer conditions (adequacy/agreements) approved by the Office; references state accession to agreements but imposes no obligation on the supervisory authority to develop international cooperation mechanisms for enforcement."}, {"id": "6201d16404c0d4b9f63d", "reason": "Alternative cross-border transfer bases (including in