{"candidates_selected": ["4a1a7742c2a181be0640"], "candidates_excluded": [{"id": "ebfe638a86be87347658", "reason": "Data portability; does not regulate objection to processing for direct marketing."}, {"id": "877fafe0080725188d05", "reason": "Rectification/erasure; not the right to object to direct marketing."}, {"id": "717a67a0d311f88c5fd9", "reason": "Right to information (including procedures on how to object), but does not itself establish the substantive right to object to direct marketing."}, {"id": "c34922f387019af45e42", "reason": "Automated decision-making/profiling objections generally; not specifically the right to object to direct marketing."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "General processing principles; no specific right to object to direct marketing."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Territorial/material scope; not about data subject rights."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restriction in certain cases; not the specific direct marketing objection."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification; unrelated to objection to direct marketing."}, {"id": "5d949837d7aab073cd67", "reason": "Complaint to authority; remedial route, not the marketing objection right."}, {"id": "dec351a1e477287e3b22", "reason": "Controller must provide contact methods to exercise rights; procedural/enabling, not the substantive right to object to direct marketing."}, {"id": "57844ac856d11c289650", "reason": "Lawful bases without consent; does not address the right to object to direct marketing."}], "target_frame": {"addressee": {"span": "صاحب البيانات", "article": "Article 17 (chapeau)"}, "modality": {"span": "يحق", "article": "Article 17 (chapeau)"}, "action": {"span": "الاعتراض على معالجة بياناته الشخصية", "article": "Article 17 (chapeau)"}, "scope": {"span": "لأغراض التسويق المباشر بما في ذلك التنميط ذات العلاقة بالتسويق المباشر", "article": "Article 17(1)"}, "condition": {"span": "إذا كانت المعالجة لأغراض التسويق المباشر", "article": "Article 17(1)"}, "exception": {"span": null, "article": null}, "temporal": {"span": "في أي من الحالات الآتية", "article": "Article 17 (chapeau)"}, "consequence": {"span": "إيقاف المعالجة", "article": "Article 17 (chapeau)"}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data subject", "target_value": "صاحب البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17 (chapeau)"}, {"slot": "modality", "gdpr_value": "right", "target_value": "يحق", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17 (chapeau)"}, {"slot": "action", "gdpr_value": "object to processing of personal data concerning him or her for direct marketing", "target_value": "الاعتراض على معالجة بياناته الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17 (chapeau)"}, {"slot": "scope", "gdpr_value": "processing for direct marketing purposes, including profiling to the extent related to such direct marketing", "target_value": "لأغراض التسويق المباشر بما في ذلك التنميط ذات العلاقة بالتسويق المباشر", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(1)"}, {"slot": "condition", "gdpr_value": "where personal data are processed for direct marketing purposes", "target_value": "إذا كانت المعالجة لأغراض التسويق المباشر", "basis": "direct_textual", "verdict": "covered", "citation": "Article 17(1)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "No exception stated for this right in the direct marketing case", "basis": "absent", "verdict": "covered", "citation": "Article 17"}, {"slot": "temporal", "gdpr_value": "at any time", "target_value": "في أي من الحالات الآتية (no temporal limitation stated; right applies whenever the case applies)", "basis": "conceptual", "verdict": "covered", "citation": "Article 17 (chapeau)"}, {"slot": "consequence", "gdpr_value": "None", "target_value": "إيقاف المعالجة", "basis": "direct_textual", "verdict": "broader", "citation": "Article 17 (chapeau)"}], "holistic_label": "covered", "confidence": 0.87, "reasoning_note": "Article 17 explicitly grants the data subject the right to object to processing for direct marketing, including related profiling. No temporal limitation is imposed; the chapeau’s phrasing and structure mean the right is exercisable whenever the marketing-processing case applies. This addresses the reviewer’s point that the ‘at any time’ element is functionally captured by Article 17’s formulation.", "label": "C1", "ru_id": "RU-180", "gdpr_article": 21, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 9, "total": 9}, {"round": 2, "n_queries": 4, "new": 4, "total": 13}, {"round": 3, "n_queries": 4, "new": 4, "total": 17}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "The 'at any time' condition is covered in Article 17(1) of the UAE jurisdiction, albeit under different terminology.", "counter_evidence": [{"id": "4a1a7742c2a181be0640", "span": "في أي من الحالات الآتية", "why": "This phrase implies that the data subject can object to the processing at any time, as long as it falls under one of the specified cases."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["4a1a7742c2a181be0640", "ebfe638a86be87347658", "877fafe0080725188d05", "717a67a0d311f88c5fd9", "c34922f387019af45e42", "3cc10eb2dd7e95bdd0c2", "743bfdd72ed773ff5ba9", "5bedab371a9fc40ba93a", "e05de90f481c9410c6e0", "5d949837d7aab073cd67", "dec351a1e477287e3b22", "57844ac856d11c289650"], "n_llm_calls": 6, "latency_s": 420.83, "temperature": 0.7, "seed": 20260801, "id": "3b1cc10f8d3f87fac03f", "condition": "stability", "rep": 0}
{"candidates_selected": ["9f3112d28a1b850ba61f", "2c020ba48e817e4f4c7a"], "candidates_excluded": [{"id": "a418980931b429c7909a", "reason": "Breach-notification duties and content of notices; no right of rectification."}, {"id": "b983a5ed0e1c7a2b779a", "reason": "Lawful bases for processing; does not address data-subject rectification rights."}], "target_frame": {"addressee": {"span": "المستخدمين", "article": "Article 4(6)"}, "modality": {"span": "حقهم", "article": "Article 4(6)"}, "action": {"span": "الوسائل التكنولوجية المناسبة التي تمكن المستخدمين من ممارسة حقهم في الوصول إلى البيانات الشخصية ومراجعتها وتصحيحها بشكل مباشر", "article": "Article 4(6)"}, "scope": {"span": "البيانات الشخصية", "article": "Article 4(6)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "data subject", "target": "المستخدمين (data subjects)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(6)"}, {"slot": "modality", "gdpr": "right", "target": "حقهم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4(6)"}, {"slot": "action", "gdpr": "obtain from the controller the rectification", "target": "تمكين المستخدمين من تصحيح البيانات الشخصية مباشرة؛ وجود آلية لتصحيحها وتلقي طلبات تصحيحها", "basis": "distributed", "verdict": "covered", "citation": "Article 4(6), Article 4(8), Article 4(12), Article 5(9)"}, {"slot": "scope", "gdpr": "inaccurate personal data concerning the data subject", "target": "البيانات الشخصية (دون قصرها على البيانات غير الدقيقة)", "basis": "direct_textual", "verdict": "broader", "citation": "Article 4(6)"}, {"slot": "condition", "gdpr": "None", "target": "No conditions stated", "basis": "absent", "verdict": "covered", "citation": "Article 4(6); Article 4(8)"}, {"slot": "exception", "gdpr": "None", "target": "No exceptions stated", "basis": "absent", "verdict": "covered", "citation": "Article 4(6); Article 4(8)"}, {"slot": "temporal", "gdpr": "without undue delay", "target": "No timeliness requirement for executing rectification; only 24/7 intake of requests", "basis": "absent", "verdict": "uncovered", "citation": "Article 4(6) (silent); Article 5(9) (على مدار الساعة لطلباته فقط)"}, {"slot": "consequence", "gdpr": "None", "target": "None stated", "basis": "absent", "verdict": "covered", "citation": ""}], "holistic_label": "partial", "confidence": 0.78, "reasoning_note": "Kuwait’s text clearly grants data subjects a right to correct personal data and obliges providers to enable correction and receive correction requests. However, none of the cited provisions imposes a timeliness standard for carrying out rectification. The 24/7 intake clause in Article 5(9) does not equate to ‘without undue delay,’ so the reviewer’s objection is valid.", "label": "C4", "ru_id": "RU-140", "gdpr_article": 16, "jurisdiction": "KWT", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 1, "total": 1}, {"round": 2, "n_queries": 4, "new": 3, "total": 4}, {"round": 3, "n_queries": 4, "new": 0, "total": 4}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's claim that the slot 'without undue delay' is uncovered is potentially unsupported.", "counter_evidence": [{"id": "a418980931b429c7909a", "span": "within 24 hours", "why": "This provision implies a requirement for prompt action, potentially covering the concept of 'without undue delay'."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The KWT legislation does not explicitly provide for the rectification of inaccurate personal data 'without undue delay' as required by the GDPR.", "counter_evidence": [{"id": "9f3112d28a1b850ba61f", "span": "Article 4(6)", "why": "Does not explicitly state rectification must be done without undue delay."}, {"id": "2c020ba48e817e4f4c7a", "span": "Article 5(9)", "why": "Refers to 24/7 handling of correction requests, not the rectification timeline itself."}], "confidence": 0.8}], "n_candidates": 4, "candidate_ids": ["2c020ba48e817e4f4c7a", "a418980931b429c7909a", "b983a5ed0e1c7a2b779a", "9f3112d28a1b850ba61f"], "n_llm_calls": 7, "latency_s": 562.0, "temperature": 0.7, "seed": 20260801, "id": "a1a643780a0965922e0a", "condition": "stability", "rep": 0}
{"candidates_selected": ["8cd7b777aa3cd8ca5f1f", "d962cad99243b9952541", "b334fb41dcb796c50b6b"], "candidates_excluded": [{"id": "601ddc5fd8dcb81306cb", "reason": "General governance of the Board; does not confer or mention administrative fines."}, {"id": "129b122a7d0386567e65", "reason": "Executive management powers; no sanctioning power to impose administrative fines."}, {"id": "762372b7329c44286e43", "reason": "Lawful-basis conditions for processing; not about supervisory authority sanctions."}, {"id": "3d71a23a91370cadf799", "reason": "Special category on criminal data; no relevance to SA fining powers."}, {"id": "f8344697d1f1dc661161", "reason": "Sensitive data processing conditions; not about SA fining powers."}, {"id": "5bd7541a2690632a7c77", "reason": "Consent requirements; not about SA enforcement or fines."}, {"id": "74358e437cd9e85fdabb", "reason": "Data Protection Officer provisions; not about SA fining powers."}, {"id": "1d8fd3d4070b1ff36d68", "reason": "Notification to the authority; not about sanctions or fines."}, {"id": "10e6e0e9f2f36b4c7b42", "reason": "Public registers; no supervisory fining power."}], "target_frame": {"addressee": {"span": "تتولى الهيئة مباشرة كافة المهام والصلاحيات اللازمة لحماية البيانات الشخصية", "article": "Article 30"}, "modality": {"span": "ولها في سبيل ذلك القيام بوجه خاص بما يلي:", "article": "Article 30"}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": "يُصدِر مجلس الإدارة قراراً مسبَّباً بِحفظ التحقيق، أو بعدم ثبوت وقوع المخالفة التي تم التحقيق بشأنها في حق مدير البيانات، أو باتخاذ أيٍّ من التدابير المنصوص عليها في المادة (55) من هذا القانون عند ثبوت المخالفة", "article": "Article 54"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "supervisory authority", "target_value": "الهيئة (the Authority) as the data protection supervisory body", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30", "slot": "addressee"}, {"gdpr_value": "power", "target_value": "Authority endowed with powers to act; may issue decisions in certain cases", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30; Article 56", "slot": "modality"}, {"gdpr_value": "impose an administrative fine", "target_value": "No textual power to levy monetary administrative fines", "basis": "absent", "verdict": "uncovered", "citation": "", "slot": "action"}, {"gdpr_value": "pursuant to Article 83, in addition to or instead of the measures referred to in paragraph 2", "target_value": "Text only refers to taking “measures” (Article 55 referenced) and urgent suspension/blocking; no fines or relationship to other measures stated", "basis": "absent", "verdict": "uncovered", "citation": "Article 54; Article 56", "slot": "scope"}, {"gdpr_value": "depending on the circumstances of each individual case", "target_value": "Reasoned decision after investigation; measures may be taken “عند ثبوت المخالفة” and urgent orders under defined thresholds", "basis": "conceptual", "verdict": "covered", "citation": "Article 54; Article 56", "slot": "condition"}, {"gdpr_value": "None", "target_value": "No exceptions stated regarding an SA fining power", "basis": "absent", "verdict": "covered", "citation": "", "slot": "exception"}, {"gdpr_value": "None", "target_value": "No temporal qualifier on a fining power", "basis": "absent", "verdict": "covered", "citation": "", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "No consequence clause tied to a fining power", "basis": "absent", "verdict": "covered", "citation": "", "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.61, "reasoning_note": "Articles 54 and 56 provide investigative and injunctive measures (e.g., suspension/blocking), but there is no text empowering the Authority to impose monetary administrative fines. Injunctive measures are not functionally equivalent to administrative fines. Without an express fining power in the provided provisions, the GDPR fining requirement remains uncovered.", "label": "C2", "ru_id": "RU-147", "gdpr_article": 17, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 11, "total": 23}, {"round": 3, "n_queries": 4, "new": 8, "total": 31}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The BHR law does not explicitly mention 'غرامات إدارية' (administrative fines) as a measure to be taken by the supervisory authority.", "counter_evidence": [{"id": "Article 54", "span": "اتخاذ تدابير إدارية (مثل الوقف أو الحجب المؤقت)", "why": "This article mentions administrative measures, but does not explicitly mention administrative fines."}, {"id": "Article 56", "span": "الوقف المؤقت عن معالجة البيانات كلياً أو جزئياً", "why": "This article mentions temporary measures to protect data, but does not explicitly mention administrative fines."}, {"id": "Article 30", "span": "تسلُّم الإخطارات والنظر فيها وِفقاً لحكم المادة (14) من هذا القانون", "why": "This article mentions investigation and enforcement, but does not explicitly mention administrative fines."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The provisions collectively provide the authority with enforcement powers that could be considered a counterpart to administrative fines, albeit not explicitly stated as such.", "counter_evidence": [{"id": "Article 54", "span": "يتولى الرئيس التنفيذي عَرْض التقرير مشفوعاً برأيه، على مجلس الإدارة، في أول جلسة تالية لانقضاء الآجال المنصوص عليها في الفقرة الثانية من المادة (53) من هذا القانون.", "why": "Indicates the President's role in presenting reports and the council's decision-making power, suggesting a mechanism for addressing violations."}, {"id": "Article 56", "span": "يجوز للرئيس التنفيذي في الحالات المُستعجَلة وبناءً على طلب صاحب الشأن، إذا قامت لديه أمارات قوية تدعو إلى الظن بأن الاستمرار في معالجة البيانات على نحو معيَّن من شأنه أنْ يؤدي إلى تعدٍّ محدَّد وجلي على حقوق وحريات مقدِّم الطلب المقرَّرة قانوناً مما يتعذَّر تداركه فيما بعد، أنْ يُصدِر قراراً مسبَّباً بما يلي:", "why": "Shows the authority's power to take immediate action in urgent cases, potentially including measures against data processing violations."}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["601ddc5fd8dcb81306cb", "129b122a7d0386567e65", "762372b7329c44286e43", "3d71a23a91370cadf799", "f8344697d1f1dc661161", "5bd7541a2690632a7c77", "74358e437cd9e85fdabb", "d962cad99243b9952541", "1d8fd3d4070b1ff36d68", "10e6e0e9f2f36b4c7b42", "8cd7b777aa3cd8ca5f1f", "b334fb41dcb796c50b6b"], "n_llm_calls": 7, "latency_s": 553.82, "temperature": 0.7, "seed": 20260801, "id": "ccf8c115977edbaf774a", "condition": "stability", "rep": 0}
{"candidates_selected": ["192caaa530952a30ad50"], "candidates_excluded": [{"id": "85d05fccf5b4f57eceaf", "reason": "Obligations on controllers regarding fair, lawful processing and safeguards; no supervisory authority cooperation or international enforcement elements."}, {"id": "6c76988b817262e3e312", "reason": "Controller internal governance and training duties; no supervisory authority role in international cooperation or enforcement."}, {"id": "fcbd13532c69b340214e", "reason": "Controller/processor security safeguards; unrelated to supervisory authority cooperation or international enforcement."}, {"id": "75db9db720e9e34a1148", "reason": "Controller duties when disclosing/transferring to processors; not about supervisory authority cooperation."}, {"id": "07962910da55dbce48d3", "reason": "Restriction on controllers limiting cross-border data flows; does not impose duties on supervisory authorities nor establish cooperation mechanisms."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "Public authority exemptions for national interests; no provision on international cooperation for data protection enforcement."}, {"id": "f5c366135483fe580381", "reason": "Breach notification to individuals and competent department by controllers; not about building international cooperation mechanisms."}, {"id": "455aae046cacf7979576", "reason": "Data quality and retention obligations on controllers; unrelated to supervisory authority cooperation."}, {"id": "89d1bb9a58e65b732117", "reason": "Controller transparency duties; no supervisory authority cooperation or international aspect."}, {"id": "83fae53ff99059f02f05", "reason": "Generic mandate for competent authorities to implement the law; no specific duty to develop international cooperation mechanisms."}, {"id": "850decaffbbae78d371d", "reason": "Controller exemptions in specified cases; no supervisory authority cooperation or international enforcement mechanisms."}], "target_frame": {"addressee": {"span": "للإدارة المختصة، في سبيل تطبيق وتنفيذ أحكام هذا القانون، أن تتخذ جميع الإجراءات اللازمة لذلك", "article": "Article 27"}, "modality": {"span": "للإدارة المختصة ... أن تتخذ جميع الإجراءات اللازمة", "article": "Article 27"}, "action": {"span": "التنسيق مع أي مجموعة أو رابطة مهنية وأي رابطة أخرى تمثل المراقبين أو مشغلي مواقع الإنترنت، وذلك بهدف تشجيع وتطوير التنظيم الذاتي، ونشر الوعي بهذا القانون، وتطوير برامج التدريب والتعليم", "article": "Article 27(1)"}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "supervisory authorities", "target_value": "الإدارة المختصة", "basis": "conceptual", "verdict": "covered", "citation": "Article 27: \"للإدارة المختصة، في سبيل تطبيق وتنفيذ أحكام هذا القانون، أن تتخذ جميع الإجراءات اللازمة لذلك\"", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "permission/power (\"للإدارة المختصة ... أن تتخذ\")", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 27: \"للإدارة المختصة ... أن تتخذ جميع الإجراءات اللازمة\"", "slot": "modality"}, {"gdpr_value": "take appropriate steps to develop international cooperation mechanisms to facilitate the effective enforcement of data protection legislation", "target_value": "coordinate with groups/associations representing controllers or website operators to encourage self-regulation, awareness, and training", "basis": "direct_textual", "verdict": "uncovered", "citation": "Article 27(1): \"التنسيق مع أي مجموعة أو رابطة مهنية ... بهدف تشجيع وتطوير التنظيم الذاتي، ونشر الوعي ... وتطوير برامج التدريب والتعليم\"", "slot": "action"}, {"gdpr_value": "in relation to third countries and international organisations", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.66, "reasoning_note": "The only relevant text (Article 27) gives the competent department a permissive power to coordinate with groups for self-regulation, awareness, and training; it neither mandates developing cooperation mechanisms nor addresses international or enforcement cooperation. Article 15 concerns controller behavior on cross-border flows, not supervisory-authority cooperation. Thus, any indirect support is too attenuated to meet the GDPR proposition.", "label": "C3", "ru_id": "RU-607", "gdpr_article": 50, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 4, "total": 16}, {"round": 3, "n_queries": 4, "new": 0, "total": 16}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The Qatari law provides some basis for international cooperation and consideration of third countries and international organizations, although it may not be explicitly stated.", "counter_evidence": [{"id": "192caaa530952a30ad50", "span": "للإدارة المختصة، في سبيل تطبيق وتنفيذ أحكام هذا القانون، أن تتخذ جميع الإجراءات اللازمة لذلك، وبوجه خاص ما يلي: 1- التنسيق مع أي مجموعة أو رابطة مهنية وأي رابطة أخرى تمثل المراقبين أو مشغلي مواقع الإنترنت", "why": "This provision implies a potential for international cooperation."}, {"id": "f5c366135483fe580381", "span": "للجهة المختصة أن تقرر معالجة بعض البيانات الشخصية دون التقيد بأحكام المواد (4)، (9)، (15)، (17) من هذا القانون، وذلك لتحقيق أي من الأغراض الآتية: 1- حماية الأمن الوطني والأمن العام. 2- حماية العلاقات الدولية للدولة", "why": "This provision suggests that the competent authority has the power to process personal data for the purpose of protecting national security and international relations."}], "confidence": 0.8}, {"verdict": "revise", "objection": "Potential for indirect support of international cooperation mechanisms, but lack of explicit alignment with GDPR proposition.", "counter_evidence": [{"id": "Article 15", "span": "يُحظر على المراقب اتخاذ أي قرار أو إجراء من شأنه الحد من تدفق البيانات الشخصية عبر الحدود", "why": "Implies consideration for international data transfer, potentially relating to cooperation with third countries or international organisations."}, {"id": "Article 27", "span": "التنسيق مع أي مجموعة أو رابطة مهنية وأي رابطة أخرى تمثل المراقبين أو مشغلي مواقع الإنترنت", "why": "Could be seen as initial steps towards broader international cooperation, especially if such groups have international ties."}], "confidence": 0.6}], "n_candidates": 12, "candidate_ids": ["85d05fccf5b4f57eceaf", "6c76988b817262e3e312", "192caaa530952a30ad50", "fcbd13532c69b340214e", "75db9db720e9e34a1148", "07962910da55dbce48d3", "3f5cc5a2c4af5fb90388", "f5c366135483fe580381", "455aae046cacf7979576", "89d1bb9a58e65b732117", "83fae53ff99059f02f05", "850decaffbbae78d371d"], "n_llm_calls": 7, "latency_s": 544.68, "temperature": 0.7, "seed": 20260801, "id": "b9a250df687d7b197bb3", "condition": "stability", "rep": 0}
{"candidates_selected": ["74358e437cd9e85fdabb"], "candidates_excluded": [{"id": "762372b7329c44286e43", "reason": "General lawful-processing conditions; no provision on DPO designation or triggers."}, {"id": "3d71a23a91370cadf799", "reason": "Rules on criminal proceedings data; does not address DPO designation."}, {"id": "2ef716a5a0437defc8f2", "reason": "Cross-border transfer exceptions; no DPO designation obligation."}, {"id": "b334fb41dcb796c50b6b", "reason": "Urgent measures by the CEO; unrelated to DPO designation."}, {"id": "5a79146e04b73c99685c", "reason": "Data subject right to be informed; no DPO designation content."}, {"id": "5bd7541a2690632a7c77", "reason": "Consent requirements; no DPO designation content."}, {"id": "1d8fd3d4070b1ff36d68", "reason": "Notification to the authority; merely references cases where a DPO is appointed but does not impose or trigger designation."}, {"id": "8cd7b777aa3cd8ca5f1f", "reason": "Supervisory authority tasks (including DPO accreditation); does not mandate designation."}, {"id": "231a37f671238dbf7112", "reason": "Definitions of internal/external DPO; no operative obligation to designate."}, {"id": "6b500d26673394f3d7e6", "reason": "Rights to rectification/blocking/erasure; unrelated to DPO designation."}, {"id": "6a403e591ecc2a5638fc", "reason": "Disciplinary referral of a DPO; does not govern when one must be designated."}], "target_frame": {"addressee": {"span": "مدير البيانات", "article": "Article 10(4)"}, "modality": {"span": "يجوز لمدير البيانات أن يعيِّن مراقباً لحماية البيانات، ومع ذلك يجوز لمجلس الإدارة أن يُلزِم بموجبه فئات معينة من مدراء البيانات بأن يعيِّنوا مراقباً لحماية البيانات.", "article": "Article 10(4)"}, "action": {"span": "يعيِّن مراقباً لحماية البيانات", "article": "Article 10(4)"}, "scope": {"span": null, "article": null}, "condition": {"span": "يجوز لمجلس الإدارة أن يُلزِم بموجبه فئات معينة من مدراء البيانات بأن يعيِّنوا مراقباً لحماية البيانات", "article": "Article 10(4)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "processor", "target": "مدير البيانات (controller), not the processor", "basis": "direct_textual", "verdict": "uncovered", "citation": "Article 10(4)", "slot": "addressee"}, {"gdpr": "obligation", "target": "Permission to appoint; a mandate may apply only if the Board issues a decision for certain controller categories", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 10(4)", "slot": "modality"}, {"gdpr": "designate a data protection officer", "target": "تعيين مراقب حماية البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 10(4)", "slot": "action"}, {"gdpr": "None", "target": "None stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "scope"}, {"gdpr": "Any of Art. 37(1)(a)–(c) triggers (public authority; large-scale regular/systematic monitoring; large-scale special/criminal data)", "target": "Obligation arises only if the Board mandates certain controller categories; no enumerated activity-based triggers", "basis": "direct_textual", "verdict": "uncovered", "citation": "Article 10(4)", "slot": "condition"}, {"gdpr": "Courts acting in their judicial capacity are excluded from point (a)", "target": "No such exception stated", "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "exception"}, {"gdpr": "None", "target": "No time frame for designation stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": "None stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.78, "reasoning_note": "Article 10(4) makes DPO appointment optional for controllers and allows the Board to require it for certain controller categories; it does not impose an absolute obligation tied to GDPR-style triggers and does not address processors at all. The reviewer’s counter-evidence is correct: the text uses ‘يجوز’ and conditions any obligation on a Board decision. No court exception or activity-based triggers appear in the target text.", "label": "C3", "ru_id": "RU-431", "gdpr_article": 37, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 5, "total": 30}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provisions suggest that the controller is responsible for appointing a data protection officer, but they do not explicitly exclude the processor from this responsibility. Additionally, the provisions imply that public authorities, including courts, may be exempt from certain requirements.", "counter_evidence": [{"id": "Article 10", "span": "مراقب حماية البيانات", "why": "The data protection officer is responsible for assisting the controller in fulfilling their obligations under the law."}, {"id": "Article 14", "span": "مدير البيانات", "why": "The controller must notify the authority before starting the processing operation."}, {"id": "Article 7", "span": "المعالجة التي تتم من قبل أي جهة عامة", "why": "Public authorities, including courts, may be exempt from certain requirements."}], "confidence": 0.7}, {"verdict": "revise", "objection": "The provision does not fully support the claim of an absolute obligation to designate a data protection officer", "counter_evidence": [{"id": "74358e437cd9e85fdabb", "span": "يجوز لمجلس الإدارة أن يُلزِم فئات معينة من مدراء البيانات أن يعيِّنوا مراقباً لحماية البيانات", "why": "The provision suggests that the obligation to designate a data protection officer is dependent on the decision of the Board of Directors"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["762372b7329c44286e43", "3d71a23a91370cadf799", "2ef716a5a0437defc8f2", "b334fb41dcb796c50b6b", "5a79146e04b73c99685c", "5bd7541a2690632a7c77", "1d8fd3d4070b1ff36d68", "8cd7b777aa3cd8ca5f1f", "231a37f671238dbf7112", "6b500d26673394f3d7e6", "74358e437cd9e85fdabb", "6a403e591ecc2a5638fc"], "n_llm_calls": 7, "latency_s": 577.82, "temperature": 0.7, "seed": 20260801, "id": "fc5676c0d8af4024507f", "condition": "stability", "rep": 0}
{"candidates_selected": ["a3c79315ae2d7920a38f", "8cd7b777aa3cd8ca5f1f"], "candidates_excluded": [{"id": "98fa9fe9b0650c71a971", "reason": "Addresses right to object to direct marketing to the data controller, not lodging complaints with the supervisory authority."}, {"id": "762372b7329c44286e43", "reason": "Sets general lawful bases for processing; does not concern the right to lodge a complaint."}, {"id": "c9145cc9a91d8ff7530c", "reason": "Concerns liability of data protection officers; not about data subject complaints."}, {"id": "6b500d26673394f3d7e6", "reason": "Provides rectification/blocking/erasure rights vis-à-vis the data controller, not complaint to the authority."}, {"id": "6a403e591ecc2a5638fc", "reason": "Concerns investigation of DPO misconduct; not about complaint rights of data subjects."}, {"id": "701e535e6a5af8ac9fff", "reason": "Sets corporate criminal liability; not about complaint procedures or rights."}, {"id": "231a37f671238dbf7112", "reason": "Definitions for a decision; no operative rule on lodging complaints."}, {"id": "f8344697d1f1dc661161", "reason": "Conditions for processing sensitive data; unrelated to complaint rights."}, {"id": "eb633917dcbabe34df47", "reason": "Right regarding automated decision-making; not a complaint to the supervisory authority."}, {"id": "74358e437cd9e85fdabb", "reason": "DPO functions; does not grant data subjects a right to lodge complaints with the authority."}], "target_frame": {"addressee": {"span": "لكل صاحب مصلحة أو صفة", "article": "Article 25"}, "modality": {"span": "لكل صاحب مصلحة أو صفة أن", "article": "Article 25"}, "action": {"span": "أن يتقدم إلى الهيئة بشكوى", "article": "Article 25"}, "scope": {"span": "إلى الهيئة", "article": "Article 25"}, "condition": {"span": "إذا كان لديه ما يحمله على الاعتقاد بوقوع أية مخالفة لأحكام هذا القانون أو بأن شخصاً ما يقوم بمعالجة بيانات شخصية بالمخالفة لأحكامه", "article": "Article 25"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "every data subject", "target": "كل صاحب مصلحة أو صفة", "basis": "direct_textual", "verdict": "broader", "citation": "Article 25: \"لكل صاحب مصلحة أو صفة\"", "slot": "addressee"}, {"gdpr": "right", "target": "صيغة الإباحة/الحق: \"لكل ... أن\"", "basis": "direct_textual", "verdict": "covered", "citation": "Article 25: \"لكل صاحب مصلحة أو صفة أن\"", "slot": "modality"}, {"gdpr": "lodge a complaint with a supervisory authority", "target": "يتقدم إلى الهيئة بشكوى", "basis": "direct_textual", "verdict": "covered", "citation": "Article 25: \"أن يتقدم إلى الهيئة بشكوى\"", "slot": "action"}, {"gdpr": "in particular in the Member State of habitual residence, place of work, or place of the alleged infringement", "target": "مجرد التوجّه إلى \"الهيئة\" دون تحديد مواقع بديلة", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 25: \"إلى الهيئة\"; Article 30(8): \"تلقِّي البلاغات والشكاوى...\"", "slot": "scope"}, {"gdpr": "if the data subject considers that the processing of personal data relating to him or her infringes this Regulation", "target": "إذا كان لديه سبب للاعتقاد بوقوع مخالفة لأحكام هذا القانون أو بمعالجة بالمخالفة لأحكامه", "basis": "direct_textual", "verdict": "covered", "citation": "Article 25: \"إذا كان لديه ما يحمله على الاعتقاد بوقوع أية مخالفة... أو بأن شخصاً ما يقوم بمعالجة بيانات شخصية بالمخالفة لأحكامه\"", "slot": "condition"}, {"gdpr": "None", "target": "None stated", "basis": "absent", "verdict": "covered", "citation": "", "slot": "exception"}, {"gdpr": "None", "target": "No temporal limits stated for lodging the complaint", "basis": "absent", "verdict": "covered", "citation": "", "slot": "temporal"}, {"gdpr": "None", "target": "No consequence specified upon lodging the complaint", "basis": "absent", "verdict": "covered", "citation": "", "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.74, "reasoning_note": "Article 25 grants a right to complain to the national Authority and sets a complaint-trigger condition closely mirroring GDPR Art. 77. However, it does not replicate the GDPR’s location-specific options (habitual residence, place of work, or infringement), so the scope is narrower as to forum choice.", "label": "C4", "ru_id": "RU-907", "gdpr_article": 77, "jurisdiction": "BHR", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 11, "total": 23}, {"round": 3, "n_queries": 4, "new": 10, "total": 33}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "The BHR provisions do not fully align with the GDPR requirement unit [RU-907] regarding the scope of the complaint submission.", "counter_evidence": [{"id": "a3c79315ae2d7920a38f", "span": "تقديم الشكوى لكل صاحب مصلحة أو صفة أن يتقدم إلى الهيئة بشكوى", "why": "Article 25 does not explicitly mention the right to lodge a complaint with a supervisory authority in the place of habitual residence, place of work, or the place of the alleged infringement."}, {"id": "98fa9fe9b0650c71a971", "span": "", "why": "No relevant information found in Article 19."}, {"id": "762372b7329c44286e43", "span": "", "why": "No relevant information found in Article 4."}, {"id": "6b500d26673394f3d7e6", "span": "", "why": "No relevant information found in Article 23."}, {"id": "8cd7b777aa3cd8ca5f1f", "span": "تلقِّي البلاغات والشكاوى المتعلقة بمخالفة أحكام هذا القانون وفحصها والوقوف على مدى جديتها", "why": "Article 30 mentions the Authority's tasks and powers, including receiving complaints and investigating them, but does not provide the same level of specificity as the GDPR requirement unit regarding the location of the supervisory authority."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["a3c79315ae2d7920a38f", "98fa9fe9b0650c71a971", "762372b7329c44286e43", "c9145cc9a91d8ff7530c", "6b500d26673394f3d7e6", "6a403e591ecc2a5638fc", "701e535e6a5af8ac9fff", "231a37f671238dbf7112", "f8344697d1f1dc661161", "8cd7b777aa3cd8ca5f1f", "eb633917dcbabe34df47", "74358e437cd9e85fdabb"], "n_llm_calls": 6, "latency_s": 493.23, "temperature": 0.7, "seed": 20260801, "id": "256770c0c68385277eb4", "condition": "stability", "rep": 0}
{"candidates_selected": ["295bad3524a8fa35d18c", "06b918a4049719ed530f"], "candidates_excluded": [{"id": "c95a0b593cc554df0eae", "reason": "Record-keeping duties; does not address territorial or extraterritorial applicability."}, {"id": "593beb6b1fe15a8fda31", "reason": "Controller–processor contracting; not about scope of application to foreign entities."}, {"id": "33d22a1a65039b5be3f9", "reason": "Definitions; no rule on territorial scope."}, {"id": "fb0cfd03e454392db4cc", "reason": "Legal basis (legitimate interest); not territorial scope."}, {"id": "ea8306cd18f9261f6413", "reason": "Transparency at collection; not territorial scope."}, {"id": "c511c9bf7779067e64f4", "reason": "Purpose limitation and exceptions; not territorial scope of the law."}, {"id": "78ae2c40eaf4fb3870fc", "reason": "Processor selection by controllers; not territorial scope."}, {"id": "0922609ffbfd96a70f90", "reason": "Right to erasure; not territorial scope."}, {"id": "f8c6dae3f69fbe207307", "reason": "Disclosure conditions; not territorial scope."}, {"id": "ce107f77eb9119ba01b0", "reason": "Privacy policy content; not territorial scope."}], "target_frame": {"addressee": {"span": "من أي جهة خارج المملكة", "article": "Article 2(1)"}, "modality": {"span": "يطبق النظام على أي عملية معالجة لبيانات شخصية...", "article": "Article 2(1)"}, "action": {"span": "بالتزاماتها المقررة بموجب أحكام النظام واللوائح", "article": "Article 33(4)"}, "scope": {"span": "معالجة البيانات الشخصية المتعلقة بالأفراد المقيمين في المملكة", "article": "Article 2(1)"}, "condition": {"span": "عند معالجتها لبيانات شخصية متعلقة بالأفراد المقيمين في المملكة بأي وسيلة كانت", "article": "Article 33(4)"}, "exception": {"span": "يستثنى من نطاق تطبيق النظام، قيام الفرد بمعالجة البيانات الشخصية لأغراض لا تتجاوز الاستخدام الشخصي أو العائلي، مادام أنه لم ينشرها أو يفصح عنها للغير.", "article": "Article 2(2)"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller or processor not established in the Union", "target_value": "من أي جهة خارج المملكة", "basis": "direct_textual", "verdict": "broader", "citation": "Article 2(1)", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "يطبق النظام ... / بالتزاماتها المقررة بموجب أحكام النظام واللوائح", "basis": "distributed", "verdict": "covered", "citation": "Article 2(1); Article 33(4)", "slot": "modality"}, {"gdpr_value": "comply with this Regulation for the processing of personal data", "target_value": "التزاماتها المقررة بموجب أحكام النظام واللوائح (مع تطبيق النظام على المعالجة)", "basis": "distributed", "verdict": "covered", "citation": "Article 2(1); Article 33(4)", "slot": "action"}, {"gdpr_value": "processing of personal data of data subjects who are in the Union", "target_value": "معالجة البيانات الشخصية المتعلقة بالأفراد المقيمين في المملكة", "basis": "direct_textual", "verdict": "partial", "citation": "Article 2(1)", "slot": "scope"}, {"gdpr_value": "processing relates to offering goods or services to such data subjects (whether or not payment is required)", "target_value": "عند معالجتها لبيانات شخصية متعلقة بالأفراد المقيمين في المملكة بأي وسيلة كانت (لا يشترط عرض سلع/خدمات)", "basis": "direct_textual", "verdict": "broader", "citation": "Article 33(4); Article 2(1)", "slot": "condition"}, {"gdpr_value": "None", "target_value": "يستثنى ... الاستخدام الشخصي أو العائلي ... مادام أنه لم ينشرها أو يفصح عنها للغير", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 2(2)", "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.83, "reasoning_note": "KSA PDPL expressly applies to processing of personal data relating to individuals residing in the Kingdom by any entity outside the Kingdom, implying foreign entities must comply. This trigger is not limited to offering goods or services and is residence-based rather than presence-based, so it diverges from GDPR Art. 3(2)(a). An additional personal/household-use exception exists under KSA law.", "label": "C4", "ru_id": "RU-009", "gdpr_article": 3, "jurisdiction": "KSA", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 3, "total": 28}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["c95a0b593cc554df0eae", "593beb6b1fe15a8fda31", "33d22a1a65039b5be3f9", "fb0cfd03e454392db4cc", "ea8306cd18f9261f6413", "c511c9bf7779067e64f4", "06b918a4049719ed530f", "78ae2c40eaf4fb3870fc", "0922609ffbfd96a70f90", "ce107f77eb9119ba01b0", "295bad3524a8fa35d18c", "f8c6dae3f69fbe207307"], "n_llm_calls": 4, "latency_s": 344.99, "temperature": 0.7, "seed": 20260801, "id": "e9bb95931c15ea719b03", "condition": "stability", "rep": 0}
{"candidates_selected": ["2712fe4ebdba355a134b"], "candidates_excluded": [{"id": "a3d16e47b198e1ecb3c6", "reason": "Sets conditions and form for consent but does not impose a duty to demonstrate/prove that consent was obtained."}, {"id": "99880e0b77b8d2601779", "reason": "Children’s consent regime; addresses who must consent and identity verification, not the controller’s burden to demonstrate consent generally."}, {"id": "4ddc7494f19d84324dd8", "reason": "Data subject access to a copy of personal data; unrelated to demonstrating consent."}, {"id": "26ab9db083b17ff619f2", "reason": "Marketing-specific consent requirement; does not establish the general obligation to demonstrate consent."}, {"id": "a37f6f979ece2e1de6bf", "reason": "Cooperation with the ministry; no rule about demonstrating consent."}, {"id": "05b7537a91d92a0529ad", "reason": "DPO appointment; unrelated to demonstrating consent."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Privacy policy content; does not require demonstrating consent."}, {"id": "5483caf68765f09059fb", "reason": "Record-keeping for processing operations in general; does not specifically require proof of consent."}, {"id": "a0a0194dd91481c29c6e", "reason": "Internal controls for processing; no obligation to demonstrate consent."}, {"id": "d0bb19cb0c67952144b4", "reason": "Data portability; irrelevant to demonstrating consent."}, {"id": "db1b46495b01511abeef", "reason": "DPO duties; no rule about demonstrating consent."}], "target_frame": {"addressee": {"span": "المتحكم", "article": "Article 10"}, "modality": {"span": "يلتزم", "article": "Article 10"}, "action": {"span": "إثبات الموافقة الكتابية لصاحب البيانات الشخصية لمعالجة بياناته", "article": "Article 10"}, "scope": {"span": "معالجة البيانات الشخصية", "article": "Article 10"}, "condition": {"span": "لا يجوز معالجة البيانات الشخصية ... وبعد الموافقة الصريحة لصاحب البيانات الشخصية على ذلك", "article": "Article 10"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "المتحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 10 (2712fe4ebdba355a134b)", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "يلتزم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 10 (2712fe4ebdba355a134b)", "slot": "modality"}, {"gdpr_value": "be able to demonstrate that the data subject has consented to the processing of their personal data", "target_value": "إثبات الموافقة الكتابية لصاحب البيانات الشخصية لمعالجة بياناته", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 10 (2712fe4ebdba355a134b)", "slot": "action"}, {"gdpr_value": "processing of personal data based on consent", "target_value": "معالجة البيانات الشخصية", "basis": "direct_textual", "verdict": "broader", "citation": "Article 10 (2712fe4ebdba355a134b)", "slot": "scope"}, {"gdpr_value": "Where processing is based on consent", "target_value": "بعد الموافقة الصريحة لصاحب البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 10 (2712fe4ebdba355a134b)", "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "covered", "confidence": 0.71, "reasoning_note": "Article 10 expressly obliges the controller to prove the data subject’s written consent to processing, which functionally satisfies the GDPR requirement to be able to demonstrate consent. The same article conditions processing on the data subject’s explicit consent (“لا يجوز … وبعد الموافقة الصريحة…”), covering the ‘where processing is based on consent’ trigger. The target rule is narrower as to evidence (written consent) but overall meets RU-017.", "label": "C4", "ru_id": "RU-017", "gdpr_article": 7, "jurisdiction": "OMN", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 5, "total": 30}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's slot verdict for the 'action' slot is unsupported by the citation", "counter_evidence": [{"id": "2712fe4ebdba355a134b", "span": "إثبات الموافقة الكتابية لصاحب البيانات الشخصية لمعالجة بياناته", "why": "The provision only mentions demonstrating written consent, which may not necessarily imply that the controller must be able to demonstrate the data subject's consent to the processing of their data"}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's reasoning contains defects, and the OMN provisions do not fully support the verdict.", "counter_evidence": [{"id": "2712fe4ebdba355a134b", "span": "يلتزم المتحكم بإثبات الموافقة الكتابية لصاحب البيانات الشخصية لمعالجة بياناته", "why": "The provision requires the controller to prove the written consent of the data subject, but it does not explicitly state that the controller must be able to demonstrate that the data subject has consented to the processing of their personal data."}, {"id": "2712fe4ebdba355a134b", "span": "لا يجوز معالجة البيانات الشخصية إلا في إطار الشفافية والأمانة، واحترام كرامة الإنسان، وبعد الموافقة الصريحة لصاحب البيانات الشخصية على ذلك", "why": "The provision requires that personal data may not be processed except in a transparent and honest manner, with respect for human dignity, and after the explicit consent of the data subject, but it does not explicitly state that the processing is based on consent."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["a3d16e47b198e1ecb3c6", "99880e0b77b8d2601779", "4ddc7494f19d84324dd8", "26ab9db083b17ff619f2", "2712fe4ebdba355a134b", "a37f6f979ece2e1de6bf", "05b7537a91d92a0529ad", "bb26cffae1f1c0beb85d", "5483caf68765f09059fb", "a0a0194dd91481c29c6e", "d0bb19cb0c67952144b4", "db1b46495b01511abeef"], "n_llm_calls": 7, "latency_s": 533.43, "temperature": 0.7, "seed": 20260801, "id": "575adb4899b5a363861f", "condition": "stability", "rep": 0}
{"candidates_selected": ["850decaffbbae78d371d"], "candidates_excluded": [{"id": "3f5cc5a2c4af5fb90388", "reason": "Creates exemptions for national security/public order/international relations/economic interests/crime, not for journalistic or academic/artistic/literary expression or freedom of expression."}, {"id": "6c76988b817262e3e312", "reason": "Controller governance duties; no exemptions or balancing for expression-related processing."}, {"id": "85d05fccf5b4f57eceaf", "reason": "General controller obligations; no expression-related derogations."}, {"id": "fcbd13532c69b340214e", "reason": "Security safeguards; no exemptions for journalism/academic/artistic/literary expression."}, {"id": "75852a697f66691bfbfb", "reason": "Narrow exemption from Art. 6 (access) to protect third-party interests; not tied to expression or information freedoms."}, {"id": "f5c366135483fe580381", "reason": "Breach notification; no expression-related exemptions."}, {"id": "07962910da55dbce48d3", "reason": "Cross-border data flow rule; no expression-related exemptions."}, {"id": "2bcce9feda2fcb9d35fe", "reason": "Statement of right to privacy; does not establish exemptions for expression."}, {"id": "dce663972f2d5e58176e", "reason": "Scope/exclusions (household use, official statistics); not journalism/academic/artistic/literary expression."}, {"id": "fca1aa50445ca4475333", "reason": "Individual rights; no expression-based derogations."}, {"id": "85e94dba24cbfb8955cd", "reason": "Access rights; no expression-based derogations."}], "target_frame": {"addressee": {"span": "يُعفى المراقب", "article": "Article 19"}, "modality": {"span": "يُعفى", "article": "Article 19"}, "action": {"span": "يُعفى المراقب من الالتزام بأحكام المواد (4)، (5/البنود 1، 2، 3)، (6)", "article": "Article 19"}, "scope": {"span": "تحقيق أغراض البحث العلمي الذي يجرى للمصلحة العامة", "article": "Article 19"}, "condition": {"span": "في أي من الحالات الآتية: ... 4- تحقيق أغراض البحث العلمي الذي يجرى للمصلحة العامة.", "article": "Article 19"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": "يُعفى المراقب من الالتزام بأحكام المواد (4)، (5/البنود 1، 2، 3)، (6) ...", "article": "Article 19"}}, "slot_verdicts": [{"gdpr": "Member States", "target": "المراقب (controller)", "basis": "direct_textual", "verdict": "uncovered", "citation": "[850decaffbbae78d371d] Article 19", "slot": "addressee"}, {"gdpr": "obligation", "target": "Statutory exemption is established (\"يُعفى\")", "basis": "direct_textual", "verdict": "covered", "citation": "[850decaffbbae78d371d] Article 19", "slot": "modality"}, {"gdpr": "Provide for exemptions or derogations from Chapters II, III, IV, V, VI, VII and IX", "target": "Exempts from Articles (4), (5/items 1–3), (6) in specified cases", "basis": "direct_textual", "verdict": "narrower", "citation": "[850decaffbbae78d371d] Article 19", "slot": "action"}, {"gdpr": "Processing for journalistic purposes or for academic, artistic or literary expression", "target": "Processing to achieve purposes of scientific research conducted for the public interest", "basis": "direct_textual", "verdict": "narrower", "citation": "[850decaffbbae78d371d] Article 19(4)", "slot": "scope"}, {"gdpr": "If necessary to reconcile data protection with freedom of expression and information", "target": "No explicit balancing with freedom of expression/information; condition is that processing serves public-interest scientific research", "basis": "absent", "verdict": "uncovered", "citation": "[850decaffbbae78d371d] Article 19(4)", "slot": "condition"}, {"gdpr": "None", "target": "None stated", "basis": "direct_textual", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr": "None", "target": "None stated", "basis": "direct_textual", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": "Controller is exempt from certain obligations (Arts 4, 5(1–3), 6)", "basis": "direct_textual", "verdict": "broader", "citation": "[850decaffbbae78d371d] Article 19", "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.61, "reasoning_note": "I accounted for Article 19(4), which does create exemptions for public-interest scientific research, but this is not framed as a freedom-of-expression derogation and does not cover journalism or artistic/literary expression, nor the broad range of chapters envisaged by GDPR Art. 85. Hence only partial functional overlap with the ‘academic’ aspect and no explicit balancing with freedom of expression and information.", "label": "C4", "ru_id": "RU-954", "gdpr_article": 85, "jurisdiction": "QAT", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 5, "total": 5}, {"round": 2, "n_queries": 4, "new": 7, "total": 12}, {"round": 3, "n_queries": 4, "new": 3, "total": 15}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Lack of direct evidence supporting the condition for exemptions and the scope of these exemptions in the Qatari law", "counter_evidence": [{"id": "Article 19", "span": "يُعفى المراقب من الالتزام بأحكام المواد (4)، (5/البنود 1، 2، 3)، (6) من هذا القانون، في أي من الحالات الآتية: 1- تنفيذ مهمة متعلقة بالمصلحة العامة وفقاً للقانون. 2- تنفيذ التزام قانوني أو أمر من محكمة مختصة. 3- حماية المصالح الحيوية للفرد. 4- تحقيق أغراض البحث العلمي الذي يجرى للمصلحة العامة. 5- جمع المعلومات اللازمة للتحقيق في إحدى الجرائم الجنائية، بناء على طلب رسمي من جهات التحقيق.", "why": "Does not explicitly cover journalistic or artistic/literary expression and lacks the condition of reconciling data protection with freedom of expression and information"}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's comparison does not fully account for the nuances of exemptions in the Qatari law, particularly concerning public-interest scientific research and the balance with freedom of expression.", "counter_evidence": [{"id": "850decaffbbae78d371d", "span": "يُعفى المراقب من الالتزام بأحكام المواد (4)، (5/البنود 1، 2، 3)، (6) من هذا القانون، في أي من الحالات الآتية: ... 4- تحقيق أغراض البحث العلمي الذي يجرى للمصلحة العامة.", "why": "This provision indicates an exemption for scientific research in the public interest, suggesting a balance between data protection and public interests that could relate to freedom of expression."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["3f5cc5a2c4af5fb90388", "6c76988b817262e3e312", "85d05fccf5b4f57eceaf", "fcbd13532c69b340214e", "75852a697f66691bfbfb", "f5c366135483fe580381", "850decaffbbae78d371d", "07962910da55dbce48d3", "2bcce9feda2fcb9d35fe", "dce663972f2d5e58176e", "fca1aa50445ca4475333", "85e94dba24cbfb8955cd"], "n_llm_calls": 7, "latency_s": 588.36, "temperature": 0.7, "seed": 20260801, "id": "bcb64dd6d0ae88d6aaba", "condition": "stability", "rep": 0}
{"candidates_selected": ["498c9cb637b86367567b", "fd2c91edc2e3ff926c6b", "a9e378888839f3a0144c", "a0a0194dd91481c29c6e"], "candidates_excluded": [{"id": "38c6f7484322711d7d32", "reason": "Post-breach supervisory actions and guidance; not a prior consultation duty tied to a DPIA."}, {"id": "b59c6e3df96d0cdf91f8", "reason": "Oversight via auditor appointment upon Ministry request; not controller-initiated prior consultation."}, {"id": "5483caf68765f09059fb", "reason": "Record-keeping/retention; unrelated to consultation with the authority."}, {"id": "2712fe4ebdba355a134b", "reason": "Consent requirement; unrelated to supervisory consultation."}, {"id": "40626451a5025d77cff5", "reason": "Pre-processing notice to the data subject, not consultation with the supervisory authority."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Privacy policy publication; not about consulting the authority."}, {"id": "6e6fc1f4d7421fb141d6", "reason": "DPO designation; no consultation trigger or duty."}, {"id": "dcd007160208896c8632", "reason": "Breach notification to the authority (ex post incident), not DPIA-triggered prior consultation."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "controller", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "addressee"}, {"gdpr": "obligation", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "modality"}, {"gdpr": "consult the supervisory authority", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr": "intended processing", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr": "where a DPIA under Article 35 indicates high risk in the absence of mitigating measures", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr": "prior to processing", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.66, "reasoning_note": "Articles 39 and 13 require risk identification/assessment by the controller, and Articles 7 and 40 provide Ministry oversight (including the ability to request an assessment report). However, no text requires the controller to proactively consult the authority before processing when a DPIA indicates high residual risk, nor links such a risk finding to a pre-processing consultation trigger. The cited OMN provisions are about internal risk assessment, transfers, or Ministry-initiated oversight, not controller-initiated prior consultation.", "label": "C2", "ru_id": "RU-415", "gdpr_article": 36, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 2, "total": 27}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Lack of direct counterpart for consulting the supervisory authority based on DPIA indicating high risk", "counter_evidence": [{"id": "a0a0194dd91481c29c6e", "span": "يلتزم المتحكم بوضع الضوابط والإجراءات الواجب الالتزام بها عند معالجة البيانات الشخصية", "why": "Indicates controller's obligation to set controls and procedures but does not directly address consulting the supervisory authority"}, {"id": "fd2c91edc2e3ff926c6b", "span": "يجب على المتحكم إجراء تقييم لمستوى الحماية التي توفرها جهة المعالجة الخارجية ومخاطر نقل أو تحويل البيانات الشخصية", "why": "Mentions evaluation of protection level and risks but does not directly link to DPIA and consulting supervisory authority"}], "confidence": 0.7}, {"verdict": "revise", "objection": "The OMN jurisdiction has provisions that imply a similar concept of risk assessment and oversight by the Ministry, which could be considered as a counterpart to the GDPR requirement.", "counter_evidence": [{"id": "fd2c91edc2e3ff926c6b", "span": "Article 39", "why": "Requires the controller to conduct an assessment of the level of protection provided by the external processing entity and the risks of transferring or transmitting personal data."}, {"id": "498c9cb637b86367567b", "span": "Article 7", "why": "Grants the Ministry the responsibility of applying the provisions of the law, including preparing and approving controls and procedures related to personal data protection."}, {"id": "a9e378888839f3a0144c", "span": "Article 40", "why": "Allows the Ministry to request a copy of the assessment report prepared by the controller to ensure that the external processing entity provides an adequate level of protection."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["a0a0194dd91481c29c6e", "38c6f7484322711d7d32", "b59c6e3df96d0cdf91f8", "5483caf68765f09059fb", "2712fe4ebdba355a134b", "fd2c91edc2e3ff926c6b", "40626451a5025d77cff5", "a9e378888839f3a0144c", "bb26cffae1f1c0beb85d", "6e6fc1f4d7421fb141d6", "498c9cb637b86367567b", "dcd007160208896c8632"], "n_llm_calls": 7, "latency_s": 575.69, "temperature": 0.7, "seed": 20260801, "id": "dc47824ac150e6d7d4d1", "condition": "stability", "rep": 0}
{"candidates_selected": ["74358e437cd9e85fdabb"], "candidates_excluded": [{"id": "3bf5db493f62912c0a15", "reason": "Concerns disclosure/conflict matters for external DPOs; does not impose a duty on the controller to provide resources to the DPO."}, {"id": "0c872442bf005518c094", "reason": "Sets conditions for registering an internal DPO; no controller obligation to provide resources."}, {"id": "7e54d45e18f8371cc670", "reason": "Procedural requirements for registering external DPOs; not about controller support/resources."}, {"id": "c9f5b5ef9189452960fe", "reason": "General obligation to be entered in the DPO register; unrelated to resource provision by controller."}, {"id": "23f5fda398d01b0f5865", "reason": "Obligations of the DPO (conflicts, confidentiality); does not create a controller duty to provide resources."}, {"id": "2ef716a5a0437defc8f2", "reason": "Cross-border transfer exceptions; no relevance to DPO resourcing."}, {"id": "8cd7b777aa3cd8ca5f1f", "reason": "Authority powers and functions; no controller duty to resource the DPO."}, {"id": "0dfa8d201a449ae5a66e", "reason": "Technical/organizational security measures; not about DPO resourcing."}, {"id": "4f0c7ea198f3c5b3627c", "reason": "Contractual clauses for cross-border transfers; no DPO resource obligation."}, {"id": "7e2914aa34ab2739dafd", "reason": "Security of processing obligations; unrelated to controller providing resources to DPO."}, {"id": "1d8fd3d4070b1ff36d68", "reason": "Notification to the authority (and exemption when DPO appointed); does not address providing resources to the DPO."}], "target_frame": {"addressee": {"span": "يجوز لمدير البيانات أن يعيِّن مراقباً لحماية البيانات", "article": "Article 10(4)"}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": "يتولى مراقب حماية البيانات ما يأتي:", "article": "Article 10(1)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "مدير البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 10(4)", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "modality"}, {"gdpr_value": "provide the resources necessary for the data protection officer to carry out the tasks referred to in Article 39", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr_value": "supporting the data protection officer in performing the tasks referred to in Article 39", "target_value": "يتولى مراقب حماية البيانات ما يأتي:", "basis": "direct_textual", "verdict": "partial", "citation": "Article 10(1)", "slot": "scope"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.56, "reasoning_note": "Article 10 sets out DPO tasks and requires DPO independence (10(1)(و)) and controller appointment/notification (10(4)), which imply some institutional support. However, no provision obliges the controller to provide the DPO with necessary resources to perform those tasks, so the specific GDPR duty is not articulated.", "label": "C2", "ru_id": "RU-456", "gdpr_article": 38, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 15, "total": 27}, {"round": 3, "n_queries": 4, "new": 8, "total": 35}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict may be too conclusive in stating uncovered aspects without considering indirect implications or potential interpretations of the provided provisions.", "counter_evidence": [{"id": "74358e437cd9e85fdabb", "span": "يتولى مراقب حماية البيانات ما يأتي", "why": "While not directly addressing resource provision, the role and independence of the data protection officer imply a need for a supportive environment."}], "confidence": 0.7}, {"verdict": "revise", "objection": "The analyst's verdict might be too absolute, as there are some related provisions that imply certain responsibilities, even if they do not directly match the GDPR requirement.", "counter_evidence": [{"id": "74358e437cd9e85fdabb", "span": "Article 10, point 1, subsection \"و\"", "why": "This provision implies that the data protection officer should have the necessary resources and independence to perform their tasks."}, {"id": "74358e437cd9e85fdabb", "span": "Article 10, point 4", "why": "This provision implies that the data controller has some responsibility towards the data protection officer."}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["3bf5db493f62912c0a15", "0c872442bf005518c094", "7e54d45e18f8371cc670", "c9f5b5ef9189452960fe", "23f5fda398d01b0f5865", "2ef716a5a0437defc8f2", "8cd7b777aa3cd8ca5f1f", "0dfa8d201a449ae5a66e", "4f0c7ea198f3c5b3627c", "7e2914aa34ab2739dafd", "1d8fd3d4070b1ff36d68", "74358e437cd9e85fdabb"], "n_llm_calls": 7, "latency_s": 580.08, "temperature": 0.7, "seed": 20260801, "id": "d9b36698497c0c43b2cc", "condition": "stability", "rep": 0}
