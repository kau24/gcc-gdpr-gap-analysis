{"candidates_selected": ["9f3112d28a1b850ba61f", "2c020ba48e817e4f4c7a"], "candidates_excluded": [{"id": "e8fe267db21063b1b45f", "reason": "General scope provision; does not address complaints, representation, or third‑party mandates."}, {"id": "b983a5ed0e1c7a2b779a", "reason": "Lawful bases for processing; no text on complaints or mandating representatives."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "not expressed as the bearer of a right to mandate a representative", "basis": "absent", "verdict": "uncovered", "citation": "Art. 4 generally addresses provider duties to users; no assignment of a mandate right to the data subject (9f3112d28a1b850ba61f).", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "no right to appoint a representative is articulated", "basis": "absent", "verdict": "uncovered", "citation": "No provision confers a right to mandate a body to complain on the user’s behalf (Arts. 4, 5).", "slot": "modality"}, {"gdpr_value": "mandate a qualified not-for-profit body to lodge the complaint on the data subject's behalf", "target_value": "no authorization/mandate of a third party to lodge complaints", "basis": "absent", "verdict": "uncovered", "citation": "Art. 4(12) covers user self-actions (modify data, withdraw consent, etc.) and Art. 5(9) requires providers to receive complaints, but neither permits mandating a representative (9f3112d28a1b850ba61f; 2c020ba48e817e4f4c7a).", "slot": "action"}, {"gdpr_value": "representative must be not-for-profit, constituted under Member State law, public-interest objectives, active in protecting data subjects’ rights", "target_value": "no criteria for representative bodies", "basis": "absent", "verdict": "uncovered", "citation": "No text on qualified not‑for‑profit bodies or their characteristics (Arts. 4, 5).", "slot": "scope"}, {"gdpr_value": "None", "target_value": "no conditions stated because the right itself is not stated", "basis": "absent", "verdict": "uncovered", "citation": "No representation right expressed to which conditions could attach.", "slot": "condition"}, {"gdpr_value": "None", "target_value": "no exceptions stated because the right itself is not stated", "basis": "absent", "verdict": "uncovered", "citation": "No representation right expressed to which exceptions could attach.", "slot": "exception"}, {"gdpr_value": "None", "target_value": "no temporal dimension stated for representation", "basis": "absent", "verdict": "uncovered", "citation": "No text on timing of a mandate/complaint by a representative.", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "no consequence related to exercising a representation mandate", "basis": "absent", "verdict": "uncovered", "citation": "No provision addresses effects of a third‑party‑lodged complaint.", "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.83, "reasoning_note": "Art. 4(12) requires a user-facing mechanism to let the user modify data, withdraw consent, or disable collection/processing/disclosure; it does not mention authorizing any third party to act or complain on the user’s behalf. Art. 5(9) obliges providers to have internal complaint channels but is silent on representation, and the text contains no criteria for qualified not‑for‑profit bodies. Therefore, GDPR Art. 80’s mandate/representation right is not textually present.", "label": "C5", "ru_id": "RU-918", "gdpr_article": 80, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 1, "total": 1}, {"round": 2, "n_queries": 4, "new": 3, "total": 4}, {