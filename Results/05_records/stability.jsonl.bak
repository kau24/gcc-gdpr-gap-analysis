{"candidates_selected": ["85d05fccf5b4f57eceaf", "455aae046cacf7979576", "fcbd13532c69b340214e", "6c76988b817262e3e312", "dce663972f2d5e58176e"], "candidates_excluded": [{"id": "75db9db720e9e34a1148", "reason": "Concerns disclosure/transfer to a processor and conformity with lawful purposes; does not establish technical/organizational measures for data minimisation or research/statistics safeguards."}, {"id": "f5c366135483fe580381", "reason": "Breach notification obligation; not about implementing minimisation safeguards or research/statistics contexts."}, {"id": "192caaa530952a30ad50", "reason": "Authority functions (coordination, awareness, research by authority); not a controller obligation on safeguards/minimisation."}, {"id": "89d1bb9a58e65b732117", "reason": "Transparency/notice to data subjects; does not address technical/organizational measures or research/statistics safeguards."}, {"id": "07962910da55dbce48d3", "reason": "Cross-border data flow; unrelated to minimisation safeguards for research/statistics."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "National security and similar exemptions; does not provide safeguards for research/archiving/statistical processing."}, {"id": "2bcce9feda2fcb9d35fe", "reason": "General right/principle; no operative requirement on technical/organizational measures for minimisation or research/statistics safeguards."}], "target_frame": {"addressee": {"span": "يتعين على المراقب الالتزام بما يلي:", "article": "Article 8"}, "modality": {"span": "يجب على كل من المراقب والمعالج اتخاذ الاحتياطات اللازمة", "article": "Article 13"}, "action": {"span": "اتخاذ الاحتياطات الإدارية والفنية والمادية المناسبة لحماية البيانات الشخصية", "article": "Article 8(3)"}, "scope": {"span": "لا تسري أحكام هذا القانون على البيانات الشخصية التي تتم معالجتها بغرض الحصول على البيانات الإحصائية الرسمية وفقاً لأحكام القانون رقم (2) لسنة 2011 المشار إليه.", "article": "Article 2"}, "condition": {"span": null, "article": null}, "exception": {"span": "لا تسري أحكام هذا القانون على البيانات الشخصية التي تتم معالجتها بغرض الحصول على البيانات الإحصائية الرسمية وفقاً لأحكام القانون رقم (2) لسنة 2011 المشار إليه.", "article": "Article 2"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "controllers", "target": "المراقب (controller) explicitly addressed", "basis": "direct_textual", "verdict": "covered", "citation": "Article 8"}, {"slot": "modality", "gdpr": "obligation", "target": "Binding language (يجب على/يتعين على)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 13; Article 8"}, {"slot": "action", "gdpr": "ensure technical and organisational measures are in place to respect the principle of data minimisation", "target": "Adopt appropriate administrative/technical/physical precautions to protect personal data; ensure data are relevant/adequate/not retained longer than necessary", "basis": "distributed", "verdict": "partial", "citation": "Article 8(3); Article 10"}, {"slot": "scope", "gdpr": "safeguards for processing under Article 89(1)", "target": "Official statistics processing excluded from the law; no special safeguards for research/archiving/statistics stated", "basis": "direct_textual", "verdict": "uncovered", "citation": "Article 2"}, {"slot": "condition", "gdpr": "when applying safeguards for processing for archiving in the public interest, scientific or historical research, or statistical purposes", "target": "No condition targeting safeguards for archiving/scientific/historical research/statistical purposes", "basis": "absent", "verdict": "uncovered", "citation": "Article 2 (excludes official statistics); otherwise no text"}, {"slot": "exception", "gdpr": "None", "target": "Exclusion of official statistics from the law’s scope", "basis": "direct_textual", "verdict": "broader", "citation": "Article 2"}, {"slot": "temporal", "gdpr": "None", "target": "No temporal element expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr": "None", "target": "No consequence expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.71, "reasoning_note": "Qatar’s law imposes general technical/organizational precautions and a minimisation-like principle, but it does not create Article 89-type safeguards for research/archiving/statistics, and official statistics are expressly excluded from the law. Therefore, the scope/condition elements tied to GDPR Art. 89(1) are absent, and the action linkage to minimisation is only partial and general.", "label": "C2", "ru_id": "RU-965", "gdpr_article": 89, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 8, "total": 8}, {"round": 2, "n_queries": 4, "new": 4, "total": 12}, {"round": 3, "n_queries": 4, "new": 2, "total": 14}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Absence of explicit provisions addressing scope and condition for archiving, research, or statistical purposes", "counter_evidence": [{"id": "Article 10", "span": "على المراقب التحقق من أن البيانات الشخصية التي يجمعها، أو التي يتم جمعها لصالحه، ذات صلة بالأغراض المشروعة وكافية لتحقيقها", "why": "Supports data minimisation but lacks specific reference to archiving, research, or statistical purposes"}, {"id": "Article 11", "span": "على المراقب اتخاذ الإجراءات التالية: 1- مراجعة إجراءات حماية الخصوصية قبل إدراج عمليات معالجة جديدة", "why": "Outlines actions for protecting personal data but does not directly address the scope or condition"}, {"id": "Article 13", "span": "يجب على كل من المراقب والمعالج اتخاذ الاحتياطات اللازمة لحماية البيانات الشخصية من الضياع أو التلف أو التعديل أو الإفشاء", "why": "Emphasizes protection of personal data but does not address the specific scope or condition"}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's slot verdict for the 'scope' and 'condition' slots is unsupported by the citation.", "counter_evidence": [{"id": "dce663972f2d5e58176e", "span": "لا تسري أحكام هذا القانون على البيانات الشخصية التي تتم معالجتها بغرض الحصول على البيانات الإحصائية الرسمية وفقاً لأحكام القانون رقم (2) لسنة 2011 المشار إليه.", "why": "This provision excludes official statistics from the scope of the law, which could be related to the GDPR requirement for safeguards for processing under Article 89(1)."}, {"id": "455aae046cacf7979576", "span": "على المراقب التحقق من أن البيانات الشخصية التي يجمعها، أو التي يتم جمعها لصالحه، ذات صلة بالأغراض المشروعة وكافية لتحقيقها، وعليه التحقق من أن تلك البيانات دقيقة ومكتملة ومحدثة بما يفي بالأغراض المشروعة، وألا يحتفظ بها لمدة تزيد على المدة الضرورية لتحقيق تلك الأغراض.", "why": "This provision requires the controller to ensure that personal data is collected for legitimate purposes and is not kept for longer than necessary, which could be related to the GDPR requirement for applying safeguards for processing for archiving in the public interest, scientific or historical research, or statistical purposes."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["85d05fccf5b4f57eceaf", "75db9db720e9e34a1148", "6c76988b817262e3e312", "fcbd13532c69b340214e", "f5c366135483fe580381", "455aae046cacf7979576", "192caaa530952a30ad50", "89d1bb9a58e65b732117", "07962910da55dbce48d3", "dce663972f2d5e58176e", "3f5cc5a2c4af5fb90388", "2bcce9feda2fcb9d35fe"], "n_llm_calls": 7, "latency_s": 641.01, "temperature": 0.7, "seed": 20260801, "id": "59029cb094fccc2e55df", "condition": "stability", "rep": 0}
{"candidates_selected": ["2c020ba48e817e4f4c7a", "9f3112d28a1b850ba61f"], "candidates_excluded": [{"id": "a418980931b429c7909a", "reason": "Mentions DPO contact in breach notification but does not assign a duty to the DPO to inform/advise the controller/processor or employees."}, {"id": "b983a5ed0e1c7a2b779a", "reason": "Sets lawful bases for processing; does not address DPO functions or informing/awareness duties."}, {"id": "62dc9e8ad2aa962982ad", "reason": "Pre-contract information and consent; no DPO role or staff-information obligation."}, {"id": "e8fe267db21063b1b45f", "reason": "Scope clause only; no operative obligation about a DPO informing controller/processor or employees."}], "target_frame": {"addressee": {"span": "على مقدم الخدمة", "source": "Article 5 (chapeau)"}, "modality": {"span": "يجب على مقدم الخدمة", "source": "Article 4 (chapeau)"}, "action": {"span": "تحديد وتدريب وتوعية المسؤولين عن حماية البيانات الشخصية", "source": "Article 5(8)"}, "scope": {"span": "شروط جمع ومعالجة البيانات", "source": "Article 4 (title/chapeau)"}, "condition": {"span": null, "source": null}, "exception": {"span": null, "source": null}, "temporal": {"span": null, "source": null}, "consequence": {"span": null, "source": null}}, "slot_verdicts": [{"gdpr": "data protection officer", "target": "مقدم الخدمة", "basis": "direct_textual", "verdict": "uncovered", "citation": "Art. 5 (chapeau); Art. 4 (chapeau)", "slot": "addressee"}, {"gdpr": "obligation", "target": "يجب/على (mandatory)", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 4 (chapeau); Art. 5 (chapeau)", "slot": "modality"}, {"gdpr": "inform the controller or the processor and the employees who carry out processing of their data protection obligations", "target": "تحديد وتدريب وتوعية المسؤولين عن حماية البيانات الشخصية", "basis": "conceptual", "verdict": "narrower", "citation": "Art. 5(8)", "slot": "action"}, {"gdpr": "obligations under the GDPR and other Union or Member State data protection provisions", "target": "شروط جمع ومعالجة البيانات (provider-facing processing obligations under the Kuwaiti regulation), with training/awareness duty not explicitly tied to legal obligations", "basis": "distributed", "verdict": "partial", "citation": "Art. 4 (chapeau); Art. 5(8)", "slot": "scope"}, {"gdpr": "None", "target": "None stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "condition"}, {"gdpr": "None", "target": "None stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr": "None", "target": "None stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": "None stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.62, "reasoning_note": "Art. 5(8) and Art. 4 establish a provider duty to train/raise awareness of personnel responsible for data protection and set processing obligations, but they do not assign the informing/advising function to the DPO nor require informing the controller/processor and all processing employees of their legal obligations. Thus, functional coverage is only partial and narrower than GDPR Art. 39(1)(a).", "label": "C2", "ru_id": "RU-474", "gdpr_article": 39, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 2, "total": 2}, {"round": 2, "n_queries": 4, "new": 3, "total": 5}, {"round": 3, "n_queries": 4, "new": 1, "total": 6}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The 'scope' slot is not entirely 'uncovered', as there are counterparts in the target jurisdiction's law that address similar data protection obligations.", "counter_evidence": [{"id": "b983a5ed0e1c7a2b779a", "span": "المادة الثالثة: مشروعية جمع ومعالجة البيانات", "why": "This article provides a framework for lawful data processing, including conditions for transparency, purpose limitation, and data protection."}, {"id": "9f3112d28a1b850ba61f", "span": "المادة الرابعة: شروط جمع ومعالجة البيانات", "why": "This article includes requirements for transparency, purpose limitation, and data protection, which are similar in scope and purpose to the GDPR obligations."}], "confidence": 0.8}, {"verdict": "revise", "objection": "Potential counter-evidence in Article 5(8) and Article 4 (intro)", "counter_evidence": [{"id": "2c020ba48e817e4f4c7a", "span": "تحديد وتدريب وتوعية المسؤولين عن حماية البيانات الشخصية", "why": "Obligation to inform and train employees about data protection obligations"}, {"id": "9f3112d28a1b850ba61f", "span": "شروط جمع ومعالجة البيانات", "why": "Conditions and obligations for collecting and processing data"}], "confidence": 0.7}], "n_candidates": 6, "candidate_ids": ["2c020ba48e817e4f4c7a", "9f3112d28a1b850ba61f", "a418980931b429c7909a", "b983a5ed0e1c7a2b779a", "62dc9e8ad2aa962982ad", "e8fe267db21063b1b45f"], "n_llm_calls": 7, "latency_s": 640.28, "temperature": 0.7, "seed": 20260801, "id": "f463ebb626d851a7ff3b", "condition": "stability", "rep": 0}
{"candidates_selected": ["d31b8876d3426a7c919a", "f8f94d8d9d379713d656", "3a56eed81feb3655d1d1", "ce107f77eb9119ba01b0", "33d22a1a65039b5be3f9", "ba8aef540689169aa848"], "candidates_excluded": [{"id": "c511c9bf7779067e64f4", "reason": "Purpose-limitation and collection bases; does not impose technical/organizational design-or-operation measures nor factor-based assessment."}, {"id": "ea8306cd18f9261f6413", "reason": "Transparency at collection; not a requirement to implement technical/organizational measures."}, {"id": "f8c6dae3f69fbe207307", "reason": "Disclosure conditions; not a design/operation security or privacy-by-design measure."}, {"id": "7ddbf4e54143664b8b8b", "reason": "Regulatory conditions for disclosure (due care, data minimization) but no general obligation to implement measures across processing or to consider state-of-art/cost/risks."}, {"id": "0922609ffbfd96a70f90", "reason": "Erasure right and related steps; not a general obligation to implement technical/organizational measures."}, {"id": "04322a32135a68c65bb5", "reason": "Relates to processing for a realized interest; does not address implementation of measures or design/operational stages."}], "target_frame": {"addressee": {"span": "على جهة التحكم", "article": "ce107f77eb9119ba01b0"}, "modality": {"span": "يجب أن تكون سجلات أنشطة معالجة البيانات الشخصية مكتوبة.", "article": "f8f94d8d9d379713d656"}, "action": {"span": "اتخاذ الوسائل المناسبة للحد من الأضرار التي قد تنتج عن ذلك، بما في ذلك وضع الضوابط الإدارية والتقنية اللازمة", "article": "3a56eed81feb3655d1d1"}, "scope": {"span": "وصف الإجراءات والوسائل التنظيمية والإدارية والتقنية التي تضمن المحافظة على البيانات الشخصية", "article": "f8f94d8d9d379713d656"}, "condition": {"span": "بحسب طبيعة النشاط الذي تمارسه جهة التحكم", "article": "d31b8876d3426a7c919a"}, "exception": {"span": null, "article": null}, "temporal": {"span": "أثناء فترة استمرار عمليات معالجة البيانات الشخصية", "article": "f8f94d8d9d379713d656"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "controller", "target": "جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": ["ce107f77eb9119ba01b0", "f8f94d8d9d379713d656"], "slot": "addressee"}, {"gdpr": "obligation", "target": "يجب / على جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": ["f8f94d8d9d379713d656", "ce107f77eb9119ba01b0"], "slot": "modality"}, {"gdpr": "implement appropriate technical and organisational measures for the processing", "target": "اتخاذ الوسائل المناسبة ... بما في ذلك وضع الضوابط الإدارية والتقنية اللازمة؛ مع وجود التزام بتوثيق ووصف الإجراءات والوسائل التنظيمية والإدارية والتقنية", "basis": "distributed", "verdict": "narrower", "citation": ["3a56eed81feb3655d1d1", "f8f94d8d9d379713d656", "ce107f77eb9119ba01b0"], "slot": "action"}, {"gdpr": "measures may include pseudonymisation and aim to meet GDPR requirements and protect data subjects’ rights", "target": "تعريف الترميز (pseudonymisation) وإلزام وصف الإجراءات التي تضمن المحافظة على البيانات الشخصية", "basis": "distributed", "verdict": "partial", "citation": ["33d22a1a65039b5be3f9", "f8f94d8d9d379713d656", "ba8aef540689169aa848"], "slot": "scope"}, {"gdpr": "taking into account state of the art, cost of implementation, nature, scope, context and purposes of processing, and risks of varying likelihood and severity to rights and freedoms", "target": "بحسب طبيعة النشاط؛ اتخاذ الوسائل المناسبة للحد من الأضرار؛ الضرورة والتناسب وعدم الإضرار بالحقوق", "basis": "distributed", "verdict": "partial", "citation": ["d31b8876d3426a7c919a", "3a56eed81feb3655d1d1", "ba8aef540689169aa848"], "slot": "condition"}, {"gdpr": "None", "target": "لا نص خاص بالاستثناء في هذه الالتزامات المحددة", "basis": "absent", "verdict": "covered", "citation": [], "slot": "exception"}, {"gdpr": "both at the time of determining the means for processing and at the time of the processing itself", "target": "إجراء تقويم للآثار (لأي منتج أو خدمة تقدم للعموم)؛ والاحتفاظ بسجلات أثناء فترة استمرار عمليات المعالجة", "basis": "distributed", "verdict": "partial", "citation": ["d31b8876d3426a7c919a", "f8f94d8d9d379713d656"], "slot": "temporal"}, {"gdpr": "None", "target": "لا نص على عاقبة قانونية خاصة بهذه الالتزامات ضمن المواد المستشهد بها", "basis": "absent", "verdict": "covered", "citation": [], "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.63, "reasoning_note": "Agree with the objection: the KSA texts do not explicitly require consideration of technological state-of-the-art or cost, and only partially reflect contextual/risk factors (nature of activity, limiting harm). The obligation to adopt technical/organizational measures is explicit only in a narrower context (public authorities for public-interest processing) and via documentation/policy duties, not as a general privacy-by-design mandate. Hence several slots are marked partial or narrower.", "label": "C2", "ru_id": "RU-209", "gdpr_article": 25, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 16, "total": 28}, {"round": 3, "n_queries": 4, "new": 6, "total": 34}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provisions do not explicitly require the controller to implement technical and organisational measures for the processing of personal data at both the design and operational stages.", "counter_evidence": [{"id": "d31b8876d3426a7c919a", "span": "المادة الثانية والعشرون", "why": "This provision only requires the controller to conduct an assessment of the impact of processing personal data, but it does not explicitly require the controller to implement technical and organisational measures to mitigate those risks."}, {"id": "3a56eed81feb3655d1d1", "span": "المادة الحادية والعشرون", "why": "This provision requires the controller to take appropriate measures to limit the harm that may result from processing personal data, but it is limited to situations where the controller is processing personal data for the purpose of achieving a public interest, and it does not explicitly require the controller to implement measures to mitigate risks at the design and operational stages."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The cited provisions do not fully align with the GDPR requirement, and the consideration of technological, economic, contextual, and risk factors is not explicitly mentioned.", "counter_evidence": [{"id": "Article 20 (Reg.)", "span": "الإفصاح عن البيانات الشخصية", "why": "Does not explicitly mention the consideration of technological, economic, contextual, and risk factors."}, {"id": "Article 21 (Law)", "span": "ضوابط معالجة البيانات الشخصية لأغراض المصلحة العامة", "why": "Does not explicitly mention the consideration of technological, economic, contextual, and risk factors."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["ce107f77eb9119ba01b0", "c511c9bf7779067e64f4", "d31b8876d3426a7c919a", "04322a32135a68c65bb5", "3a56eed81feb3655d1d1", "ea8306cd18f9261f6413", "0922609ffbfd96a70f90", "33d22a1a65039b5be3f9", "f8c6dae3f69fbe207307", "7ddbf4e54143664b8b8b", "f8f94d8d9d379713d656", "ba8aef540689169aa848"], "n_llm_calls": 7, "latency_s": 657.25, "temperature": 0.7, "seed": 20260801, "id": "81a5b84fb06b6f3a55de", "condition": "stability", "rep": 0}
{"candidates_selected": ["85e94dba24cbfb8955cd", "6c76988b817262e3e312", "dce663972f2d5e58176e", "3f5cc5a2c4af5fb90388"], "candidates_excluded": [{"id": "75db9db720e9e34a1148", "reason": "Regulates controller-to-processor disclosures; does not create a data-subject right to receive data or specify format."}, {"id": "fcbd13532c69b340214e", "reason": "Security safeguards and breach handling; no right to receive data or format requirements."}, {"id": "fca1aa50445ca4475333", "reason": "Deals with withdrawal, objection, erasure, and correction; no portability-like right to obtain a copy in a particular format."}, {"id": "85d05fccf5b4f57eceaf", "reason": "General controller obligations and privacy-by-design; not a data-subject right to receive data."}, {"id": "f5c366135483fe580381", "reason": "Breach notification; unrelated to data-subject receipt of data."}, {"id": "455aae046cacf7979576", "reason": "Data quality and retention principles; does not grant a right to receive data."}, {"id": "2bcce9feda2fcb9d35fe", "reason": "General right to privacy; does not specify a portability-like entitlement."}, {"id": "f169b712b14aea8718ee", "reason": "Lawful basis (consent/legitimate interest) for processing; does not condition or define a right to receive a copy."}], "target_frame": {"addressee": {"span": "للفرد، في أي وقت، الوصول إلى بياناته الشخصية", "article": "Article 6 [85e94dba24cbfb8955cd]"}, "modality": {"span": "وله بوجه خاص الحق فيما يلي", "article": "Article 6 [85e94dba24cbfb8955cd]"}, "action": {"span": "الحصول على نسخة من بياناته الشخصية بعد سداد مبلغ لا يجاوز مقابل الخدمة", "article": "Article 6 [85e94dba24cbfb8955cd]"}, "scope": {"span": "الوصول إلى بياناته الشخصية ... الحصول على نسخة من بياناته الشخصية", "article": "Article 6 [85e94dba24cbfb8955cd]"}, "condition": {"span": "تسري أحكام هذا القانون على البيانات الشخصية عندما تتم معالجتها على نحو إلكتروني، أو يتم الحصول عليها أو جمعها أو استخراجها على أي نحو آخر تمهيداً لمعالجتها إلكترونياً", "article": "Article 2 [dce663972f2d5e58176e]"}, "exception": {"span": "للجهة المختصة أن تقرر معالجة بعض البيانات الشخصية دون التقيد بأحكام المواد (4)، (9)، (15)، (17) من هذا القانون، وذلك لتحقيق أي من الأغراض الآتية: 1- حماية الأمن الوطني والأمن العام. 2- حماية العلاقات الدولية للدولة. 3- حماية المصالح الاقتصادية أو المالية للدولة. 4- منع أي جريمة جنائية، أو جمع معلومات عنها، أو التحقيق فيها.", "article": "Article 18 [3f5cc5a2c4af5fb90388]"}, "temporal": {"span": "في أي وقت", "article": "Article 6 [85e94dba24cbfb8955cd]"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": "الفرد (the individual/data subject)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 6 [85e94dba24cbfb8955cd]", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "وله بوجه خاص الحق (has, in particular, the right)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 6 [85e94dba24cbfb8955cd]", "slot": "modality"}, {"gdpr_value": "receive the personal data provided to a controller in a structured, commonly used and machine-readable format", "target_value": "الحصول على نسخة من بياناته الشخصية (obtain a copy of personal data) with no specified format", "basis": "direct_textual", "verdict": "partial", "citation": "Article 6 [85e94dba24cbfb8955cd]", "slot": "action"}, {"gdpr_value": "Personal data provided by the data subject; format must be structured, commonly used, machine-readable; without prejudice to Article 17", "target_value": "بياناته الشخصية (any personal data about the individual); no structured/commonly used/machine-readable format requirement; fee may apply", "basis": "direct_textual", "verdict": "partial", "citation": "Article 6 [85e94dba24cbfb8955cd]", "slot": "scope"}, {"gdpr_value": "Processing based on consent or a contract and carried out by automated means", "target_value": "Right exercisable \"في أي وقت\" (at any time); law applies where processing is electronic or destined for electronic processing", "basis": "distributed", "verdict": "broader", "citation": "Article 6 [85e94dba24cbfb8955cd]; Article 2 [dce663972f2d5e58176e]", "slot": "condition"}, {"gdpr_value": "No portability where processing is necessary for a task in the public interest or under official authority; and exercise must not adversely affect rights and freedoms of others", "target_value": "Public-interest/official-authority carve-out allowing processing without complying with specified provisions (Arts 4, 9, 15, 17) for national security, public order, international relations, state economic/financial interests, and crime prevention/investigation", "basis": "direct_textual", "verdict": "partial", "citation": "Article 18 [3f5cc5a2c4af5fb90388]", "slot": "exception"}, {"gdpr_value": "None", "target_value": "في أي وقت (at any time)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 6 [85e94dba24cbfb8955cd]", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "No specific consequence stated for non-provision in a particular format", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.58, "reasoning_note": "Qatar’s law provides an access right including a copy of personal data, but it lacks the GDPR’s portability elements (structured, commonly used, machine-readable; limited to data provided by the subject; consent/contract and automated-processing conditions). Article 18 does introduce a public-interest/official-authority carve-out, but it is tied to specified provisions and does not expressly limit the Article 6 copy right. Therefore, the exception dimension is only partially mirrored.", "label": "C2", "ru_id": "RU-174", "gdpr_article": 20, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 7, "total": 7}, {"round": 2, "n_queries": 4, "new": 7, "total": 14}, {"round": 3, "n_queries": 4, "new": 0, "total": 14}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict for the 'condition' slot is 'uncovered', but Article 4 provides a condition for processing personal data, which is 'after obtaining the individual's consent' or 'if the processing is necessary for a legitimate purpose of the controller or the third party to whom the data is transmitted'. Although it does not exactly match the GDPR condition, it provides a basis for arguing that some form of condition exists.", "counter_evidence": [{"id": "f169b712b14aea8718ee", "span": "لا يجوز للمراقب معالجة البيانات الشخصية، إلا بعد الحصول على موافقة الفرد، ما لم تكن المعالجة ضرورية لتحقيق غرض مشروع للمراقب أو الغير الذي تُرسل إليه البيانات.", "why": "This provision indicates that processing of personal data is conditional upon obtaining the individual's consent or if it is necessary for a legitimate purpose."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict for the exception slot is unsupported by the citation, and counter-evidence from Article 18 suggests an implicit exception for processing necessary for a task in the public interest or under official authority.", "counter_evidence": [{"id": "3f5cc5a2c4af5fb90388", "span": "للجهة المختصة أن تقرر معالجة بعض البيانات الشخصية دون التقيد بأحكام المواد (4)، (9)، (15)، (17) من هذا القانون، وذلك لتحقيق أي من الأغراض الآتية: 1- حماية الأمن الوطني والأمن العام. 2- حماية العلاقات الدولية للدولة. 3- حماية المصالح الاقتصادية أو المالية للدولة. 4- منع أي جريمة جنائية، أو جمع معلومات عنها، أو التحقيق فيها.", "why": "This article suggests an implicit exception for processing necessary for a task in the public interest or under official authority, which is not explicitly mentioned in Article 6."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["75db9db720e9e34a1148", "85e94dba24cbfb8955cd", "f169b712b14aea8718ee", "dce663972f2d5e58176e", "fcbd13532c69b340214e", "fca1aa50445ca4475333", "3f5cc5a2c4af5fb90388", "2bcce9feda2fcb9d35fe", "6c76988b817262e3e312", "85d05fccf5b4f57eceaf", "f5c366135483fe580381", "455aae046cacf7979576"], "n_llm_calls": 7, "latency_s": 678.26, "temperature": 0.7, "seed": 20260801, "id": "031c9871022d199a36ab", "condition": "stability", "rep": 0}
{"candidates_selected": ["62cc177254bb6a5bed90", "7ddbf4e54143664b8b8b", "37d872c258760ad10ae9"], "candidates_excluded": [{"id": "9cfd6fbae8182dbc0028", "reason": "Information/notice duties to data subjects; does not impose security measures or mention (pseudo)nymisation."}, {"id": "a7597ada8323b333cc94", "reason": "Collection/minimisation rules; not a requirement to include pseudonymisation as a security measure."}, {"id": "3a56eed81feb3655d1d1", "reason": "Public-interest processing controls; no specific pseudonymisation requirement."}, {"id": "e32b4ffefbc31a6a5072", "reason": "Confidentiality obligation; does not address pseudonymisation or specific security techniques."}, {"id": "593beb6b1fe15a8fda31", "reason": "Processor selection/oversight; no requirement to include pseudonymisation."}, {"id": "06b918a4049719ed530f", "reason": "Licensing/certification and oversight; not an operative security-control obligation on controllers."}, {"id": "8394f801a0a97e521f68", "reason": "DPO designation and tasks; does not mandate pseudonymisation as a security measure."}, {"id": "14105f25ea49e7794aaa", "reason": "DPIA content and triggers; risk assessment but no directive to use pseudonymisation."}, {"id": "3074a33b0107bc8c40a0", "reason": "Definitions; no operative requirement to include pseudonymisation in security measures."}], "target_frame": {"addressee": {"span": "على جهة التحكم اتخاذ التدابير التنظيمية والإدارية والتقنية اللازمة", "article": "Article 23"}, "modality": {"span": "على جهة التحكم", "article": "Article 23"}, "action": {"span": "ترميز البيانات الشخصية التي تدل على هوية الشخص الآخر ما أمكن ذلك.", "article": "Article 20(4)(ب)"}, "scope": {"span": "ضمان أمن البيانات الشخصية وخصوصية أصحابها", "article": "Article 23"}, "condition": {"span": "تطبيق التدابير الأمنية والتقنية الضرورية للحد من المخاطر الأمنية", "article": "Article 23(1)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller", "target_value": "جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23: \"على جهة التحكم اتخاذ التدابير...\""}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "صيغة إلزامية: \"على جهة التحكم\"", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23"}, {"slot": "action", "gdpr_value": "include pseudonymisation in the implemented security measures", "target_value": "لا يوجد نص عام يُلزم باعتماد التسنيد/التقنيع كإجراء أمني؛ يوجد \"ترميز البيانات... ما أمكن ذلك\" عند الإفصاح المرتبط بشخص آخر، والتزامات عند إخفاء الهوية (المادة 9) وهي إخفاء نهائي يجعل البيانات غير شخصية.", "basis": "distributed", "verdict": "partial", "citation": "Article 20(4)(ب); Article 23; Article 9(1)-(2)"}, {"slot": "scope", "gdpr_value": "personal data processed", "target_value": "أمن البيانات الشخصية وخصوصية أصحابها", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23"}, {"slot": "condition", "gdpr_value": "as appropriate to the risk", "target_value": "التدابير الأمنية والتقنية الضرورية للحد من المخاطر الأمنية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(1)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "لا استثناء منصوصاً به يقيّد وجوب اتخاذ تدابير الأمن ذات الصلة", "basis": "absent", "verdict": "covered", "citation": "No contrary exception located"}, {"slot": "temporal", "gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": "N/A"}, {"slot": "consequence", "gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": "N/A"}], "holistic_label": "partial", "confidence": 0.66, "reasoning_note": "Article 9 governs anonymisation (إخفاء الهوية) and even states that anonymised data are no longer personal data (Art. 9(2)), which is conceptually distinct from GDPR-style pseudonymisation where data remain personal. The KSA text imposes general security measures (Art. 23) and a context-specific masking/encoding when disclosing data related to another person (Art. 20(4)(ب)), but it does not require controllers to include pseudonymisation as a general security measure. Therefore, coverage of the GDPR requirement remains partial.", "label": "C2", "ru_id": "RU-317", "gdpr_article": 32, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 14, "total": 26}, {"round": 3, "n_queries": 4, "new": 7, "total": 33}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The KSA jurisdiction does not have a direct counterpart to the GDPR requirement of including pseudonymisation in the implemented security measures.", "counter_evidence": [{"id": "62cc177254bb6a5bed90", "span": "اتخاذ التدابير التنظيمية والإدارية والتقنية اللازمة لضمان أمن البيانات الشخصية وخصوصية أصحابها", "why": "Article 23 does not explicitly mention pseudonymisation."}, {"id": "7ddbf4e54143664b8b8b", "span": "ترميز البيانات الشخصية التي تدل على هوية الشخص الآخر ما أمكن ذلك", "why": "Article 20(4)(ب) limits pseudonymisation to personal data that reveals the identity of another person."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict of 'partial' coverage is not entirely accurate. Article 9 of the KSA jurisdiction directly addresses pseudonymisation.", "counter_evidence": [{"id": "37d872c258760ad10ae9", "span": "المادة التاسعة: إخفاء الهوية", "why": "This provision directly addresses pseudonymisation, which is a counterpart to the GDPR requirement."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["7ddbf4e54143664b8b8b", "9cfd6fbae8182dbc0028", "a7597ada8323b333cc94", "3a56eed81feb3655d1d1", "e32b4ffefbc31a6a5072", "37d872c258760ad10ae9", "593beb6b1fe15a8fda31", "06b918a4049719ed530f", "8394f801a0a97e521f68", "14105f25ea49e7794aaa", "62cc177254bb6a5bed90", "3074a33b0107bc8c40a0"], "n_llm_calls": 7, "latency_s": 667.1, "temperature": 0.7, "seed": 20260801, "id": "abf802f1d23b4ebc36f2", "condition": "stability", "rep": 0}
{"candidates_selected": [], "candidates_excluded": [{"id": "6ada991a77a31372fb4c", "reason": "Concerns appointing an external auditor and access for audit; no duty for a processor to notify a controller about adding/replacing sub-processors or any pre-change notice."}, {"id": "b59c6e3df96d0cdf91f8", "reason": "Obligation to appoint an external auditor upon ministry request and provide the report; not about sub-processing or processor-to-controller notifications."}, {"id": "5483caf68765f09059fb", "reason": "Records retention by controller/processor; no linkage to sub-processor changes or notifications."}, {"id": "38c6f7484322711d7d32", "reason": "Post-breach supervisory actions; unrelated to sub-processing change notifications."}, {"id": "498c9cb637b86367567b", "reason": "Ministry responsibilities; no operative rule imposing pre-change notice about sub-processors."}, {"id": "a3d16e47b198e1ecb3c6", "reason": "Consent requirements; not relevant to sub-processing or notice duties."}, {"id": "b08fd8d6893cd6de53e8", "reason": "Retention of processing documents; no notice obligation regarding sub-processors."}, {"id": "c7ddf58d01bb4d45c9d5", "reason": "Controller must notify the authority of changes in permit data within 15 days after changes; addressee, recipient, subject, and timing all differ from a processor’s pre-change notice to a controller about sub-processors."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Privacy policy publication; no connection to sub-processor change notifications."}, {"id": "a0a0194dd91481c29c6e", "reason": "Controller must set processing controls/procedures; does not impose any duty to notify the controller of sub-processor changes or any pre-implementation notice."}, {"id": "a023625d7c33737b6c29", "reason": "Update and provide register of processing activities to authority; not a processor-to-controller sub-processing change notice."}, {"id": "26ab9db083b17ff619f2", "reason": "Marketing consent; unrelated to sub-processing or notice duties."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "processor", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "modality", "gdpr_value": "obligation", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "action", "gdpr_value": "inform the controller of any intended changes concerning the addition or replacement of other processors", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "scope", "gdpr_value": "sub-processing", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "condition", "gdpr_value": "where the controller has given general written authorisation to engage other processors", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "temporal", "gdpr_value": "before implementing the intended changes", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.79, "reasoning_note": "The cited provisions do not establish a processor duty to notify the controller, in advance, of adding or replacing sub-processors upon general authorization. Article 9 is a controller-to-authority, post-change notice about permit data; Article 13 is a general governance duty without any notice requirement about sub-processors. No distributed text in the provided corpus functionally supplies the GDPR norm.", "label": "C5", "ru_id": "RU-226", "gdpr_article": 28, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 3, "total": 28}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Potential for indirect or distributed provisions addressing the GDPR requirement, particularly regarding notification or information obligations in the context of processor-controller relationships.", "counter_evidence": [{"id": "c7ddf58d01bb4d45c9d5", "span": "يلتزم المتحكم بإخطار الإدارة المختصة - على النموذج المعد لذلك - بأي تعديلات في البيانات الواردة في التصريح الصادر له", "why": "This provision mentions the obligation to notify the competent authority of any modifications, which could be related to the concept of informing about changes, although it does not directly address the processor-controller relationship or sub-processing."}], "confidence": 0.6}, {"verdict": "revise", "objection": "Potential counterpart exists under different terminology or distributed across provisions", "counter_evidence": [{"id": "c7ddf58d01bb4d45c9d5", "span": "يلتزم المتحكم بإخطار الإدارة المختصة - على النموذج المعد لذلك - بأي تعديلات في البيانات الواردة في التصريح الصادر له", "why": "Establishes a requirement for notification of changes, which could be interpreted to include changes regarding processors."}, {"id": "a0a0194dd91481c29c6e", "span": "يلتزم المتحكم بوضع الضوابط والإجراءات الواجب الالتزام بها عند معالجة البيانات الشخصية", "why": "Implies a level of responsibility and oversight that could encompass notifications about changes in processors."}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["6ada991a77a31372fb4c", "b59c6e3df96d0cdf91f8", "5483caf68765f09059fb", "38c6f7484322711d7d32", "498c9cb637b86367567b", "a3d16e47b198e1ecb3c6", "b08fd8d6893cd6de53e8", "c7ddf58d01bb4d45c9d5", "bb26cffae1f1c0beb85d", "a0a0194dd91481c29c6e", "a023625d7c33737b6c29", "26ab9db083b17ff619f2"], "n_llm_calls": 7, "latency_s": 585.01, "temperature": 0.7, "seed": 20260801, "id": "c0f8002b8607d3f9462d", "condition": "stability", "rep": 0}
