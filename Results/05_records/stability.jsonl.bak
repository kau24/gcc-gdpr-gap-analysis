gs.", "label": "C5", "ru_id": "RU-926", "gdpr_article": 81, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 11, "total": 11}, {"round": 2, "n_queries": 4, "new": 5, "total": 16}, {"round": 3, "n_queries": 4, "new": 2, "total": 18}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "The Qatari law has provisions that could be related to the GDPR requirement, such as Article 26 and Article 29, which provide mechanisms for cooperation and complaint handling.", "counter_evidence": [{"id": "43a894c88a019f80b1d4", "span": "للفرد أن يتقدم بشكوى إلى الإدارة المختصة", "why": "This article provides a procedure for an individual to file a complaint with the competent authority, which could be used to address issues related to parallel proceedings."}, {"id": "ca31304d94e06fa35850", "span": "يكون لموظفي الوزارة، الذين يصدر بتخويلهم صفة مأموري الضبط القضائي", "why": "This article mentions the authorization of ministry employees to investigate and prove crimes, which could be related to cooperation between authorities."}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["85d05fccf5b4f57eceaf", "fcbd13532c69b340214e", "dce663972f2d5e58176e", "f5c366135483fe580381", "ca31304d94e06fa35850", "9548224453cca1301899", "850decaffbbae78d371d", "43a894c88a019f80b1d4", "85e94dba24cbfb8955cd", "83fae53ff99059f02f05", "75db9db720e9e34a1148", "75852a697f66691bfbfb"], "n_llm_calls": 6, "latency_s": 454.58, "temperature": 0.7, "seed": 20260801, "id": "3e936bdde5cf7163725c", "condition": "stability", "rep": 0}
{"candidates_selected": ["8cd7b777aa3cd8ca5f1f", "74358e437cd9e85fdabb"], "candidates_excluded": [{"id": "601ddc5fd8dcb81306cb", "reason": "Internal governance powers of the Board; no accreditation of monitoring bodies or codes of conduct."}, {"id": "8e585010f3f5f3f24dbb", "reason": "Inspection/oversight of DPOs; does not create an accreditation power or a code-of-conduct monitoring framework."}, {"id": "bd5a2bbf9e9652a21d70", "reason": "Inspection powers; unrelated to accrediting monitoring bodies or codes of conduct."}, {"id": "129b122a7d0386567e65", "reason": "CEO powers; not about accreditation of monitoring bodies or codes of conduct."}, {"id": "3e6cee6b3f058328aa31", "reason": "Ministerial oversight of the authority; not about accreditation of monitoring bodies or codes of conduct."}, {"id": "6a403e591ecc2a5638fc", "reason": "Referral of DPO to investigation; not an accreditation power."}, {"id": "1d8fd3d4070b1ff36d68", "reason": "Notification regime; not about accreditation or codes of conduct."}, {"id": "231a37f671238dbf7112", "reason": "Definitions of DPOs; does not itself confer accreditation power or establish code-of-conduct monitoring bodies."}, {"id": "3bf5db493f62912c0a15", "reason": "Disclosure duty of external DPOs; unrelated to accreditation or codes of conduct."}, {"id": "c9145cc9a91d8ff7530c", "reason": "Liability of DPO legal persons; not about accreditation power or code-of-conduct monitoring."}], "target_frame": {"addressee": {"span": "تتولى الهيئة مباشرة كافة المهام والصلاحيات اللازمة لحماية البيانات الشخصية ... 6 - اعتماد مراقبي حماية البيانات", "article": "Article 30(6)"}, "modality": {"span": "ولها في سبيل ذلك القيام بوجه خاص بما يلي: ... 6 - اعتماد مراقبي حماية البيانات", "article": "Article 30(6)"}, "action": {"span": "اعتماد مراقبي حماية البيانات وِفقاً لأحكام المادة (10) من هذا القانون.", "article": "Article 30(6)"}, "scope": {"span": "مراقبي حماية البيانات", "article": "Article 30(6)"}, "condition": {"span": "يُنشَأ لدى الهيئة سجل يسمى (سجل مراقبي حماية البيانات)، ويُشتَرَط لاعتماد مراقب حماية البيانات أن يكون مقيَّداً في هذا السجل. ويُصدِر مجلس الإدارة قراراً بتنظيم أعمال مراقبي حماية البيانات وبتحديد الشروط اللازم توافُرها فيمَن يقيَّد في السجل المشار إليه وبإجراءات القيْد ومدة سريانه وتجديده.", "article": "Article 10(2)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "competent supervisory authority", "target_value": "الهيئة (سلطة حماية البيانات) المخوّلة باعتماد مراقبي حماية البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30(6)"}, {"slot": "modality", "gdpr_value": "power", "target_value": "ولها ... 6 - اعتماد مراقبي حماية البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 30(6)"}, {"slot": "action", "gdpr_value": "accredit a body to monitor compliance with a code of conduct", "target_value": "اعتماد مراقبي حماية البيانات (DPOs)، الذين يتحققون من التزام مدير البيانات بأحكام القانون", "basis": "conceptual", "verdict": "partial", "citation": "Article 30(6); Article 10(1)(ج)"}, {"slot": "scope", "gdpr_value": "accreditation of a body referred to in Article 41(1) (monitoring body for a code of conduct)", "target_value": "اعتماد مراقبي حماية البيانات (داخليين/خارجيين) — لا ذكر لأجسام ترصد الالتزام بمدونات سلوك", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "condition", "gdpr_value": "body has demonstrated independence and expertise; has procedures to assess eligibility, monitor compliance and periodically review; has complaint-handling structures transparent to data subjects and the public; no conflict of interest", "target_value": "يُشترط القيْد في سجل مراقبي حماية البيانات مع شروط يحددها مجلس الإدارة؛ كما ينص على قيام المراقب بمهامه في استقلال وحيدة", "basis": "distributed", "verdict": "partial", "citation": "Article 10(2); Article 10(1)(و)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.64, "reasoning_note": "Articles 30(6) and 10 create an accreditation regime, but it is for Data Protection Officers (internal/external), not for code-of-conduct monitoring bodies. Unlike GDPR Art. 41(2), the Bahraini texts do not establish criteria or procedures for accrediting bodies to monitor compliance with codes of conduct. Therefore, some affinity exists on ‘accrediting compliance monitors,’ but the specific GDPR construct remains largely unaddressed.", "label": "C2", "ru_id": "RU-504", "gdpr_article": 41, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 12, "total": 24}, {"round": 3, "n_queries": 4, "new": 0, "total": 24}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Counterpart exists under different terminology", "counter_evidence": [{"id": "10", "span": "مراقب حماية البيانات", "why": "The concept of a Data Protection Officer and the registration process implies a form of accreditation"}, {"id": "10(2)", "span": "سجل مراقبي حماية البيانات", "why": "The creation of a register for Data Protection Officers suggests a process for accrediting or registering individuals"}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict that the action 'accredit a body to monitor compliance with a code of conduct' is uncovered may be incorrect due to the presence of related provisions in Article 10 and Article 30.", "counter_evidence": [{"id": "10", "span": "اعتماد مراقبي حماية البيانات", "why": "This provision mentions the accreditation of data protection officers, which could be related to monitoring compliance with a code of conduct."}, {"id": "30", "span": "ولها في سبيل ذلك القيام بوجه خاص بما يلي: ... 6 - اعتماد مراقبي حماية البيانات", "why": "This provision grants the authority the power to accredit data protection officers according to the provisions of Article 10."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["601ddc5fd8dcb81306cb", "8e585010f3f5f3f24dbb", "bd5a2bbf9e9652a21d70", "129b122a7d0386567e65", "8cd7b777aa3cd8ca5f1f", "3e6cee6b3f058328aa31", "6a403e591ecc2a5638fc", "1d8fd3d4070b1ff36d68", "74358e437cd9e85fdabb", "231a37f671238dbf7112", "3bf5db493f62912c0a15", "c9145cc9a91d8ff7530c"], "n_llm_calls": 7, "latency_s": 573.66, "temperature": 0.7, "seed": 20260801, "id": "be4cc8bdd64d7dfa097c", "condition": "stability", "rep": 0}
{"candidates_selected": ["a079a5ac446830a74bfc", "6201d16404c0d4b9f63d"], "candidates_excluded": [{"id": "9c38ab11b550755816f5", "reason": "Duties toward the DPO; no international cooperation or supervisory-authority cooperation mechanism."}, {"id": "9d65c2815c41a25064db", "reason": "Security of processing; no international cooperation or supervisory-authority role."}, {"id": "674524dee00496cb5de7", "reason": "Controller general obligations; not about international cooperation by supervisory authorities."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment; no international cooperation mechanism."}, {"id": "34f7595acb9df257ef5e", "reason": "DPO roles; liaison is with the domestic Office only; no international cooperation duty."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification; domestic supervisory process, not international cooperation."}, {"id": "0cc06e3d3b107448da5a", "reason": "Processor obligations; no international cooperation or supervisory-authority duty."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Scope of law; does not establish cooperation mechanisms or obligations on the supervisory authority."}, {"id": "dec351a1e477287e3b22", "reason": "Data subject communication with controller; unrelated to international cooperation."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "Processing principles; no supervisory authority cooperation mechanisms."}], "target_frame": {"addressee": {"span": "الدولة", "article": "Article 22(2)"}, "modality": {"span": "يجوز نقل البيانات الشخصية إلى خارج الدولة في الأحوال الآتية المعتمدة من المكتب", "article": "Article 22 (chapeau)"}, "action": {"span": "انضمام الدولة إلى الاتفاقيات الثنائية أو متعددة الأطراف المتعلقة بحماية البيانات الشخصية", "article": "Article 22(2)"}, "scope": {"span": "مع الدول التي سيتم نقل البيانات الشخصية إليها", "article": "Article 22(2)"}, "condition": {"span": "في الأحوال الآتية المعتمدة من المكتب", "article": "Article 22 (chapeau)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "supervisory authorities", "target_value": "The actor referenced is the State (الدولة), not the supervisory authority; the Office is only mentioned as approving adequacy cases.", "basis": "direct_textual", "verdict": "uncovered", "citation": "[a079a5ac446830a74bfc, Art 22(2)]"}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "Permission framework for cross-border transfers approved by the Office; no duty to conclude agreements or to develop cooperation mechanisms.", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "[a079a5ac446830a74bfc, Art 22 chapeau]"}, {"slot": "action", "gdpr_value": "take appropriate steps to develop international cooperation mechanisms to facilitate the effective enforcement of legislation for the protection of personal data", "target_value": "Recognizes State accession to bilateral/multilateral data-protection agreements and references international judicial cooperation as transfer bases; no express duty on the supervisory authority to develop cooperation mechanisms.", "basis": "distributed", "verdict": "partial", "citation": "[a079a5ac446830a74bfc, Art 22(2); 6201d16404c0d4b9f63d, Art 23(1)(هـ)]"}, {"slot": "scope", "gdpr_value": "in relation to third countries and international organisations", "target_value": "Tied to countries to which data are transferred; mentions international judicial cooperation but not international organisations generally.", "basis": "direct_textual", "verdict": "narrower", "citation": "[a079a5ac446830a74bfc, Art 22(2); 6201d16404c0d4b9f63d, Art 23(1)(هـ)]"}, {"slot": "condition", "gdpr_value": "None", "target_value": "Applies only within the transfer-permission framework and cases approved by the Office.", "basis": "direct_textual", "verdict": "narrower", "citation": "[a079a5ac446830a74bfc, Art 22 chapeau]"}, {"slot": "exception", "gdpr_value": "None", "target_value": "No specific exception stated regarding cooperation mechanisms.", "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "temporal", "gdpr_value": "None", "target_value": "No temporal element specified.", "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "consequence", "gdpr_value": "None", "target_value": "No consequence specified.", "basis": "absent", "verdict": "covered", "citation": ""}], "holistic_label": "partial", "confidence": 0.64, "reasoning_note": "Article 22(2) recognizes international cooperation mechanisms by treating the State’s accession to bilateral/multilateral data-protection agreements as a basis for cross-border transfers, and Article 23 references international judicial cooperation. However, the text does not impose an obligation on the supervisory authority to take steps to develop such mechanisms; the cooperation basis is framed as a transfer condition, not an SA duty, so coverage is partial and of weaker modality.", "label": "C3", "ru_id": "RU-607", "gdpr_article": 50, "jurisdiction": "UAE", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 1, "total": 13}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict may not fully consider the implications of provisions related to international data transfers and cooperation.", "counter_evidence": [{"id": "a079a5ac446830a74bfc", "span": "الاتفاقيات الثنائية أو متعددة الأطراف ... مع الدول التي سيتم نقل البيانات الشخصية إليها", "why": "This provision suggests a form of international cooperation regarding personal data protection, particularly in the context of data transfers."}, {"id": "6201d16404c0d4b9f63d", "span": "المادة (23) نقل ومشاركة البيانات الشخصية عبر الحدود لأغراض المعالجة في حال عدم وجود مستوى حماية ملائم", "why": "Article 23 implies considerations for international data transfers, which could be part of broader international cooperation efforts on personal data protection."}], "confidence": 0.7}, {"verdict": "revise", "objection": "The analyst's claim that there is no obligation to develop international cooperation mechanisms is not entirely accurate, and there is some evidence to suggest that the UAE provisions do provide some basis for international cooperation mechanisms.", "counter_evidence": [{"id": "a079a5ac446830a74bfc", "span": "المادة (22): \"انضمام الدولة إلى الاتفاقيات الثنائية أو متعددة الأطراف المتعلقة بحماية البيانات الشخصية مع الدول التي سيتم نقل البيانات الشخصية إليها\"", "why": "This article mentions the need for agreements or contracts that ensure the protection of personal data, which could be interpreted as a form of international cooperation."}, {"id": "9c38ab11b550755816f5", "span": "المادة (7): \"اتخاذ الإجراءات والتدابير التقنية والتنظيمية الملائمة لتطبيق المعايير القياسية اللازمة لحماية وتأمين البيانات الشخصية\"", "why": "This article mentions the need for the controller to take appropriate technical and organizational measures to protect personal data, which could be interpreted as an obligation to cooperate internationally."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["9c38ab11b550755816f5", "9d65c2815c41a25064db", "674524dee00496cb5de7", "9630e6d967b64e07d339", "34f7595acb9df257ef5e", "e05de90f481c9410c6e0", "6201d16404c0d4b9f63d", "0cc06e3d3b107448da5a", "743bfdd72ed773ff5ba9", "dec351a1e477287e3b22", "3cc10eb2dd7e95bdd0c2", "a079a5ac446830a74bfc"], "n_llm_calls": 6, "latency_s": 567.96, "temperature": 0.7, "seed": 20260801, "id": "79fededee14369d9e905", "condition": "stability", "rep": 0}
{"candidates_selected": ["a200ece03fd0ba143354", "85d05fccf5b4f57eceaf", "76d28900b8b4cbbb215d", "2bcce9feda2fcb9d35fe"], "candidates_excluded": [{"id": "3f5cc5a2c4af5fb90388", "reason": "National-security exemptions from compliance; no permission to set employment-specific rules or use collective agreements."}, {"id": "6c76988b817262e3e312", "reason": "Controller internal governance duties; does not empower lawmakers or social partners to issue sector-specific rules."}, {"id": "fcbd13532c69b340214e", "reason": "Security safeguards obligation; not a meta-permission to create more specific employment-context rules."}, {"id": "07962910da55dbce48d3", "reason": "Cross-border data flow rule; unrelated to authorizing specific employment-processing rules."}, {"id": "f5c366135483fe580381", "reason": "Breach notification; no authorization for sector-specific or employment-specific rulemaking."}, {"id": "dce663972f2d5e58176e", "reason": "General material scope of the law; does not address permissions to adopt specific employment rules."}, {"id": "75db9db720e9e34a1148", "reason": "Disclosure/transfer to processor conditions; no permission for employment-specific rules."}, {"id": "85e94dba24cbfb8955cd", "reason": "Data subject access/notification rights; does not authorize adoption of more specific employment rules."}], "target_frame": {"addressee": {"span": "وللوزير، بقرار منه، فرض احتياطات إضافية", "article": "Article 16"}, "modality": {"span": "وللوزير أن يضيف أصنافاً أخرى", "article": "Article 16"}, "action": {"span": "تُحدد، بقرار من الوزير، الضوابط والإجراءات", "article": "Article 7"}, "scope": {"span": null, "article": null}, "condition": {"span": "إذا كان من شأن سوء استخدامها أو إفشائها إلحاق ضرر جسيم بالفرد", "article": "Article 16"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "Member States", "target": "الوزير (Minister)", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 16: \"وللوزير، بقرار منه، فرض احتياطات إضافية\""}, {"slot": "modality", "gdpr": "permission", "target": "permission (\"وللوزير أن ...\")", "basis": "direct_textual", "verdict": "covered", "citation": "Article 16: \"وللوزير أن يضيف أصنافاً أخرى\""}, {"slot": "action", "gdpr": "provide more specific rules by law or by collective agreements", "target": "determine controls and procedures by ministerial decision", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7: \"تُحدد، بقرار من الوزير، الضوابط والإجراءات\""}, {"slot": "scope", "gdpr": "processing of employees' personal data in the employment context for listed employment-related purposes", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "condition", "gdpr": "None", "target": "Minister may add categories only if misuse/disclosure would cause serious harm", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 16: \"إذا كان من شأن سوء استخدامها أو إفشائها إلحاق ضرر جسيم بالفرد\""}, {"slot": "exception", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.55, "reasoning_note": "I considered distributed provisions: Article 8 (ministerial privacy policies) and Article 7 (minister-set controls) show a governmental power to issue more specific data-protection rules, and Article 3 establishes a general right to data privacy. However, the text contains no employment-specific mandate or permission nor any role for collective agreements, so GDPR Art. 88’s sectoral permission is only partially mirrored.", "label": "C4", "ru_id": "RU-960", "gdpr_article": 88, "jurisdiction": "QAT", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 6, "total": 6}, {"round": 2, "n_queries": 4, "new": 5, "total": 11}, {"round": 3, "n_queries": 4, "new": 1, "total": 12}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Potential counterpart exists in Article 7", "counter_evidence": [{"id": "a200ece03fd0ba143354", "span": "تُحدد، بقرار من الوزير، الضوابط والإجراءات المتعلقة بممارسة الأفراد للحقوق المنصوص عليها في المادتين السابقتين.", "why": "Article 7 allows the Minister to determine controls and procedures, which could include more specific rules for employee personal data protection."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's conclusion might overlook indirect or combined provisions that address the GDPR requirement unit [RU-960].", "counter_evidence": [{"id": "85d05fccf5b4f57eceaf", "span": "يتعين على المراقب الالتزام بما يلي: 1- معالجة البيانات الشخصية بأمانة ومشروعية.", "why": "This provision implies a duty on the controller to process personal data lawfully and fairly, which could encompass protections for employees' personal data in the employment context."}, {"id": "2bcce9feda2fcb9d35fe", "span": "لكل فرد الحق في حماية خصوصية بياناته الشخصية، ولا يجوز معالجة تلك البيانات إلا في إطار الشفافية والأمانة واحترام كرامة الإنسان والممارسات المقبولة، وفقاً لأحكام هذا القانون.", "why": "This article establishes a right to privacy for personal data, suggesting a basis for protecting employees' data."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["3f5cc5a2c4af5fb90388", "a200ece03fd0ba143354", "6c76988b817262e3e312", "fcbd13532c69b340214e", "76d28900b8b4cbbb215d", "07962910da55dbce48d3", "f5c366135483fe580381", "85d05fccf5b4f57eceaf", "dce663972f2d5e58176e", "75db9db720e9e34a1148", "85e94dba24cbfb8955cd", "2bcce9feda2fcb9d35fe"], "n_llm_calls": 7, "latency_s": 593.37, "temperature": 0.7, "seed": 20260801, "id": "54011bd130180a3948e5", "condition": "stability", "rep": 0}
{"candidates_selected": ["063ab5d9ef023666aed7"], "candidates_excluded": [{"id": "23f5fda398d01b0f5865", "reason": "Obligations of the data protection officer (conflict of interest/confidentiality); no record-of-processing or joint-controller record content."}, {"id": "0c872442bf005518c094", "reason": "Registration conditions for internal DPO; unrelated to records of processing or joint-controller details."}, {"id": "c9f5b5ef9189452960fe", "reason": "Obligation to register DPOs in a register; not about ROPA content or joint-controller entries."}, {"id": "61761ad6643b2051eebd", "reason": "Duration/renewal of DPO registration; no bearing on ROPA or joint-controller record entries."}, {"id": "019b82ab5e0d0396a62e", "reason": "Electronic submissions to the authority; not about records of processing or their content."}, {"id": "34ea02d93464e8e2fa05", "reason": "Definitions and privacy by design; no requirement to keep a ROPA or include joint-controller details."}, {"id": "7e2914aa34ab2739dafd", "reason": "Security of processing and processor contracts; no record-of-processing requirement."}, {"id": "10e6e0e9f2f36b4c7b42", "reason": "Concerns data contained in public registers and conditions for their establishment; not the controller's internal record of processing activities, and does not require listing joint-controller names/contact details."}, {"id": "1d9b90bc8d164f514dc3", "reason": "Breach notification/documentation; unrelated to ROPA content or joint-controller details."}, {"id": "a8603a05076226e9b8fc", "reason": "Register of DPOs published by the authority; not about ROPA or joint-controller record entries."}, {"id": "93fde8c87940ae524c86", "reason": "Transparency information to data subjects; does not impose keeping a ROPA or including joint-controller details in any record."}], "target_frame": {"addressee": {"span": "مديري البيانات", "article": "Article 7"}, "modality": {"span": "يجب", "article": "Article 7"}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": "في حال تمت مُعالجة البيانات من قبل أكثر من مدير بيانات بصورة مشتركة", "article": "Article 7"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "controller", "target": "مديري البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7", "slot": "addressee"}, {"gdpr": "obligation", "target": "يجب", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7", "slot": "modality"}, {"gdpr": "include the name and contact details of the joint controller in the record", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr": "the record of processing activities maintained under Article 30(1)", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr": "where applicable (a joint controller exists)", "target": "في حال تمت مُعالجة البيانات من قبل أكثر من مدير بيانات بصورة مشتركة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 7", "slot": "condition"}, {"gdpr": "None", "target": "None", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr": "None", "target": "None", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": "None", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.68, "reasoning_note": "Article 7 recognizes joint controllers and imposes a written agreement, disclosure of joint processing, and designation of a single contact point, but it does not require recording the name/contact details of joint controllers in any record. Article 11 concerns public registers and their content/establishment conditions, not a controller’s internal record of processing activities. Therefore, the specific ROPA entry required by GDPR Art. 30(1)(a) remains missing.", "label": "C2", "ru_id": "RU-257", "gdpr_article": 30, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 8, "total": 20}, {"round": 3, "n_queries": 4, "new": 1, "total": 21}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Counterpart present under different terminology or distributed across provisions", "counter_evidence": [{"id": "063ab5d9ef023666aed7", "span": "في حال تمت مُعالجة البيانات من قبل أكثر من مدير بيانات بصورة مشتركة", "why": "Implies joint controller scenarios and the need for agreements and transparency, potentially covering the GDPR requirement indirectly."}, {"id": "10e6e0e9f2f36b4c7b42", "span": "يجب أن تكون البيانات الشخصية المدرجة في السجلات، المتاح للجمهور الاطلاع عليها، في حدود الضرورة وللأغراض التي تنشأ من أجلها هذه السجلات.", "why": "Suggests the importance of records and transparency, which could encompass the inclusion of joint controller details for data processing activities."}], "confidence": 0.8}, {"verdict": "revise", "objection": "Potential counterpart exists under different terminology or across multiple provisions", "counter_evidence": [{"id": "063ab5d9ef023666aed7", "span": "في حال تمت مُعالجة البيانات من قبل أكثر من مدير بيانات بصورة مشتركة", "why": "Implies the existence of joint controllers and requires an agreement in writing between them"}, {"id": "11", "span": "يجب أن تكون البيانات الشخصية المدرجة في السجلات، المتاح للجمهور الاطلاع عليها، في حدود الضرورة وللأغراض التي تنشأ من أجلها هذه السجلات", "why": "Implies that records should contain necessary information for their purposes, potentially including details about joint controllers"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["23f5fda398d01b0f5865", "0c872442bf005518c094", "c9f5b5ef9189452960fe", "61761ad6643b2051eebd", "063ab5d9ef023666aed7", "019b82ab5e0d0396a62e", "34ea02d93464e8e2fa05", "7e2914aa34ab2739dafd", "10e6e0e9f2f36b4c7b42", "1d9b90bc8d164f514dc3", "a8603a05076226e9b8fc", "93fde8c87940ae524c86"], "n_llm_calls": 7, "latency_s": 561.38, "temperature": 0.7, "seed": 20260801, "id": "9ed6747aac87d6977fcb", "condition": "stability", "rep": 0}
{"candidates_selected": ["e8fe267db21063b1b45f", "9f3112d28a1b850ba61f", "2c020ba48e817e4f4c7a", "9b42add02f4d45cf8a57"], "candidates_excluded": [{"id": "b983a5ed0e1c7a2b779a", "reason": "Sets lawful bases for processing; does not address codes of conduct, transfer safeguards, or permissions for adherence."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": "إخطار صاحب البيانات في حال كان مقدم الخدمة يعتزم نقل بيانات الشخصية إلى خارج دولة الكويت.", "article": "Article 4(9)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "Controllers or processors not subject to the Regulation pursuant to Article 3", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "addressee"}, {"gdpr_value": "permission", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "modality"}, {"gdpr_value": "adhere to approved and generally valid codes of conduct", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr_value": "To provide appropriate safeguards for personal data transfers to third countries or international organisations under Article 46(2)(e)", "target_value": "النقل إلى خارج دولة الكويت مذكور؛ وتُفرض تدابير أمنية عامة لحماية البيانات.", "basis": "distributed", "verdict": "partial", "citation": "Article 4(9); Article 5(1)", "slot": "scope"}, {"gdpr_value": "The code of conduct is approved pursuant to paragraph 5 and has general validity pursuant to paragraph 9", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.66, "reasoning_note": "Re-examining Article 5 shows general security measures that act as safeguards, but the target text does not provide the specific GDPR mechanism: permission for non-GDPR entities to adhere to GDPR-approved codes of conduct as a transfer safeguard under Art. 46(2)(e). The only relevant elements are a notification duty for transfers and general security obligations, which do not substitute for the code-of-conduct transfer mechanism.", "label": "C2", "ru_id": "RU-487", "gdpr_article": 40, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 2, "total": 2}, {"round": 2, "n_queries": 4, "new": 3, "total": 5}, {"round": 3, "n_queries": 4, "new": 0, "total": 5}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Potential counterpart found in Article 7(2) and Article 5", "counter_evidence": [{"id": "9b42add02f4d45cf8a57", "span": "Article 7(2)", "why": "Authority has the power to issue instructions or guidelines related to data privacy"}, {"id": "2c020ba48e817e4f4c7a", "span": "Article 5", "why": "Emphasizes the importance of taking appropriate security measures to protect personal data"}], "confidence": 0.8}, {"verdict": "revise", "objection": "Potential for indirect or implied safeguards in data transfers through security and protection measures, suggesting a need to reevaluate the absence of a counterpart.", "counter_evidence": [{"id": "2c020ba48e817e4f4c7a", "span": "المادة الخامسة: أمن وحماية البيانات الشخصية", "why": "Article 5 implies the need for security measures that could be interpreted as providing appropriate safeguards in data transfers, indirectly addressing the concept of protecting personal data during transfers."}], "confidence": 0.6}], "n_candidates": 5, "candidate_ids": ["9b42add02f4d45cf8a57", "b983a5ed0e1c7a2b779a", "e8fe267db21063b1b45f", "9f3112d28a1b850ba61f", "2c020ba48e817e4f4c7a"], "n_llm_calls": 7, "latency_s": 632.04, "temperature": 0.7, "seed": 20260801, "id": "5401799e919e91440d76", "condition": "stability", "rep": 0}
{"candidates_selected": ["498c9cb637b86367567b", "3f916831456908af27d8", "3ebf8596bc5a77b0eeea", "823830174d241884bd73", "9afcca9ce75d4e0c23f1", "b59c6e3df96d0cdf91f8", "a37f6f979ece2e1de6bf"], "candidates_excluded": [{"id": "ae67f8fe376642167563", "reason": "Addresses sensitive data categories and ministry permits; does not establish supervision of churches/religious associations or an independent authority."}, {"id": "a2a61b7c9316716b7e74", "reason": "Prohibits disclosure of certain sensitive data; not about supervisory oversight or church-specific regimes."}, {"id": "865fbf2c2a6ca6fcb814", "reason": "General scope exemptions from the law; does not create a church-specific supervisory framework."}, {"id": "a9e378888839f3a0144c", "reason": "Concerns cross-border processor assessment reports; not about supervision of religious bodies or independence."}, {"id": "38c6f7484322711d7d32", "reason": "Incident-handling steps after breach notification; not about establishing supervisory authority over churches."}], "target_frame": {"addressee": {"span": "يلتزم المتحكم والمعالج بالضوابط والإجراءات التي تقررها الوزارة", "article": "Article 15"}, "modality": {"span": "يلتزم", "article": "Article 15"}, "action": {"span": "إصدار الضوابط والإجراءات اللازمة لمعالجة البيانات الشخصية والتحقق من التزام المتحكم والمعالج بها", "article": "Article 7(b)"}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": "تتخذ الوزارة ... أ- إنذار المتحكم أو المعالج ... ب- الأمر بتصحيح ومحو البيانات ... ج- وقف معالجة البيانات ... د- وقف تحويل البيانات ... هـ- أي إجراء آخر تراه الوزارة ضرورياً", "article": "Article 8(a)-(هـ)"}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "churches and religious associations", "target_value": "المتحكم والمعالج", "basis": "direct_textual", "verdict": "broader", "citation": "Art. 15"}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "يلتزم", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 15"}, {"slot": "action", "gdpr_value": "be subject to the supervision of an independent supervisory authority", "target_value": "الوزارة مسؤولة عن التطبيق والتحقق من التزام المتحكم والمعالج واتخاذ إجراءات إنفاذ", "basis": "distributed", "verdict": "partial", "citation": "Art. 7(b); Art. 8; Art. 12; Art. 16; Art. 18"}, {"slot": "scope", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "condition", "gdpr_value": "they apply comprehensive rules in accordance with Article 91(1)", "target_value": "لا نص مماثل بشأن قواعد شاملة للكنائس أو الجمعيات الدينية", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "إنذار، أوامر بالتصحيح أو المحو، وقف المعالجة أو التحويل، وإجراءات أخرى", "basis": "direct_textual", "verdict": "broader", "citation": "Art. 8(a)-(هـ)"}], "holistic_label": "partial", "confidence": 0.47, "reasoning_note": "While Oman’s PDPL establishes ministerial oversight over all controllers/processors (which would include religious entities), it does not recognize church-specific comprehensive rules nor specify an independent supervisory authority. Article 7’s general mandate to the Ministry is not a clear textual counterpart to GDPR Art. 91(2). This addresses the objection: there is only generic supervision, not the church-specific, independence-conditioned regime GDPR requires.", "label": "C4", "ru_id": "RU-977", "gdpr_article": 91, "jurisdiction": "OMN", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 8, "total": 20}, {"round": 3, "n_queries": 4, "new": 0, "total": 20}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict is not fully supported by the provisions, specifically the mention of churches and religious associations and the reference to Article 91(1) are not supported.", "counter_evidence": [{"id": "9afcca9ce75d4e0c23f1", "span": "يلتزم المتحكم والمعالج بالضوابط والإجراءات التي تقررها الوزارة", "why": "This provision suggests that the controller and processor are subject to the supervision of the Ministry, which could be considered an independent supervisory authority."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The target jurisdiction's laws and regulations do not provide a clear counterpart to the GDPR's requirement for churches and religious associations to be subject to supervision when applying comprehensive rules.", "counter_evidence": [{"id": "498c9cb637b86367567b", "span": "Article 7", "why": "The article mentions the Ministry's responsibility for applying the law, but does not explicitly mention churches and religious associations."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["3f916831456908af27d8", "3ebf8596bc5a77b0eeea", "ae67f8fe376642167563", "498c9cb637b86367567b", "a2a61b7c9316716b7e74", "b59c6e3df96d0cdf91f8", "823830174d241884bd73", "9afcca9ce75d4e0c23f1", "a37f6f979ece2e1de6bf", "865fbf2c2a6ca6fcb814", "a9e378888839f3a0144c", "38c6f7484322711d7d32"], "n_llm_calls": 7, "latency_s": 613.78, "temperature": 0.7, "seed": 20260801, "id": "2a861d895c3c6f923d7a", "condition": "stability", "rep": 0}
{"candidates_selected": ["5d949837d7aab073cd67", "717a67a0d311f88c5fd9"], "candidates_excluded": [{"id": "e05de90f481c9410c6e0", "reason": "Controller/processor breach notification to the Office; not a data-subject complaint right."}, {"id": "c34922f387019af45e42", "reason": "Automated decision-making rights; unrelated to lodging complaints."}, {"id": "674524dee00496cb5de7", "reason": "Controller obligations; does not grant a complaint right."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restriction of processing; not about complaints to the authority."}, {"id": "877fafe0080725188d05", "reason": "Rectification/erasure rights; not about complaints."}, {"id": "ebfe638a86be87347658", "reason": "Data portability; not about complaints."}, {"id": "6201d16404c0d4b9f63d", "reason": "Cross-border transfer conditions; not about complaints."}, {"id": "9d65c2815c41a25064db", "reason": "Security measures; not about complaints."}, {"id": "a079a5ac446830a74bfc", "reason": "Cross-border adequacy; not about complaints."}, {"id": "743bfdd72ed773ff5ba9", "reason": "General scope of the law; does not address the complaint right itself."}], "target_frame": {"addressee": {"span": "لصاحب البيانات", "article": "Article 24(1)"}, "modality": {"span": "لصاحب البيانات أن يتقدم", "article": "Article 24(1)"}, "action": {"span": "أن يتقدم إلى المكتب بشكوى", "article": "Article 24(1)"}, "scope": {"span": "إلى المكتب", "article": "Article 24(1)"}, "condition": {"span": "إذا كان لديه ما يحمله على الاعتقاد بوقوع أي مخالفة لأحكام هذا المرسوم بقانون، أو بأن المتحكم أو المعالج يقوم بمعالجة بياناته الشخصية بالمخالفة لأحكامه", "article": "Article 24(1)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": "يتولى المكتب استلام الشكاوى المقدمة من صاحب البيانات ... والتحقق منها بالتنسيق مع المتحكم والمعالج", "article": "Article 24(2)"}}, "slot_verdicts": [{"gdpr_value": "every data subject", "target_value": "“صاحب البيانات” (data subject)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 24(1)", "slot": "addressee"}, {"gdpr_value": "right", "target_value": "Permissive/right: “لصاحب البيانات أن يتقدم” (the data subject may/has the right to submit)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 24(1)", "slot": "modality"}, {"gdpr_value": "lodge a complaint with a supervisory authority", "target_value": "“أن يتقدم إلى المكتب بشكوى” (submit a complaint to the Office)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 24(1); see also Article 13(1)(ط)", "slot": "action"}, {"gdpr_value": "in particular with a supervisory authority in the Member State of habitual residence, place of work, or place of alleged infringement", "target_value": "Complaint is lodged “إلى المكتب” (to the Office) without venue options", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 24(1)", "slot": "scope"}, {"gdpr_value": "if the data subject considers processing of personal data relating to him or her infringes the GDPR", "target_value": "If the data subject has reason to believe of any violation of the Decree-Law, or that the controller/processor is processing his personal data contrary to it", "basis": "direct_textual", "verdict": "broader", "citation": "Article 24(1)", "slot": "condition"}, {"gdpr_value": "None", "target_value": "No explicit exceptions stated", "basis": "absent", "verdict": "covered", "citation": "—", "slot": "exception"}, {"gdpr_value": "None", "target_value": "No temporal element expressed", "basis": "absent", "verdict": "covered", "citation": "—", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "The Office receives and verifies complaints; may impose administrative sanctions upon proven violations", "basis": "distributed", "verdict": "broader", "citation": "Article 24(2)-(3)", "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.78, "reasoning_note": "UAE PDPL Article 24(1) grants data subjects a right to lodge a complaint with the Office when they believe there is a violation, which functionally covers the GDPR’s complaint right. However, the GDPR’s specific venue options (habitual residence, place of work, or of infringement) are not replicated—UAE law specifies only “to the Office,” making the scope narrower. The condition is broader in UAE law because it allows complaints for any violation of the Decree-Law, not only infringements relating to the complainant’s own data.", "label": "C4", "ru_id": "RU-907", "gdpr_article": 77, "jurisdiction": "UAE", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 8, "total": 20}, {"round": 3, "n_queries": 4, "new": 1, "total": 21}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "Incomplete and potentially inaccurate citation of Article 24(1) for the scope slot verdict", "counter_evidence": [{"id": "5d949837d7aab073cd67", "span": "المادة (24) تقديم الشكوى 1. لصاحب البيانات أن يتقدم إلى المكتب بشكوى، إذا كان لديه ما يحمله على الاعتقاد بوقوع أي مخالفة لأحكام هذا المرسوم بقانون، أو بأن المتحكم أو المعالج يقوم بمعالجة بياناته الشخصية بالمخالفة لأحكامه", "why": "Article 24(1) does not fully capture the scope of the complaint lodging right in the GDPR"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["5d949837d7aab073cd67", "717a67a0d311f88c5fd9", "e05de90f481c9410c6e0", "c34922f387019af45e42", "674524dee00496cb5de7", "5bedab371a9fc40ba93a", "877fafe0080725188d05", "ebfe638a86be87347658", "6201d16404c0d4b9f63d", "9d65c2815c41a25064db", "a079a5ac446830a74bfc", "743bfdd72ed773ff5ba9"], "n_llm_calls": 6, "latency_s": 471.64, "temperature": 0.7, "seed": 20260801, "id": "09a38521864aa6bd07b9", "condition": "stability", "rep": 0}
{"candidates_selected": [], "candidates_excluded": [{"id": "762372b7329c44286e43", "reason": "Sets lawful bases for processing; does not address a data subject’s judicial remedies or venue."}, {"id": "3d71a23a91370cadf799", "reason": "Regulates processing of criminal-case data; no right for data subjects to bring court proceedings or venue rules."}, {"id": "f8344697d1f1dc661161", "reason": "Conditions for processing sensitive data; no judicial remedy or forum provisions."}, {"id": "6b500d26673394f3d7e6", "reason": "Provides rights to rectification/blocking/erasure via controller requests; no court proceedings or venue."}, {"id": "98fa9fe9b0650c71a971", "reason": "Obligation to inform of right to object to direct marketing; unrelated to judicial remedies or venue."}, {"id": "652b328bac75ed18d3be", "reason": "Scope and territorial application (including habitual residence) but not a right to bring court proceedings or venue rules."}, {"id": "8cd7b777aa3cd8ca5f1f", "reason": "Authority powers to receive complaints/investigate (administrative); no data subject judicial remedy or venue."}, {"id": "eb633917dcbabe34df47", "reason": "Automated-decision rights; does not cover court proceedings or venue."}, {"id": "9bcb8d6e5e38974e2a1b", "reason": "Investigation committee’s power to obtain documents via court; not a data subject’s right to sue or venue."}, {"id": "5a79146e04b73c99685c", "reason": "Access right and complaint to authority; no judicial proceedings or venue."}, {"id": "6a403e591ecc2a5638fc", "reason": "DPO disciplinary investigation; irrelevant to data subject judicial remedies."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "data subject", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "addressee"}, {"gdpr_value": "power", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "modality"}, {"gdpr_value": "bring proceedings against a controller or processor before the courts of the Member State where the data subject has habitual residence", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr_value": "judicial proceedings under Article 79", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr_value": "unless the controller or processor is a public authority of a Member State acting in the exercise of its public powers", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.68, "reasoning_note": "None of the provided Bahrain PDPL provisions establish a data subject’s right to bring judicial proceedings or specify venue based on the data subject’s habitual residence. The texts focus on processing conditions, data subject requests, and administrative complaints to the authority. Therefore the GDPR venue right is not reflected in the cited target texts.", "label": "C5", "ru_id": "RU-917", "gdpr_article": 79, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 8, "total": 33}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["762372b7329c44286e43", "3d71a23a91370cadf799", "f8344697d1f1dc661161", "6b500d26673394f3d7e6", "98fa9fe9b0650c71a971", "652b328bac75ed18d3be", "8cd7b777aa3cd8ca5f1f", "eb633917dcbabe34df47", "5bd7541a2690632a7c77", "9bcb8d6e5e38974e2a1b", "5a79146e04b73c99685c", "6a403e591ecc2a5638fc"], "n_llm_calls": 4, "latency_s": 323.94, "temperature": 0.7, "seed": 20260801, "id": "843edd65f663baf36f64", "condition": "stability", "rep": 0}
{"candidates_selected": ["[3daba86dc4c13ff4e918]", "[1d8fd3d4070b1ff36d68]", "[8cd7b777aa3cd8ca5f1f]"], "candidates_excluded": [{"id": "[7e2914aa34ab2739dafd]", "reason": "Security of processing obligations; no requirement to consult or engage the authority based on DPIA outcomes."}, {"id": "[0dfa8d201a449ae5a66e]", "reason": "Technical and organizational security measures; no linkage to prior consultation with the authority."}, {"id": "[34ea02d93464e8e2fa05]", "reason": "Definitions; does not establish consultation duties."}, {"id": "[7448a27e7806f2c0c143]", "reason": "Data quality principles; unrelated to prior consultation or DPIA-triggered engagement."}, {"id": "[803cdc5aa2ea085c3461]", "reason": "International transfers framework; no DPIA-based prior consultation requirement."}, {"id": "[74358e437cd9e85fdabb]", "reason": "DPO functions include coordination with the authority generally, but no controller duty to consult the authority prior to processing due to DPIA high risk."}, {"id": "[6a403e591ecc2a5638fc]", "reason": "Procedural provisions on investigating DPO misconduct; not about controller consultation duties."}, {"id": "[3d71a23a91370cadf799]", "reason": "Rules for criminal data processing; no consultation duty tied to DPIA."}, {"id": "[f8344697d1f1dc661161]", "reason": "Sensitive data processing conditions; no DPIA-based prior consultation with the authority."}], "target_frame": {"addressee": {"span": "على مدير البيانات", "article": "Article 14(1)"}, "modality": {"span": "على مدير البيانات إخطار الهيئة", "article": "Article 14(1)"}, "action": {"span": "إخطار الهيئة", "article": "Article 14(1)"}, "scope": {"span": "قبل بدء عملية المعالجة التي تتم آلياً كلياً أو جزئياً، أو لمجموعة عمليات من ذلك بقصد تحقيق غرض واحد أو عدة أغراض ذات صلة ببعضها", "article": "Article 14(1)"}, "condition": {"span": null, "article": null}, "exception": {"span": "ويُعفى مدير البيانات من تقديم الإخطار المشار إليه بشأن ما يأتي: أ - المعالَجة التي يكون الغرض الوحيد منها إمساك سجل وفقاً للقانون... ب - معالجة البيانات التي تتم في سياق أنشطة الجمعيات... ج - معالجة صاحب العمل لبيانات العاملين لديه... د - الحالات التي يتم فيها تعيين مراقب حماية بيانات.", "article": "Article 14(1)(أ–د)"}, "temporal": {"span": "قبل بدء عملية المعالجة", "article": "Article 14(1)"}, "consequence": {"span": "وللهيئة خلال عشرة أيام عمل ... أن تطلب ... استيفاء أيّ نقص ... وعلى مقدِّم الطلب التوقف عن المعالَجة لحين استيفاء النقص بالإخطار.", "article": "Article 14(4)"}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "مدير البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 14(1)", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "على (duty) – \"على مدير البيانات إخطار الهيئة\"", "basis": "direct_textual", "verdict": "covered", "citation": "Article 14(1)", "slot": "modality"}, {"gdpr_value": "consult the supervisory authority", "target_value": "إخطار الهيئة (notify the authority); no duty to consult the authority", "basis": "direct_textual", "verdict": "uncovered", "citation": "Article 14(1)", "slot": "action"}, {"gdpr_value": "intended processing", "target_value": "processing that is automated wholly or partly", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 14(1)", "slot": "scope"}, {"gdpr_value": "where a DPIA indicates high risk absent mitigating measures", "target_value": "No condition linking DPIA outcome to authority engagement", "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": "Exemptions from notification (public registers; nonprofits; employer HR; where a DPO is appointed)", "basis": "direct_textual", "verdict": "broader", "citation": "Article 14(1)(أ–د)", "slot": "exception"}, {"gdpr_value": "prior to processing", "target_value": "قبل بدء عملية المعالجة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 14(1)", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "Stop processing until notification is completed upon authority’s request to cure deficiencies", "basis": "direct_textual", "verdict": "broader", "citation": "Article 14(4)", "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.58, "reasoning_note": "Bahrain’s law contains related mechanisms (mandatory DPIA in specified high-risk scenarios and a general prior notification duty to the authority), but it does not require the controller to consult the authority when a DPIA shows a high residual risk. The authority engagement is via notification (and in some cases prior permits under another article), not DPIA-triggered consultation. Hence coverage is partial rather than entirely absent.", "label": "C4", "ru_id": "RU-415", "gdpr_article": 36, "jurisdiction": "BHR", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 11, "total": 23}, {"round": 3, "n_queries": 4, "new": 7, "total": 30}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Potential implicit requirement for consultation or notification in cases of high risk", "counter_evidence": [{"id": "3daba86dc4c13ff4e918", "span": "Article 3: تقييم أثر حماية البيانات (Data Protection Impact Assessment)", "why": "Implicit requirement for evaluating risks and potential consultation"}, {"id": "1d8fd3d4070b1ff36d68", "span": "Article 14: إخطار الهيئة", "why": "Notification of the authority before the start of automated processing implies potential for consultation"}], "confidence": 0.7}, {"verdict": "revise", "objection": "The analyst's conclusion of no counterpart for consulting the supervisory authority based on a DPIA indicating high risk may be too absolute, given the presence of related mechanisms in the BHR law.", "counter_evidence": [{"id": "[3daba86dc4c13ff4e918]", "span": "Article 3", "why": "Discusses data protection impact assessment, suggesting a mechanism for assessing processing impact."}, {"id": "[1d8fd3d4070b1ff36d68]", "span": "Article 14", "why": "Requires notification to the authority before processing, including automated processing, indicating some form of authority engagement."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["7e2914aa34ab2739dafd", "3daba86dc4c13ff4e918", "1d8fd3d4070b1ff36d68", "0dfa8d201a449ae5a66e", "34ea02d93464e8e2fa05", "7448a27e7806f2c0c143", "803cdc5aa2ea085c3461", "74358e437cd9e85fdabb", "6a403e591ecc2a5638fc", "3d71a23a91370cadf799", "8cd7b777aa3cd8ca5f1f", "f8344697d1f1dc661161"], "n_llm_calls": 7, "latency_s": 658.26, "temperature": 0.7, "seed": 20260801, "id": "38a4f0694f4b868c83cb", "condition": "stability", "rep": 0}
{"candidates_selected": ["67a122f7dc547487996a", "d9a05a425b46428120ee", "04f45ac99bac1acaa486"], "candidates_excluded": [{"id": "f8c6dae3f69fbe207307", "reason": "Substantive rules on disclosure; no supervisory authority sanctioning power."}, {"id": "ea8306cd18f9261f6413", "reason": "Transparency/notice obligations; does not address supervisory authority fines."}, {"id": "3a56eed81feb3655d1d1", "reason": "Public-interest processing safeguards; not about supervisory authority sanctioning powers."}, {"id": "08b4c74d887bbe3b2039", "reason": "Credit-data processing specifics; unrelated to fines by a supervisory authority."}, {"id": "c511c9bf7779067e64f4", "reason": "Lawful bases for collection/processing; not about supervisory authority fines."}, {"id": "7ddbf4e54143664b8b8b", "reason": "Disclosure conditions; not about supervisory authority fines."}, {"id": "ce107f77eb9119ba01b0", "reason": "Privacy policy requirement; not about supervisory authority fines."}, {"id": "1fc3063dbbcf8d500da0", "reason": "Security measures; not about supervisory authority fines."}, {"id": "eef2332de931ce118731", "reason": "Retention/destruction; not about supervisory authority fines."}], "target_frame": {"addressee": {"span": "تكون الجهة المختصة الجهة المشرفة على تطبيق أحكام النظام واللوائح", "article": "Article 30(1)"}, "modality": {"span": "لجنة (أو أكثر) ... تتولى النظر في المخالفات وإيقاع عقوبة الإنذار أو الغرامة", "article": "Article 36(2)"}, "action": {"span": "تعاقب بالإنذار أو بغرامة لا تزيد على (خمسة ملايين) ريال", "article": "Article 36(1)"}, "scope": {"span": "تعاقب بالإنذار أو بغرامة لا تزيد على (خمسة ملايين) ريال ... وتجوز مضاعفة عقوبة الغرامة في حالة تكرار المخالفة", "article": "Article 36(1)"}, "condition": {"span": "وذلك بحسب نوع المخالفة المرتكبة وجسامتها ومدى تأثيرها", "article": "Article 36(2)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": "وتجوز مضاعفة عقوبة الغرامة في حالة تكرار المخالفة", "article": "Article 36(1)"}}, "slot_verdicts": [{"gdpr": "supervisory authority", "target": "الجهة المختصة (الجهة المشرفة)؛ لجنة مشكلة بقرار من رئيس الجهة المختصة تتولى الإيقاع بالعقوبات", "basis": "distributed", "verdict": "covered", "citation": "Art. 30(1); Art. 36(2)", "slot": "addressee"}, {"gdpr": "power", "target": "تتولى ... إيقاع عقوبة", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 36(2)", "slot": "modality"}, {"gdpr": "impose an administrative fine", "target": "إيقاع عقوبة ... الغرامة", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 36(1)-(2)", "slot": "action"}, {"gdpr": "pursuant to Article 83, in addition to or instead of the measures referred to in paragraph 2", "target": "الإنذار أو الغرامة حتى خمسة ملايين ريال؛ لا نص على إمكان الجمع مع تدابير إشرافية أخرى أو بدليتها منها", "basis": "direct_textual", "verdict": "partial", "citation": "Art. 36(1)-(2); Art. 30(4)", "slot": "scope"}, {"gdpr": "depending on the circumstances of each individual case", "target": "بحسب نوع المخالفة المرتكبة وجسامتها ومدى تأثيرها", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 36(2)", "slot": "condition"}, {"gdpr": "None", "target": "لا يوجد نص استثناء ذي صلة", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr": "None", "target": "لا يوجد نص زمني ذي صلة", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": "تجوز مضاعفة عقوبة الغرامة في حالة تكرار المخالفة", "basis": "direct_textual", "verdict": "broader", "citation": "Art. 36(1)", "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.66, "reasoning_note": "KSA PDPL empowers the competent authority (via its committee) to impose administrative fines and to calibrate them to case circumstances. However, the text does not state that a fine may be imposed in addition to or instead of other supervisory measures; it only provides an alternative between warning or fine, addressing the reviewer’s objection.", "label": "C2", "ru_id": "RU-147", "gdpr_article": 17, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 17, "total": 29}, {"round": 3, "n_queries": 4, "new": 2, "total": 31}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The target jurisdiction's provisions do not fully align with the GDPR requirement, as the power to impose an administrative fine is limited to imposing a warning or a fine, and the penalty scope is narrower.", "counter_evidence": [{"id": "67a122f7dc547487996a", "span": "تتولى النظر في المخالفات وإيقاع عقوبة الإنذار أو الغرامة", "why": "The power to impose an administrative fine is limited to imposing a warning or a fine."}, {"id": "67a122f7dc547487996a", "span": "تُعاقب بالإنذار أو بغرامة لا تزيد على (خمسة ملايين) ريال", "why": "The penalty scope is narrower than the GDPR requirement."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's claim that the target jurisdiction has a provision that allows for the imposition of an administrative fine 'in addition to or instead of the measures referred to in paragraph 2' is not fully supported.", "counter_evidence": [{"id": "67a122f7dc547487996a", "span": "تُعاقب بالإنذار أو بغرامة لا تزيد على (خمسة ملايين) ريال", "why": "This provision only mentions the fine as a possible penalty, but it does not explicitly state that it can be imposed in addition to or instead of other measures."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["f8c6dae3f69fbe207307", "ea8306cd18f9261f6413", "3a56eed81feb3655d1d1", "08b4c74d887bbe3b2039", "c511c9bf7779067e64f4", "7ddbf4e54143664b8b8b", "ce107f77eb9119ba01b0", "04f45ac99bac1acaa486", "1fc3063dbbcf8d500da0", "d9a05a425b46428120ee", "67a122f7dc547487996a", "eef2332de931ce118731"], "n_llm_calls": 7, "latency_s": 597.73, "temperature": 0.7, "seed": 20260801, "id": "ff6a755647f1c902468a", "condition": "stability", "rep": 0}
{"candidates_selected": ["dec351a1e477287e3b22", "34f7595acb9df257ef5e", "9c38ab11b550755816f5"], "candidates_excluded": [{"id": "5d949837d7aab073cd67", "reason": "Complaints to the Office; no rule on controllers designating a data-subject contact point or joint controller arrangements."}, {"id": "e05de90f481c9410c6e0", "reason": "Personal data breach notification; no relevance to joint controllers or designation of a data-subject contact point."}, {"id": "0cc06e3d3b107448da5a", "reason": "Processor obligations; a clause on multiple processors’ contracts, not joint controllers or a data-subject contact point."}, {"id": "80f95c322bb3204c7f65", "reason": "Consent conditions; no rule about controller contact points or joint controller arrangements."}, {"id": "c34922f387019af45e42", "reason": "Automated decision-making rights; no rule about controller contact points or joint controller arrangements."}, {"id": "6201d16404c0d4b9f63d", "reason": "Cross-border transfers (no adequate level); unrelated to joint controllers or designating a contact point."}, {"id": "a079a5ac446830a74bfc", "reason": "Cross-border transfers (adequate level); unrelated to joint controllers or designating a contact point."}, {"id": "674524dee00496cb5de7", "reason": "General controller obligations; does not provide for designating a data-subject contact point or joint controller arrangements."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "Processing principles; no operative rule on contact points or joint controller arrangements."}], "target_frame": {"addressee": {"span": "المتحكم", "article": "المادة (19)"}, "modality": {"span": "على المتحكم", "article": "المادة (19)"}, "action": {"span": "توفير طرق وآليات مناسبة وواضحة لتمكين صاحب البيانات من التواصل معه", "article": "المادة (19)"}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "joint controllers", "target_value": "المتحكم", "basis": "direct_textual", "verdict": "broader", "citation": "المادة (19): \"على المتحكم توفير طرق وآليات مناسبة وواضحة...\""}, {"slot": "modality", "gdpr_value": "permission", "target_value": "obligation on the controller to provide communication channels; separate permission for the data subject to contact the DPO", "basis": "distributed", "verdict": "partial", "citation": "المادة (19): \"على المتحكم...\"؛ المادة (12)(2): \"لصاحب البيانات التواصل مباشرة مع مسؤول حماية البيانات...\""}, {"slot": "action", "gdpr_value": "designate in the arrangement a contact point for data subjects", "target_value": "provide ways for data subjects to contact the controller; data subject may directly contact the DPO who receives requests/complaints", "basis": "distributed", "verdict": "partial", "citation": "المادة (19): \"توفير طرق وآليات مناسبة وواضحة لتمكين صاحب البيانات من التواصل معه\"؛ المادة (11)(ب): \"تلقي الطلبات والشكاوى المتعلقة بالبيانات الشخصية\"؛ المادة (12)(2): \"لصاحب البيانات التواصل مباشرة مع مسؤول حماية البيانات\""}, {"slot": "scope", "gdpr_value": "the arrangement between the joint controllers", "target_value": "no mention of any arrangement between joint controllers", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "condition", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.63, "reasoning_note": "UAE PDPL requires controllers to provide means for data subjects to contact them and enables data subjects to contact the DPO, who receives requests and complaints. However, the texts do not address joint controllers or any arrangement between them to designate a single contact point. Thus, there is functional overlap on “contact point” but not on the joint-controller/arrangement aspect.", "label": "C4", "ru_id": "RU-216", "gdpr_article": 26, "jurisdiction": "UAE", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 5, "total": 5}, {"round": 2, "n_queries": 4, "new": 10, "total": 15}, {"round": 3, "n_queries": 4, "new": 1, "total": 16}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The UAE provisions do not explicitly mention 'joint controllers' or 'designating a contact point,' and the modality claim is unsupported by the modal wording.", "counter_evidence": [{"id": "dec351a1e477287e3b22", "span": "المادة (19) طرق التواصل مع المتحكم على المتحكم توفير طرق وآليات مناسبة وواضحة لتمكين صاحب البيانات من التواصل معه وطلب ممارسة أي من حقوقه المنصوص عليها في هذا المرسوم بقانون", "why": "This article provides methods for data subjects to communicate with the controller, but does not explicitly mention 'joint controllers' or 'designating a contact point.'"}, {"id": "9c38ab11b550755816f5", "span": "المادة (12) واجبات المتحكم والمعالج تجاه مسؤول حماية البيانات... 2. لصاحب البيانات التواصل مباشرة مع مسؤول حماية البيانات بكل ما يتعلق ببياناته الشخصية ومعالجتها لتمكينه من ممارسة حقوقه وفقاً لأحكام هذا المرسوم بقانون", "why": "This article provides methods for data subjects to communicate with the data protection officer, but does not explicitly mention 'joint controllers' or 'designating a contact point.'"}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's label C2 does not accurately reflect the match between the GDPR requirement and the UAE provisions.", "counter_evidence": [{"id": "dec351a1e477287e3b22", "span": "المادة (19) طرق التواصل مع المتحكم على المتحكم توفير طرق وآليات مناسبة وواضحة لتمكين صاحب البيانات من التواصل معه وطلب ممارسة أي من حقوقه المنصوص عليها في هذا المرسوم بقانون", "why": "This provision implies that the controller must provide a means for data subjects to communicate with them and exercise their rights."}, {"id": "9c38ab11b550755816f5", "span": "المادة (12) واجبات المتحكم والمعالج تجاه مسؤول حماية البيانات", "why": "This provision mentions the role of the data protection officer, which could be seen as a contact point for data subjects."}, {"id": "34f7595acb9df257ef5e", "span": "المادة (11) أدوار مسؤول حماية البيانات", "why": "This provision further describes the role of the data protection officer, which could be seen as a contact point for data subjects."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["5d949837d7aab073cd67", "e05de90f481c9410c6e0", "9c38ab11b550755816f5", "dec351a1e477287e3b22", "0cc06e3d3b107448da5a", "80f95c322bb3204c7f65", "c34922f387019af45e42", "6201d16404c0d4b9f63d", "a079a5ac446830a74bfc", "34f7595acb9df257ef5e", "674524dee00496cb5de7", "3cc10eb2dd7e95bdd0c2"], "n_llm_calls": 7, "latency_s": 618.68, "temperature": 0.7, "seed": 20260801, "id": "c5b37552a5e611610357", "condition": "stability", "rep": 0}
{"candidates_selected": ["5d949837d7aab073cd67", "0897840c01b58a706cd5"], "candidates_excluded": [{"id": "674524dee00496cb5de7", "reason": "Sets general controller obligations; does not establish civil liability for damages or compensation."}, {"id": "3cc10eb2dd7e95bdd0c2", "reason": "Processing principles only; no provision on controller liability for damage."}, {"id": "57844ac856d11c289650", "reason": "Lists lawful bases/exemptions from consent; no rule on liability for damages."}, {"id": "0cc06e3d3b107448da5a", "reason": "Processor obligations and potential joint responsibility among processors; does not create controller liability for damages to data subjects."}, {"id": "877fafe0080725188d05", "reason": "Data subject rights (rectification/erasure); no civil liability or damages remedy."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Scope and exclusions; no liability rule."}, {"id": "c34922f387019af45e42", "reason": "Automated decision-making rights; no liability for damages."}, {"id": "e05de90f481c9410c6e0", "reason": "Breach notification duties and possibility of administrative sanctions; no civil damages liability."}, {"id": "9c38ab11b550755816f5", "reason": "DPO-related duties; no liability for damages."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restrict processing; no liability for damages."}], "target_frame": {"addressee": {"span": "المتحكم أو المعالج", "article": "Article 24(3)"}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": "في حال ثبوت مخالفة المتحكم أو المعالج لأحكامه", "article": "Article 24(3)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": "للمكتب توقيع الجزاءات الإدارية المشار إليها في المادة (26)", "article": "Article 24(3); Article 26"}}, "slot_verdicts": [{"gdpr_value": "controller involved in processing", "target_value": "المتحكم أو المعالج", "basis": "direct_tex