{"candidates_selected": ["ce107f77eb9119ba01b0", "6f4fee23b0aedf942410", "08b4c74d887bbe3b2039"], "candidates_excluded": [{"id": "ba8aef540689169aa848", "reason": "Regulates indirect collection and related safeguards by controllers; does not impose requirements on legislators to include categories of personal data in legislative measures."}, {"id": "7780dca28ee02b6e0f07", "reason": "Addresses guardian consent and representation for minors/incapacitated persons; no requirement about legislative measures specifying categories of data."}, {"id": "c511c9bf7779067e64f4", "reason": "Sets controller-level bases and exceptions for collection/processing; does not require that statutes include specific provisions on categories of personal data."}, {"id": "fa368b0d433d7765b715", "reason": "General non-derogation clause; no operative obligation for legislators to specify data categories."}, {"id": "90da7bc2380e8f3f2fb8", "reason": "Controller duty to respond to data subject requests; unrelated to legislative content requirements."}, {"id": "3e9d037ae7bf1b125ff2", "reason": "Cross-border transfer framework; no requirement to include data-category specifications in laws."}, {"id": "06b918a4049719ed530f", "reason": "Accreditation/audit and oversight mechanics; does not address legislative drafting content on categories of data."}, {"id": "557230873031d6e5cb2c", "reason": "Permits marketing processing with consent; no rule about specifying categories in legislative measures."}, {"id": "33d22a1a65039b5be3f9", "reason": "Definitions; does not create an obligation for legislators to include categories of personal data in restrictions."}], "target_frame": {"addressee": {"span": "على جهة التحكم", "article": "Article 12 (ce107f77eb9119ba01b0)"}, "modality": {"span": "على", "article": "Article 12 (ce107f77eb9119ba01b0)"}, "action": {"span": "أن تعتمد سياسة للخصوصية، وأن تجعلها متاحة لأصحاب البيانات الشخصية ليطلعوا عليها عند جمع بياناتهم. على أن تشتمل تلك السياسة على تحديد الغرض من جمعها، ومحتوى البيانات الشخصية المطلوب جمعها", "article": "Article 12 (ce107f77eb9119ba01b0)"}, "scope": {"span": "عند جمع بياناتهم", "article": "Article 12 (ce107f77eb9119ba01b0)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "Union or Member State legislator", "target_value": "على جهة التحكم", "basis": "direct_textual", "verdict": "uncovered", "citation": "Article 12 (ce107f77eb9119ba01b0)", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "على", "basis": "direct_textual", "verdict": "covered", "citation": "Article 12 (ce107f77eb9119ba01b0)", "slot": "modality"}, {"gdpr_value": "ensure the legislative measure contains specific provisions as to the categories of personal data", "target_value": "السياسة تشمل \"محتوى البيانات الشخصية المطلوب جمعها\"", "basis": "conceptual", "verdict": "partial", "citation": "Article 12 (ce107f77eb9119ba01b0)", "slot": "action"}, {"gdpr_value": "any legislative measure adopted under Article 23(1)", "target_value": "عند جمع بياناتهم (سياسة خصوصية على مستوى جهة التحكم)", "basis": "direct_textual", "verdict": "uncovered", "citation": "Article 12 (ce107f77eb9119ba01b0)", "slot": "scope"}, {"gdpr_value": "where relevant", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.63, "reasoning_note": "Article 12 requires controllers to specify the content of personal data in their privacy policies, which conceptually touches on specifying data categories but operates at the controller-policy level, not at the level of legislative measures restricting rights. Articles 9 and 24 address restrictions and regulatory content generally, yet none impose on the legislator a duty to ensure that such laws specify categories of personal data. Therefore, there is related coverage but a gap remains on the legislator-focused requirement.", "label": "C2", "ru_id": "RU-197", "gdpr_article": 23, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 11, "total": 23}, {"round": 3, "n_queries": 4, "new": 3, "total": 26}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Potential for indirect or implied requirements, and the need for further clarification on legislative measures and data categorization.", "counter_evidence": [{"id": "c511c9bf7779067e64f4", "span": "المادة العاشرة: لا يجوز لجهة التحكم جمع البيانات الشخصية إلا من صاحبها مباشرة، ولا تجوز كذلك معالجة تلك البيانات إلا لتحقيق الغرض الذي جمعت من أجله.", "why": "Article 10 discusses data collection and processing but does not explicitly address legislative measures and data categorization."}, {"id": "33d22a1a65039b5be3f9", "span": "المادة الأولى: التعريفات تكون للكلمات والعبارات الواردة في هذه اللائحة المعاني الموضحة أمام كل منها في المادة (الأولى) من نظام حماية البيانات الشخصية", "why": "Article 1 provides definitions and references to other regulations, potentially implying a broader legal framework that could address the GDPR requirement indirectly."}], "confidence": 0.6}, {"verdict": "revise", "objection": "The analyst's label C5 is too broad, as there are provisions in the KSA jurisdiction that address related concepts.", "counter_evidence": [{"id": "ce107f77eb9119ba01b0", "span": "محتوى البيانات الشخصية المطلوب جمعها", "why": "This provision requires the controller to specify the content of the personal data to be collected, which is similar to the GDPR requirement."}, {"id": "6f4fee23b0aedf942410", "span": "المادة التاسعة", "why": "This article outlines the conditions under which personal data can be collected and processed, including situations where the collection or processing is necessary for the public interest, national security, or the implementation of another law."}, {"id": "08b4c74d887bbe3b2039", "span": "المادة الرابعة والعشرون", "why": "This article states that the regulations will determine the additional controls and procedures for processing credit data, which includes ensuring the privacy of its owners and protecting their rights."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["ba8aef540689169aa848", "7780dca28ee02b6e0f07", "c511c9bf7779067e64f4", "fa368b0d433d7765b715", "90da7bc2380e8f3f2fb8", "3e9d037ae7bf1b125ff2", "08b4c74d887bbe3b2039", "6f4fee23b0aedf942410", "ce107f77eb9119ba01b0", "06b918a4049719ed530f", "557230873031d6e5cb2c", "33d22a1a65039b5be3f9"], "n_llm_calls": 7, "latency_s": 675.21, "temperature": 0.7, "seed": 20260803, "id": "f1b459db50076c3115b3", "condition": "stability", "rep": 2}
{"candidates_selected": ["3f916831456908af27d8", "de8d26aee9201d58a52b"], "candidates_excluded": [{"id": "b157dcadab6a3e8daf5f", "reason": "Data subject rights; does not concern supervisory authority powers or any certification mechanism."}, {"id": "2712fe4ebdba355a134b", "reason": "General consent rule; no relevance to certification or supervisory authority power to order non-issuance."}, {"id": "93f989531fe30cac1ed5", "reason": "Right to erasure; unrelated to certification bodies or supervisory authority control over certifications."}, {"id": "ae67f8fe376642167563", "reason": "Creates a permit requirement for special-category processing, not a certification scheme or certification bodies."}, {"id": "a2a61b7c9316716b7e74", "reason": "Disclosure prohibitions; no connection to certification or supervisory authority orders to certification bodies."}, {"id": "caad155111190c1aa274", "reason": "Definitions (including 'permit'); contains no certification mechanism and no relevant supervisory authority power."}, {"id": "a0040ee4dad7d4440e19", "reason": "Procedural details for obtaining a ministry permit; not a certification regime and no power to order certification bodies."}, {"id": "4053c4a22e1e688ad0dd", "reason": "Child data disclosure consent; unrelated to certification."}, {"id": "de5924c49336b5580d1e", "reason": "Representation for incapacitated persons; unrelated to certification."}, {"id": "99880e0b77b8d2601779", "reason": "Child consent for processing; unrelated to certification."}], "target_frame": {"addressee": {"span": "تتخذ الوزارة في سبيل حماية حقوق أصحاب البيانات الشخصية أياً من الإجراءات الآتية", "article": "Article 8"}, "modality": {"span": "أي إجراء آخر تراه الوزارة ضرورياً لحماية البيانات الشخصية", "article": "Article 8"}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": "يلغى التصريح في إحدى الحالات الآتية: ... 2- إذا ارتكب المتحكم مخالفة لأحكام القانون أو هذه اللائحة.", "article": "Article 10 (Reg.)"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "supervisory authority", "target_value": "الوزارة (the Ministry) as the competent authority taking measures", "basis": "direct_textual", "verdict": "covered", "citation": "Article 8"}, {"slot": "modality", "gdpr_value": "power", "target_value": "Discretionary authority to take necessary measures", "basis": "direct_textual", "verdict": "covered", "citation": "Article 8"}, {"slot": "action", "gdpr_value": "order the certification body not to issue a certification", "target_value": "No reference to ordering certification bodies or non-issuance of certifications", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "scope", "gdpr_value": "certifications under Articles 42 and 43", "target_value": "No certification scheme or certification bodies are mentioned", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "condition", "gdpr_value": "the requirements for the certification are not or are no longer met", "target_value": "Conditions for cancelling a ministry permit (e.g., violation of the law), not conditions for certification issuance/non-issuance", "basis": "absent", "verdict": "uncovered", "citation": "Article 10 (Reg.)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "No expressed framework for certification-related orders; thus no defined exceptions", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "No temporal element stated for any certification-related power", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "No consequence specified regarding certification orders", "basis": "absent", "verdict": "uncovered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.81, "reasoning_note": "The target texts grant the Ministry broad enforcement powers and contain a separate permit regime, but they do not establish a certification mechanism or powers vis-à-vis certification bodies. Therefore, the specific GDPR power to order a certification body not to issue a certification is absent.", "label": "C2", "ru_id": "RU-146", "gdpr_article": 17, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 17, "total": 29}, {"round": 3, "n_queries": 4, "new": 5, "total": 34}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["3f916831456908af27d8", "b157dcadab6a3e8daf5f", "2712fe4ebdba355a134b", "93f989531fe30cac1ed5", "ae67f8fe376642167563", "a2a61b7c9316716b7e74", "caad155111190c1aa274", "a0040ee4dad7d4440e19", "4053c4a22e1e688ad0dd", "de5924c49336b5580d1e", "de8d26aee9201d58a52b", "99880e0b77b8d2601779"], "n_llm_calls": 4, "latency_s": 406.58, "temperature": 0.7, "seed": 20260803, "id": "247fa67c7f7a81d605ef", "condition": "stability", "rep": 2}
{"candidates_selected": ["b157dcadab6a3e8daf5f", "546cfd19de051c612c06", "40626451a5025d77cff5"], "candidates_excluded": [{"id": "93f989531fe30cac1ed5", "reason": "Concerns erasure (right to deletion) rather than rectification."}, {"id": "d0bb19cb0c67952144b4", "reason": "Concerns data portability, not rectification."}, {"id": "4ddc7494f19d84324dd8", "reason": "Concerns right to obtain a copy, not rectification."}, {"id": "3a6219e8839cbad1f76e", "reason": "Breach notification obligation; unrelated to rectification right."}, {"id": "a4136d70ee84d058ef85", "reason": "Concerns publication of DPO contact details; not about rectification."}, {"id": "2712fe4ebdba355a134b", "reason": "General consent/processing principles; does not establish rectification right."}, {"id": "dcd007160208896c8632", "reason": "Breach notification to authority; not rectification."}, {"id": "a0a0194dd91481c29c6e", "reason": "Controller’s internal controls; no rectification right."}, {"id": "6e6fc1f4d7421fb141d6", "reason": "Appointment of DPO; not rectification."}], "target_frame": {"addressee": {"span": "لصاحب البيانات الشخصية", "article": "[b157dcadab6a3e8daf5f] Art. 11"}, "modality": {"span": "يكون لصاحب البيانات الشخصية الحق", "article": "[b157dcadab6a3e8daf5f] Art. 11"}, "action": {"span": "طلب تعديل بياناته الشخصية أو تحديثها", "article": "[b157dcadab6a3e8daf5f] Art. 11(b)"}, "scope": {"span": "بياناته الشخصية", "article": "[b157dcadab6a3e8daf5f] Art. 11"}, "condition": {"span": "تقديم طلب كتابي للمتحكم", "article": "[546cfd19de051c612c06] Art. 16"}, "exception": {"span": null, "article": null}, "temporal": {"span": "يجب على المتحكم البت في الطلب خلال مدة لا تتجاوز (45) خمسة وأربعين يوماً من تاريخ تسلمه الطلب", "article": "[546cfd19de051c612c06] Art. 16"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "data subject", "target": "صاحب البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "[b157dcadab6a3e8daf5f] Art. 11", "slot": "addressee"}, {"gdpr": "right", "target": "الحق", "basis": "direct_textual", "verdict": "covered", "citation": "[b157dcadab6a3e8daf5f] Art. 11", "slot": "modality"}, {"gdpr": "obtain from the controller the rectification", "target": "طلب تعديل بياناته الشخصية أو تحديثها (ومذكور أيضاً: حق ... تصحيحها)", "basis": "distributed", "verdict": "partial", "citation": "[b157dcadab6a3e8daf5f] Art. 11(b); [40626451a5025d77cff5] Art. 14(e)", "slot": "action"}, {"gdpr": "inaccurate personal data concerning the data subject", "target": "بياناته الشخصية (دون تقييد بحالة عدم الدقة)", "basis": "direct_textual", "verdict": "broader", "citation": "[b157dcadab6a3e8daf5f] Art. 11(b)", "slot": "scope"}, {"gdpr": "None", "target": "تقديم طلب كتابي للمتحكم", "basis": "direct_textual", "verdict": "narrower", "citation": "[546cfd19de051c612c06] Art. 16", "slot": "condition"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr": "without undue delay", "target": "البَتّ في الطلب خلال 45 يوماً", "basis": "direct_textual", "verdict": "partial", "citation": "[546cfd19de051c612c06] Art. 16", "slot": "temporal"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.78, "reasoning_note": "OMN law recognizes a data subject’s right to request correction/amendment and mentions correction explicitly, but frames it as a request and sets a 45-day decision period. It does not expressly require the controller to rectify without undue delay or tie the right specifically to inaccuracy. Hence only partial equivalence to GDPR Art. 16.", "label": "C4", "ru_id": "RU-140", "gdpr_article": 16, "jurisdiction": "OMN", "ablation": "full", "direction": "broader", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 9, "total": 21}, {"round": 3, "n_queries": 4, "new": 4, "total": 25}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["93f989531fe30cac1ed5", "b157dcadab6a3e8daf5f", "d0bb19cb0c67952144b4", "4ddc7494f19d84324dd8", "a4136d70ee84d058ef85", "3a6219e8839cbad1f76e", "2712fe4ebdba355a134b", "546cfd19de051c612c06", "dcd007160208896c8632", "40626451a5025d77cff5", "a0a0194dd91481c29c6e", "6e6fc1f4d7421fb141d6"], "n_llm_calls": 4, "latency_s": 367.48, "temperature": 0.7, "seed": 20260803, "id": "7a2332461380531af50a", "condition": "stability", "rep": 2}
{"candidates_selected": ["2c020ba48e817e4f4c7a", "9f3112d28a1b850ba61f", "a418980931b429c7909a"], "candidates_excluded": [{"id": "62dc9e8ad2aa962982ad", "reason": "Consent and pre-contract information duties; does not address implementing technical/organizational measures or design/operational privacy and security obligations."}, {"id": "8df6b1810850e58a6a30", "reason": "Introductory/contextual text without operative obligations; not a provision imposing measures on processing."}], "target_frame": {"addressee": {"span": "على مقدم الخدمة اتخاذ الآتي", "article": "Article 5 (chapeau)"}, "modality": {"span": "يجب على مقدم الخدمة", "article": "Article 4 (chapeau)"}, "action": {"span": "توفير التدابير الأمنية المناسبة لحماية البيانات الشخصية ... بما في ذلك ... اختبار وتقييم فعالية التدابير التقنية والتنظيمية لضمان أمن المعالجة", "article": "Article 5(1) and 5(1.4)"}, "scope": {"span": "اتخاذ التدابير اللاحقة التي تكفل عدم ارتفاع المخاطر على حقوق وحريات الأشخاص أصحاب البيانات", "article": "Article 6(5)"}, "condition": {"span": "ويجب أن تكون هذه التدابير ملائمة لطبيعة ونطاق أنشطته وحساسية أي بيانات شخصية يتم جمعها وتخزينها", "article": "Article 5(1)"}, "exception": {"span": null, "article": null}, "temporal": {"span": "مراعاة الضوابط الخاصة بتصميم أو تغيير أو تطوير المنتجات والنظم والخدمات والتي من الممكن أن تؤثر على معالجة البيانات الشخصية", "article": "Article 5(6)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "controller", "target": "مقدم الخدمة", "basis": "conceptual", "verdict": "covered", "citation": "Article 5 (chapeau); Article 4 (chapeau)"}, {"slot": "modality", "gdpr": "obligation", "target": "يجب؛ على مقدم الخدمة اتخاذ", "basis": "direct_textual", "verdict": "covered", "citation": "Article 4 (chapeau); Article 5 (chapeau)"}, {"slot": "action", "gdpr": "implement appropriate technical and organisational measures for the processing", "target": "توفير التدابير الأمنية المناسبة ... بما في ذلك التدابير التقنية والتنظيمية وضمان أمن المعالجة", "basis": "direct_textual", "verdict": "covered", "citation": "Article 5(1), 5(1.4)"}, {"slot": "scope", "gdpr": "measures may include pseudonymisation and aim to meet GDPR requirements and protect data subjects’ rights", "target": "ضمان السرية والنزاهة والتوافر لأمن المعالجة؛ وتدابير تكفل عدم ارتفاع المخاطر على حقوق وحريات أصحاب البيانات", "basis": "distributed", "verdict": "partial", "citation": "Article 5(1.2), 5(1.4); Article 6(5)"}, {"slot": "condition", "gdpr": "taking into account state of the art, cost of implementation, nature, scope, context and purposes of processing, and risks of varying likelihood and severity for rights and freedoms", "target": "ملائمة التدابير لطبيعة ونطاق أنشطة مقدم الخدمة وحساسية البيانات؛ والالتزام بإدارة المخاطر", "basis": "distributed", "verdict": "partial", "citation": "Article 5(1) (nature/scope/sensitivity); Article 5(3) (إدارة المخاطر); Article 6(5) (حقوق وحريات)"}, {"slot": "exception", "gdpr": "None", "target": "No exception language identified limiting the obligation to implement measures", "basis": "absent", "verdict": "covered", "citation": "No exceptions in Articles 4–6 relevant to this duty"}, {"slot": "temporal", "gdpr": "both at design (determination of means) and at the time of processing", "target": "ضوابط التصميم أو التغيير أو التطوير (تصميم)؛ وضمان السرية المستمرة واختبار وتقييم الفعالية (تشغيل/أثناء المعالجة)", "basis": "distributed", "verdict": "covered", "citation": "Article 5(6); Article 5(1.2), 5(1.4)"}, {"slot": "consequence", "gdpr": "None", "target": "No specific consequence attached to the design/operational measures duty in the cited provisions", "basis": "absent", "verdict": "covered", "citation": "Articles 4–6"}], "holistic_label": "partial", "confidence": 0.74, "reasoning_note": "The target texts impose an obligation on service providers to implement appropriate technical and organisational measures at both design and operational stages, largely aligning with Art. 25’s core duty. However, the condition factors are only partially articulated: Kuwait’s provisions reference nature/scope/sensitivity and risk management, but not state of the art or cost of implementation, and rights/freedoms are mentioned mainly in a post-breach context. This addresses the reviewer’s objection by marking the condition slot as partial with specific citations.", "label": "C2", "ru_id": "RU-209", "gdpr_article": 25, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 1, "total": 1}, {"round": 2, "n_queries": 4, "new": 3, "total": 4}, {"round": 3, "n_queries": 4, "new": 1, "total": 5}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's slot verdict for the condition 'taking into account state of the art, cost of implementation, nature, scope, context and purposes of processing, and risks of varying likelihood and severity for rights and freedoms' is 'narrower', but the provision only partially supports this verdict. Additionally, the scope of the measures is not comprehensively covered by the cited provisions.", "counter_evidence": [{"id": "2c020ba48e817e4f4c7a", "span": "Article 5(1) and (3)", "why": "The provision mentions the importance of considering the nature and scope of the activities and the sensitivity of the personal data, but it does not explicitly mention the 'state of the art' or 'cost of implementation' as factors to be considered."}, {"id": "a418980931b429c7909a", "span": "Article 6(5)", "why": "The provision only mentions the need to take measures to ensure that the risks to the rights and freedoms of individuals are not increased, but it does not provide a comprehensive overview of the scope of the measures."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The condition slot is not fully covered by the target jurisdiction's provisions.", "counter_evidence": [{"id": "2c020ba48e817e4f4c7a", "span": "Article 5(1)", "why": "The provision mentions the nature and scope of activities and data sensitivity but does not explicitly address the state of the art or cost of implementation."}, {"id": "a418980931b429c7909a", "span": "Article 6(5)", "why": "The provision relates to risk management but does not fully align with the condition specified in the GDPR requirement unit."}], "confidence": 0.8}], "n_candidates": 5, "candidate_ids": ["2c020ba48e817e4f4c7a", "a418980931b429c7909a", "9f3112d28a1b850ba61f", "62dc9e8ad2aa962982ad", "8df6b1810850e58a6a30"], "n_llm_calls": 7, "latency_s": 703.82, "temperature": 0.7, "seed": 20260803, "id": "3be9833facf380711ee5", "condition": "stability", "rep": 2}
{"candidates_selected": ["f5c366135483fe580381", "6c76988b817262e3e312"], "candidates_excluded": [{"id": "85d05fccf5b4f57eceaf", "reason": "General controller obligations and safeguards; no requirement to consult the supervisory authority and no DPIA-triggered consultation."}, {"id": "fcbd13532c69b340214e", "reason": "Precautions and processor-to-controller notifications; no consultation with supervisory authority and no DPIA context."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "Public-interest exemptions for a competent authority; not a controller duty to consult before high-risk processing."}, {"id": "75db9db720e9e34a1148", "reason": "Conditions for disclosure/transfer to a processor; unrelated to authority consultation or DPIA."}, {"id": "75852a697f66691bfbfb", "reason": "Exemptions from access rights; no relevance to prior consultation or DPIA."}, {"id": "192caaa530952a30ad50", "reason": "Powers of the competent administration; does not impose a controller pre-consultation obligation."}, {"id": "85e94dba24cbfb8955cd", "reason": "Data subject access rights; no authority consultation."}, {"id": "07962910da55dbce48d3", "reason": "Cross-border data flow restriction rule; not about consultation or DPIA."}, {"id": "89d1bb9a58e65b732117", "reason": "Transparency to the individual prior to processing; no supervisory authority consultation."}, {"id": "f169b712b14aea8718ee", "reason": "Lawful bases for processing; no DPIA or consultation requirement."}], "target_frame": {"addressee": {"span": "المراقب", "article": "f5c366135483fe580381"}, "modality": {"span": "يجب", "article": "f5c366135483fe580381"}, "action": {"span": "إعلام الفرد والإدارة المختصة، بحدوث أي إخلال بالاحتياطات المنصوص عليها في المادة السابقة", "article": "f5c366135483fe580381"}, "scope": {"span": null, "article": null}, "condition": {"span": "إذا كان من شأن ذلك إحداث ضرر جسيم بالبيانات الشخصية أو بخصوصية الفرد", "article": "f5c366135483fe580381"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "controller", "target": "المراقب", "basis": "direct_textual", "verdict": "covered", "citation": "Article 14", "slot": "addressee"}, {"gdpr": "obligation", "target": "يجب", "basis": "direct_textual", "verdict": "covered", "citation": "Article 14", "slot": "modality"}, {"gdpr": "consult the supervisory authority", "target": "إعلام ... الإدارة المختصة (إخطار الجهة المختصة بحدوث إخلال)", "basis": "conceptual", "verdict": "partial", "citation": "Article 14", "slot": "action"}, {"gdpr": "intended processing", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr": "where a DPIA under Article 35 indicates high risk absent mitigating measures", "target": "الإخلال بالاحتياطات الذي قد يسبب ضرراً جسيماً (حادث/خرق)", "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr": "prior to processing", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.74, "reasoning_note": "The Qatari texts do not establish DPIA-based prior consultation with the supervisory authority. The closest norms are breach notification to the competent department (Art. 14) and internal pre-processing privacy reviews (Art. 11), which do not satisfy the GDPR Art. 36 trigger, timing, or content. Therefore the requirement is substantively missing.", "label": "C2", "ru_id": "RU-415", "gdpr_article": 36, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 11, "total": 11}, {"round": 2, "n_queries": 4, "new": 3, "total": 14}, {"round": 3, "n_q