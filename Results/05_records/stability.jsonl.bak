is": "direct_textual", "verdict": "covered", "citation": "Article 9(4)"}, {"slot": "modality", "gdpr": "power", "target": "طلب المكتب مع التزام المعالج بالتزويد عند الطلب", "basis": "distributed", "verdict": "weaker_modality", "citation": "Article 8(7); Article 8(8); Article 9(1)(و)"}, {"slot": "action", "gdpr": "order the controller/processor/representative to provide any information required", "target": "تقديم سجلات المعالجة وإثباتات الالتزام وأية متطلبات إضافية تتعلق بالإخطار بالاختراق عند طلب المكتب", "basis": "distributed", "verdict": "narrower", "citation": "Article 8(7); Article 8(8); Article 9(1)(و)"}, {"slot": "scope", "gdpr": "investigative powers", "target": "التحقق من أسباب الانتهاك والاختراق؛ التزامات تزويد معلومات محددة", "basis": "distributed", "verdict": "narrower", "citation": "Article 9(4); Article 8(7)-(8)"}, {"slot": "condition", "gdpr": "Where applicable re representative; information is required for SA tasks", "target": "عند طلب المكتب ولأغراض محددة (السجلات، إثبات الالتزام، متطلبات إخطار الاختراق)", "basis": "distributed", "verdict": "partial", "citation": "Article 8(7)-(8); Article 9(1)(و)"}, {"slot": "exception", "gdpr": "None", "target": "No exception expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr": "None", "target": "No temporal element expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr": "None", "target": "No consequence expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.62, "reasoning_note": "There is no explicit, general GDPR-like power for the Office to order any information for all tasks. However, the law creates specific, request-based duties on processors/controllers to provide defined information to the Office (records, proof of compliance, breach-related data), which offers limited functional coverage. The representative aspect and an open-ended ‘any information’ 