tions": [], "n_candidates": 12, "candidate_ids": ["743bfdd72ed773ff5ba9", "3cc10eb2dd7e95bdd0c2", "fdfffc71ce002ff82134", "e05de90f481c9410c6e0", "0cc06e3d3b107448da5a", "5bedab371a9fc40ba93a", "c34922f387019af45e42", "9c38ab11b550755816f5", "5d949837d7aab073cd67", "9630e6d967b64e07d339", "34f7595acb9df257ef5e", "9d65c2815c41a25064db"], "n_llm_calls": 4, "latency_s": 357.05, "temperature": 0.7, "seed": 20260801, "id": "b74121d51ac16db5752a", "condition": "stability", "rep": 0}
