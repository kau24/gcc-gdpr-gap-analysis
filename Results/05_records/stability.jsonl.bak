{"candidates_selected": ["1f0de28c69e3ad65d235"], "candidates_excluded": [{"id": "34f7595acb9df257ef5e", "reason": "Addresses the role of the Data Protection Officer inside a controller/processor to ensure their compliance; it does not assign a supervisory authority a duty to monitor application across the territory."}, {"id": "9c38ab11b550755816f5", "reason": "Obligations of controllers/processors toward the DPO; no supervisory authority monitoring mandate."}, {"id": "674524dee00496cb5de7", "reason": "Controller obligations (including keeping/providing records to the Office on request); does not establish a supervisory authority duty to monitor."}, {"id": "717a67a0d311f88c5fd9", "reason": "Data subject right to information; not about supervisory authority monitoring."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment conditions; not a supervisory authority monitoring task."}, {"id": "dec351a1e477287e3b22", "reason": "Controller must provide contact means for data subjects; not a supervisory authority monitoring duty."}, {"id": "6201d16404c0d4b9f63d", "reason": "Cross‑border transfer conditions; no supervisory authority monitoring mandate."}, {"id": "0897840c01b58a706cd5", "reason": "Provides for Cabinet decisions on violations and administrative penalties; does not assign the supervisory authority a monitoring obligation."}, {"id": "0cc06e3d3b107448da5a", "reason": "Processor obligations (including providing information to the Office/instructions); no supervisory authority duty to monitor application."}, {"id": "c34922f387019af45e42", "reason": "Rights regarding automated decision‑making; unrelated to supervisory authority monitoring."}, {"id": "743bfdd72ed773ff5ba9", "reason": "Territorial/material scope of the law; does not impose a monitoring duty on the supervisory authority."}], "target_frame": {"addressee": {"span": "تفويض أي من الجهات الحكومية المحلية المختصة ... ببعض الاختصاصات المنوطة بالمكتب", "article": "Article 27"}, "modality": {"span": null,