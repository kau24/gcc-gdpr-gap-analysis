{"candidates_selected": [], "candidates_excluded": [{"id": "2bcce9feda2fcb9d35fe", "reason": "General right to protection of personal data; does not authorize or permit adoption of more specific rules for processing employees' data in the employment context, nor mention collective agreements."}, {"id": "85d05fccf5b4f57eceaf", "reason": "Sets general controller obligations and reference to privacy policies; does not provide a permission or framework to adopt special employment-specific processing rules or via collective agreements."}, {"id": "a200ece03fd0ba143354", "reason": "Authorizes the minister to set procedures for exercising data subject rights generally; not specific to the employment context and no role for collective agreements."}, {"id": "6c76988b817262e3e312", "reason": "Operational compliance duties for controllers; no authorization for employment-specific rules."}, {"id": "75db9db720e9e34a1148", "reason": "Conditions for disclosure/transfer to a processor; unrelated to permission for employment-context rules."}, {"id": "fcbd13532c69b340214e", "reason": "Security safeguards and breach notice to controller; no employment-specific rulemaking permission."}, {"id": "f5c366135483fe580381", "reason": "Breach notification to individuals and authority; not about authorizing specific employment rules."}, {"id": "07962910da55dbce48d3", "reason": "Cross-border data flow; not related to empowering more specific employment data rules."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "National security/public interest derogations; does not confer permission to create specific employment-processing rules."}, {"id": "32f2136681f29047cd6a", "reason": "Definitions; no operative permission concerning employment data rules or collective agreements."}, {"id": "dce663972f2d5e58176e", "reason": "Scope of the law; does not provide permission to adopt specific employment processing rules."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "a