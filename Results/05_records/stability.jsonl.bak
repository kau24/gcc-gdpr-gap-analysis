on": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "supervisory authority", "target_value": "الإدارة المختصة", "basis": "conceptual", "verdict": "covered", "citation": "Article 27", "slot": "addressee"}, {"gdpr_value": "obligation (shall)", "target_value": "أن تتخذ جميع الإجراءات اللازمة لذلك", "basis": "direct_textual", "verdict": "weaker_modality", "citation": "Article 27", "slot": "modality"}, {"gdpr_value": "approve codes of conduct", "target_value": "التنسيق مع المجموعات بهدف تشجيع وتطوير التنظيم الذاتي", "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr_value": "pursuant to Article 40(5)", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr_value": "where the codes of conduct provide sufficient safeguards", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.78, "reasoning_note": "The Qatari text empowers the competent authority to encourage self-regulation but does not provide an approval mechanism for codes of conduct or tie approval to safeguards. Key GDPR elements—mandatory approval, Article 40(5) linkage, and a safeguards condition—are absent. Overlap is limited to a general promotion of self-regulation.", "label": "C3", "ru_id": "RU-392", "gdpr_article": 35, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 9, "