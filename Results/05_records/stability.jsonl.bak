{"candidates_selected": ["85d05fccf5b4f57eceaf", "6c76988b817262e3e312", "fcbd13532c69b340214e", "455aae046cacf7979576", "dce663972f2d5e58176e", "850decaffbbae78d371d"], "candidates_excluded": [{"id": "75db9db720e9e34a1148", "reason": "Relates to disclosure/transfer alignment with legitimate purposes; does not address safeguards for research/statistics or measures to ensure data minimisation."}, {"id": "f5c366135483fe580381", "reason": "Breach notification duties; not about technical/organizational measures for data minimisation or research/statistical safeguards."}, {"id": "2bcce9feda2fcb9d35fe", "reason": "General right to privacy and processing principles; no specific obligation about safeguards or data minimisation measures."}, {"id": "89d1bb9a58e65b732117", "reason": "Transparency/information to data subjects; not about implementing safeguards or data minimisation measures."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "National security and related exemptions; unrelated to archiving/research/statistical safeguards or data minimisation."}, {"id": "07962910da55dbce48d3", "reason": "Cross‑border data flow; no bearing on safeguards for research/statistics or data minimisation measures."}], "target_frame": {"addressee": {"span": "يتعين على المراقب الالتزام بما يلي:", "article": "Article 8"}, "modality": {"span": "يجب على كل من المراقب والمعالج", "article": "Article 13"}, "action": {"span": "اتخاذ الاحتياطات الإدارية والفنية والمادية المناسبة لحماية البيانات الشخصية", "article": "Article 8(3)"}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "controllers", "target": "المراقب (controller) is explicitly addressed.", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 8"}, {"slot": "modality", "gdpr": "obligation", "target": "Mandatory language (يتعين/يجب).", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 8; Art. 13"}, {"slot": "action", "gdpr": "ensure technical and organisational measures are in place to respect the principle of data minimisation", "target": "Obligation to take administrative/technical/physical precautions to protect personal data; separate duty that collected data be relevant and sufficient for legitimate purposes.", "basis": "distributed", "verdict": "partial", "citation": "Art. 8(3); Art. 10"}, {"slot": "scope", "gdpr": "safeguards for processing under Article 89(1)", "target": "No distinct safeguards regime for archiving/research/statistical processing.", "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "condition", "gdpr": "when applying safeguards for processing for archiving in the public interest, scientific or historical research, or statistical purposes", "target": "No condition linking measures to those contexts; research in the public interest triggers exemptions, and official statistics are excluded from the law.", "basis": "direct_textual", "verdict": "uncovered", "citation": "Art. 19; Art. 2"}, {"slot": "exception", "gdpr": "None", "target": "No exception specified within the relevant obligation texts.", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr": "None", "target": "No temporal element specified.", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr": "None", "target": "No consequence specified.", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.62, "reasoning_note": "Qatari law imposes general technical/organizational measures (security) and a separate duty akin to data minimisation, but it does not tie measures to ensuring minimisation as a safeguard for archiving/research/statistics. Moreover, official statistics are excluded and public‑interest research is handled via exemptions, not safeguards.", "label": "C2", "ru_id": "RU-965", "gdpr_article": 89, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 8, "total": 8}, {"round": 2, "n_queries": 4, "new": 7, "total": 15}, {"round": 3, "n_queries": 4, "new": 0, "total": 15}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 0, "objections": [], "n_candidates": 12, "candidate_ids": ["85d05fccf5b4f57eceaf", "75db9db720e9e34a1148", "6c76988b817262e3e312", "fcbd13532c69b340214e", "f5c366135483fe580381", "455aae046cacf7979576", "2bcce9feda2fcb9d35fe", "89d1bb9a58e65b732117", "850decaffbbae78d371d", "dce663972f2d5e58176e", "3f5cc5a2c4af5fb90388", "07962910da55dbce48d3"], "n_llm_calls": 4, "latency_s": 543.16, "temperature": 0.7, "seed": 20260803, "id": "9ef81b7c70cad3511958", "condition": "stability", "rep": 2}
{"candidates_selected": ["2c020ba48e817e4f4c7a", "9f3112d28a1b850ba61f", "b983a5ed0e1c7a2b779a"], "candidates_excluded": [{"id": "e8fe267db21063b1b45f", "reason": "General scope of the regulation; does not address DPO functions or informing/training duties."}, {"id": "9b42add02f4d45cf8a57", "reason": "General enforcement and guidance provisions; not specific to a duty to inform or to DPO tasks."}], "target_frame": {"addressee": {"span": "على مقدم الخدمة اتخاذ الآتي:", "article": "Article 5 (chapeau)"}, "modality": {"span": "على مقدم الخدمة اتخاذ الآتي:", "article": "Article 5 (chapeau)"}, "action": {"span": "8. تحديد وتدريب وتوعية المسؤولين عن حماية البيانات الشخصية.", "article": "Article 5(8)"}, "scope": {"span": "يجب على مقدم الخدمة أثناء توفير الخدمة أو بعد انتهائها أن يقوم بجمع ومعالجة البيانات وفقاً للشروط التالية:", "article": "Article 4 (chapeau)"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data protection officer", "target_value": "Service provider (مقدم الخدمة); data protection officer mentioned only as a record entry (مسؤول حماية البيانات).", "basis": "distributed", "verdict": "partial", "citation": "Art. 5 chapeau; Art. 5(4.1)"}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "Obligatory language: \"على مقدم الخدمة اتخاذ الآتي\" (shall/ must).", "basis": "direct_textual", "verdict": "covered", "citation": "Art. 5 chapeau"}, {"slot": "action", "gdpr_value": "inform the controller or the processor and the employees who carry out processing of their data protection obligations", "target_value": "Identify, train, and raise awareness of those responsible for personal data protection.", "basis": "conceptual", "verdict": "partial", "citation": "Art. 5(8)"}, {"slot": "scope", "gdpr_value": "obligations under the GDPR and other Union or Member State data protection provisions", "target_value": "Collection and processing must comply with stated conditions and lawfulness requirements under the regulation.", "basis": "distributed", "verdict": "partial", "citation": "Art. 4 chapeau; Art. 3 chapeau"}, {"slot": "condition", "gdpr_value": "None", "target_value": "Not specified for this duty.", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": "Not specified for this duty.", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": "Not specified for this duty.", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "Not specified for this duty.", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "partial", "confidence": 0.56, "reasoning_note": "Article 5(8) creates an organizational duty to train/raise awareness of data-protection-responsible staff, which functionally overlaps with informing employees, and the regulation elsewhere sets the substantive obligations (Arts. 3–4). However, the Kuwait text assigns duties to the service provider rather than the DPO and does not expressly require informing the controller/processor or tie the training to legal obligations, hence only partial coverage.", "label": "C2", "ru_id": "RU-474", "gdpr_article": 39, "jurisdiction": "KWT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 2, "total": 2}, {"round": 2, "n_queries": 4, "new": 3, "total": 5}, {"round": 3, "n_queries": 4, "new": 0, "total": 5}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 2, "objections": [{"verdict": "revise", "objection": "The analyst's verdict of 'uncovered' for the 'addressee' and 'scope' slots may be too strict, as there are provisions in the KWT jurisdiction that could be considered as counterparts to the GDPR requirement.", "counter_evidence": [{"id": "2c020ba48e817e4f4c7a", "span": "المادة الخامسة: أمن وحماية البيانات الشخصية على مقدم الخدمة اتخاذ الآتي:", "why": "This article mentions the service provider, which could be considered as the controller or processor."}, {"id": "2c020ba48e817e4f4c7a", "span": "8. تحديد وتدريب وتوعية المسؤولين عن حماية البيانات الشخصية.", "why": "This provision seems to be related to the action of informing employees about their data protection obligations."}, {"id": "9f3112d28a1b850ba61f", "span": "المادة الثالثة: مشروعية جمع ومعالجة البيانات", "why": "This article mentions the lawfulness of collecting and processing data, which could be related to the scope of data protection obligations."}], "confidence": 0.7}], "n_candidates": 5, "candidate_ids": ["2c020ba48e817e4f4c7a", "9f3112d28a1b850ba61f", "b983a5ed0e1c7a2b779a", "9b42add02f4d45cf8a57", "e8fe267db21063b1b45f"], "n_llm_calls": 6, "latency_s": 647.0, "temperature": 0.7, "seed": 20260803, "id": "fc22a8694e7914dc6796", "condition": "stability", "rep": 2}
{"candidates_selected": ["d31b8876d3426a7c919a", "37d872c258760ad10ae9", "3a56eed81feb3655d1d1", "593beb6b1fe15a8fda31", "33d22a1a65039b5be3f9"], "candidates_excluded": [{"id": "ce107f77eb9119ba01b0", "reason": "Privacy policy content/transparency; does not impose design/operational technical-organisational measures."}, {"id": "0922609ffbfd96a70f90", "reason": "Erasure/right to deletion; not about implementing technical/organisational measures at design/operation."}, {"id": "ea8306cd18f9261f6413", "reason": "Collection notice duties; not a requirement to implement technical/organisational measures."}, {"id": "c511c9bf7779067e64f4", "reason": "Lawful basis/purpose limitation; does not address privacy by design/operation measures."}, {"id": "f8c6dae3f69fbe207307", "reason": "Disclosure conditions; not about controller’s design/operational measures."}, {"id": "d9a05a425b46428120ee", "reason": "Supervisory/DPO framework; not substantive TOMs at design/operation."}, {"id": "d29636711e8dc90e5e69", "reason": "Communication means for data subject requests; not TOMs."}], "target_frame": {"addressee": {"span": "على جهة التحكم", "article": "Article 22 (d31b8876d3426a7c919a)"}, "modality": {"span": "على جهة التحكم", "article": "Article 22 (d31b8876d3426a7c919a)"}, "action": {"span": "اتخاذ التدابير التنظيمية والإدارية والتقنية اللازمة لتجنب المخاطر", "article": "Article 9(1)(ج) (37d872c258760ad10ae9)"}, "scope": {"span": "تقدم ضمانات كافية لحماية البيانات الشخصية", "article": "Article 17(1) (593beb6b1fe15a8fda31)"}, "condition": {"span": "مع مراعاة التطورات التقنية وأساليب إخفاء الهوية وتحديثها ومواءمتها مع تلك التطورات", "article": "Article 9(1)(ج) (37d872c258760ad10ae9)"}, "exception": {"span": null, "article": null}, "temporal": {"span": "التحقق من التزام جهة المعالجة -بشكل دوري- بإجراء عمليات المعالجة", "article": "Article 17(3) (593beb6b1fe15a8fda31)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr": "controller", "target": "على جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 22 (d31b8876d3426a7c919a); also Article 17 (593beb6b1fe15a8fda31)"}, {"slot": "modality", "gdpr": "obligation", "target": "على جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 22 (d31b8876d3426a7c919a)"}, {"slot": "action", "gdpr": "implement appropriate technical and organisational measures for the processing", "target": "اتخاذ التدابير التنظيمية والإدارية والتقنية اللازمة لتجنب المخاطر / وضع الضوابط الإدارية والتقنية اللازمة", "basis": "distributed", "verdict": "partial", "citation": "Article 9(1)(ج) (37d872c258760ad10ae9); Article 21(3) (3a56eed81feb3655d1d1)"}, {"slot": "scope", "gdpr": "measures may include pseudonymisation and aim to meet GDPR requirements and protect data subjects’ rights", "target": "تقدم ضمانات كافية لحماية البيانات الشخصية; تعريف الترميز (pseudonymisation) موجود", "basis": "distributed", "verdict": "partial", "citation": "Article 17(1) (593beb6b1fe15a8fda31); Article 1(7) (33d22a1a65039b5be3f9)"}, {"slot": "condition", "gdpr": "taking into account the state of the art, the cost of implementation, the nature, scope, context and purposes of processing, and the risks of varying likelihood and severity for rights and freedoms of natural persons posed by the processing", "target": "مع مراعاة التطورات التقنية ...; إجراء تقويم للآثار المترتبة على معالجة البيانات الشخصية", "basis": "distributed", "verdict": "partial", "citation": "Article 9(1)(ج) (37d872c258760ad10ae9); Article 22 (d31b8876d3426a7c919a)"}, {"slot": "exception", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": "No exception stated in selected provisions"}, {"slot": "temporal", "gdpr": "both at the time of the determination of the means for processing and at the time of the processing itself", "target": "عند اختيار جهة المعالجة ... / التحقق من التزام جهة المعالجة -بشكل دوري-", "basis": "distributed", "verdict": "partial", "citation": "Article 17(1) and 17(3) (593beb6b1fe15a8fda31)"}, {"slot": "consequence", "gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": "No consequence stated in selected provisions"}], "holistic_label": "partial", "confidence": 0.64, "reasoning_note": "While there is no single clause enumerating all GDPR Art. 25 factors, the KSA texts require risk- and technology-aware measures in defined contexts: a DPIA for public-facing products/services (Art. 22) and, in anonymization, measures taken with regard to technological developments (Art. 9). They also require technical/organisational controls in certain scenarios and protections via adequate guarantees (Arts. 21, 17), but do not generalize these duties to all processing nor mention cost or full contextual factors.", "label": "C2", "ru_id": "RU-209", "gdpr_article": 25, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 13, "total": 25}, {"round": 3, "n_queries": 4, "new": 4, "total": 29}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The provisions do not explicitly mention the implementation of technical and organizational measures for the processing of personal data at both the design and operational stages.", "counter_evidence": [{"id": "d31b8876d3426a7c919a", "span": "المادة الثانية والعشرون: على جهة التحكم إجراء تقويم للآثار المترتبة على معالجة البيانات الشخصية لأي منتج أو خدمة تقدم للعموم بحسب طبيعة النشاط الذي تمارسه جهة التحكم", "why": "This article requires the controller to conduct an assessment of the impact of processing personal data, but it does not explicitly mention the implementation of technical and organizational measures."}, {"id": "3a56eed81feb3655d1d1", "span": "المادة الحادية والعشرون: ضوابط معالجة البيانات الشخصية لأغراض المصلحة العامة على الجهة العامة عند جمعها للبيانات الشخصية من غير صاحبها مباشرة أو معالجتها لغرض آخر غير الذي جمعت من أجله", "why": "This article provides guidelines for the processing of personal data for public interest purposes, but it does not explicitly address the implementation of technical and organizational measures."}], "confidence": 0.7}, {"verdict": "revise", "objection": "The provisions do not explicitly mention 'taking into account specified technological, economic, contextual and risk factors' as required by the GDPR proposition.", "counter_evidence": [{"id": "d31b8876d3426a7c919a", "span": "إجراء تقويم للآثار المترتبة على معالجة البيانات الشخصية", "why": "This provision implies that the controller should consider the potential effects of processing personal data, which could include technological, economic, contextual, and risk factors."}, {"id": "37d872c258760ad10ae9", "span": "اتخاذ التدابير التنظيمية والإدارية والتقنية اللازمة لتجنب المخاطر", "why": "This provision supports the idea of implementing measures to avoid risks, but it does not explicitly mention 'taking into account specified technological, economic, contextual and risk factors'."}, {"id": "37d872c258760ad10ae9", "span": "مع مراعاة التطورات التقنية", "why": "This provision supports the idea of considering technological factors when implementing measures."}], "confidence": 0.7}], "n_candidates": 12, "candidate_ids": ["ce107f77eb9119ba01b0", "d31b8876d3426a7c919a", "0922609ffbfd96a70f90", "ea8306cd18f9261f6413", "3a56eed81feb3655d1d1", "c511c9bf7779067e64f4", "f8c6dae3f69fbe207307", "d9a05a425b46428120ee", "593beb6b1fe15a8fda31", "d29636711e8dc90e5e69", "37d872c258760ad10ae9", "33d22a1a65039b5be3f9"], "n_llm_calls": 7, "latency_s": 855.25, "temperature": 0.7, "seed": 20260803, "id": "36b2de488479a0effca5", "condition": "stability", "rep": 2}
{"candidates_selected": ["85e94dba24cbfb8955cd", "6c76988b817262e3e312"], "candidates_excluded": [{"id": "75db9db720e9e34a1148", "reason": "Controller-to-processor disclosures; not a data-subject right to receive data."}, {"id": "f169b712b14aea8718ee", "reason": "Lawful basis for processing; does not grant a right to receive data in any format."}, {"id": "dce663972f2d5e58176e", "reason": "Applicability of the law; no operative right to receive data."}, {"id": "fca1aa50445ca4475333", "reason": "Withdraw/objection/erasure/correction rights; no right to obtain a copy in a specific format."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "National security and related exemptions from certain articles; not about data portability."}, {"id": "2bcce9feda2fcb9d35fe", "reason": "General privacy principle; no specific operative right matching portability."}, {"id": "f5c366135483fe580381", "reason": "Breach notification; unrelated to data-subject receipt of data."}, {"id": "07962910da55dbce48d3", "reason": "Cross-border data flow; not a data-subject receipt right."}, {"id": "85d05fccf5b4f57eceaf", "reason": "Controller obligations in general; does not specify subject's right to receive data or format."}], "target_frame": {"addressee": {"span": "للفرد", "article": "Article 6"}, "modality": {"span": "وله بوجه خاص الحق فيما يلي", "article": "Article 6"}, "action": {"span": "الحصول على نسخة من بياناته الشخصية", "article": "Article 6(3)"}, "scope": {"span": "بياناته الشخصية", "article": "Article 6"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": "في أي وقت", "article": "Article 6"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data subject", "target_value": "للفرد", "basis": "direct_textual", "verdict": "covered", "citation": "Article 6: \"للفرد\""}, {"slot": "modality", "gdpr_value": "right", "target_value": "وله بوجه خاص الحق", "basis": "direct_textual", "verdict": "covered", "citation": "Article 6: \"وله بوجه خاص الحق\""}, {"slot": "action", "gdpr_value": "receive the personal data provided to a controller in a structured, commonly used and machine-readable format", "target_value": "الحصول على نسخة من بياناته الشخصية (لا ذكر لصيغة منظمة أو شائعة أو قابلة للقراءة آلياً). تمكين الوصول والمراجعة والتصحيح باستخدام الوسائل التكنولوجية المناسبة", "basis": "distributed", "verdict": "partial", "citation": "Article 6(3): \"الحصول على نسخة من بياناته الشخصية\"; Article 11(6): \"استخدام الوسائل التكنولوجية المناسبة لتمكين الأفراد من ممارسة حقهم في الوصول...\""}, {"slot": "scope", "gdpr_value": "Personal data concerning the data subject that the data subject has provided to a controller; format must be structured, commonly used and machine-readable; exercise without prejudice to Article 17", "target_value": "بياناته الشخصية (غير مقيدة بما قدمه الفرد للمراقب، ولا توجد متطلبات لصيغة منظمة/شائعة/قابلة للقراءة آلياً، ولا إحالة إلى عدم الإخلال بحق الحذف)", "basis": "direct_textual", "verdict": "partial", "citation": "Article 6: \"بياناته الشخصية\""}, {"slot": "condition", "gdpr_value": "Processing based on consent or contract and carried out by automated means", "target_value": "لا شروط مماثلة منصوصاً عليها", "basis": "absent", "verdict": "uncovered", "citation": "No provision in the cited articles"}, {"slot": "exception", "gdpr_value": "No applicability for public interest/official authority tasks; exercise shall not adversely affect rights and freedoms of others", "target_value": "لا استثناءات مقابلة منصوصاً عليها في حق الحصول على نسخة", "basis": "absent", "verdict": "uncovered", "citation": "No provision in the cited articles"}, {"slot": "temporal", "gdpr_value": "None", "target_value": "في أي وقت", "basis": "direct_textual", "verdict": "covered", "citation": "Article 6: \"للفرد، في أي وقت\""}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None stated", "basis": "absent", "verdict": "covered", "citation": "No consequence specified in either text"}], "holistic_label": "partial", "confidence": 0.7, "reasoning_note": "Qatari law grants a right to access and to obtain a copy of personal data and to be enabled via technological means, but it does not specify the structured, commonly used, machine-readable format central to GDPR portability. It also lacks GDPR’s conditions (consent/contract and automated means) and the specific exceptions. The reviewer’s objection is valid: the format requirement is not expressed in the Qatari provisions.", "label": "C2", "ru_id": "RU-174", "gdpr_article": 20, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 7, "total": 7}, {"round": 2, "n_queries": 4, "new": 2, "total": 9}, {"round": 3, "n_queries": 4, "new": 2, "total": 11}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's claim of no counterpart for the exception 'Not applicable for tasks in the public interest/official authority; must not adversely affect others' rights and freedoms' is incorrect.", "counter_evidence": [{"id": "3f5cc5a2c4af5fb90388", "span": "حماية الأمن الوطني والأمن العام. 2- حماية العلاقات الدولية للدولة.", "why": "Article 18 provides an exception for processing personal data for tasks in the public interest or under official authority, which aligns with the GDPR requirement."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The Qatari law does not explicitly provide for the personal data to be in a structured, commonly used, and machine-readable format as required by the GDPR.", "counter_evidence": [{"id": "Article 6", "span": "للفرد، في أي وقت، الوصول إلى بياناته الشخصية وطلب مراجعتها", "why": "Does not specify the format of the personal data."}, {"id": "Article 11(6)", "span": "تمكين الأفراد باستخدام الوسائل التكنولوجية للوصول والمراجعة والتصحيح مباشرة", "why": "Implies machine-readable but does not explicitly mention structured and commonly used format."}], "confidence": 0.8}], "n_candidates": 11, "candidate_ids": ["75db9db720e9e34a1148", "85e94dba24cbfb8955cd", "f169b712b14aea8718ee", "dce663972f2d5e58176e", "fca1aa50445ca4475333", "3f5cc5a2c4af5fb90388", "2bcce9feda2fcb9d35fe", "f5c366135483fe580381", "07962910da55dbce48d3", "6c76988b817262e3e312", "85d05fccf5b4f57eceaf"], "n_llm_calls": 7, "latency_s": 855.45, "temperature": 0.7, "seed": 20260803, "id": "b4e8be8c8edbecfba84f", "condition": "stability", "rep": 2}
{"candidates_selected": ["62cc177254bb6a5bed90", "37d872c258760ad10ae9"], "candidates_excluded": [{"id": "e32b4ffefbc31a6a5072", "reason": "Confidentiality duty regarding data secrets; does not address security measures or pseudonymisation."}, {"id": "593beb6b1fe15a8fda31", "reason": "Processor selection and contractual controls; no requirement to include pseudonymisation as a security measure."}, {"id": "21847c9e87d6df45a9a7", "reason": "Data accuracy requirement; unrelated to security measures or pseudonymisation."}, {"id": "8394f801a0a97e521f68", "reason": "DPO appointment and tasks; not about technical/security measures such as pseudonymisation."}, {"id": "06b918a4049719ed530f", "reason": "Certification/auditing framework; no operative obligation on controllers to use pseudonymisation."}, {"id": "c511c9bf7779067e64f4", "reason": "Lawfulness and purpose change grounds; not a security-measures provision."}, {"id": "d29636711e8dc90e5e69", "reason": "Communication means for data subject requests; unrelated to security measures."}, {"id": "3074a33b0107bc8c40a0", "reason": "Definitions; no operative requirement to include pseudonymisation."}, {"id": "ce107f77eb9119ba01b0", "reason": "Privacy policy content; not an obligation to implement specific security measures."}, {"id": "f8f94d8d9d379713d656", "reason": "Record of processing activities; describes documentation, not implementation of pseudonymisation."}], "target_frame": {"addressee": {"span": "على جهة التحكم", "article": "Article 23"}, "modality": {"span": "على جهة التحكم اتخاذ", "article": "Article 23"}, "action": {"span": "اتخاذ التدابير التنظيمية والإدارية والتقنية اللازمة لضمان أمن البيانات الشخصية وخصوصية أصحابها", "article": "Article 23"}, "scope": {"span": "البيانات الشخصية", "article": "Article 23"}, "condition": {"span": "للحد من المخاطر الأمنية لحدوث تسرب البيانات الشخصية", "article": "Article 23"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "controller", "target_value": "جهة التحكم", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23: \"على جهة التحكم\""}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "على جهة التحكم اتخاذ", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23"}, {"slot": "action", "gdpr_value": "include pseudonymisation in the implemented security measures", "target_value": "اتخاذ التدابير الأمنية لضمان أمن البيانات الشخصية (لا ذكر صريح لإدراج إخفاء الهوية/التقنيع كإجراء أمني). وأحكام \"إخفاء الهوية\" في المادة 9 تُطبق فقط عند تنفيذ الإخفاء وبمفهوم يجعل إعادة التعرف غير ممكنة (أي إخفاء الهوية/إلغاء التعريف وليس التقنيع).", "basis": "absent", "verdict": "uncovered", "citation": "Article 23; Article 9(1)-(2)"}, {"slot": "scope", "gdpr_value": "personal data processed", "target_value": "البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23"}, {"slot": "condition", "gdpr_value": "as appropriate to the risk", "target_value": "تطبيق تدابير ضرورية \"للحد من المخاطر الأمنية لحدوث تسرب البيانات الشخصية\"", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 23(1)"}, {"slot": "exception", "gdpr_value": "None", "target_value": "لا استثناء مذكور", "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "temporal", "gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "consequence", "gdpr_value": "None", "target_value": "غير منصوص", "basis": "absent", "verdict": "covered", "citation": ""}], "holistic_label": "partial", "confidence": 0.66, "reasoning_note": "Article 9 governs إخفاء الهوية (anonymisation) and explicitly makes re-identification impossible and the result non-personal data, which is conceptually different from GDPR pseudonymisation. Article 23 imposes security measures but does not require inclusion or consideration of pseudonymisation. Therefore, there is no clear textual counterpart mandating pseudonymisation as a security measure; only general security obligations exist.", "label": "C2", "ru_id": "RU-317", "gdpr_article": 32, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 14, "total": 26}, {"round": 3, "n_queries": 4, "new": 5, "total": 31}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict is based on an incomplete analysis of the provisions.", "counter_evidence": [{"id": "37d872c258760ad10ae9", "span": "إخفاء الهوية", "why": "Article 9 mentions anonymisation and includes provisions related to pseudonymisation, which suggests that pseudonymisation is covered in the KSA jurisdiction."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's verdict of C2 (partial match) is incorrect, as Article 9 provides a clear counterpart to the GDPR requirement unit [RU-317].", "counter_evidence": [{"id": "37d872c258760ad10ae9", "span": "إخفاء الهوية", "why": "Article 9 specifically mentions pseudonymisation as a measure to be taken by the controller when processing personal data."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["e32b4ffefbc31a6a5072", "37d872c258760ad10ae9", "593beb6b1fe15a8fda31", "21847c9e87d6df45a9a7", "8394f801a0a97e521f68", "06b918a4049719ed530f", "c511c9bf7779067e64f4", "d29636711e8dc90e5e69", "62cc177254bb6a5bed90", "3074a33b0107bc8c40a0", "ce107f77eb9119ba01b0", "f8f94d8d9d379713d656"], "n_llm_calls": 7, "latency_s": 810.83, "temperature": 0.7, "seed": 20260803, "id": "aedb536787b59ede3af6", "condition": "stability", "rep": 2}
{"candidates_selected": [], "candidates_excluded": [{"id": "6ada991a77a31372fb4c", "reason": "Concerns appointment and access of an external auditor; no duty for a processor to notify a controller about adding/replacing subprocessors."}, {"id": "b59c6e3df96d0cdf91f8", "reason": "Requires appointment of an external auditor upon ministry request and sending the report; unrelated to sub-processing or processor-to-controller notifications."}, {"id": "a023625d7c33737b6c29", "reason": "Obliges the controller to update records and provide them to the authority; no relation to notifying about changes to subprocessors."}, {"id": "5483caf68765f09059fb", "reason": "Document retention requirements; does not address sub-processing change notifications."}, {"id": "a9e378888839f3a0144c", "reason": "Allows the ministry to request a controller’s evaluation of an external processing entity; does not impose any processor duty to inform the controller about intended additions or replacements of subprocessors, nor any pre-implementation timing."}, {"id": "a3d16e47b198e1ecb3c6", "reason": "Consent requirements; unrelated to sub-processing notification duties."}, {"id": "09d77a4e064de5fe6273", "reason": "Data breach documentation by the controller; no processor-to-controller notification about subprocessor changes."}, {"id": "b08fd8d6893cd6de53e8", "reason": "General retention of processing documents; no notification obligation about subprocessor changes."}, {"id": "409b1f88bc235e09ef89", "reason": "Access for a child’s guardian; unrelated to sub-processing or notifications."}, {"id": "bb26cffae1f1c0beb85d", "reason": "Privacy policy publication; unrelated to processor notifications about subprocessors."}, {"id": "c7ddf58d01bb4d45c9d5", "reason": "Controller must notify the competent authority of changes to license data within 15 days; this is not a processor duty, not a notice to the controller, not about adding/replacing subprocessors, and not a pre-implementation notice."}, {"id": "a0a0194dd91481c29c6e", "reason": "Controller’s internal controls for processing; no duty regarding processor notices about subprocessor changes."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "processor", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "modality"}, {"gdpr_value": "inform the controller of any intended changes concerning the addition or replacement of other processors", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr_value": "sub-processing", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr_value": "where the controller has given general written authorisation to engage other processors", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": "no exception stated in the target provisions", "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "before implementing the intended changes", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": "no consequence stated in the target provisions", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.73, "reasoning_note": "None of the cited OMN provisions impose a duty on a processor to notify the controller, prior to implementation, about adding or replacing subprocessors under a general authorization. Article 9 is a controller-to-authority notice about license data, not a processor-to-controller subprocessing change notice. Article 40 mentions external processing entities but contains no such notification requirement or timing constraint.", "label": "C5", "ru_id": "RU-226", "gdpr_article": 28, "jurisdiction": "OMN", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 12, "total": 24}, {"round": 3, "n_queries": 4, "new": 7, "total": 31}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Potential for indirect counterpart or related concept under different terminology or distribution across provisions", "counter_evidence": [{"id": "c7ddf58d01bb4d45c9d5", "span": "يلتزم المتحكم بإخطار الإدارة المختصة - على النموذج المعد لذلك - بأي تعديلات في البيانات الواردة في التصريح الصادر له، وذلك خلال (15) خمسة عشر يوماً من تاريخ إجراء تلك التعديلات", "why": "Implies a requirement for notification of changes, potentially related to the GDPR requirement"}], "confidence": 0.6}, {"verdict": "revise", "objection": "Potential counterpart to the GDPR requirement might exist under different terminology or context, such as notification requirements.", "counter_evidence": [{"id": "c7ddf58d01bb4d45c9d5", "span": "يلتزم المتحكم بإخطار الإدارة المختصة - على النموذج المعد لذلك - بأي تعديلات في البيانات الواردة في التصريح الصادر له", "why": "Establishes a general obligation for the controller to inform the administration of changes."}], "confidence": 0.4}], "n_candidates": 12, "candidate_ids": ["6ada991a77a31372fb4c", "b59c6e3df96d0cdf91f8", "a023625d7c33737b6c29", "5483caf68765f09059fb", "a9e378888839f3a0144c", "a3d16e47b198e1ecb3c6", "09d77a4e064de5fe6273", "b08fd8d6893cd6de53e8", "409b1f88bc235e09ef89", "bb26cffae1f1c0beb85d", "c7ddf58d01bb4d45c9d5", "a0a0194dd91481c29c6e"], "n_llm_calls": 7, "latency_s": 731.26, "temperature": 0.7, "seed": 20260803, "id": "0af652293feef38095af", "condition": "stability", "rep": 2}
{"candidates_selected": ["6b500d26673394f3d7e6"], "candidates_excluded": [{"id": "f8344697d1f1dc661161", "reason": "Sensitive data processing conditions; no rule to notify recipients of rectification/erasure/restriction."}, {"id": "a3c79315ae2d7920a38f", "reason": "Complaint procedure; no rule on communicating rectification/erasure/restriction to recipients."}, {"id": "74358e437cd9e85fdabb", "reason": "DPO duties/record-keeping; does not address notifying recipients of rectification/erasure/restriction."}, {"id": "4f0c7ea198f3c5b3627c", "reason": "Cross-border transfer contractual clauses; no general duty to notify recipients of rectification/erasure/restriction."}, {"id": "c9145cc9a91d8ff7530c", "reason": "Liability of DPOs; not about notifications to recipients."}, {"id": "7e2914aa34ab2739dafd", "reason": "Security of processing; no notification-to-recipients rule."}, {"id": "6a403e591ecc2a5638fc", "reason": "DPO investigation; irrelevant to recipient notification after rectification/erasure/restriction."}, {"id": "3d71a23a91370cadf799", "reason": "Criminal data processing; no duty to notify recipients of rectification/erasure/restriction."}, {"id": "5bd7541a2690632a7c77", "reason": "Consent; not about communicating rectification/erasure/restriction to recipients."}, {"id": "daaf1e5a7eedf0d7755e", "reason": "Investigation procedures; no relevant notification rule."}, {"id": "8e585010f3f5f3f24dbb", "reason": "Oversight/inspection; no rule on notifying recipients of rectification/erasure/restriction."}], "target_frame": {"addressee": {"span": "على مدير البيانات", "article": "Article 23(5)"}, "modality": {"span": "على مدير البيانات ... إخطار", "article": "Article 23(5)"}, "action": {"span": "إخطار أيّ طرف ثالث أفصح له عن تلك البيانات عن التصحيح أو المسح أو الحَجْب", "article": "Article 23(5)"}, "scope": {"span": "أيّ طرف ثالث أفصح له عن تلك البيانات", "article": "Article 23(5)"}, "condition": {"span": "من تاريخ استجابته - كلياً أو جزئياً - لطلب قُدِّم إليه استناداً لحكم البند (1) من هذه المادة", "article": "Article 23(5)"}, "exception": {"span": "مالم يكن ذلك متعذراً أو لا يمكن تحقيقه بحسب الأحوال", "article": "Article 23(5)"}, "temporal": {"span": "خلال خمسة عشر يوماً", "article": "Article 23(5)"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "controller", "target_value": "مدير البيانات (controller)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(5)", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "على مدير البيانات ... إخطار (must notify)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(5)", "slot": "modality"}, {"gdpr_value": "communicate any rectification or erasure of personal data or restriction of processing", "target_value": "إخطار ... عن التصحيح أو المسح أو الحَجْب", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(5)", "slot": "action"}, {"gdpr_value": "each recipient to whom the personal data have been disclosed", "target_value": "أيّ طرف ثالث أفصح له عن تلك البيانات", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(5)", "slot": "scope"}, {"gdpr_value": "after carrying out the rectification or erasure or restriction in accordance with Articles 16, 17(1) or 18", "target_value": "بعد استجابة مدير البيانات كلياً أو جزئياً لطلب صاحب البيانات المنصوص عليه في الفقرة (1) من المادة 23", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 23(5)", "slot": "condition"}, {"gdpr_value": "unless this proves impossible or involves disproportionate effort", "target_value": "ما لم يكن ذلك متعذراً أو لا يمكن تحقيقه", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 23(5)", "slot": "exception"}, {"gdpr_value": "None", "target_value": "خلال خمسة عشر يوماً", "basis": "direct_textual", "verdict": "broader", "citation": "Article 23(5)", "slot": "temporal"}, {"gdpr_value": "None", "target_value": "None stated", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.67, "reasoning_note": "Agree with the objection: Article 23(5) BHR triggers notification only when the controller has acted on a data subject’s request, not for all instances of rectification/erasure/restriction. Hence the condition slot is narrower than GDPR Art. 19. Other elements (addressee, modality, action, scope, and an impossibility-type exception) are textually covered.", "label": "C1", "ru_id": "RU-172", "gdpr_article": 19, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 19, "total": 31}, {"round": 3, "n_queries": 4, "new": 6, "total": 37}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The Bahraini jurisdiction's provision (Article 23(5)) does not fully align with the GDPR requirement unit [RU-172], as it only requires notification of third parties after the controller has responded to a request, whereas the GDPR requirement obliges the controller to communicate any rectification or erasure of personal data or restriction of processing to each recipient to whom the personal data have been disclosed, regardless of whether a request has been made.", "counter_evidence": [{"id": "6b500d26673394f3d7e6", "span": "على مدير البيانات، خلال خمسة عشر يوماً من تاريخ استجابته - كلياً أو جزئياً - لطلب قُدِّم إليه استناداً لحكم البند (1) من هذه المادة، إخطار أيّ طرف ثالث أفصح له عن تلك البيانات عن التصحيح أو المسح أو الحَجْب الذي تم نتيجة الطلب المشار إليه، مالم يكن ذلك متعذراً أو لا يمكن تحقيقه بحسب الأحوال.", "why": "The provision only requires notification of third parties after the controller has responded to a request, which is narrower than the GDPR requirement."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The BHR law only requires notification of rectification, erasure, or restriction of processing in response to a request from the data subject, whereas the GDPR requires notification in all cases where such measures have been carried out.", "counter_evidence": [{"id": "6b500d26673394f3d7e6", "span": "على مدير البيانات، خلال خمسة عشر يوماً من تاريخ استجابته - كلياً أو جزئياً - لطلب قُدِّم إليه استناداً لحكم البند (1) من هذه المادة، إخطار أيّ طرف ثالث أفصح له عن تلك البيانات عن التصحيح أو المسح أو الحَجْب الذي تم نتيجة الطلب المشار إليه", "why": "This provision only requires notification in response to a request from the data subject, whereas the GDPR requires notification in all cases."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["f8344697d1f1dc661161", "a3c79315ae2d7920a38f", "74358e437cd9e85fdabb", "4f0c7ea198f3c5b3627c", "c9145cc9a91d8ff7530c", "6b500d26673394f3d7e6", "7e2914aa34ab2739dafd", "6a403e591ecc2a5638fc", "3d71a23a91370cadf799", "5bd7541a2690632a7c77", "daaf1e5a7eedf0d7755e", "8e585010f3f5f3f24dbb"], "n_llm_calls": 7, "latency_s": 810.47, "temperature": 0.7, "seed": 20260803, "id": "8479f35c51289a71102a", "condition": "stability", "rep": 2}
{"candidates_selected": ["75db9db720e9e34a1148", "89d1bb9a58e65b732117"], "candidates_excluded": [{"id": "f169b712b14aea8718ee", "reason": "Addresses the controller (المراقب) lawful bases; does not regulate the processor (المعالج) or tie processor activity to controller’s instructions."}, {"id": "850decaffbbae78d371d", "reason": "Controller exemptions from certain obligations; no rule on processor acting only under controller’s instructions."}, {"id": "07962910da55dbce48d3", "reason": "Cross‑border flow restriction addressed to the controller; no processor‑instruction rule."}, {"id": "f5c366135483fe580381", "reason": "Breach notification by controller; unrelated to processor instructions."}, {"id": "2bcce9feda2fcb9d35fe", "reason": "General principles; no processor‑specific obligation to act only on controller’s instructions."}, {"id": "75852a697f66691bfbfb", "reason": "Exemptions from data subject rights responses; no bearing on processor instruction‑bound processing."}, {"id": "85d05fccf5b4f57eceaf", "reason": "Controller obligations; does not impose instruction‑bound processing on processors."}, {"id": "dce663972f2d5e58176e", "reason": "Scope of the law; no operative rule on processor instructions."}, {"id": "18cb1cd8191cffb1c314", "reason": "Authority may process for specified state interests; not about a processor’s duty to act only on controller’s instructions."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "Public‑interest/authority processing carve‑out; not a processor instruction rule."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "article": null}, "action": {"span": "يتولى معالجة البيانات لصالح المراقب", "article": "89d1bb9a58e65b732117"}, "scope": {"span": "البيانات الشخصية", "article": "89d1bb9a58e65b732117"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "processor", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "modality", "gdpr_value": "prohibition", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "action", "gdpr_value": "process personal data", "target_value": "يتولى معالجة البيانات لصالح المراقب", "basis": "direct_textual", "verdict": "covered", "citation": "89d1bb9a58e65b732117"}, {"slot": "scope", "gdpr_value": "personal data to which the processor has access", "target_value": "البيانات الشخصية", "basis": "direct_textual", "verdict": "covered", "citation": "89d1bb9a58e65b732117"}, {"slot": "condition", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "exception", "gdpr_value": "when acting on instructions from the controller; or when required to process by Union or Member State law", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null}, {"slot": "temporal", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.66, "reasoning_note": "Article 4 addresses the controller (المراقب), not the processor (المعالج), so it cannot serve as a functional counterpart to a processor‑addressed prohibition. The selected texts acknowledge processing by a third party on behalf of the controller (Art. 9) and controller duties when transferring to a processor (Art. 12), but they do not impose a rule that the processor may act only on the controller’s instructions or when required by law. Exceptions in Arts. 18/19 relate to controllers/authorities, not processors.", "label": "C2", "ru_id": "RU-251", "gdpr_article": 29, "jurisdiction": "QAT", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 7, "total": 7}, {"round": 2, "n_queries": 4, "new": 9, "total": 16}, {"round": 3, "n_queries": 4, "new": 3, "total": 19}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's claim of no counterpart for the exception of processing personal data when required by law is not supported, as Articles 19 and 18 provide relevant provisions.", "counter_evidence": [{"id": "850decaffbbae78d371d", "span": "تنفيذ التزام قانوني أو أمر من محكمة مختصة", "why": "This provision in Article 19 indicates an exception for legal obligations or court orders, covering part of the GDPR's requirement for processing based on legal necessity."}, {"id": "3f5cc5a2c4af5fb90388", "span": "منع أي جريمة جنائية، أو جمع معلومات عنها، أو التحقيق فيها", "why": "Article 18 allows for the processing of personal data for the prevention of any criminal offense, which aligns with the GDPR's exception for processing when required by Union or Member State law."}], "confidence": 0.8}, {"verdict": "revise", "objection": "Counterpart for 'addressee' slot (processor) might exist under different terminology in Article 4.", "counter_evidence": [{"id": "f169b712b14aea8718ee", "span": "لا يجوز للمراقب معالجة البيانات الشخصية، إلا بعد الحصول على موافقة الفرد، ما لم تكن المعالجة ضرورية لتحقيق غرض مشروع للمراقب أو الغير الذي تُرسل إليه البيانات.", "why": "This provision implies that the controller (which could be analogous to the processor in certain contexts) must have a legitimate purpose or consent to process personal data."}, {"id": "3f5cc5a2c4af5fb90388", "span": "للجهة المختصة أن تقرر معالجة بعض البيانات الشخصية دون التقيد بأحكام المواد (4)، (9)، (15)، (17) من هذا القانون، وذلك لتحقيق أي من الأغراض الآتية:", "why": "This article provides exceptions for processing personal data, similar to the GDPR's exception for processing required by Union or Member State law."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["f169b712b14aea8718ee", "850decaffbbae78d371d", "75db9db720e9e34a1148", "07962910da55dbce48d3", "f5c366135483fe580381", "2bcce9feda2fcb9d35fe", "89d1bb9a58e65b732117", "75852a697f66691bfbfb", "85d05fccf5b4f57eceaf", "dce663972f2d5e58176e", "18cb1cd8191cffb1c314", "3f5cc5a2c4af5fb90388"], "n_llm_calls": 7, "latency_s": 813.11, "temperature": 0.7, "seed": 20260803, "id": "67ac8731b5a8f2e3c002", "condition": "stability", "rep": 2}
{"candidates_selected": ["1d8fd3d4070b1ff36d68", "30fc4eea1adc8ce439a8", "7e2914aa34ab2739dafd", "063ab5d9ef023666aed7"], "candidates_excluded": [{"id": "e38e0bed35316765ba57", "reason": "Administrative register of notifications/authorizations; does not set general applicability to automated processing or compliance duty."}, {"id": "34ea02d93464e8e2fa05", "reason": "Definition (privacy by design) in a decision; not a material-scope/applicability rule."}, {"id": "4f0c7ea198f3c5b3627c", "reason": "Cross-border transfer contractual terms; not a general duty to comply when processing by automated means."}, {"id": "231a37f671238dbf7112", "reason": "Definitions for DPO register; no rule on applicability to automated processing."}, {"id": "cf27d7263418b5d502ef", "reason": "Definitions (BCRs) in a decision; does not address the RU-003 proposition."}, {"id": "7448a27e7806f2c0c143", "reason": "Data quality principles; do not establish a general duty tied to automated processing or exclusions."}, {"id": "10e6e0e9f2f36b4c7b42", "reason": "Public registers conditions; not about general applicability to automated processing."}, {"id": "74358e437cd9e85fdabb", "reason": "DPO roles/help ensure compliance but do not articulate material scope or a general duty triggered by automated processing."}, {"id": "e38e0bed35316765ba57", "reason": "Register of notifications/authorizations; procedural only, not material scope."}], "target_frame": {"proposition": {"span": null, "article": null}, "addressee": {"span": "على مدير البيانات", "article": "Article 14(1)"}, "modality": {"span": "على مدير البيانات إخطار الهيئة", "article": "Article 14(1)"}, "action": {"span": "الاتفاق الكتابي فيما بينهم على دور ومسؤوليات كل منهم، لضمان الامتثال للقانون والقرارات الصادرة تنفيذاً له", "article": "Article 7(1) (Decision on joint controllers)"}, "scope": {"span": "المعالجة التي تتم آلياً كلياً أو جزئياً", "article": "Article 14(1)"}, "condition": {"span": null, "article": null}, "exception": {"span": "ويُعفى مدير البيانات من تقديم الإخطار المشار إليه بشأن ما يأتي: أ - المعالَجة التي يكون الغرض الوحيد منها إمساك سجل وِفقاً للقانون بهدف توفير معلومات للجمهور ... ب - معالجة البيانات التي تتم في سياق أنشطة الجمعيات بأنواعها والنقابات وغيرها من الجهات التي لا تهدف إلى تحقيق الربح. ج - معالجة صاحب العمل لبيانات العاملين لديه ... د - الحالات التي يتم فيها تعيين مراقب حماية بيانات.", "article": "Article 14(1)(a)-(d)"}, "temporal": {"span": "قبل بدء عملية المعالجة", "article": "Article 14(1)"}, "consequence": {"span": "وعلى مقدِّم الطلب التوقف عن المعالَجة لحين استيفاء النقص بالإخطار.", "article": "Article 14(4)"}}, "slot_verdicts": [{"gdpr_value": "Controllers and processors must comply with this Regulation when they process personal data wholly or partly by automated means, subject to listed exclusions.", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "proposition"}, {"gdpr_value": "controllers and processors", "target_value": "مدير البيانات (controller)", "basis": "direct_textual", "verdict": "narrower", "citation": "Article 14(1)", "slot": "addressee"}, {"gdpr_value": "obligation", "target_value": "على مدير البيانات ... (mandatory ‘must’)", "basis": "direct_textual", "verdict": "covered", "citation": "Article 14(1)", "slot": "modality"}, {"gdpr_value": "comply with this Regulation", "target_value": "… لضمان الامتثال للقانون والقرارات الصادرة تنفيذاً له (ensure compliance with the law)", "basis": "direct_textual", "verdict": "partial", "citation": "Article 7(1) (Decision on joint controllers)", "slot": "action"}, {"gdpr_value": "processing of personal data wholly or partly by automated means", "target_value": "المعالجة التي تتم آلياً كلياً أو جزئياً", "basis": "direct_textual", "verdict": "covered", "citation": "Article 14(1)", "slot": "scope"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "condition"}, {"gdpr_value": "Exclusions (a)-(d) where the Regulation does not apply (Union law outside scope; Member State activities under TEU V.2; personal/household; law-enforcement).", "target_value": "Exemptions from notification for certain processing (public registers; non-profits; employer HR; DPO appointed).", "basis": "direct_textual", "verdict": "uncovered", "citation": "Article 14(1)(a)-(d)", "slot": "exception"}, {"gdpr_value": "None", "target_value": "قبل بدء عملية المعالجة", "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": "التوقف عن المعالجة لحين استيفاء النقص بالإخطار", "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "partial", "confidence": 0.63, "reasoning_note": "Article 8(1) imposes a specific security obligation but does not articulate a general “duty to comply with the PDPL when processing by automated means,” nor does it set material-scope exclusions equivalent to GDPR Art. 2(2). The only explicit mentions of automated processing (Arts. 14 and 15) create notification/authorization requirements, not a general applicability clause. Therefore, RU-003’s general proposition and its exceptions remain uncovered on the provided texts.", "label": "C4", "ru_id": "RU-003", "gdpr_article": 2, "jurisdiction": "BHR", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 11, "total": 11}, {"round": 2, "n_queries": 4, "new": 18, "total": 29}, {"round": 3, "n_queries": 4, "new": 2, "total": 31}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's verdict is not entirely accurate, and the BHR law has some provisions that are similar to the GDPR.", "counter_evidence": [{"id": "[1d8fd3d4070b1ff36d68]", "span": "Article 14(1)", "why": "The BHR law requires the controller to notify the authority before processing personal data, which is similar to the GDPR requirement."}, {"id": "[7e2914aa34ab2739dafd]", "span": "Article 8(1)", "why": "The BHR law requires the controller to implement technical and organizational measures to protect personal data, which is similar to the GDPR requirement."}, {"id": "[063ab5d9ef023666aed7]", "span": "Article 7", "why": "The BHR law mentions the concept of 'more than one controller' processing personal data, which suggests that the BHR law may have a broader scope than initially claimed."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's claim that there is no single clause stating a general duty to comply with the PDPL when processing by automated means is incorrect.", "counter_evidence": [{"id": "Article 8(1)", "span": "على مدير البيانات تطبيق التدابير الفنية والتنظيمية الكفيلة بحماية البيانات من الإتلاف غير المقصود أو غير المصرَّح به، أو من الفقْد العَرَضي، أو مما هو غير مصرَّح به من التغيير أو الإفصاح أو النفاذ أو أيٍّ من الصور الأخرى للمعالَجة", "why": "This provision implies that controllers have a general duty to comply with the PDPL when processing personal data, including by automated means."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["e38e0bed35316765ba57", "7e2914aa34ab2739dafd", "34ea02d93464e8e2fa05", "74358e437cd9e85fdabb", "1d8fd3d4070b1ff36d68", "4f0c7ea198f3c5b3627c", "231a37f671238dbf7112", "cf27d7263418b5d502ef", "063ab5d9ef023666aed7", "30fc4eea1adc8ce439a8", "7448a27e7806f2c0c143", "10e6e0e9f2f36b4c7b42"], "n_llm_calls": 7, "latency_s": 883.06, "temperature": 0.7, "seed": 20260803, "id": "d6b7aa08f998708d44c3", "condition": "stability", "rep": 2}
{"candidates_selected": ["6201d16404c0d4b9f63d"], "candidates_excluded": [{"id": "0cc06e3d3b107448da5a", "reason": "Processor obligations and general compliance/tools; mentions rules/conditions and Office instructions, but no scheme allowing non-subject entities to adhere to approved codes of conduct as a transfer safeguard."}, {"id": "c34922f387019af45e42", "reason": "Data subject rights re automated decisions; unrelated to cross-border transfer safeguards or codes of conduct."}, {"id": "dec351a1e477287e3b22", "reason": "Controller communication channels; not about transfer safeguards or codes of conduct."}, {"id": "9c38ab11b550755816f5", "reason": "Duties toward DPO; not about cross-border transfer safeguards or codes of conduct."}, {"id": "80f95c322bb3204c7f65", "reason": "Consent conditions; not about codes of conduct or their use as transfer safeguards."}, {"id": "674524dee00496cb5de7", "reason": "Controller obligations and records; includes cross-border record-keeping but no code-of-conduct adherence mechanism for transfers."}, {"id": "5bedab371a9fc40ba93a", "reason": "Right to restrict processing; unrelated to transfer safeguards or codes of conduct."}, {"id": "34f7595acb9df257ef5e", "reason": "DPO roles; no cross-border safeguards or codes of conduct."}, {"id": "9630e6d967b64e07d339", "reason": "DPO appointment; no cross-border safeguards or codes of conduct."}, {"id": "877fafe0080725188d05", "reason": "Rectification/erasure rights; unrelated to codes of conduct or transfer safeguards."}, {"id": "5d949837d7aab073cd67", "reason": "Complaints to the authority; no cross-border safeguards or codes of conduct."}], "target_frame": {"addressee": {"span": "المنشآت العاملة في الدولة وفي تلك الدول", "article": "Article 23(1)(أ) [6201d16404c0d4b9f63d]"}, "modality": {"span": "يجوز نقل البيانات الشخصية إلى خارج الدولة", "article": "Article 23(1) [6201d16404c0d4b9f63d]"}, "action": {"span": "أن تنقل البيانات بموجب عقد أو اتفاقية يلزم المنشأة في تلك الدول بتطبيق الأحكام والتدابير والضوابط والاشتراطات الواردة في هذا المرسوم بقانون", "article": "Article 23(1)(أ) [6201d16404c0d4b9f63d]"}, "scope": {"span": "نقل ومشاركة البيانات الشخصية عبر الحدود لأغراض المعالجة في حال عدم وجود مستوى حماية ملائم", "article": "Article 23 (title) [6201d16404c0d4b9f63d]"}, "condition": {"span": "شاملاً أحكاماً تتعلق بفرض التدابير المناسبة على المتحكم أو المعالج من خلال جهة رقابية أو قضائية معنية في تلك الدولة وتحدد في العقد", "article": "Article 23(1)(أ) [6201d16404c0d4b9f63d]"}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr_value": "Controllers or processors not subject to the Regulation pursuant to Article 3", "target_value": "المنشآت العاملة في الدولة وفي تلك الدول", "basis": "direct_textual", "verdict": "uncovered", "citation": "Article 23(1)(أ) [6201d16404c0d4b9f63d]", "slot": "addressee"}, {"gdpr_value": "permission", "target_value": "يجوز", "basis": "direct_textual", "verdict": "covered", "citation": "Article 23(1) [6201d16404c0d4b9f63d]", "slot": "modality"}, {"gdpr_value": "adhere to approved and generally valid codes of conduct", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr_value": "To provide appropriate safeguards for personal data transfers to third countries or international organisations under Article 46(2)(e)", "target_value": "نقل ومشاركة البيانات الشخصية عبر الحدود في حال عدم وجود مستوى حماية ملائم", "basis": "conceptual", "verdict": "partial", "citation": "Article 23 (title) [6201d16404c0d4b9f63d]", "slot": "scope"}, {"gdpr_value": "The code of conduct is approved pursuant to paragraph 5 and has general validity pursuant to paragraph 9", "target_value": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "condition"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr_value": "None", "target_value": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.67, "reasoning_note": "Article 23 provides a contractual mechanism for cross-border transfers where no adequate protection exists; it does not establish or reference an approved, generally valid code-of-conduct scheme, nor permit non-subject entities to adhere to such a code as a transfer safeguard. The cited phrases about “rules/conditions/controls” and Office instructions are general compliance features, not a GDPR-like Art. 40 approval/general-validity framework or an Art. 46(2)(e) safeguard.", "label": "C2", "ru_id": "RU-487", "gdpr_article": 40, "jurisdiction": "UAE", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 7, "total": 19}, {"round": 3, "n_queries": 4, "new": 1, "total": 20}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Counterpart provision found in Article 23, which discusses transfer of personal data across borders with appropriate safeguards.", "counter_evidence": [{"id": "6201d16404c0d4b9f63d", "span": "المادة (23) نقل ومشاركة البيانات الشخصية عبر الحدود لأغراض المعالجة في حال عدم وجود مستوى حماية ملائم", "why": "This article discusses the transfer of personal data across borders and mentions the need for appropriate safeguards, which relates to the original proposition."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The UAE law has provisions related to the transfer of personal data across borders and the implementation of rules, conditions, and controls, which could be related to the concept of codes of conduct.", "counter_evidence": [{"id": "6201d16404c0d4b9f63d", "span": "يجوز للمنشآت العاملة في الدولة وفي تلك الدول أن تنقل البيانات بموجب عقد أو اتفاقية يلزم المنشأة في تلك الدول بتطبيق الأحكام والتدابير والضوابط والاشتراطات الواردة في هذا المرسوم بقانون شاملاً أحكاماً تتعلق بفرض التدابير المناسبة على المتحكم أو المعالج من خلال جهة رقابية أو قضائية معنية في تلك الدولة وتحدد في العقد", "why": "This provision is related to the transfer of personal data across borders and mentions the application of measures and controls, which could be related to the concept of codes of conduct."}, {"id": "0cc06e3d3b107448da5a", "span": "إجراء المعالجة وتنفيذها طبقاً للقواعد والاشتراطات والضوابط المحددة بهذا المرسوم بقانون ولائحته التنفيذية أو التي يصدر بموجبها تعليمات من المكتب", "why": "This provision mentions the implementation of rules, conditions, and controls, which could be related to the concept of codes of conduct."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["0cc06e3d3b107448da5a", "c34922f387019af45e42", "dec351a1e477287e3b22", "9c38ab11b550755816f5", "80f95c322bb3204c7f65", "674524dee00496cb5de7", "5bedab371a9fc40ba93a", "34f7595acb9df257ef5e", "9630e6d967b64e07d339", "877fafe0080725188d05", "5d949837d7aab073cd67", "6201d16404c0d4b9f63d"], "n_llm_calls": 7, "latency_s": 822.0, "temperature": 0.7, "seed": 20260803, "id": "4d75610be0803c3657cc", "condition": "stability", "rep": 2}
{"candidates_selected": [], "candidates_excluded": [{"id": "3d71a23a91370cadf799", "reason": "Addresses criminal-justice data processing and exceptions; no supervisory-authority duty to advise on proposed processing operations."}, {"id": "348fe2ada83b7d57f33a", "reason": "Confidentiality and disclosure by the authority; does not create or describe an advisory function toward controllers."}, {"id": "f8344697d1f1dc661161", "reason": "Sensitive-data processing bases and a prior permit in limited cases; this is authorization, not a duty to give advice on processing operations."}, {"id": "7448a27e7806f2c0c143", "reason": "Data quality principles for processing; no supervisory-authority advisory obligation."}, {"id": "601ddc5fd8dcb81306cb", "reason": "Board powers to issue regulations/decisions and oversee the authority; no text requiring advice on specific processing operations."}, {"id": "4415e9a46823d9615000", "reason": "Provision on deputing law-enforcement officers for investigations; unrelated to advisory duties."}, {"id": "daaf1e5a7eedf0d7755e", "reason": "Investigation procedures; no obligation to advise controllers on intended processing."}, {"id": "0c6c8a278f0b3b395e23", "reason": "Appeals against authority decisions; procedural, not advisory."}, {"id": "129b122a7d0386567e65", "reason": "CEO’s administrative powers; no advisory duty toward controllers on processing operations."}, {"id": "eb633917dcbabe34df47", "reason": "Data subject right regarding automated decisions; no supervisory-authority advisory role."}, {"id": "9bcb8d6e5e38974e2a1b", "reason": "Power to obtain information in investigations; enforcement, not advisory."}], "target_frame": {"addressee": {"span": null, "article": null}, "modality": {"span": null, "article": null}, "action": {"span": null, "article": null}, "scope": {"span": null, "article": null}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"gdpr": "supervisory authority", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "addressee"}, {"gdpr": "obligation", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "modality"}, {"gdpr": "give advice", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "action"}, {"gdpr": "on the processing operations referred to in Article 36(2)", "target": null, "basis": "absent", "verdict": "uncovered", "citation": null, "slot": "scope"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "condition"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "exception"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "temporal"}, {"gdpr": "None", "target": null, "basis": "absent", "verdict": "covered", "citation": null, "slot": "consequence"}], "holistic_label": "uncovered", "confidence": 0.56, "reasoning_note": "The cited Bahrain provisions (Board/CEO powers and investigation mechanisms) provide regulatory, managerial, and enforcement authorities, but do not articulate a duty to provide advice to controllers on intended processing operations akin to GDPR prior consultation. Article 37(3)(b) even concerns the Authority seeking others’ advice, not giving it. No distributed text among the provided articles functionally establishes the supervisory authority’s obligation to give advice on specific processing operations.", "label": "C5", "ru_id": "RU-389", "gdpr_article": 35, "jurisdiction": "BHR", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 16, "total": 28}, {"round": 3, "n_queries": 4, "new": 7, "total": 35}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Potential for advisory role within tasks and powers of authority boards and committees", "counter_evidence": [{"id": "48", "span": "Article 48, investigation procedures and the role of the Investigation Committee", "why": "Suggests a guiding or oversight role in the context of investigations"}, {"id": "40", "span": "Article 40, tasks and powers of the Board of Directors", "why": "Implies oversight and guidance in implementing the law"}], "confidence": 0.7}, {"verdict": "revise", "objection": "Counterpart exists under different terminology or distributed across several provisions", "counter_evidence": [{"id": "44", "span": "الرئيس التنفيذي", "why": "The President of the Executive Body has regulatory and advisory powers"}, {"id": "40", "span": "مجلس الإدارة", "why": "The Board of Directors has the power to issue regulations and decisions"}, {"id": "48", "span": "لجنة التحقيق", "why": "The Investigation Committee has the power to request data and information necessary for investigation"}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["3d71a23a91370cadf799", "348fe2ada83b7d57f33a", "f8344697d1f1dc661161", "7448a27e7806f2c0c143", "601ddc5fd8dcb81306cb", "4415e9a46823d9615000", "daaf1e5a7eedf0d7755e", "0c6c8a278f0b3b395e23", "129b122a7d0386567e65", "eb633917dcbabe34df47", "9bcb8d6e5e38974e2a1b", "5bd7541a2690632a7c77"], "n_llm_calls": 7, "latency_s": 725.65, "temperature": 0.7, "seed": 20260803, "id": "61c42efeb3885a639716", "condition": "stability", "rep": 2}
{"candidates_selected": ["6c76988b817262e3e312", "32f2136681f29047cd6a"], "candidates_excluded": [{"id": "85d05fccf5b4f57eceaf", "reason": "Sets general controller obligations and adherence to authority-issued privacy policies, but does not assign monitoring/training/audit functions."}, {"id": "75db9db720e9e34a1148", "reason": "Addresses conditions for disclosure/transfer to a processor; no compliance-monitoring or audit duties."}, {"id": "fcbd13532c69b340214e", "reason": "Security safeguards and breach notice to controller; not about ongoing compliance monitoring/audits/training."}, {"id": "f5c366135483fe580381", "reason": "Breach notification to data subject and authority; not a monitoring/audit/training obligation."}, {"id": "455aae046cacf7979576", "reason": "Data quality and storage limitation duties; no monitoring/training/audit mandate."}, {"id": "89d1bb9a58e65b732117", "reason": "Transparency information to individuals; not about monitoring compliance or internal audits/training."}, {"id": "07962910da55dbce48d3", "reason": "Cross-border data flow restriction; unrelated to compliance-monitoring functions."}, {"id": "3f5cc5a2c4af5fb90388", "reason": "Public-interest processing exemptions; no duties to monitor/audit/train."}, {"id": "85e94dba24cbfb8955cd", "reason": "Data subject access rights; not an obligation to monitor compliance."}, {"id": "2bcce9feda2fcb9d35fe", "reason": "High-level right and principles; no operative monitoring/training/audit duties."}], "target_frame": {"addressee": {"span": "على المراقب اتخاذ الإجراءات التالية:", "article": "Article 11"}, "modality": {"span": "على المراقب اتخاذ الإجراءات التالية:", "article": "Article 11"}, "action": {"span": "تدريب وتوعية المعالجين على حماية البيانات الشخصية؛ إجراء عمليات تدقيق ومراجعة شاملة عن مدى الالتزام بحماية البيانات الشخصية؛ التحقق من التزام المعالج بالتعليمات التي يوجهها إليه ... ورصد ومتابعة ذلك بصفة مستمرة.", "article": "Article 11"}, "scope": {"span": "مدى الالتزام بحماية البيانات الشخصية؛ إجراءات حماية الخصوصية؛ التعليمات التي يوجهها المراقب؛ ونظم داخلية للإدارة الفعالة للبيانات الشخصية.", "article": "Article 11"}, "condition": {"span": null, "article": null}, "exception": {"span": null, "article": null}, "temporal": {"span": "ورصد ومتابعة ذلك بصفة مستمرة", "article": "Article 11"}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "data protection officer", "target_value": "المراقب (controller)", "basis": "direct_textual", "verdict": "uncovered", "citation": "Article 11; Article 1 (تعريف المراقب)"}, {"slot": "modality", "gdpr_value": "obligation", "target_value": "obligation (\"على المراقب ...\")", "basis": "direct_textual", "verdict": "covered", "citation": "Article 11"}, {"slot": "action", "gdpr_value": "monitor compliance with legal and internal data protection requirements, including assigning responsibilities, awareness-raising and training, and related audits", "target_value": "train and raise awareness; conduct comprehensive audits reviewing compliance; verify processor compliance with instructions and monitor it continuously; establish internal systems/procedures", "basis": "distributed", "verdict": "covered", "citation": "Article 11(2)-(3), (5), (7)-(8)"}, {"slot": "scope", "gdpr_value": "GDPR, other Union or Member State data protection provisions, and the controller’s/processor’s policies on personal data protection, incl. assignment of responsibilities, awareness-raising and training, and related audits", "target_value": "compliance with personal data protection under Qatari law; controller’s instructions; privacy-protection procedures; internal systems; training and audits", "basis": "distributed", "verdict": "narrower", "citation": "Article 11(1), (3), (5), (7)-(8)"}, {"slot": "condition", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "exception", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": ""}, {"slot": "temporal", "gdpr_value": "None", "target_value": "continuous monitoring (\"بصفة مستمرة\")", "basis": "direct_textual", "verdict": "broader", "citation": "Article 11(8)"}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": ""}], "holistic_label": "partial", "confidence": 0.69, "reasoning_note": "Functional responsibilities akin to a DPO—training, audits, and ongoing monitoring for compliance—are expressly imposed, but on the controller (المراقب), not on a distinct data protection officer. Thus, the action is covered while the addressee diverges, and the legal scope is domestic rather than multi-jurisdictional. This addresses the objection by recognizing functional equivalence without equating the controller to a DPO role.", "label": "C4", "ru_id": "RU-476", "gdpr_article": 39, "jurisdiction": "QAT", "ablation": "full", "direction": "narrower", "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 10, "total": 10}, {"round": 2, "n_queries": 4, "new": 6, "total": 16}, {"round": 3, "n_queries": 4, "new": 1, "total": 17}], "sufficiency_met": true, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "The analyst's slot verdicts are not supported by the cited provisions, and the target value for the 'addressee' slot is incorrect.", "counter_evidence": [{"id": "6c76988b817262e3e312", "span": "على المراقب اتخاذ الإجراءات التالية:", "why": "The provision does not explicitly mention the 'data protection officer' or the 'GDPR'."}, {"id": "6c76988b817262e3e312", "span": "المراقب", "why": "The term 'المراقب' refers to the controller, not the data protection officer."}], "confidence": 0.8}, {"verdict": "revise", "objection": "The analyst's conclusion about the absence of a counterpart to the GDPR's data protection officer might be too narrow, as it focuses on specific terminology rather than functional responsibilities.", "counter_evidence": [{"id": "Article 11", "span": "على المراقب اتخاذ الإجراءات التالية:", "why": "This article assigns various responsibilities to the controller (المراقب) that could be seen as similar to the role of a data protection officer, including monitoring compliance with data protection provisions."}, {"id": "Article 1", "span": "المراقب: الشخص الطبيعي أو المعنوي الذي يقوم منفرداً أو بالاشتراك مع آخرين بتحديد كيفية معالجة البيانات الشخصية والغرض منها.", "why": "The definition of the controller (المراقب) implies a role that involves determining how personal data is processed and for what purpose, which could encompass responsibilities similar to those of a data protection officer."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["85d05fccf5b4f57eceaf", "75db9db720e9e34a1148", "6c76988b817262e3e312", "fcbd13532c69b340214e", "2bcce9feda2fcb9d35fe", "f5c366135483fe580381", "455aae046cacf7979576", "89d1bb9a58e65b732117", "07962910da55dbce48d3", "3f5cc5a2c4af5fb90388", "85e94dba24cbfb8955cd", "32f2136681f29047cd6a"], "n_llm_calls": 7, "latency_s": 780.13, "temperature": 0.7, "seed": 20260803, "id": "08b1444957657c5e84df", "condition": "stability", "rep": 2}
{"candidates_selected": ["d9a05a425b46428120ee"], "candidates_excluded": [{"id": "3a56eed81feb3655d1d1", "reason": "Sets conditions for public-interest processing by public bodies; does not address supervisory authorities’ jurisdiction or courts."}, {"id": "ccbc630de03e970296c4", "reason": "Provides a private right to compensation; unrelated to supervisory oversight or judicial carve-outs."}, {"id": "67a122f7dc547487996a", "reason": "Establishes penalties and a violations committee; does not delimit supervision over courts."}, {"id": "bddc41add335b2853d90", "reason": "Concerns confiscation/publication sanctions; no scope rule for supervising courts."}, {"id": "7780dca28ee02b6e0f07", "reason": "Regulates guardians’ consent/rights for minors; irrelevant to supervisory authority scope."}, {"id": "e33bde5f24e463a1e604", "reason": "Concerns accreditation bodies; not about supervisory jurisdiction or court exemptions."}, {"id": "17d4b446ea6ed7965d08", "reason": "Implements data subject request-handling; no rule on supervising courts."}, {"id": "fa368b0d433d7765b715", "reason": "Saves stronger data-subject protections from other laws/treaties; does not limit supervisory authority or exempt courts."}, {"id": "04f45ac99bac1acaa486", "reason": "Empowers inspectors for violations; does not create or imply a carve-out for courts acting judicially."}, {"id": "6ce308b7241fe0cf26f0", "reason": "Lists consent exceptions/legal bases; no bearing on supervisory oversight of courts."}, {"id": "eef2332de931ce118731", "reason": "Data retention/erasure including for litigation; no supervisory carve-out for courts."}], "target_frame": {"addressee": {"span": "تكون الجهة المختصة الجهة المشرفة على تطبيق أحكام النظام واللوائح.", "article": "d9a05a425b46428120ee Art. 30(1)"}, "modality": {"span": "تكون الجهة المختصة الجهة المشرفة على تطبيق أحكام النظام واللوائح.", "article": "d9a05a425b46428120ee Art. 30(1)"}, "action": {"span": "الإشراف على تطبيق أحكام النظام واللوائح", "article": "d9a05a425b46428120ee Art. 30(1)"}, "scope": {"span": "تطبيق أحكام النظام واللوائح", "article": "d9a05a425b46428120ee Art. 30(1)"}, "condition": {"span": null, "article": null}, "exception": {"span": "مع عدم الإخلال بأحكام النظام، وما للبنك المركزي السعودي من صلاحيات وفقاً لما تقضي به النصوص النظامية ذات العلاقة", "article": "d9a05a425b46428120ee Art. 30(1)"}, "temporal": {"span": null, "article": null}, "consequence": {"span": null, "article": null}}, "slot_verdicts": [{"slot": "addressee", "gdpr_value": "supervisory authorities", "target_value": "الجهة المختصة (الجهة المشرفة على تطبيق أحكام النظام واللوائح)", "basis": "direct_textual", "verdict": "covered", "citation": "d9a05a425b46428120ee Art. 30(1)"}, {"slot": "modality", "gdpr_value": "prohibition", "target_value": "إسناد/تمكين من الإشراف (ليست حظراً)", "basis": "direct_textual", "verdict": "uncovered", "citation": "d9a05a425b46428120ee Art. 30(1)"}, {"slot": "action", "gdpr_value": "supervise processing operations", "target_value": "الإشراف على تطبيق أحكام النظام واللوائح", "basis": "direct_textual", "verdict": "covered", "citation": "d9a05a425b46428120ee Art. 30(1)"}, {"slot": "scope", "gdpr_value": "processing operations of courts acting in their judicial capacity", "target_value": "تطبيق أحكام النظام واللوائح (لا ذكر للمحاكم أو العمل القضائي)", "basis": "absent", "verdict": "uncovered", "citation": "d9a05a425b46428120ee Art. 30(1)"}, {"slot": "condition", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "exception", "gdpr_value": "None", "target_value": "استثناء/تحفظ يتعلق بصلاحيات البنك المركزي السعودي فقط", "basis": "direct_textual", "verdict": "uncovered", "citation": "d9a05a425b46428120ee Art. 30(1)"}, {"slot": "temporal", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}, {"slot": "consequence", "gdpr_value": "None", "target_value": "None expressed", "basis": "absent", "verdict": "covered", "citation": null}], "holistic_label": "uncovered", "confidence": 0.67, "reasoning_note": "Article 30 assigns supervisory competence broadly and carves out only the Saudi Central Bank; it contains no prohibition or exemption for courts acting in their judicial capacity. The savings clause in Article 3 preserves stronger data-subject rights from other laws, not limits on supervisory jurisdiction. Therefore, the GDPR-style bar on supervising judicial processing is textually absent.", "label": "C2", "ru_id": "RU-016", "gdpr_article": 6, "jurisdiction": "KSA", "ablation": "full", "direction": null, "sufficiency_curve": [{"round": 1, "n_queries": 1, "new": 12, "total": 12}, {"round": 2, "n_queries": 4, "new": 5, "total": 17}, {"round": 3, "n_queries": 4, "new": 6, "total": 23}], "sufficiency_met": false, "slot_completeness": 1.0, "rule_vs_holistic_agree": false, "n_revisions": 4, "objections": [{"verdict": "revise", "objection": "Insufficient evidence to support the claim that supervisory authorities are prohibited from supervising processing operations of courts acting in their judicial capacity", "counter_evidence": [{"id": "d9a05a425b46428120ee", "span": "المادة الثلاثون: 1- مع عدم الإخلال بأحكام النظام، وما للبنك المركزي السعودي من صلاحيات وفقاً لما تقضي به النصوص النظامية ذات العلاقة، تكون الجهة المختصة الجهة المشرفة على تطبيق أحكام النظام واللوائح.", "why": "Article 30(1) does not explicitly carve out an exception for courts acting in their judicial capacity"}, {"id": "04f45ac99bac1acaa486", "span": "المادة السابعة والثلاثون: 1- يتولى الموظفون أو العاملون -الذين يصدر بتسميتهم قرار من رئيس الجهة المختصة- صلاحيات الضبط والتفتيش المتعلقة بالمخالفات المنصوص عليها في النظام أو اللوائح.", "why": "Article 37 implies that the authority supervising the application of the law and regulations has powers related to inspection and investigation, but does not explicitly state that these powers apply to courts acting in their judicial capacity"}], "confidence": 0.8}, {"verdict": "revise", "objection": "The provisions do not explicitly exempt courts acting in their judicial capacity from supervision, but they do suggest limitations to the supervisory authority's jurisdiction and potential additional protections under other laws or agreements.", "counter_evidence": [{"id": "d9a05a425b46428120ee", "span": "المادة الثلاثون: 1- مع عدم الإخلال بأحكام النظام، وما للبنك المركزي السعودي من صلاحيات وفقاً لما تقضي به النصوص النظامية ذات العلاقة، تكون الجهة المختصة الجهة المشرفة على تطبيق أحكام النظام واللوائح.", "why": "This provision suggests that the supervisory authority's powers are limited by other laws or agreements, which may include protections for courts acting in their judicial capacity."}, {"id": "fa368b0d433d7765b715", "span": "المادة الثالثة: لا تخل الأحكام والإجراءات المنصوص عليها في النظام بأي حكم يمنح حقًا لصاحب البيانات الشخصية أو يقرر حماية أفضل لها، ينص عليه نظام آخر أو اتفاقية دولية تكون المملكة طرًفا فيها.", "why": "This provision implies that other laws or international agreements may provide additional protections for data subjects, including courts acting in their judicial capacity."}], "confidence": 0.8}], "n_candidates": 12, "candidate_ids": ["3a56eed81feb3655d1d1", "ccbc630de03e970296c4", "67a122f7dc547487996a", "bddc41add335b2853d90", "7780dca28ee02b6e0f07", "e33bde5f24e463a1e604", "17d4b446ea6ed7965d08", "fa368b0d433d7765b715", "04f45ac99bac1acaa486", "d9a05a425b46428120ee", "6ce308b7241fe0cf26f0", "eef2332de931ce118731"], "n_llm_calls": 7, "latency_s": 792.29, "temperature": 0.7, "seed": 20260803, "id": "e5f874b271687e4d37b0", "condition": "stability", "rep": 2}
{"candidates_selected": ["865fbf2c2a6ca6fcb814"], "candidates_excluded": [{"id": "a0040ee4dad7d4440e19", "reason": "Mentions disclosure only as an item in a prior-authorization application; does not establish a permission to disclose or relate to official documents/public access balancing."}, {"id": "3f916831456908af27d8", "reason": "Enforcement/remedial powers of the ministry; does not address disclosure of official documents."}, {"id": "93f989531fe30cac1ed5", "reason": "Data erasure right and its limits; unrelated to disclosure of official documents."}, {"id": "6e8de83975a220288296", "reason": "Preamble issuing the executive regulation; no operative rule on disclosure."}, {"id": "487015f110e7b88b5c03", "reason": "Documentation to accompany authorization requests; no rule on disclosure of official documents."}, {"id": "498c9cb637b86367567b", "reason": "Ministry’s functions; no substantive permission concerning disclosure of official documents."}, {"id": "a4136d70ee84d058ef85", "reason": "DPO contact publication; irrelevant to disclosure of official documents."}, {"id": "823830174d241884bd73", "reason": "Complaint mechanism; no rule on disclosure of official documents."}, {"id": "4f65c1f467f9e61b2f46", "reason": "General scope clause; does not speak to disclosure of official documents or balancing with public access."}, {"id": "2712fe4ebdba355a134b", "reason": "General consent requirement for processing; does not create a specific permission to disclose personal data from official documents or a public-access reconciliation."}, {"id": "c62011bb3dda1c9374e5", "reason": "General statement of protection; no operative content on disclosure."}], "target_frame": {"addressee": {"span": "تنفيذ وحدات الجهاز الإداري للدولة وغيرها من الأشخاص الاعتبارية العامة للاختصاصات المقررة لها قانوناً", "article": "865fbf2c2a6ca6fcb814 (Article 3)"}, "modality": {"span": "لا تسري أحكام هذا القانون على معالجة البيانات الشخصية التي تتم في الأحوال الآتية", "article": "865fbf2c2a6ca6fcb814 (A